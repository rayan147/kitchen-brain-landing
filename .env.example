# Optional local development overrides.
CHOKIDAR_USEPOLLING="false"
# Origin of the matching CostCook app. Production safely falls back to
# https://app.costcook.io when this is omitted or invalid.
PUBLIC_APP_URL="http://localhost:5173"
# Must match the recurring Stripe Price configured in the app.
PUBLIC_LAUNCH_PRICE_DISPLAY="$49/month"
