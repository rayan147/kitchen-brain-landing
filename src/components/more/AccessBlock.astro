---
/**
 * Team and access, as a block inside #more. Foundation:
 * docs/stories/team-and-access.story.md
 *
 * WAS A STOP OF ITS OWN UNTIL 2026-09-09. It carried 96 words in 1,290px on a
 * phone, which is the worst words-to-pixels ratio on the page and not because
 * the copy is padded: it is 96 words wrapped in a section heading, a lede, a
 * hand-off line and a screen of section padding. Four such stops in a row is
 * what made the homepage 33 phone viewports against a page whose stated job is
 * to be decided on in under a minute. The block is unchanged; the chrome around
 * it is now shared with three neighbours. See src/components/sections/WhatElse.astro.
 *
 * NOTHING HERE WAS CUT. The h2 is an h3 because the band above it owns the h2.
 */
import FoldedDetail from '../FoldedDetail.astro';

// Considered Strategy; not used because these fixed role summaries are static
// story data and the page does not swap access behavior at runtime.
const roles = [
	{ name: 'Owner', detail: 'Billing and owner-only recipe lifecycle decisions.' },
	{ name: 'Manager', detail: 'Setup, teammates and protected Sage work.' },
	{ name: 'Staff', detail: 'The shared kitchen workspace without higher-role actions.' }
] as const;
---

<article class="more-block" data-more-block="access" data-reveal>
	<p class="more-label">Team &amp; access</p>
	<h3 class="more-title">Three roles. A short list of real boundaries.</h3>
	<p class="more-lede">Bring the crew into one workspace. Owner, Manager and Staff protect specific sensitive actions, while the operational record stays shared.</p>

	<div class="mt-8 border-t border-ticket-rule">
		{roles.map((role) => (
			<div class="grid gap-2 border-b border-dashed border-ticket-rule py-4 sm:grid-cols-[8rem_minmax(0,1fr)]">
				<strong>{role.name}</strong><span class="text-ink-soft">{role.detail}</span>
			</div>
		))}
	</div>

	<p class="mt-7 max-w-[60ch] text-ink-soft"><strong class="text-ink">The limit:</strong> there is no custom role or per-screen permission grid. <a href="/features/team-and-access" class="btn-quiet">See every access boundary</a>.</p>

	<!-- The ticket is the working, the three rows above are the claim. See the
	     note in FoldedDetail.astro for why only one of those two folds. -->
	<FoldedDetail summary="The access check, as one ticket" hint="Role-aware actions, fine-grained screens, who may invite">
		<figure class="access-ticket">
			<p class="font-mono text-eyebrow font-semibold tracking-wide text-amber-deep">ACCESS CHECK · ONE KITCHEN</p>
			<dl class="mt-5 border-t border-ticket-rule">
				<div><dt>Role-aware actions</dt><dd>Yes</dd></div>
				<div><dt>Fine-grained screens</dt><dd>No</dd></div>
				<div><dt>New invitations</dt><dd>Staff</dd></div>
			</dl>
			<figcaption>A role is a boundary, not a badge.</figcaption>
		</figure>
	</FoldedDetail>
</article>

<style>
	.access-ticket { margin-top: 1.5rem; padding: clamp(1.25rem, 3vw, 2rem); border-top: 4px solid var(--color-green); background: var(--color-paper); box-shadow: var(--shadow-ticket); }
	.access-ticket dl div { display: flex; justify-content: space-between; gap: 2rem; padding-block: .9rem; border-bottom: 1px solid var(--color-ticket-rule); }
	.access-ticket dt { color: var(--color-ink-soft); }
	.access-ticket dd { font-weight: 750; }
	.access-ticket figcaption { margin-top: 2rem; font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2.2rem); font-weight: 600; line-height: 1.15; }
</style>
