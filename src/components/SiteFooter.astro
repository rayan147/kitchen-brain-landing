---
import { demoCta, signIn, site, siteMap } from '../lib/site';
import BrandLockup from './BrandLockup.astro';

// GROUPED, 2026-10-07 (owner, after a footer review): readers skim a footer,
// so the links sit under headings instead of one run. The groups are siteMap
// in src/lib/site.ts, which the phone Menu reads too, so the two cannot
// disagree; "Talk to us" adds the two actions (demo, Sign in) here.
// Design review 2026-10-07: headings take the eyebrow token (they were an
// untokened font-mono that fell back to the system Courier), Contact moved in
// with the email and phone, and the frame matches the header's (96rem, same
// gutter) so the top and bottom marks line up at every width.
// Considered Composite; not used because this is one level of headings over
// links, rendered by one loop.

// Static site: computing the year at build time would freeze at the last
// deploy anyway, so own it explicitly. Bump with the copyright.
const year = 2026;
const linkClass = 'inline-flex min-h-11 min-w-11 items-center text-sm [overflow-wrap:anywhere] text-ink-soft transition-colors duration-150 hover:text-ink';
---

<footer class="border-t border-hairline">
	<div class="mx-auto w-full max-w-[96rem] pl-(--gutter-left) pr-(--gutter-right) py-12">
		<div class="grid grid-cols-2 gap-x-6 gap-y-8 lg:grid-cols-[1.2fr_repeat(4,minmax(0,1fr))] lg:gap-x-8">
			<div class="col-span-2 lg:col-span-1">
				<BrandLockup />
				<p class="mt-3 max-w-[22ch] text-sm text-ink-soft">Catering software, built by a chef.</p>
			</div>
			<nav aria-label="Footer" class="contents">
				{siteMap.map((group) => (
					<div class="min-w-0">
						<h2 class="eyebrow [overflow-wrap:anywhere]">{group.heading}</h2>
						<ul role="list" class="mt-2">
							{group.links.map((item) => (
								<li><a href={item.href} target={item.target} rel={item.rel} aria-label={item.ariaLabel} class={linkClass}>{item.label}</a></li>
							))}
							{group.heading === 'Talk to us' && (
								<>
									<li><a href={demoCta.href} target={demoCta.target} rel={demoCta.rel} aria-label={demoCta.ariaLabel} class={linkClass}>{demoCta.label}</a></li>
									<li><a href={signIn.href} target={signIn.target} aria-label={signIn.ariaLabel} class={linkClass}>{signIn.label}</a></li>
								</>
							)}
						</ul>
					</div>
				))}
			</nav>
		</div>
		<p class="mt-10 border-t border-hairline pt-6 text-sm text-ink-soft">© {year} {site.name}</p>
	</div>
</footer>
