---
import { demoCta, featuresMenu, nav, signIn, site } from '../lib/site';

// The header renders /features as a disclosure over its five areas. A footer
// is a list rather than a menu, so it carries the plain hub link, in the slot
// it held before the split.
const footerLinks = nav.flatMap((item) =>
	item.href === '/pricing' ? [item, { label: 'Every feature', href: featuresMenu.href }] : [item]
);
import BrandLockup from './BrandLockup.astro';

// Static site: computing the year at build time would freeze at the last
// deploy anyway, so own it explicitly. Bump with the copyright.
const year = 2026;
---

<footer class="border-t border-hairline">
	<div
		class="container-page flex flex-col gap-6 py-10 sm:flex-row sm:items-baseline sm:justify-between"
	>
		<div>
			<BrandLockup />
			<a
				href={`mailto:${site.email}`}
				class="mt-1 flex min-h-11 items-center text-sm text-ink-soft underline decoration-hairline underline-offset-4 transition-colors duration-150 hover:text-ink"
			>
				{site.email}
			</a>
			<a
				href={site.phoneHref}
				class="flex min-h-11 items-center text-sm text-ink-soft underline decoration-hairline underline-offset-4 transition-colors duration-150 hover:text-ink"
			>
				{site.phone}
			</a>
		</div>
		<nav aria-label="Footer">
			<ul role="list" class="flex flex-wrap gap-x-6 gap-y-2">
				{
					footerLinks.map((item) => (
						<li>
							<a
								href={item.href}
								class="inline-flex min-h-11 items-center text-sm text-ink-soft transition-colors duration-150 hover:text-ink"
							>
								{item.label}
							</a>
						</li>
					))
				}
				<li>
					<a
						href={signIn.href}
						target={signIn.target}
						aria-label={signIn.ariaLabel}
						class="inline-flex min-h-11 items-center text-sm text-ink-soft transition-colors duration-150 hover:text-ink"
					>
						{signIn.label}
					</a>
				</li>
				<li>
					<a
						href={demoCta.href}
						target={demoCta.target}
						rel={demoCta.rel}
						aria-label={demoCta.ariaLabel}
						class="inline-flex min-h-11 items-center text-sm text-ink-soft transition-colors duration-150 hover:text-ink"
					>
						Book a demo
					</a>
				</li>
			</ul>
		</nav>
		<p class="text-sm text-ink-soft">© {year} {site.name}</p>
	</div>
</footer>
