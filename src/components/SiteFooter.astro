---
import { demoCta, signIn, site, siteMap } from '../lib/site';
import BrandLockup from './BrandLockup.astro';

// Considered Composite; not used because the footer has one fixed level of
// headings and links. The ordered siteMap array is also read by the phone Menu.
// The four groups are bounded, so one plain render pass is sufficient.
const year = 2026;
---
<!-- story: docs/stories/site-footer-2026-10.story.md -->
<footer class="site-footer">
	<div class="site-footer__inner">
		<div class="site-footer__main">
			<div class="site-footer__brand">
				<BrandLockup />
				<p>Catering software, built by a chef.</p>
				<p>Price the job, then carry the same menu and guest count into shopping, prep, and closeout.</p>
				<a class="site-footer__tour" href="/tour/main">Take the product tour <span aria-hidden="true">→</span></a>
			</div>

			<nav aria-label="Footer" class="site-footer__nav">
				{siteMap.map((group) => (
					<div class="site-footer__group">
						<h2 class="eyebrow">{group.heading}</h2>
						<ul role="list">
							{group.links.map((item) => (
								<>
									{group.heading === 'Talk to us' && item.label === 'Contact' && (
										<li><a href={demoCta.href} aria-label={demoCta.ariaLabel} class="site-footer__contact-link">
											<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4M17 3v4M3 10h18"/></svg>
											<span>{demoCta.label}</span>
										</a></li>
									)}
									<li><a href={item.href} target={item.target} rel={item.rel} aria-label={item.ariaLabel} class:list={['site-footer__link', group.heading === 'Talk to us' && 'site-footer__contact-link']}>
										{group.heading === 'Talk to us' && (
											<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
												{item.href.startsWith('mailto:') && <><rect x="2.5" y="4.5" width="19" height="15" rx="2"/><path d="m3.5 6 8.5 7 8.5-7"/></>}
												{item.href.startsWith('tel:') && <path d="M7.2 3.5 10 6.3l-1.7 2.4a14 14 0 0 0 7 7l2.4-1.7 2.8 2.8-1.5 2.8c-.4.7-1.2 1-2 .8A19 19 0 0 1 3.6 6c-.2-.8.1-1.6.8-2l2.8-1.5Z"/>}
												{!item.href.startsWith('mailto:') && !item.href.startsWith('tel:') && <><path d="M4 5.5h16v11H8l-4 3v-14Z"/><path d="M8 10h8M8 13h5"/></>}
											</svg>
										)}
										<span>{item.label}</span>
									</a></li>
								</>
							))}
							{group.heading === 'Talk to us' && (
								<li><a href={signIn.href} target={signIn.target} aria-label={signIn.ariaLabel} class="site-footer__contact-link">
									<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="7" r="3.5"/><path d="M4.5 20v-2a7.5 7.5 0 0 1 15 0v2h-15Z"/></svg>
									<span>{signIn.label}</span>
								</a></li>
							)}
						</ul>
					</div>
				))}
			</nav>
		</div>
		<div class="site-footer__bottom"><p>© {year} {site.name}. All rights reserved.</p></div>
	</div>
</footer>

<style>
	.site-footer { background: var(--color-cream); border-top: 1px solid var(--color-ticket-rule); }
	.site-footer__inner { width: min(100%, 92rem); margin-inline: auto; padding: clamp(3rem, 5vw, 5rem) var(--gutter-right) 2.5rem var(--gutter-left); }
	.site-footer__main { display: grid; gap: 3rem 4rem; }
	.site-footer__brand { max-width: 19rem; }
	.site-footer__brand :global(p:first-child) { font-size: var(--text-h3); }
	.site-footer__brand > p { margin-top: 1rem; color: var(--color-ink-soft); font-size: var(--text-body); line-height: 1.5; }
	.site-footer__brand > p + p { margin-top: 1.5rem; }
	.site-footer__tour { display: inline-flex; align-items: center; min-height: 2.75rem; gap: .35rem; margin-top: 1rem; color: var(--color-green-deep); font-size: var(--text-body); font-weight: 700; text-decoration: underline; text-underline-offset: 5px; }
	.site-footer__nav { display: grid; grid-template-columns: 1fr; gap: 2rem 2.5rem; }
	.site-footer__group { min-width: 0; }
	.site-footer__group h2 { margin: 0 0 .75rem; }
	.site-footer__group ul { margin: 0; padding: 0; }
	.site-footer__group li { list-style: none; }
	.site-footer__link, .site-footer__contact-link { display: inline-flex; align-items: center; min-height: 2.75rem; max-width: 100%; color: var(--color-ink-soft); font-size: var(--text-body); line-height: 1.4; text-decoration: none; overflow-wrap: anywhere; }
	.site-footer__link:hover, .site-footer__contact-link:hover, .site-footer__tour:hover { color: var(--color-green-deep); text-decoration: underline; text-underline-offset: 4px; }
	.site-footer__contact-link { gap: .85rem; }
	.site-footer__contact-link svg { flex: none; width: 1.4rem; height: 1.4rem; }
	.site-footer__bottom { margin-top: clamp(2.5rem, 5vw, 4rem); border-top: 1px solid var(--color-ticket-rule); padding-top: 1.5rem; color: var(--color-ink-soft); font-size: var(--text-body-sm); }
	@media (min-width: 40rem) { .site-footer__nav { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (min-width: 64rem) { .site-footer__main { grid-template-columns: minmax(15rem, 1.5fr) minmax(0, 4fr); } .site-footer__nav { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem; } }
</style>
