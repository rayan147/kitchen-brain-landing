---
/**
 * /features/online-ordering
 * story: docs/stories/online-ordering.story.md
 * ledger: RC-59
 *
 * The ordering group's guide: the office-lunch film, the two ways a client
 * orders (your own link, or the form on your website), the settings walk and
 * what happens after a request arrives. Settings labels are quoted from
 * kitchen-brain local develop 7a7e407d9 (Settings > Integrations > Ordering
 * site, read 2026-10-08); the flow and its boundaries come from
 * src/lib/ordering.ts.
 *
 * THE SNIPPET is printed as its shape with placeholders. A capture of the
 * "Put on your website" tab from a local app shows localhost and a real site
 * id, and the page never prints a working id.
 *
 * Considered Template Method (a shared FeatureGuide shell); not used because
 * the feature family shares semantic roles, not an algorithm. Same refusal as
 * InvoiceEmailFeature.astro.
 */
import FeatureTrialTerms from '../FeatureTrialTerms.astro';
import { cta, demoCta } from '../../lib/site';
import { ordering, orderingAvailability as availability } from '../../lib/ordering';
import { bookingRuleOutcomes, orderingFilm, orderingLimits, orderingTabs, goLiveNeeds, paymentChoices } from '../../lib/ordering-guide';

// The shape the app's "Snippet for your web person" box prints
// (website/+page.svelte), with the two values the app fills in left as words.
// Two lines, as the app prints them; the ticket wraps them, never the data.
const snippet = [
	'<div id="order-here"></div>',
	'<script src="https://[your ordering address]/ordering.js" data-site-id="[your site id]" data-target="#order-here" data-ordering-origin="https://[your ordering address]"></script>'
].join('\n');
---

<!-- story: docs/stories/online-ordering.story.md -->
<article id="features-ordering" class="ordering-page">
	<section class="hero" aria-labelledby="ordering-heading">
		<div class="container-page hero-grid">
			<div class="hero-copy anim-enter">
				<nav aria-label="Breadcrumb" class="feature-breadcrumb">
					<a href="/features">Every feature</a>
					<span aria-hidden="true">/</span>
					<span>Online ordering</span>
				</nav>
				<h1 id="ordering-heading" class="feature-display">The client fills in the order. You approve it.</h1>
				<p class="hero-lede">
					Put your menus on an ordering page of your own, or on the website you already have.
					The request comes in priced and you approve it. If your booking rules ask for money up
					front, the client pays by card from a link.
				</p>
				<p class="status-line" data-ordering-status={availability.verdict}>
					<span class="status-word">{availability.word}</span> Settings &gt; Integrations &gt; Ordering site.
				</p>
				<div class="hero-actions">
					<a href={cta.href} target={cta.target} rel={cta.rel} aria-label={cta.ariaLabel} class="btn-primary">{cta.label}</a>
					<a href={demoCta.href} target={demoCta.target} rel={demoCta.rel} aria-label={demoCta.ariaLabel} class="btn-quiet">{demoCta.label}</a>
				</div>
				<FeatureTrialTerms />
			</div>

			<figure class="film anim-enter" style="--enter-delay: 120ms" data-ordering-film>
				<video controls playsinline preload="none" poster={orderingFilm.poster} width={orderingFilm.width} height={orderingFilm.height} aria-label={orderingFilm.label}>
					<source src={orderingFilm.mp4} type="video/mp4" />
					<track kind="captions" src={orderingFilm.captions} srclang="en" label="English" />
					<a href={orderingFilm.mp4}>Download the film (MP4)</a>
				</video>
				<figcaption>{orderingFilm.caption}</figcaption>
				<details class="transcript">
					<summary>Read what the film shows</summary>
					<ol role="list">
						{orderingFilm.lines.map((line) => <li data-ordering-film-line>{line}</li>)}
					</ol>
				</details>
			</figure>
		</div>
	</section>

	<section id="two-ways" class="product-section" aria-labelledby="two-ways-heading">
		<div class="container-page">
			<div class="section-head" data-reveal>
				<h2 id="two-ways-heading">Two ways in. Keep the website you have.</h2>
				<p>Both show the same menus, prices and dates, and send the request to the same place in Orders. The client never needs a login.</p>
			</div>
			<div class="ways">
				<div data-reveal>
					<p class="ticket-label">Your link</p>
					<h3>{ordering.modes[0].lead}</h3>
					<p>Copy it into an email or a text, or print the QR code on a flyer or the menu you leave with a lunch drop.</p>
				</div>
				<div data-reveal style="--reveal-delay: 60ms" data-ordering-widget>
					<p class="ticket-label">On your website</p>
					<h3>{ordering.modes[1].lead}</h3>
					<p>The order form sits right on your own page, under your own heading. One small script loads it in a sealed frame, so it can’t touch the rest of your site.</p>
				</div>
			</div>
			<p class="handoff">Next: Putting it on your website.</p>
		</div>
	</section>

	<section id="website" class="product-section soft" aria-labelledby="website-heading">
		<div class="container-page split">
			<div>
				<div class="section-head" data-reveal>
					<h2 id="website-heading">Put the order form on your website.</h2>
					<p>It’s on the last tab, <strong>Put on your website</strong>. Your link and the snippet show up there once Setup has your name. Then there are three steps, and the hard one goes to whoever looks after your site.</p>
				</div>
				<ol role="list" class="steps">
					<li data-reveal>
						<p class="ticket-label">01</p>
						<h3>Add your website</h3>
						<p>Type your site’s address under <strong>Websites that will show it</strong> and press <strong>Add website</strong>. The form only shows on sites in that list.</p>
					</li>
					<li data-reveal style="--reveal-delay: 60ms">
						<p class="ticket-label">02</p>
						<h3>Send the snippet</h3>
						<p>Press <strong>Copy snippet</strong>, or <strong>Email it to them</strong>: your mail app opens with the snippet in it, and you add their address.</p>
					</li>
					<li data-reveal style="--reveal-delay: 120ms">
						<p class="ticket-label">03</p>
						<h3>Check it showed up</h3>
						<p>Under the snippet the app says where it has been seen and when. If it turns up on a site you didn’t list, it says so, with a button to add that site.</p>
					</li>
				</ol>
				<p class="section-note" data-reveal>Until you press Go live, the form on your site says “Not taking online orders right now.” That’s expected, not broken.</p>
			</div>
			<figure class="ticket" data-reveal data-ordering-snippet>
				<figcaption>Snippet for your web person · the app writes it</figcaption>
				<pre><code>{snippet}</code></pre>
				<p class="ticket-foot">A sample with blanks: use <strong>Copy snippet</strong> in the app for the real one. The script is under 12 KB, adds its own small stylesheet and the form in a sealed frame, and touches nothing else on your page.</p>
				<p class="snap" data-ordering-snap>Your web person pastes two lines. You never touch the code.</p>
			</figure>
		</div>
		<div class="container-page">
			<p class="handoff">Next: The settings behind it.</p>
		</div>
	</section>

	<section id="settings" class="product-section" aria-labelledby="settings-heading">
		<div class="container-page">
			<div class="section-head" data-reveal>
				<h2 id="settings-heading">Four tabs, then Go live.</h2>
				<p>Settings &gt; Integrations, then <strong>Manage storefront</strong> on the Ordering site card. It saves as you type. There’s no Save button.</p>
			</div>
			<ol role="list" class="tabs">
				{orderingTabs.map((tab, index) => (
					<li data-reveal style={`--reveal-delay: ${index * 60}ms`} data-ordering-tab={tab.name}>
						<p class="ticket-label">Tab {index + 1}</p>
						<h3>{tab.name}</h3>
						<p>{tab.what}</p>
						<ul role="list">
							{tab.settings.map((setting) => <li>{setting}</li>)}
						</ul>
					</li>
				))}
			</ol>

			<div class="captures">
				<figure data-reveal>
					<div class="shot-pan" tabindex="0" role="region" aria-label="Pickup and delivery capture, scrolls sideways on a phone">
					<img src="/proof/ordering-setup-delivery.png" style="--shot-w: 790px" width="790" height="391" loading="lazy" decoding="async" alt="The Setup tab’s Pickup and delivery card: Pickup switched on with Place, Address and an optional Note for customers; Delivery switched on with a $25.00 delivery fee, added only when the customer picks delivery, and a box to charge sales tax on the delivery fee." />
					</div>
					<a class="full-size" href="/proof/ordering-setup-delivery.png" target="_blank" rel="noopener noreferrer">Open full-size (new tab)</a>
					<figcaption>Setup: how the food gets to them. Pickup needs a place and an address; delivery can carry a fee.</figcaption>
				</figure>
				<figure data-reveal style="--reveal-delay: 60ms">
					<div class="shot-pan" tabindex="0" role="region" aria-label="Payments and tax capture, scrolls sideways on a phone">
					<img src="/proof/ordering-setup-payments.png" style="--shot-w: 790px" width="790" height="795" loading="lazy" decoding="async" alt="The Setup tab’s Payments and tax card: three choices, Card, through CostCook (Stripe connected), A partner collects it, and You collect it (invoice, check, cash or ACH after you confirm); the deposit from booking rules; an estimated tax percentage; and an example estimate for 50 guests at $32.00 plus $25.00 delivery, $1,625.00 before tax." />
					</div>
					<a class="full-size" href="/proof/ordering-setup-payments.png" target="_blank" rel="noopener noreferrer">Open full-size (new tab)</a>
					<figcaption>Setup: how they pay. Pick one of three; only card needs Stripe.</figcaption>
				</figure>
			</div>

			<div class="pay-and-live">
				<div data-reveal>
					<h3>How the client pays</h3>
					<dl class="choices">
						{paymentChoices.map((choice) => (
							<div data-ordering-payment={choice.label}>
								<dt>{choice.label}</dt>
								<dd>{choice.detail}</dd>
							</div>
						))}
					</dl>
				</div>
				<div class="golive" data-reveal style="--reveal-delay: 60ms" data-ordering-golive>
					<p class="ticket-label">Go live stays grey until</p>
					<ul role="list">
						{goLiveNeeds.map((need) => <li data-ordering-golive-need>{need}</li>)}
					</ul>
					<p class="golive-foot">Missing descriptions and an empty website list show up as suggestions. They don’t stop you. <strong>Take offline</strong> shows clients “Not taking online orders right now.”</p>
				</div>
			</div>
			<p class="handoff">Next: When a request comes in.</p>
		</div>
	</section>

	<section id="after" class="product-section soft" aria-labelledby="after-heading">
		<div class="container-page split">
			<div data-reveal>
				<h2 id="after-heading">What they pay up front is your call.</h2>
				<p>The request lands in Orders waiting on you. Approve it or decline it. Under Settings &gt; Booking, <strong>Approving requests</strong> can let clear ones through on their own; it’s off until you turn it on.</p>
				<p>What happens when you approve is set by your <strong>Booking rules</strong>, on the same page:</p>
				<dl class="choices">
					{bookingRuleOutcomes.map((rule) => (
						<div data-ordering-rule={rule.label}>
							<dt>{rule.label}</dt>
							<dd>{rule.detail}</dd>
						</div>
					))}
				</dl>
				<p>Collecting it yourself? Pick <strong>You collect it</strong> in Setup. The client gets an approval email instead of a pay link, and you record the payment on the order.</p>
				<p>A request for something bespoke, like staff on site or rentals, takes no money. It comes to you to price, and you can move it to an inquiry.</p>
			</div>
			<ul role="list" class="limit-list" aria-label="Where it stops">
				{orderingLimits.map((line) => <li data-ordering-limit>{line}</li>)}
			</ul>
		</div>
	</section>

	<section class="closing" aria-labelledby="closing-heading">
		<div class="container-page closing-grid" data-reveal>
			<div>
				<h2 id="closing-heading">Put one menu on it and send yourself an order.</h2>
				<p>Turn on your lunch menu, open your link on your phone, and order lunch for 20. You’ll see what your clients see, and what lands in Orders. Decline it after, so it doesn’t sit there like a real job.</p>
			</div>
			<div class="closing-actions">
				<a href={cta.href} target={cta.target} rel={cta.rel} aria-label={cta.ariaLabel} class="btn-primary">{cta.label}</a>
				<a href={demoCta.href} target={demoCta.target} rel={demoCta.rel} aria-label={demoCta.ariaLabel} class="btn-quiet">{demoCta.label}</a>
			</div>
		</div>
		<nav class="container-page onward feature-onward" aria-label="Related feature guides">
			<a href="/features/events-and-proposals">Events &amp; proposals</a>
			<a href="/features/order-shop-prep-pack">Orders, shop, prep &amp; pack</a>
			<a href="/features">Every CostCook feature</a>
		</nav>
	</section>
</article>

<style>
	.ordering-page { background: var(--color-cream); }
	.hero-grid, .split, .closing-grid { display: grid; gap: clamp(2.5rem, 6vw, 5rem); align-items: center; }
	.hero-grid > *, .split > *, .closing-grid > * { min-width: 0; }
	.hero-grid { padding-block: clamp(3rem, 6vw, 5rem) var(--spacing-section-tight); }
	.closing-grid { padding-block: var(--spacing-section-tight); }
	.product-section { border-top: 1px solid var(--color-hairline); padding-block: var(--spacing-section); }
	.product-section.soft { background: var(--color-paper); }
	.feature-breadcrumb { margin-bottom: 1.6rem; }
	.hero-lede { margin-top: 1.5rem; max-width: 56ch; font-size: var(--text-lede); line-height: var(--text-lede--line-height); color: var(--color-ink-soft); }
	.status-line { margin-top: 1.25rem; max-width: 56ch; padding: .75rem 1rem; border: 1px dashed var(--color-ticket-rule); background: var(--color-softamber); font-size: var(--text-body-sm); }
	.status-word { font-family: var(--font-mono); font-size: var(--text-micro); font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--color-amber-deep); margin-right: .4rem; }
	.hero-actions, .closing-actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2rem; }
	.hero-actions .btn-primary, .closing-actions .btn-primary { min-height: 48px; align-items: center; justify-content: center; padding-inline: 1.7rem; text-align: center; }
	/* Scoped per feature page across this family, the same four declarations
	   as InvoiceEmailFeature.astro (hoisting is its own pass). */
	h2 { font-family: var(--font-display); font-size: var(--text-h2); font-weight: 600; line-height: 1.12; text-wrap: balance; }
	h3 { font-weight: 650; font-size: var(--text-h3); line-height: 1.25; text-wrap: balance; }
	.section-head { max-width: 62ch; }
	.section-note { margin-top: 1.5rem; max-width: 60ch; color: var(--color-ink-soft); }
	.section-head p, .split > div > p { margin-top: 1.25rem; max-width: 60ch; color: var(--color-ink-soft); }
	.handoff { padding-top: 2rem; font-family: var(--font-mono); font-size: var(--text-micro); font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--color-amber-deep); }
	.ticket-label { font-family: var(--font-mono); font-size: var(--text-eyebrow); font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--color-amber-deep); }

	/* The film: a plain player, no autoplay, the poster until pressed. */
	.film video { display: block; width: 100%; height: auto; border: 1px solid var(--color-hairline-strong); border-radius: .5rem; background: var(--color-paper); }
	.film figcaption { margin-top: .75rem; font-size: var(--text-body-sm); color: var(--color-ink-soft); }
	.transcript { margin-top: .5rem; font-size: var(--text-body-sm); color: var(--color-ink-soft); }
	.transcript summary { display: inline-flex; min-height: 44px; align-items: center; cursor: pointer; font-weight: 600; color: var(--color-green-deep); text-decoration: underline; text-underline-offset: 4px; }
	.transcript ol { margin-top: .5rem; padding-left: 1.2rem; list-style: decimal; }
	.transcript li + li { margin-top: .3rem; }

	.ways { display: grid; gap: 1.5rem; margin-top: 2.5rem; grid-template-columns: minmax(0, 1fr); }
	.ways > div, .steps > li, .tabs > li { overflow-wrap: anywhere; padding: 1.25rem clamp(1rem, 4vw, 1.5rem); border-top: 2px solid var(--color-hairline-strong); background: var(--color-paper); }
	.soft .steps > li { background: var(--color-cream); }
	.ways h3, .steps h3, .tabs h3 { margin-top: .4rem; }
	.ways p:not(.ticket-label), .steps p:not(.ticket-label), .tabs p:not(.ticket-label) { margin-top: .75rem; color: var(--color-ink-soft); }
	.steps { display: grid; gap: 1rem; margin-top: 2rem; }

	/* The snippet: the app's own box on ticket paper, tilted like every ticket
	   on the site, and flat under reduced motion. */
	.ticket { border-block: 1px solid var(--color-ticket-rule); background: var(--color-cream); box-shadow: var(--shadow-ticket); transform: rotate(-1.5deg); }
	@media (prefers-reduced-motion: reduce) {
		.ticket { transform: none; }
	}
	.ticket figcaption { padding: .75rem 1rem; border-bottom: 1px dashed var(--color-ticket-rule); color: var(--color-amber-deep); font-size: var(--text-micro); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
	.ticket pre { margin: 0; padding: 1.25rem 1rem; font-family: var(--font-mono); font-size: var(--text-body-sm); line-height: 1.6; white-space: pre-wrap; overflow-wrap: anywhere; color: var(--color-ink); }
	.ticket-foot { padding: .75rem 1rem; border-top: 1px dashed var(--color-ticket-rule); font-size: var(--text-body-sm); color: var(--color-ink-soft); }
	.ticket .snap { padding: 1rem; border-top: 1px dashed var(--color-ticket-rule); background: var(--color-softamber); font-family: var(--font-display); font-size: var(--text-h3); font-weight: 600; line-height: 1.25; color: var(--color-ink); }

	.tabs { display: grid; gap: 1.5rem; margin-top: 2.5rem; grid-template-columns: minmax(0, 1fr); }
	.tabs ul { margin-top: .75rem; padding-left: 1.1rem; list-style: disc; font-size: var(--text-body-sm); color: var(--color-ink-soft); }
	.tabs ul li + li { margin-top: .3rem; }

	/* The cards are 790 CSS px (2x PNGs). Side by side they shrank to about
	   70%, and the owner found them hard to read (2026-10-08), so each card gets
	   its own row at no more than its real size. Under 48rem the image keeps a
	   readable floor and scrolls inside its own frame (.shot-pan, global.css);
	   the page itself never scrolls sideways. */
	.captures { display: grid; gap: 3rem; margin-top: 3rem; grid-template-columns: minmax(0, 1fr); max-width: 790px; }
	.captures figure { min-width: 0; }
	.captures .shot-pan { border-radius: .5rem; }
	.captures img { display: block; width: 100%; height: auto; border: 1px solid var(--color-hairline-strong); border-radius: .5rem; background: var(--color-paper); }
	.captures .full-size { display: inline-flex; min-height: 44px; align-items: center; font-size: var(--text-body-sm); font-weight: 600; color: var(--color-green-deep); text-decoration: underline; }
	.captures figcaption { font-size: var(--text-body-sm); color: var(--color-ink-soft); }

	.pay-and-live { display: grid; gap: 2rem; margin-top: 3rem; grid-template-columns: minmax(0, 1fr); align-items: start; }
	.choices { margin-top: 1rem; }
	.choices > div { padding-block: .9rem; border-top: 1px dashed var(--color-ticket-rule); }
	.choices dt { font-weight: 700; }
	.choices dd { margin-top: .25rem; font-size: var(--text-body-sm); color: var(--color-ink-soft); }
	.golive { padding: 1.25rem 1.5rem; border-block: 1px solid var(--color-ticket-rule); background: var(--color-softamber); }
	.golive ul { margin-top: .75rem; padding-left: 1.1rem; list-style: disc; }
	.golive ul li + li { margin-top: .4rem; }
	.golive-foot { margin-top: 1rem; font-size: var(--text-body-sm); color: var(--color-ink-soft); }

	.limit-list { display: grid; gap: 1.25rem; }
	.limit-list > li { padding-top: .9rem; border-top: 1px solid var(--color-hairline-strong); font-size: var(--text-body-sm); line-height: 1.55; color: var(--color-ink-soft); }

	.closing { border-top: 1px solid var(--color-hairline); background: var(--color-paper); }
	.closing-grid p { margin-top: 1rem; max-width: 56ch; color: var(--color-ink-soft); }
	.onward { display: flex; flex-wrap: wrap; gap: 1.5rem; padding-bottom: var(--spacing-section-tight); }

	@media (min-width: 48rem) {
		.captures img { min-width: 0; }
	}
	@media (min-width: 40rem) {
		.ways { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.tabs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
	@media (min-width: 60rem) {
		.hero-grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
		.split { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: start; }
		.closing-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
		.tabs { grid-template-columns: repeat(4, minmax(0, 1fr)); }
		.pay-and-live { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
	}
</style>
