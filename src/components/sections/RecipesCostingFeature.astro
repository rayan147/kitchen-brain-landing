---
import { featureGroups } from '../../lib/features';
import { cta, demoCta } from '../../lib/site';

const capabilityIds = ['recipes', 'math', 'ingredients', 'menus'] as const;
const capabilities = capabilityIds.map((id) => {
	const group = featureGroups.find((candidate) => candidate.id === id);
	if (!group) throw new Error(`Missing public feature group: ${id}`);
	return group;
});
const capabilityCount = capabilities.reduce((total, group) => total + group.items.length, 0);

const costPath = [
	{ name: 'Case', note: 'What the supplier charged for the whole pack.' },
	{ name: 'Unit', note: 'The price per kilo, litre, or each.' },
	{ name: 'Edible', note: 'What remains after trim and cooking loss.' },
	{ name: 'Plate', note: 'That ingredient’s share of one dish.' },
	{ name: 'Event', note: 'The food cost the quote is judged against.' }
];

const dishes = ['Roast chicken', 'Grain bowl', 'Lunch box', 'Canapé tray', 'Family meal'];

// Considered Strategy; not used because the FAQ varies as static content data,
// not as interchangeable behavior selected at runtime.
const faqItems = [
	{
		question: 'What is recipe management software?',
		answer:
			'Recipe management software keeps ingredients, method, yield, sub-recipes, scaling, and the kitchen-ready version together. In CostCook, that means the recipe the kitchen reads is also the record used for costing.'
	},
	{
		question: 'How does recipe costing work in CostCook?',
		answer:
			'CostCook follows the purchase price through pack size, usable yield, recipe quantity, portion, and guest count. You can open the arithmetic behind a plate cost or food-cost percentage instead of accepting an unexplained total.'
	},
	{
		question: 'Can I scale a recipe without changing the original?',
		answer:
			'Yes. Scale by a target amount or by what you have on hand, then use the recalculated quantities as a preview. The saved recipe stays unchanged.'
	},
	{
		question: 'What happens when a yield or ingredient price is missing?',
		answer:
			'Trim loss and cooking loss remain separate facts. If a line cannot be costed, CostCook names the missing price and labels the total as partial instead of quietly treating the ingredient as free.'
	},
	{
		question: 'Can I reuse sub-recipes and hand recipes to the kitchen?',
		answer:
			'Yes. A sauce or other sub-recipe can feed several dishes without copying its costing facts into each one. Recipes can also be exported to CSV or printed as clean kitchen sheets stamped with the print time.'
	},
	{
		question: 'Will a later price change rewrite a confirmed quote?',
		answer:
			'No. Confirming an order freezes its plan, math, and money together. CostCook can compare that frozen quote with current prices later without silently rewriting what you originally quoted.'
	}
] as const;
---

<!-- story: docs/stories/recipes-and-costing-redesign-prompt.story.md -->
<article class="recipes-costing">
	<section class="hero" aria-labelledby="recipes-costing-heading">
		<div class="container-page hero-grid">
			<div class="hero-copy anim-enter">
				<nav aria-label="Breadcrumb" class="breadcrumb">
					<a href="/features">Every feature</a>
					<span aria-hidden="true">/</span>
					<span>Recipes and costing</span>
				</nav>
				<h1 id="recipes-costing-heading">The recipe has to work on the line and in the quote.</h1>
				<p class="hero-lede">
					When the method lives in one place and the cost in another, one of them goes stale.
					Keep the working recipe and the number you say out loud connected.
				</p>
				<div class="hero-actions">
					<a href={cta.href} target={cta.target} rel={cta.rel} aria-label={cta.ariaLabel} class="btn-primary">
						{cta.label}
					</a>
					<a
						href={demoCta.href}
						target={demoCta.target}
						rel={demoCta.rel}
						aria-label={demoCta.ariaLabel}
						class="btn-outline"
					>
						Book 15 minutes
					</a>
				</div>
			</div>

			<figure class="record-flow anim-enter" style="--enter-delay: 120ms">
				<p class="figure-note">Illustrative recipe flow</p>
				<div class="record-pair">
					<div class="record recipe-record">
						<div class="record-head">
							<span>Working recipe</span>
							<span>24 portions</span>
						</div>
						<h2>Herb roast chicken</h2>
						<dl class="record-facts">
							<div><dt>Yield</dt><dd>6.4 kg</dd></div>
							<div><dt>Portion</dt><dd>265 g</dd></div>
						</dl>
						<div class="record-rule"></div>
						<p class="record-label">Ingredients</p>
						<ul role="list" class="ingredient-lines">
							<li><span>Chicken thigh</span><strong>7.8 kg</strong></li>
							<li><span>Herb marinade</span><strong>1.1 kg</strong></li>
							<li><span>Lemon</span><strong>12 each</strong></li>
							<li><span>Pan jus</span><strong>1.4 L</strong></li>
						</ul>
						<p class="method-line">Roast, rest, portion, and hold for service.</p>
					</div>

					<div class="flow-join" aria-hidden="true"><span></span></div>

					<div class="record costing-record">
						<div class="record-head">
							<span>Recipe costing</span>
							<span>Same recipe</span>
						</div>
						<h2>Herb roast chicken</h2>
						<dl class="cost-facts">
							<div><dt>Recipe cost</dt><dd>$164.16</dd></div>
							<div><dt>Per portion</dt><dd>$6.84</dd></div>
							<div><dt>Food cost</dt><dd>30.4%</dd></div>
						</dl>
						<div class="record-rule"></div>
						<p class="record-label">The path stays visible</p>
						<ul role="list" class="cost-lines">
							<li><span>Purchased amount</span><strong>8.6 kg</strong></li>
							<li><span>Usable yield</span><strong>91%</strong></li>
							<li><span>Cost contribution</span><strong>$109.42</strong></li>
						</ul>
					</div>
				</div>
				<figcaption>Illustrative values. Product evidence below uses the real CostCook interface.</figcaption>
			</figure>
		</div>
	</section>

	<section class="split-problem" aria-labelledby="split-heading">
		<div class="container-page problem-grid">
			<div data-reveal>
				<h2 id="split-heading">Three places. One answer due today.</h2>
				<p>
					The method is in a binder. The current case price is in a purchase record. The quote is
					waiting in a spreadsheet. The split feels harmless until the kitchen and the customer
					need their answers on the same afternoon.
				</p>
			</div>
			<figure class="handoff" data-reveal>
				<div class="handoff-step">
					<span>Recipe</span>
					<strong>What to make</strong>
				</div>
				<div class="handoff-gap" aria-label="A manual handoff separates the recipe from its current price">
					<svg width="42" height="18" viewBox="0 0 42 18" aria-hidden="true">
						<path d="M1 9h33M28 2l7 7-7 7" />
					</svg>
					<small>rekey</small>
				</div>
				<div class="handoff-step">
					<span>Price</span>
					<strong>What it costs</strong>
				</div>
				<div class="handoff-gap" aria-label="A second manual handoff separates the cost from the quote">
					<svg width="42" height="18" viewBox="0 0 42 18" aria-hidden="true">
						<path d="M1 9h33M28 2l7 7-7 7" />
					</svg>
					<small>recheck</small>
				</div>
				<div class="handoff-step">
					<span>Quote</span>
					<strong>What you say</strong>
				</div>
				<figcaption>One working recipe should carry both the method and the math.</figcaption>
			</figure>
		</div>
	</section>

	<nav class="product-nav container-page" aria-label="On this page">
		<a href="#recipe-management">
			<span>Recipe management</span>
			<small>Build it once. Find it, scale it, and hand it to the kitchen.</small>
			<svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5" /></svg>
		</a>
		<a href="#recipe-costing">
			<span>Recipe costing</span>
			<small>Follow the price from the case to the plate and the quote.</small>
			<svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5" /></svg>
		</a>
	</nav>

	<section id="recipe-management" class="product-section management" aria-labelledby="management-heading">
		<div class="container-page">
			<div class="section-intro" data-reveal>
				<h2 id="management-heading">
					<span>Recipe management software</span>
					One working recipe, from first draft to prep sheet.
				</h2>
				<p>
					Build the dish while the details are in your hands. Keep ingredients, prep, yield,
					sub-recipes, and the version the kitchen should use in one record.
				</p>
			</div>

			<figure class="management-workspace" data-reveal>
				<div class="builder-panel">
					<div class="panel-bar">
						<div><span class="status-dot"></span> Working recipe</div>
						<span>Private draft</span>
					</div>
					<div class="builder-title">
						<div>
							<small>Recipe name</small>
							<strong>Lemon herb chicken</strong>
						</div>
						<div>
							<small>Batch yield</small>
							<strong>24 portions</strong>
						</div>
					</div>
					<div class="builder-table" role="table" aria-label="Illustrative recipe builder">
						<div class="builder-row builder-head" role="row">
							<span role="columnheader">Ingredient</span><span role="columnheader">Used</span><span role="columnheader">Prep</span>
						</div>
						<div class="builder-row" role="row"><span role="cell">Chicken thigh</span><strong role="cell">6.4 kg</strong><span role="cell">trimmed</span></div>
						<div class="builder-row active" role="row"><span role="cell">Herb marinade</span><strong role="cell">1.1 kg</strong><span role="cell">sub-recipe</span></div>
						<div class="builder-row" role="row"><span role="cell">Lemon</span><strong role="cell">12 each</strong><span role="cell">zested</span></div>
						<div class="builder-row add-row" role="row"><span role="cell">Add an ingredient</span><span role="cell"></span><span role="cell">Type, pick, next line</span></div>
					</div>
				</div>

				<div class="management-side">
					<div class="scale-preview">
						<div class="panel-bar"><div>Scaling preview</div><span>Saved recipe unchanged</span></div>
						<div class="scale-change">
							<div><small>Original</small><strong>24</strong><span>portions</span></div>
							<svg width="34" height="18" viewBox="0 0 34 18" aria-hidden="true"><path d="M1 9h26M22 3l6 6-6 6" /></svg>
							<div><small>Target</small><strong>80</strong><span>portions</span></div>
						</div>
						<p>Chicken thigh <strong>21.3 kg</strong></p>
						<p>Herb marinade <strong>3.7 kg</strong></p>
					</div>
					<div class="print-preview">
						<div class="print-stamp">Printed 8:42 AM</div>
						<strong>Lemon herb chicken</strong>
						<p>Roast until browned. Rest before portioning.</p>
						<div class="print-rule"></div>
						<small>24 portions · 265 g each</small>
					</div>
				</div>
				<figcaption>Illustrative walkthrough of shipped recipe-builder, scaling-preview, and print-sheet behavior.</figcaption>
			</figure>

			<div class="feature-scenes">
				<article>
					<h3>Build without leaving the recipe.</h3>
					<p>Type, pick, and move to the next line. Add a missing ingredient without losing the recipe already in your hands.</p>
				</article>
				<article>
					<h3>Scale without rewriting the original.</h3>
					<p>Preview a target amount or work from what you have on hand. The saved recipe stays exactly where you left it.</p>
				</article>
				<article>
					<h3>Hand off the current version.</h3>
					<p>Print a clean kitchen sheet with the time it was printed, so the paper on the prep table says when it left the system.</p>
				</article>
			</div>
		</div>
	</section>

	<section id="recipe-costing" class="product-section costing" aria-labelledby="costing-heading">
		<div class="container-page">
			<div class="section-intro costing-intro" data-reveal>
				<h2 id="costing-heading">
					<span>Recipe costing software</span>
					See the cost change before the quote does.
				</h2>
				<p>
					A case price only becomes useful after the pack, usable yield, sub-recipe, portion,
					and guest count have had their say. Keep every step open to inspection.
				</p>
			</div>

			<figure class="cost-path" data-reveal>
				<ol role="list">
					{costPath.map((step, index) => (
						<li>
							<div class="cost-index">{index + 1}</div>
							<strong>{step.name}</strong>
							<p>{step.note}</p>
						</li>
					))}
				</ol>
				<figcaption>One price, four steps. Every step stays available when a number needs checking.</figcaption>
			</figure>

			<div class="costing-evidence">
				<div class="evidence-copy" data-reveal>
					<h3>Open the arithmetic.</h3>
					<p>
						Purchased amount, yield, quantity to buy, prep state, and cost contribution sit on
						the same line. Open any calculation and follow the number back to its facts.
					</p>
					<ul role="list">
						<li>Missing prices are named instead of reading as zero.</li>
						<li>Every line reconciles to the recipe total.</li>
						<li>Trim and cooking loss remain separate facts.</li>
					</ul>
				</div>
				<figure class="screenshot-frame" data-reveal>
					<picture>
						<source media="(max-width: 639px)" srcset="/proof/yield-lines-mobile.png" />
						<img
							src="/proof/yield-lines.png"
							width="2272"
							height="1370"
							loading="lazy"
							decoding="async"
							alt="CostCook recipe lines showing ingredient amounts used, usable yield, quantity to buy, preparation state, and each line's cost."
						/>
					</picture>
					<figcaption>Each ingredient carries its own working, not just a share of the final total.</figcaption>
				</figure>
			</div>

			<div class="quote-evidence" data-reveal>
				<figure>
					<img
						src="/demo-poster.jpg"
						width="1600"
						height="1000"
						loading="lazy"
						decoding="async"
						alt="CostCook order screen showing food cost per guest, the price needed to meet the target, and quoted cost compared with current prices."
					/>
				</figure>
				<div>
					<h3>Price the menu before commitment.</h3>
					<p>
						See cost per guest against the price you plan to charge, then compare the frozen quote
						with today's prices after the order is confirmed.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section class="connected-proof" aria-labelledby="connected-heading">
		<div class="container-page proof-grid">
			<div data-reveal>
				<h2 id="connected-heading">A sauce is one recipe, even in five dishes.</h2>
				<p>
					Cost the batch once. Reuse it wherever it belongs. When its facts change, you can see
					which recipes and menus are touched before you decide what to do next.
				</p>
			</div>
			<figure class="subrecipe-map" data-reveal>
				<div class="source-recipe">
					<span>Sub-recipe</span>
					<strong>Herb marinade</strong>
					<small>One batch · one cost</small>
				</div>
				<div class="map-rule" aria-hidden="true"></div>
				<ul role="list">
					{dishes.map((dish) => <li>{dish}</li>)}
				</ul>
				<figcaption>One maintained component, reused without copying its costing facts into five places.</figcaption>
			</figure>
		</div>
	</section>

	<section class="capabilities" aria-labelledby="capabilities-heading">
		<div class="container-page">
			<div class="capability-heading" data-reveal>
				<div>
					<h2 id="capabilities-heading">The complete Recipes & Costing list.</h2>
					<p>Everything below is shipped today and remains available for the diligence read.</p>
				</div>
				<p class="count"><strong>{capabilityCount}</strong><span>shipped capabilities</span></p>
			</div>

			<div class="disclosures">
				{capabilities.map((group) => (
					<details id={`features-${group.id}`} data-reveal>
