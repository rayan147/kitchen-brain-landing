						<summary>
							<span>{item.question}</span>
							<svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
								<path d="M4 7l6 6 6-6" />
							</svg>
						</summary>
						<p>{item.answer}</p>
					</details>
