---
import { cta, site } from '../../lib/site';
---

<section id="book" class="relative container-page py-section">
	<!-- No reveal here: by the conversion section the page should be still
	     and certain — and the CTA below renders instantly regardless. -->
	<div class="max-w-2xl">
		<p class="eyebrow">Book a demo</p>
		<h2 class="mt-4 text-h2 font-semibold">Bring one real menu or order.</h2>
		<p class="mt-5 text-lede text-ink-soft">
			In fifteen minutes, we&rsquo;ll place it in CostCook&rsquo;s costing chain and show how
			ingredient prices become a food-cost reading, a shopping plan, and the kitchen&rsquo;s
			Prep and Pack work.
		</p>
		<p class="mt-5 text-sm text-ink-soft">
			CostCook is an early product. The demo is a practical fit check, not a generic sales deck.
		</p>
	</div>

	<a
		href={cta.href}
		class="btn-primary mt-9"
	>
		{cta.label}
	</a>
	<p class="mt-4 text-sm text-ink-soft">
		Prefer to talk or text? <a href={site.phoneHref} class="font-medium text-green-deep underline decoration-current underline-offset-4">{site.phone}</a>.
	</p>
</section>
