---
import { site } from '../../lib/site';
import {
	SUPPORT_MESSAGE_MAX_LENGTH,
	SUPPORT_MESSAGE_MIN_LENGTH,
	SUPPORT_NAME_MAX_LENGTH
} from '../../lib/support';

/**
 * The question box that used to be a mailto: link.
 *
 * WHY IT CHANGED. "Email Rayan" handed the visitor their own mail client and
 * hoped. On a phone mid-shift that is a context switch out of the browser into
 * an app that may not be signed in, with an empty body and a subject line we
 * wrote for them. The app already solved this for signed-in kitchens with the
 * Contact support dialog; this is that same dialog for someone who has not
 * signed up yet, which is the visitor this page exists for.
 *
 * NO-JAVASCRIPT IS NOT A FALLBACK HERE, IT IS THE BASE. The form is a real
 * <form method="post" action="/api/support">, present in the HTML, submittable
 * with the dialog element doing nothing at all. Script only upgrades it: it
 * moves the same form into a modal, sends it with fetch, and answers in place.
 * CSP allows both paths already (form-action 'self', connect-src 'self').
 *
 * Considered Strategy for the two submit paths; not used because there is one
 * behaviour with one enhancement, not two interchangeable algorithms. The
 * no-script path is the form element's own default, which is the point.
 *
 * story: docs/stories/contact-support.story.md
 */

const mailtoHref = `mailto:${site.email}?subject=${encodeURIComponent('Question about CostCook')}`;
---

<div class="ask-support" data-ask-support>
	<p class="ask-actions">
		<button type="button" class="btn-primary" data-support-open hidden>Ask a question</button>
		<a href="#ask-form" class="btn-primary" data-support-inline-link>Ask a question</a>
		<a href={site.phoneHref} class="btn-quiet">Call {site.phone}</a>
	</p>

	<!-- The dialog is a plain container until script promotes it. Without
	     script this section stays open on the page and the form below works. -->
	<div class="ask-panel" id="ask-form" data-support-panel>
		<div class="ask-ticket">
			<p class="ask-eyebrow">ASK · REPLY BY EMAIL</p>
			<h3 class="ask-title">Ask about your kitchen</h3>
			<p class="ask-lede">
				Tell me what you are trying to fix. This goes straight to my inbox and I reply to the
				address you leave here.
			</p>

			<form
				class="ask-form"
				method="post"
				action="/api/support"
				data-support-form
				novalidate={false}
			>
				<div class="ask-field">
					<label for="support-name">Your name <span class="ask-optional">(optional)</span></label>
					<input
						id="support-name"
						name="name"
						type="text"
						autocomplete="name"
						maxlength={SUPPORT_NAME_MAX_LENGTH}
					/>
				</div>

				<div class="ask-field">
					<label for="support-email">Email for the reply</label>
					<input
						id="support-email"
						name="email"
						type="email"
						required
						autocomplete="email"
						inputmode="email"
						placeholder="you@yourkitchen.com"
						aria-describedby="support-email-help"
					/>
					<p id="support-email-help" class="ask-help">The only place my answer can go.</p>
				</div>

				<div class="ask-field">
					<label for="support-message">What can I help with?</label>
					<textarea
						id="support-message"
						name="message"
						rows="6"
						required
						minlength={SUPPORT_MESSAGE_MIN_LENGTH}
						maxlength={SUPPORT_MESSAGE_MAX_LENGTH}
						placeholder="Your kitchen type, the step causing trouble, and what you have tried."
						aria-describedby="support-message-help"></textarea>
					<p id="support-message-help" class="ask-help">
						Do not include passwords, payment card details, or other sensitive information.
					</p>
				</div>

				<!-- Not for people. A bot that fills every field names itself. -->
				<div class="ask-trap" aria-hidden="true">
					<label for="support-company">Company</label>
					<input id="support-company" name="company" type="text" tabindex="-1" autocomplete="off" />
				</div>

				<p class="ask-status" role="status" aria-live="polite" data-support-status></p>

				<p class="ask-submit">
					<button type="button" class="btn-quiet" data-support-cancel hidden>Cancel</button>
					<button type="submit" class="btn-primary" data-support-send>Send question</button>
				</p>
			</form>
		</div>
	</div>

	<noscript>
		<p class="ask-help ask-noscript">
			The form above sends without JavaScript. If your browser blocks the send, email
			<a href={mailtoHref}>{site.email}</a> or call {site.phone}.
		</p>
	</noscript>
</div>

<script>
	/**
	 * Bundled, never is:inline: the CSP in vercel.json is script-src 'self' with
	 * no 'unsafe-inline', so an inline script would be refused by the browser.
	 */
	const root = document.querySelector<HTMLElement>('[data-ask-support]');
	const panel = root?.querySelector<HTMLElement>('[data-support-panel]');
	const form = root?.querySelector<HTMLFormElement>('[data-support-form]');
	const openButton = root?.querySelector<HTMLButtonElement>('[data-support-open]');
	const inlineLink = root?.querySelector<HTMLAnchorElement>('[data-support-inline-link]');
	const cancelButton = root?.querySelector<HTMLButtonElement>('[data-support-cancel]');
	const sendButton = root?.querySelector<HTMLButtonElement>('[data-support-send]');
	const status = root?.querySelector<HTMLElement>('[data-support-status]');

	if (root && panel && form && openButton && inlineLink && cancelButton && sendButton && status) {
		// Promote the panel to a modal only now that script is running. Until this
		// line the panel is an ordinary open section and the anchor above scrolls
		// to it, which is exactly the no-script experience.
		const dialog = document.createElement('dialog');
		dialog.className = 'ask-dialog';
		dialog.setAttribute('aria-labelledby', 'ask-dialog-title');
		panel.replaceWith(dialog);
		dialog.append(panel);
		panel.hidden = false;

		const title = panel.querySelector('.ask-title');
		title?.setAttribute('id', 'ask-dialog-title');

		openButton.hidden = false;
		cancelButton.hidden = false;
		inlineLink.remove();

		let lastFocused: HTMLElement | null = null;

		const open = (): void => {
			lastFocused = document.activeElement as HTMLElement | null;
			status.textContent = '';
			status.dataset.tone = '';
			dialog.showModal();
			panel.querySelector<HTMLInputElement>('#support-email')?.focus();
		};

		const close = (): void => {
			dialog.close();
			lastFocused?.focus();
		};

		openButton.addEventListener('click', open);
		cancelButton.addEventListener('click', close);
		// Clicking the backdrop closes, matching the app's dialog.
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) close();
		});

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (!form.reportValidity()) return;

			sendButton.disabled = true;
			sendButton.setAttribute('aria-busy', 'true');
			const sendingLabel = 'Sending…';
			const idleLabel = 'Send question';
			sendButton.textContent = sendingLabel;
			status.dataset.tone = '';
			status.textContent = '';

			const payload = {
				name: (form.elements.namedItem('name') as HTMLInputElement).value,
				email: (form.elements.namedItem('email') as HTMLInputElement).value,
				message: (form.elements.namedItem('message') as HTMLTextAreaElement).value,
				company: (form.elements.namedItem('company') as HTMLInputElement).value
			};

			try {
				const response = await fetch('/api/support', {
					method: 'POST',
					headers: { 'content-type': 'application/json', accept: 'application/json' },
					body: JSON.stringify(payload)
				});
				const result = (await response.json()) as { ok: boolean; message?: string };

				if (!response.ok || !result.ok) {
					status.dataset.tone = 'error';
					status.textContent =
						result.message ??
						'Your message could not be sent. Your draft is still here, so please try again.';
					return;
				}

				// The draft is only cleared once it is somewhere else.
				form.reset();
				status.dataset.tone = 'sent';
				status.textContent = 'Sent. I reply to every message myself, usually the same day.';
			} catch {
				status.dataset.tone = 'error';
				status.textContent =
					'Your message could not be sent. Your draft is still here, so please try again.';
			} finally {
				sendButton.disabled = false;
				sendButton.removeAttribute('aria-busy');
				sendButton.textContent = idleLabel;
			}
		});
	}
</script>

<style>
	.ask-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.5rem;
		margin-top: 2rem;
	}
	.ask-panel { margin-top: 2.5rem; }
	.ask-ticket {
		border: 1px solid var(--color-hairline);
		background: var(--color-paper);
		box-shadow: 0 12px 32px rgba(31, 36, 33, 0.08);
		padding: clamp(1.25rem, 3vw, 2rem);
	}
	.ask-eyebrow {
		color: var(--color-amber-deep);
		font-family: var(--font-mono, ui-monospace, monospace);
		font-size: var(--text-eyebrow);
		font-weight: 700;
		letter-spacing: 0.08em;
	}
	.ask-title { margin-top: 0.75rem; font-family: var(--font-display); font-size: 1.5rem; font-weight: 650; }
	.ask-lede { max-width: 54ch; margin-top: 0.6rem; color: var(--color-ink-soft); line-height: 1.6; }
	.ask-form {
		display: grid;
		gap: 1.25rem;
		margin-top: 1.75rem;
		border-top: 1px dashed var(--color-ticket-rule);
		padding-top: 1.5rem;
	}
	.ask-field { display: grid; gap: 0.4rem; }
	.ask-field label { font-size: 0.9rem; font-weight: 650; }
	.ask-optional { color: var(--color-ink-soft); font-weight: 400; }
	.ask-field input,
	.ask-field textarea {
		width: 100%;
		min-height: 2.75rem;
		border: 1px solid var(--color-hairline);
		border-radius: 0.35rem;
		background: #fff;
		padding: 0.65rem 0.75rem;
		color: var(--color-ink);
		font: inherit;
	}
	.ask-field textarea { min-height: 9rem; resize: vertical; }
	.ask-field input:focus-visible,
	.ask-field textarea:focus-visible {
		outline: 2px solid var(--color-green);
		outline-offset: 2px;
	}
	.ask-help { color: var(--color-ink-soft); font-size: 0.85rem; line-height: 1.5; }
	.ask-noscript { margin-top: 1rem; }
	/* Off-screen rather than display:none so a bot reading styles still fills it. */
	.ask-trap {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.ask-status:empty { display: none; }
	.ask-status {
		border-left: 3px solid var(--color-hairline);
		padding: 0.5rem 0.75rem;
		font-size: 0.9rem;
		line-height: 1.5;
	}
	.ask-status[data-tone='sent'] { border-color: var(--color-green); color: var(--color-green-deep); font-weight: 650; }
	.ask-status[data-tone='error'] { border-color: var(--color-amber-deep); color: var(--color-amber-deep); }
	.ask-submit { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.25rem; }

	/* :global is REQUIRED on every rule below. Astro scopes component styles by
	   stamping an attribute onto elements that exist in the template, and this
	   dialog is created by script at runtime, so it carries no such attribute
	   and a plain .ask-dialog rule never reaches it. The first version of this
	   file learned that the slow way: the modal rendered unstyled in the
	   top-left corner, taller than the viewport, because neither margin nor
	   max-height applied. Scoped under .ask-support so nothing leaks. */
	.ask-support :global(dialog.ask-dialog) {
		/* margin: auto is what centres a modal dialog, and it is not redundant:
		   Tailwind's preflight zeroes margin on every element. */
		margin: auto;
		width: min(38rem, calc(100vw - 2rem));
		max-height: calc(100dvh - 2rem);
		overflow: auto;
		border: 0;
		background: transparent;
		padding: 0;
	}
	.ask-support :global(dialog.ask-dialog)::backdrop { background: rgba(31, 36, 33, 0.45); }
	.ask-support :global(dialog.ask-dialog) .ask-panel { margin-top: 0; }
</style>
