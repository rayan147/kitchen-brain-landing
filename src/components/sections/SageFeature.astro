---
import FeatureTrialTerms from "../FeatureTrialTerms.astro";
import { sage, sageAllowanceLine, sageAllowanceProof, sageDraftKinds, sageDraftKindsAnd, sageFilm, sageReadToolCount, sageStatusWord } from '../../lib/sage';
import { spell, spellCapital } from '../../lib/words';
import { cta, demoCta } from '../../lib/site';
import SageIcon from '../SageIcon.astro';

// Considered Strategy; not used because the page selects one fixed editorial
// view of Sage's static product contract; no behavior is swapped at runtime.
const faqItems = [
	{
		question: 'Is Sage available now?',
		answer:
			'Yes. Open it from the app navigation, or from the setup header while setup is unfinished.'
	},
	{
		question: 'How does Sage help during setup?',
		answer:
			'Ask Sage opens from the setup header with starting questions for your stage. Back to setup returns you to the unfinished stage, with your progress saved.'
	},
	{
		question: 'What can I ask Sage?',
		answer:
			`Sage has ${spell(sageReadToolCount, { compound: true })} read-only tools across the shift, orders, recipes, stock, buying and setup. It can also prepare ${spell(sageDraftKinds.length)} kinds of draft for an owner or manager to approve: ${sageDraftKindsAnd}.`
	},
	{
		question: 'Can Sage change my kitchen records?',
		answer:
			'Not on its own. Its tools read records, and a draft changes nothing. An owner or manager approves or discards each draft, and CostCook checks the underlying records again before an approved draft is saved. If they changed, nothing is saved.'
	},
	{
		question: 'What happens when the evidence is missing?',
		answer:
			'Sage names the missing evidence or an incomplete check instead of filling the gap with a confident number. The answer still helps: it tells you what the record needs.'
	},
	{
		question: 'Is there a limit on Sage?',
		answer:
			`Yes: ${sageAllowanceLine}. You cannot buy more. Sage warns you in its panel once 80% of them are used. If they run out, Sage waits for the reset and every other screen keeps working.`
	},
	{
		question: 'Can my staff use Sage?',
		answer:
			'No. Only an owner or manager can open Sage, because it reads the money.'
	}
] as const;

---

<!-- story: docs/stories/sage-feature.story.md -->
<article id="features-assistant" class="sage-page">
	<section class="hero" aria-labelledby="sage-feature-heading">
		<div class="container-page hero-grid">
			<div class="hero-copy anim-enter">
				<nav aria-label="Breadcrumb" class="feature-breadcrumb">
					<a href="/features">Every feature</a>
					<span aria-hidden="true">/</span>
					<span>Sage</span>
				</nav>
				<div class="sage-identity">
					<SageIcon size={32} context="specialist" />
					<div><strong>Sage</strong><p class="availability"><span aria-hidden="true"></span>{sageStatusWord}</p></div>
				</div>
				<h1 id="sage-feature-heading" class="feature-display">Ask Sage about your kitchen.</h1>
				<p class="hero-lede">Ask about your recipes, your stock and what things cost, even before setup is done. You can check the records behind every answer. If it drafts a shopping list, you create it or discard it.</p>
				<div class="hero-actions">
					<a href={cta.href} target={cta.target} rel={cta.rel} aria-label={cta.ariaLabel} class="btn-primary">{cta.label}</a>
					<a href="#sage-allowance" class="btn-quiet">What it costs to run</a>
				</div>
				<FeatureTrialTerms />
			</div>

			<!-- The film, with the homepage hero's player rules: native controls, no
			     autoplay, preload="metadata" (with "none" Chrome ignored clicks on the
			     poster), MP4 first and faststart. Music and burned-in words, so no
			     caption track to double them; the transcript below says the same. -->
			<figure id="watch-sage" class="hero-film-frame anim-enter" style="--enter-delay: 120ms">
				<video class="hero-film" controls playsinline preload="metadata" poster={sageFilm.poster} width={sageFilm.width} height={sageFilm.height} aria-label={sageFilm.label}>
					<source src={sageFilm.mp4} type="video/mp4" />
					<source src={sageFilm.webm} type="video/webm" />
					<a href={sageFilm.mp4}>Download the film (MP4)</a>
				</video>
				<figcaption>A sample kitchen asks what the short rib costs, then checks its credits. {sageFilm.length}, music only, every word on screen. Captured in CostCook on Oct 7 and {sageFilm.capturedOn}.</figcaption>
				<details class="film-transcript">
					<summary>Read what the film shows</summary>
					<ol>{sageFilm.transcript.map((line) => <li>{line}</li>)}</ol>
				</details>
			</figure>
		</div>
	</section>





	<nav class="feature-chapters container-page" aria-label="On this page">
		<a href="#sage-jobs"><strong>Questions you can ask</strong><span>From Saturday’s prep to a guest-count change.</span></a>
		<a href="#sage-guardrails"><strong>Where Sage stops</strong><span>What it reads, what it drafts, and what stays your call.</span></a>
		<a href="#sage-allowance"><strong>Its monthly credits</strong><span>How many, the warning, and what happens when they run out.</span></a>
	</nav>

	<section class="proof-section" aria-labelledby="proof-heading">
		<div class="container-page proof-grid">
			<div class="proof-copy" data-reveal>
				<h2 id="proof-heading">The number arrives with its record.</h2>
				<p>One answer, held still so you can read every line: why does the short rib cost what it costs?</p>
				<dl class="answer-facts">
					<div><dt>Cost per portion</dt><dd>$7.28</dd></div>
					<div><dt>Biggest line</dt><dd>Beef short rib, $7.00 (96%)</dd></div>
					<div><dt>Evidence</dt><dd>3 cited lines</dd></div>
					<div><dt>Source</dt><dd>Recipe · Braised Short Rib</dd></div>
				</dl>
				<p class="snap-setup">When a line has no record behind it, Sage says so instead of filling the gap.</p>
				<p class="snap">A missing number is an answer, too.</p>
			</div>
			<figure class="proof-capture" data-reveal>
				<picture>
					<source media={sage.proof.mobileMedia} srcset={sage.proof.mobile.src} width={sage.proof.mobile.width} height={sage.proof.mobile.height} />
					<img
						src={sage.proof.desktop.src}
						alt={sage.proof.desktop.alt}
						width={sage.proof.desktop.width}
						height={sage.proof.desktop.height}
						loading="lazy"
						decoding="async"
					/>
				</picture>
				<figcaption>{sage.proof.caption}</figcaption>
			</figure>
		</div>
	</section>
	<section id="sage-jobs" class="questions" aria-labelledby="questions-heading">
		<div class="container-page questions-grid">
			<div class="questions-intro" data-reveal>
				<h2 id="questions-heading">Questions you can ask. A shopping list you can approve.</h2>
				<p>Sage is for owners and managers. It pulls the records that matter and shows you what it found.</p>
			</div>
			<ol class="question-list">
				{sage.abilities.map((ability, index) => (
					<li data-reveal>
						<span>{String(index + 1).padStart(2, '0')}</span>
						<div><h3>&ldquo;{ability.ask}&rdquo;</h3><p>{ability.does}</p></div>
					</li>
				))}
			</ol>
		</div>
	</section>
	<section class="setup-section" aria-labelledby="setup-heading">
		<div class="container-page setup-grid">
			<figure class="setup-capture" data-reveal>
				<!-- The setup header over stage 1, cropped from the onboarding capture
				     (/proof/setup/01-kitchen.png, the Harbor & Hearth kitchen) from its left
				     edge, stage list included (issue #81: a crop starting mid-rail left a
				     sliver of the active stage's border): the
				     caption's claim is the header's Ask Sage, and the stage under it shows
				     setup is still in progress. The old whole-window
				     frame drew 4px text on a phone and named an older sample kitchen
				     (readability review 2026-10-09). The capture is 2x. -->
				<div class="shot-pan" tabindex="0" role="region" aria-label="Setup header screenshot">
					<!-- A phone gets the header's buttons alone, so Ask Sage, the
					     caption's claim, opens in view instead of 270px to the right
					     (design review 2026-10-09). The alt holds for both crops. -->
					<picture>
						<source media="(max-width: 39.99rem)" srcset="/proof/sage-setup-header-phone.png" width="720" height="130" />
						<img
							src="/proof/sage-setup-header.png"
							alt="The CostCook setup screen's header, with Ask Sage beside Support and Save and exit."
							width="2040"
							height="870"
							loading="lazy"
							decoding="async"
						/>
					</picture>
				</div>
				<figcaption>Captured from the setup screen: Ask Sage sits beside Support and Save and exit. <a class="full-size" href="/proof/setup/01-kitchen.png" target="_blank" rel="noopener noreferrer">Open full-size (new tab)</a></figcaption>
			</figure>
			<div class="setup-copy" data-reveal>
				<h2 id="setup-heading">Ask before the kitchen is fully set up.</h2>
				<p>
					Sage does not pretend a half-built kitchen is finished. It works from what you have
					entered so far, tells you what is still missing, and keeps the way back to setup in view.
				</p>
				<dl>
					<div><dt>Open it from setup</dt><dd>{sage.onboarding.entry}</dd></div>
					<div><dt>Ask a question that fits</dt><dd>{sage.onboarding.context}</dd></div>
					<div><dt>Keep your place</dt><dd>{sage.onboarding.return}</dd></div>
				</dl>
			</div>
		</div>
	</section>
	<section id="sage-guardrails" class="guardrails" aria-labelledby="guardrails-heading">
		<div class="container-page">
			<div class="guardrails-heading" data-reveal>
				<h2 id="guardrails-heading">You can see exactly where Sage stops.</h2>
				<p>Answering a question changes nothing. A draft stays a draft until an owner or manager approves it.</p>
			</div>
			<div class="approval-path" data-reveal aria-label={`${spellCapital(sageReadToolCount, { compound: true })} tools read records, ${spell(sageDraftKinds.length)} kinds of draft can be prepared, and a person approves`}>
				<div><span>{sageReadToolCount} tools</span><strong>Read records</strong></div>
				<i aria-hidden="true"></i>
				<div><span>{sageDraftKinds.length} kinds of draft</span><strong>Wait for approval</strong></div>
				<i aria-hidden="true"></i>
				<div class="person"><span>You</span><strong>Go ahead or discard</strong></div>
			</div>
			<ul class="guardrail-list" role="list">
				{sage.guardrails.map((rule) => (
					<li data-reveal><h3>{rule.lead}</h3><p>{rule.detail}</p></li>
				))}
			</ul>
		</div>
	</section>
	<section id="sage-allowance" class="allowance" aria-labelledby="allowance-heading">
		<div class="container-page allowance-grid">
			<div class="allowance-copy" data-reveal>
				<h2 id="allowance-heading">What it costs to run.</h2>
				<p class="allowance-line">{sageAllowanceLine}.</p>
				<p>
					The credits come with the plan. There is no meter, and you cannot buy more. The billing
					page shows the count and the day they reset. Once 80% of them are used, the Sage panel
					says so. If they run out, Sage waits for the reset. Every other screen keeps working.
				</p>
			</div>
			<figure class="allowance-capture" data-reveal>
				<img
					src={sageAllowanceProof.src}
					alt={sageAllowanceProof.alt}
					width={sageAllowanceProof.width}
					height={sageAllowanceProof.height}
					loading="lazy"
					decoding="async"
				/>
				<figcaption>The note in the Sage panel, in a sample kitchen with 1,640 credits used. Captured in CostCook on {sageFilm.capturedOn}.</figcaption>
			</figure>
		</div>
	</section>

	<section class="faq" aria-labelledby="faq-heading">
		<div class="container-page faq-grid">
			<div class="faq-intro" data-reveal>
				<h2 id="faq-heading">Questions owners ask first.</h2>
				<p>Is it live, what can it change, what does it cost, and who sees the money.</p>
			</div>
			<div class="faq-list">
				{faqItems.map((item) => (
					<details data-reveal data-sage-disclosure>
						<summary><span>{item.question}</span><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 7l6 6 6-6" /></svg></summary>
						<p>{item.answer}</p>
					</details>
				))}
			</div>
		</div>
	</section>

	<section class="closing" aria-labelledby="closing-heading">
		<div class="container-page closing-grid" data-reveal>
			<div>
				<h2 id="closing-heading">Ask the next question. Keep the final say.</h2>
				<p>Check the record behind the answer, then get back to the kitchen.</p>
			</div>
			<div class="closing-actions">
				<a href={cta.href} target={cta.target} rel={cta.rel} aria-label={cta.ariaLabel} class="btn-primary">{cta.label}</a>
				<a href={demoCta.href} target={demoCta.target} rel={demoCta.rel} aria-label={demoCta.ariaLabel} class="btn-quiet">{demoCta.label}</a>
			</div>
		</div>
		<nav class="container-page onward feature-onward" aria-label="Related feature guides">
			<a href="/features/invoices-and-price-list-import">Invoices &amp; price-list import</a>
			<a href="/features/recipes-and-costing">Recipes &amp; food costing</a>
			<a href="/features">Every CostCook feature</a>
		</nav>
	</section>
</article>

<style>
	.sage-page { --rule: color-mix(in srgb, var(--color-ink) 17%, transparent); overflow: clip; }
	.hero { border-block: 1px solid var(--color-hairline); background: var(--color-cream); }
	.hero-grid { display: grid; gap: clamp(3.5rem, 7vw, 7rem); align-items: center; padding-block: clamp(3.5rem, 6vw, 7rem); }
	.sage-identity { display: flex; align-items: center; gap: .75rem; margin-bottom: .5rem; color: var(--color-green-deep); }
	.sage-identity > div { display: flex; min-width: 0; flex-wrap: wrap; align-items: center; gap: .3rem .7rem; }
	.sage-identity strong { color: var(--color-ink); font-family: var(--font-display); font-size: var(--text-record); font-weight: 600; line-height: 1.1; }
	.availability { display: inline-flex; align-items: center; gap: 0.55rem; color: var(--color-green-deep); font-size: var(--text-caption); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
	.availability span { width: 0.65rem; height: 0.65rem; border-radius: 999px; background: var(--color-green); box-shadow: 0 0 0 5px color-mix(in srgb, var(--color-green) 13%, transparent); }
	.hero h1 { max-width: 10ch; }
	.hero-lede { max-width: 40ch; margin-top: 1.75rem; color: var(--color-ink-soft); font-size: var(--text-lede); line-height: 1.55; }
	.hero-actions, .closing-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2rem; }
	.hero-actions .btn-primary, .closing-actions .btn-primary { min-height: 48px; align-items: center; justify-content: center; padding-inline: 1.7rem; }
	.feature-chapters { display: grid; gap: 1px; padding-block: 1px; background: var(--color-hairline); }
	.feature-chapters a { display: flex; min-height: 5.5rem; flex-direction: column; justify-content: center; padding: 1rem clamp(1rem, 2vw, 1.5rem); background: var(--color-paper); color: var(--color-ink); text-decoration: none; }
	.feature-chapters strong { font-family: var(--font-display); font-size: var(--text-record-sm); font-weight: 600; }
	.feature-chapters span { margin-top: 0.3rem; color: var(--color-ink-soft); font-size: var(--text-body-sm); line-height: 1.4; }
	.feature-chapters a:hover strong { color: var(--color-green-deep); }
	/* The film: the homepage hero's frame, 16:9 before the poster loads. */
	.hero-film-frame { margin: 0; min-width: 0; }
	.hero-film { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; border-radius: 8px; box-shadow: var(--shadow-lift); background: var(--color-paper); }
	.hero-film-frame > figcaption { margin-top: 0.8rem; color: var(--color-ink-soft); font-size: var(--text-label-sm); line-height: 1.5; }
	.film-transcript { margin-top: 0.25rem; color: var(--color-ink-soft); font-size: var(--text-label-sm); line-height: 1.5; }
	.film-transcript summary { display: flex; width: fit-content; min-height: 2.75rem; align-items: center; gap: 0.5rem; cursor: pointer; text-decoration: underline; text-underline-offset: 0.2em; }
	.film-transcript summary::before { content: '▸'; text-decoration: none; }
	.film-transcript[open] summary::before { content: '▾'; }
	.film-transcript ol { display: grid; gap: 0.35rem; padding-left: 1.25rem; list-style: decimal; }
	/* The caption starts past the setup slip, which sits over the figure's
	   bottom-left corner and hid the caption's first words. */

	.allowance-copy h2, .setup-copy h2, .questions-intro h2, .proof-copy h2, .guardrails-heading h2, .faq-intro h2, .closing h2 { font-family: var(--font-display); font-size: var(--text-h2); font-weight: 600; line-height: 1.05; letter-spacing: -0.02em; text-wrap: balance; }

	.setup-section, .proof-section, .faq { background: var(--color-offwhite); }
	.setup-grid, .proof-grid, .faq-grid { display: grid; gap: clamp(3rem, 7vw, 7rem); align-items: center; padding-block: var(--spacing-section); }
	.setup-capture { min-width: 0; }
	/* The floor follows the source: 1020px for the screen, 360px for the
	   phone's header crop (set here, since an inline value can't switch). */
	.setup-capture picture { display: block; }
	.setup-capture img { --shot-w: 1020px; display: block; width: 100%; height: auto; border-top: 4px solid var(--color-green); border-radius: .5rem; box-shadow: var(--shadow-lift); }
	.setup-capture figcaption { margin-top: 0.8rem; color: var(--color-ink-soft); font-size: var(--text-label-sm); line-height: 1.5; }
	.setup-copy > p, .questions-intro > p, .proof-copy > p:not(.snap), .guardrails-heading > p, .faq-intro > p, .closing p { max-width: 45ch; margin-top: 1.25rem; color: var(--color-ink-soft); font-size: var(--text-body-lg); line-height: 1.65; }
	.setup-copy dl { margin-top: 2rem; border-top: 1px solid var(--rule); }
	.setup-copy dl div { padding-block: 1rem; border-bottom: 1px solid var(--rule); }
	.setup-copy dt { font-weight: 700; }
	.setup-copy dd { margin-top: 0.35rem; color: var(--color-ink-soft); font-size: var(--text-body-sm); line-height: 1.55; }

	.questions { background: var(--color-softgreen); }
	.questions-grid { display: grid; gap: clamp(3rem, 6vw, 6rem); align-items: start; padding-block: var(--spacing-section); }
	.questions-intro { position: sticky; top: 7rem; }
	.question-list { border-top: 1px solid var(--rule); }
	.question-list li { display: grid; grid-template-columns: 2.8rem minmax(0, 1fr); gap: clamp(1rem, 3vw, 2rem); padding-block: clamp(1.25rem, 2.5vw, 2rem); border-bottom: 1px solid var(--rule); }
	.question-list > li > span { color: var(--color-amber-deep); font-size: var(--text-label-sm); font-weight: 750; font-variant-numeric: tabular-nums; letter-spacing: 0.06em; }
	.question-list h3 { font-family: var(--font-display); font-size: var(--text-h3); font-weight: 600; line-height: 1.2; }
	.question-list p { max-width: 55ch; margin-top: 0.55rem; color: var(--color-ink-soft); line-height: 1.6; }

	.proof-grid { align-items: start; }
	.proof-copy { max-width: 46rem; }
	.answer-facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 2rem; border-top: 1px solid var(--rule); }
	.answer-facts div { padding: 1rem 1rem 1rem 0; border-bottom: 1px solid var(--rule); }
	.answer-facts dt { color: var(--color-ink-soft); font-size: var(--text-label-sm); font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; }
	.answer-facts dd { margin-top: 0.35rem; font-size: var(--text-body-lg); font-weight: 700; font-variant-numeric: tabular-nums; }
	.snap-setup { max-width: 45ch; margin-top: 1.5rem; color: var(--color-ink-soft); line-height: 1.6; }
	.snap { margin-top: 2rem; padding-top: 1.4rem; border-top: 3px solid var(--color-amber-deep); font-family: var(--font-display); font-size: var(--text-h2); font-weight: 600; line-height: 1.15; }
	/* Shown at a quarter of its pixels on a phone: let it open full-size. */
	.full-size { display: inline-flex; min-height: 44px; align-items: center; font-size: var(--text-body-sm); font-weight: 600; color: var(--color-green-deep); text-decoration: underline; }

	.guardrails { background: var(--color-cream); }
	.guardrails > .container-page { padding-block: var(--spacing-section); }
	.guardrails-heading { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2rem 4rem; align-items: end; }
	.approval-path { display: grid; grid-template-columns: minmax(0, 1fr) 2.5rem minmax(0, 1fr) 2.5rem minmax(0, 1fr); gap: 0.75rem; align-items: center; margin-top: clamp(2.5rem, 5vw, 4.5rem); padding: clamp(1rem, 2.5vw, 1.8rem); border-block: 1px solid var(--rule); background: var(--color-paper); }
	.approval-path div { min-width: 0; }
	.approval-path span, .approval-path strong { display: block; }
	.approval-path span { color: var(--color-ink-soft); font-size: var(--text-label-sm); font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; }
	.approval-path strong { margin-top: 0.25rem; }
	.approval-path i { position: relative; height: 1px; background: var(--color-hairline-strong); }
	.approval-path i::after { position: absolute; right: 0; top: 50%; width: 0.45rem; height: 0.45rem; border-top: 1px solid var(--color-ink-soft); border-right: 1px solid var(--color-ink-soft); content: ''; transform: translateY(-50%) rotate(45deg); }
	.approval-path .person { padding: 0.8rem 1rem; background: var(--color-softgreen); }
	.guardrail-list { display: grid; gap: 0; margin-top: 3rem; border-top: 1px solid var(--rule); }
	.guardrail-list li { padding-block: 1.25rem; border-bottom: 1px solid var(--rule); }
	.guardrail-list h3 { font-size: var(--text-body); font-weight: 700; }
	.guardrail-list p { max-width: 58ch; margin-top: 0.4rem; color: var(--color-ink-soft); font-size: var(--text-body-sm); line-height: 1.55; }

	.allowance { background: var(--color-softamber); }
	.allowance-grid { display: grid; gap: clamp(2.5rem, 6vw, 6rem); align-items: center; padding-block: var(--spacing-section); }
	.allowance-copy > p:not(.allowance-line) { max-width: 45ch; margin-top: 1.25rem; color: var(--color-ink-soft); font-size: var(--text-body-lg); line-height: 1.65; }
	.allowance-line { max-width: 24ch; margin-top: 1.5rem; padding-top: 1.2rem; border-top: 3px solid var(--color-amber-deep); font-family: var(--font-display); font-size: var(--text-h3); font-weight: 600; line-height: 1.2; }
	.allowance-capture { margin: 0; min-width: 0; }
	.allowance-capture img { display: block; width: 100%; max-width: 32rem; height: auto; border-radius: .5rem; box-shadow: var(--shadow-lift); }
	.allowance-capture figcaption { margin-top: 0.8rem; color: var(--color-ink-soft); font-size: var(--text-label-sm); line-height: 1.5; }
	.proof-capture { margin: 0; min-width: 0; }
	.proof-capture img { display: block; width: 100%; height: auto; border-top: 4px solid var(--color-green); border-radius: .5rem; box-shadow: var(--shadow-lift); }
