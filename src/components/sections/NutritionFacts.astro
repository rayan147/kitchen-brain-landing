---
/**
 * Nutrition facts on the homepage. Foundation: docs/stories/nutrition-facts.story.md
 * Visual evidence revision: docs/stories/homepage-nutrition-visual.story.md
 *
 * SEVENTH STOP, after TheYield and before PaperIn: both are recipe-level
 * mechanics, and yield is the one that sets up "the numbers on the plate are
 * computed from the line", which this section continues. Added 2026-08-29 at
 * the owner's request, with the meal-prep reader named in the lede because
 * that is who asks for these numbers first (RC-01 covers the audience).
 *
 * SHIPPED, so it carries no Coming badge; the one Coming thing near it (the
 * label printer) is named in "what it is not" rather than hidden. RC-42 and
 * RC-50 back every sentence; the print page is RC-50's evidence.
 *
 * NO PRIMARY CTA. The quiet link goes to the feature area.
 */
import SectionHandoff from '../SectionHandoff.astro';
import { nutrition } from '../../lib/nutrition';

// Considered Composite; not used because the five nutrition checks form one
// fixed editorial sequence, not a nested tree with shared behaviour.
const evidenceGuides = [
	{
		iconPaths: ['M4 20h16', 'M6 18v-6', 'M12 18V6', 'M18 18v-9'],
		cues: ['339 calories', '22 g protein', '48.1 g carbs', '7 g fat']
	},
	{
		iconPaths: ['M5 6c0-1.7 3.1-3 7-3s7 1.3 7 3-3.1 3-7 3-7-1.3-7-3z', 'M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6', 'M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6'],
		cues: ['USDA profile', 'Matched by you', 'Used everywhere']
	},
	{
		iconPaths: ['M7 3h7l4 4v14H7z', 'M14 3v5h5', 'M10 13h5', 'M10 17h2'],
		cues: ['Missing stays blank', 'Partial stays partial']
	},
	{
		iconPaths: ['M7 8V3h10v5', 'M6 17H4v-7h16v7h-2', 'M7 14h10v7H7z', 'M17 11h.01'],
		cues: ['Panel', 'Ingredients', 'Allergens', 'Printed time']
	},
	{
		iconPaths: ['M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z', 'M9 12l2 2 4-5'],
		cues: ['Supplier record', 'Package label', 'Kitchen review']
	}
] as const;
---

<!-- story: docs/stories/homepage-nutrition-visual.story.md -->
<section id="nutrition" class="container-page border-t border-hairline py-section" aria-labelledby="nutrition-heading">
	<div class="nutrition-layout">
		<div class="max-w-3xl" data-reveal>
			<p class="eyebrow">Nutrition facts</p>
			<h2 id="nutrition-heading" class="mt-4 text-h2 font-semibold">
				The numbers on the label, from the recipe you already costed.
			</h2>
			<p class="mt-5 max-w-[60ch] text-lede text-ink-soft">
				A meal-prep kitchen is asked for calories and protein before it is asked for a
				price. CostCook computes the fifteen numbers an FDA panel carries for every recipe,
				per portion, from the same lines that cost it, and says out loud when a value is
				missing instead of counting it as zero.
			</p>

			<ol role="list" class="evidence-rail" data-nutrition-evidence>
				{
					nutrition.points.map((point, index) => (
						<li class="evidence-step" data-nutrition-step={String(index + 1).padStart(2, '0')}>
							<div class="evidence-marker" aria-hidden="true">
								<span>{String(index + 1).padStart(2, '0')}</span>
								<i>
									<svg width="24" height="24" viewBox="0 0 24 24" fill="none">
										{evidenceGuides[index].iconPaths.map((path) => <path d={path} />)}
									</svg>
								</i>
							</div>
							<div class="evidence-copy">
								<p class="font-semibold">{point.lead}</p>
								<p class="mt-1 max-w-[52ch] text-sm leading-relaxed text-ink-soft">{point.detail}</p>
								<ul role="list" class="evidence-cues">
									{evidenceGuides[index].cues.map((cue) => <li data-nutrition-cue>{cue}</li>)}
								</ul>
							</div>
						</li>
					))
				}
			</ol>
		</div>

		<!-- Two captures of one recipe: the panel on the recipe page, and the sheet
		     the Print button makes. The label is shown on phones because it is the
		     portrait one; the panel is shown from sm up at half its 2x size. -->
		<figure class="nutrition-proof" data-nutrition-proof data-reveal>
			<p class="font-mono text-eyebrow font-semibold tracking-wide text-amber-deep">
				RECIPE NUTRITION
			</p>
			<div class="mt-3 border border-hairline bg-paper p-1 shadow-ticket sm:p-2">
				<img
					src={nutrition.proof.label.src}
					alt={nutrition.proof.label.alt}
					width={nutrition.proof.label.width}
					height={nutrition.proof.label.height}
					loading="lazy"
					decoding="async"
					class="mx-auto h-auto w-full max-w-[384px] sm:hidden"
				/>
				<img
					src={nutrition.proof.panel.src}
					alt={nutrition.proof.panel.alt}
					width={nutrition.proof.panel.width}
					height={nutrition.proof.panel.height}
					loading="lazy"
					decoding="async"
					style="width: 1136px; max-width: 100%"
					class="hidden h-auto sm:block"
				/>
			</div>
			<figcaption class="mt-3 max-w-[60ch] text-sm text-ink-soft">{nutrition.proof.caption}</figcaption>
		</figure>
	</div>

	<div class="mt-12 border-t border-ticket-rule pt-8" data-reveal>
		<h3 class="text-h3 font-semibold">What it is not.</h3>
		<ul role="list" class="mt-6 grid gap-x-12 gap-y-4 sm:grid-cols-2">
			{
				nutrition.notClaimed.map((line) => (
					<li class="border-t border-hairline pt-3 text-sm leading-relaxed text-ink-soft">{line}</li>
				))
			}
		</ul>
		<p class="mt-8 max-w-[66ch] text-ink-soft">
			Every line of it is on the feature list, with the one Coming thing marked.{' '}
			<a href={nutrition.href} class="btn-quiet">Nutrition facts, area by area</a>.
		</p>
	</div>

	<SectionHandoff from="nutrition" />
</section>

<style>
	.nutrition-layout {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 29rem), 1fr));
		gap: clamp(3rem, 5vw, 4rem);
		align-items: start;
	}

	.evidence-rail {
		display: grid;
		margin-top: 2rem;
	}

	.evidence-step {
		position: relative;
		display: grid;
		grid-template-columns: 3.25rem minmax(0, 1fr);
		gap: 1rem;
		padding-bottom: 1.5rem;
	}

	.evidence-step:not(:last-child)::after {
		position: absolute;
		top: 3.25rem;
		bottom: 0;
		left: calc(1.5rem - 0.5px);
		width: 1px;
		background: var(--color-ticket-rule);
		content: '';
	}

	.evidence-marker {
		position: relative;
		z-index: 1;
		display: grid;
		justify-items: center;
		gap: 0.4rem;
		align-content: start;
	}

	.evidence-marker > span {
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: var(--text-micro);
		font-weight: 700;
		line-height: 1;
		letter-spacing: 0.08em;
		color: var(--color-amber-deep);
	}

	.evidence-marker i {
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		border: 1px solid var(--color-ticket-rule);
		border-radius: 999px;
		background: var(--color-paper);
		color: var(--color-amber-deep);
	}

	.evidence-marker svg {
		stroke: currentColor;
		stroke-width: 1.7;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.evidence-copy {
		min-width: 0;
		padding-top: 0.1rem;
	}

	.evidence-cues {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 7.5rem), 1fr));
		gap: 0 1rem;
		margin-top: 0.8rem;
		border-bottom: 1px solid var(--color-ticket-rule);
	}

	.evidence-cues li {
		padding-block: 0.45rem;
		border-top: 1px solid var(--color-ticket-rule);
		font-size: var(--text-caption);
		font-weight: 600;
		line-height: 1.35;
		color: var(--color-ink-soft);
	}

	.nutrition-proof {
		align-self: start;
	}

	@media (min-width: 64rem) {
		.nutrition-proof {
			position: sticky;
			top: 5.5rem;
		}
	}
</style>
