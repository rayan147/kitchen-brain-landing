---
/**
 * Nutrition facts on the homepage. story: docs/stories/nutrition-facts.story.md
 *
 * SEVENTH STOP, after TheYield and before PaperIn: both are recipe-level
 * mechanics, and yield is the one that sets up "the numbers on the plate are
 * computed from the line", which this section continues. Added 2026-08-29 at
 * the owner's request, with the meal-prep reader named in the lede because
 * that is who asks for these numbers first (RC-01 covers the audience).
 *
 * SHIPPED, so it carries no Coming badge; the one Coming thing near it (the
 * label printer) is named in "what it is not" rather than hidden. RC-42 and
 * RC-50 back every sentence; the print page is RC-50's evidence.
 *
 * NO PRIMARY CTA. The quiet link goes to the feature area.
 */
import SectionHandoff from '../SectionHandoff.astro';
import { nutrition } from '../../lib/nutrition';
---

<section id="nutrition" class="container-page border-t border-hairline py-section" aria-labelledby="nutrition-heading">
	<div class="grid gap-12 lg:grid-cols-[5fr_7fr] lg:items-start lg:gap-16">
		<div class="max-w-3xl" data-reveal>
			<p class="eyebrow">Nutrition facts</p>
			<h2 id="nutrition-heading" class="mt-4 text-h2 font-semibold">
				The numbers on the label, from the recipe you already costed.
			</h2>
			<p class="mt-5 max-w-[60ch] text-lede text-ink-soft">
				A meal-prep kitchen is asked for calories and protein before it is asked for a
				price. CostCook computes the fifteen numbers an FDA panel carries for every recipe,
				per portion, from the same lines that cost it, and says out loud when a value is
				missing instead of counting it as zero.
			</p>

			<ol role="list" class="mt-8 border-t border-ticket-rule">
				{
					nutrition.points.map((point, index) => (
						<li class="grid gap-x-4 gap-y-1 border-b border-dashed border-ticket-rule py-3 sm:grid-cols-[2.5rem_minmax(0,1fr)]">
							<p class="font-mono text-eyebrow font-semibold tabular-nums text-amber-deep">
								{String(index + 1).padStart(2, '0')}
							</p>
							<div class="min-w-0">
								<p class="font-semibold">{point.lead}</p>
								<p class="mt-1 max-w-[52ch] text-sm leading-relaxed text-ink-soft">{point.detail}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>

		<!-- Two captures of one recipe: the panel on the recipe page, and the sheet
		     the Print button makes. The label is shown on phones because it is the
		     portrait one; the panel is shown from sm up at half its 2x size. -->
		<figure data-reveal>
			<p class="font-mono text-eyebrow font-semibold tracking-wide text-amber-deep">
				SANDBOX BUILD · {nutrition.verified.branch} · {nutrition.verified.on}
			</p>
			<div class="mt-3 border border-hairline bg-paper p-1 shadow-ticket sm:p-2">
				<img
					src={nutrition.proof.label.src}
					alt={nutrition.proof.label.alt}
					width={nutrition.proof.label.width}
					height={nutrition.proof.label.height}
					loading="lazy"
					decoding="async"
					class="mx-auto h-auto w-full max-w-[384px] sm:hidden"
				/>
				<img
					src={nutrition.proof.panel.src}
					alt={nutrition.proof.panel.alt}
					width={nutrition.proof.panel.width}
					height={nutrition.proof.panel.height}
					loading="lazy"
					decoding="async"
					style="width: 1136px; max-width: 100%"
					class="hidden h-auto sm:block"
				/>
			</div>
			<figcaption class="mt-3 max-w-[60ch] text-sm text-ink-soft">{nutrition.proof.caption}</figcaption>
		</figure>
	</div>

	<div class="mt-12 border-t border-ticket-rule pt-8" data-reveal>
		<h3 class="text-h3 font-semibold">What it is not.</h3>
		<ul role="list" class="mt-6 grid gap-x-12 gap-y-4 sm:grid-cols-2">
			{
				nutrition.notClaimed.map((line) => (
					<li class="border-t border-hairline pt-3 text-sm leading-relaxed text-ink-soft">{line}</li>
				))
			}
		</ul>
		<p class="mt-8 max-w-[66ch] text-ink-soft">
			Every line of it is on the feature list, with the one Coming thing marked.{' '}
			<a href={nutrition.href} class="btn-quiet">Nutrition facts, area by area</a>.
		</p>
	</div>

	<SectionHandoff from="nutrition" />
</section>
