---
const moments = [
	{
		title: 'A supplier price changes',
		body: 'Which dishes, menus, and unconfirmed events use that ingredient?'
	},
	{
		title: 'The guest count moves',
		body: 'Which portions, batches, cases, and equipment need to change?'
	},
	{
		title: 'The event is over',
		body: 'What should the food have cost, and what did the kitchen actually spend?'
	}
];
---

<section id="problem" class="border-y border-hairline bg-cream">
	<div class="container-page py-section-tight">
		<div class="max-w-3xl" data-reveal>
			<h2 class="text-h2 font-semibold">One changed price can leave every other sheet behind.</h2>
			<p class="mt-5 max-w-[68ch] text-lede text-ink-soft">
				Supplier prices change in one place. Recipes live somewhere else. Menus and event
				quotes may be copied again. By the time the shopping list is written, the cost used
				on the phone may already be stale.
			</p>
		</div>

		<ul role="list" class="mt-10 grid gap-8 md:grid-cols-3 md:gap-10">
			{
				moments.map((moment, index) => (
					<li class="border-t border-ticket-rule pt-5" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
						<h3 class="text-h3 font-semibold">{moment.title}</h3>
						<p class="mt-2 text-ink-soft">{moment.body}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
