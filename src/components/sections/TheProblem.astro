---
const moments = [
	{
		title: 'You quote from an old price',
		body: 'The vendor changed the case price, but the copied recipe and event sheet never heard about it.'
	},
	{
		title: 'You rebuild the same order four times',
		body: 'A head-count change means new recipe math, a new shopping list, a new prep plan, and another pack check.'
	},
	{
		title: 'You learn the margin after service',
		body: 'The event looked busy. Only later do the invoices show whether the price you gave away actually worked.'
	}
];
---

<section id="problem" class="border-y border-hairline bg-cream">
	<div class="container-page py-section-tight">
		<div class="max-w-3xl" data-reveal>
			<h2 class="text-h2 font-semibold">The spreadsheet works until the job changes.</h2>
			<p class="mt-5 max-w-[68ch] text-lede text-ink-soft">
				A supplier price moves. The client adds forty guests. A case arrives short. Each
				change creates another place to retype the math, another sheet that can disagree,
				and another chance to find the mistake when the kitchen can least afford it.
			</p>
		</div>

		<ul role="list" class="mt-10 grid gap-8 md:grid-cols-3 md:gap-10">
			{
				moments.map((moment, index) => (
					<li class="border-t border-ticket-rule pt-5" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
						<h3 class="text-h3 font-semibold">{moment.title}</h3>
						<p class="mt-2 text-ink-soft">{moment.body}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
