---
import { featureCount } from '../../lib/features';

// Krug's billboard rule: the home page pitches outcomes and keeps the path
// to booking short. The exhaustive list is reference material and lives at
// /features; this band is the one-sentence bridge that proves depth without
// charging every visitor the scroll cost. The count is computed from
// features.ts so it can never drift from the list it points at.
---

<section
	id="everything"
	class="border-y border-hairline bg-cream"
	aria-labelledby="everything-heading"
>
	<div class="container-page py-section-tight">
		<div class="max-w-3xl" data-reveal>
			<p class="eyebrow">The complete list</p>
			<h2 id="everything-heading" class="mt-4 text-h3 font-semibold">
				CostCook does {featureCount} specific things.
			</h2>
			<p class="mt-4 max-w-[66ch] text-ink-soft">
				Every one is shipped and written from the code, not the roadmap. The whole
				list lives on its own page, grouped so you can scan straight to the parts
				your kitchen cares about.
				<a href="/features" class="btn-quiet">See every feature</a>
			</p>
		</div>
	</div>
</section>
