---
/**
 * FOUR answers, deliberately one per pain in TheProblem and in the same order.
 * The section is one continuous order journey rather than four equivalent
 * cards, so the reader can see what moves forward at each handoff.
 *
 *   old price          -> quote with the food cost in front of you
 *   rebuild four times -> change the count once
 *   retype to buy it   -> send the buying without retyping it   (RC-22, RC-26, RC-27)
 *   margin after       -> bring the real price back
 *
 * The captures are 2x screenshots from the running app
 * (scripts/capture-proof.mjs), shown at half their pixel width and never
 * upscaled. RC-48 records the proof-image rule and provenance.
 *
 * story: docs/stories/homepage-visual-guidance.story.md
 * story: docs/stories/homepage-spreadsheet-pain.story.md
 *
 * THE FOUR "from" LABELS NAME THE SHEET SINCE 2026-09-05 (RC-56). They are the
 * before side of each handoff and they were tool-agnostic, so the mirror to
 * TheProblem was structural but invisible: the reader could not see that the
 * thing being replaced was her spreadsheet. They now pick up the same nouns
 * that section introduces, in the same order. The "to" labels did not move,
 * because nothing new is claimed about the app here.
 *
 * These four must stay one per pain in TheProblem, in this order. The section
 * order on the homepage rests on a measurement that is void without it; the
 * header of src/pages/index.astro has the numbers.
 */
import SectionHandoff from '../SectionHandoff.astro';

// Considered Composite; not used because the visual guide is four stable
// sibling scenes, not a recursive part/whole tree with shared behaviour.
const outcomes = [
	{
		stage: 'Quote',
		title: 'Quote with the food cost in front of you',
		body: 'Pick the menu, enter guests and price per head, and see the job against your food-cost target before you say yes.',
		from: 'A price the copy never got',
		to: 'Cost checked before the quote',
		iconPaths: ['M4 5h10l6 6-9 9-7-7z', 'M8.5 9h.01'],
		proof: {
			src: '/proof/outcome-quote.png',
			width: 512,
			height: 316,
			alt: 'Food-cost target panel: 39.6 percent food cost, marked critical, 9.6 percentage points over target. Food only: packaging, rentals, staff and anything you cook over the guarantee are outside this number.'
		}
	},
	{
		stage: 'Plan',
		title: 'Change the count once',
		// The phone sentence sits HERE and not on Buy, on purpose (2026-09-10).
		// A reader asked where the page says any of this works on a phone. Shop,
		// Prep and Pack do (the two crops beside Plan and Buy are phone captures,
		// and RC-54 covers a loaded page staying readable with no signal).
		// Receiving at the dock is the claim she actually wanted and it is NOT
		// made: the app's receiving table clips its right-hand columns at 390px
		// (src/lib/workflow.ts). Fix it in the app, then say it here.
		body: 'Recipes scale, shared ingredients roll together, whole packs recalculate, and Shop, Prep and Pack stay on one plan. All three work on a phone, and one you opened earlier stays readable in a walk-in with no signal.',
		from: 'One number, four tabs',
		to: 'One guest count carried through',
		iconPaths: ['M6 4h12v16H6z', 'M9 9h6M9 13h6M9 17h4', 'M9 4V2h6v2'],
		proof: {
			src: '/proof/outcome-prep.png',
			width: 696,
			height: 572,
			alt: 'Prep list for Braised Short Rib at 360 portions, with a Complete all checkbox. Beef short rib, boneless: 75.6 kilograms, no additional prep. Mirepoix Base: 21.6 kilograms, no additional prep.'
		}
	},
	{
		stage: 'Buy',
		title: 'Send the buying without retyping it',
		body: 'The shopping list groups by supplier, and receiving records what actually arrived: short, over, substituted, or missing.',
		from: 'Rows retyped into emails',
		to: 'Whole packs grouped by supplier',
		iconPaths: ['M3 6h11v10H3z', 'M14 9h4l3 3v4h-7z', 'M7 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM17 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4z'],
		proof: {
			src: '/proof/outcome-po.png',
			width: 696,
			height: 984,
			alt: 'The shop list group for one supplier, Baldor, estimated at $690.82. Arugula: need 5.4 kilograms, buy 4 by 3 pound clamshell, $82.32, with an on-hand counter at 0 kilograms and a View buy calculation control. Baby spinach: need 19.8 kilograms, buy 15 by 3 pound clamshell, $410.40, on hand 0.'
		}
	},
	{
		stage: 'Cost again',
		title: 'Bring the real price back to the next quote',
		body: 'Record what you paid. Approved prices update future costing; the confirmed quote keeps its price.',
		from: 'An invoice in a folder, not the sheet',
		to: 'The paid price in future costing',
		iconPaths: ['M20 11a8 8 0 1 1-2.34-5.66', 'M20 4v7h-7', 'M12 8v4l3 2'],
		proof: {
			src: '/proof/outcome-price.png',
			width: 716,
			height: 680,
			alt: 'Live cost panel for baby spinach. Recipes use the usable cost after this ingredient is saved. Pack price $27.36, pack contains 3 pounds, purchased cost $20.11 a kilogram, trim yield 100 percent, usable cost $20.11 a kilogram.'
		}
	}
];
---

<!-- story: docs/stories/homepage-caterer-fixes.story.md -->
<section id="outcomes" class="outcomes-guide bg-softgreen" aria-labelledby="outcomes-heading" data-outcomes-guide>
	<div class="container-page py-section-tight">
		<header class="outcomes-heading" data-reveal>
			<div>
				<h2 id="outcomes-heading" class="text-h2 font-semibold">
					One event. One connected plan.
				</h2>
				<p class="mt-5 max-w-[66ch] text-lede text-ink-soft">
					Price it, scale it, buy it, then bring the paid price back. Each step picks up
					where the last one finished, so there is no second copy of the numbers to keep
					in agreement with the first.
				</p>
			</div>

			<div class="route-key" aria-label="The order moves from quote to plan to buying and back to costing">
				{outcomes.map((outcome, index) => (
					<>
						<span>{outcome.stage}</span>
						{index < outcomes.length - 1 && (
							<svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
								<path d="M3 9h11M10 5l4 4-4 4" />
							</svg>
						)}
					</>
				))}
			</div>
		</header>

		<ol role="list" class="outcomes-route">
			{
				outcomes.map((outcome, index) => (
					<li class="outcome-step" data-outcome-stage={outcome.stage.toLowerCase().replace(' ', '-')} data-reveal style={`--reveal-delay: ${index * 70}ms`}>
						<div class="route-node" aria-hidden="true">
							<span>{String(index + 1).padStart(2, '0')}</span>
						</div>

						<div class="outcome-copy">
							<div class="stage-label">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
									{outcome.iconPaths.map((path) => <path d={path} />)}
								</svg>
								<span>{outcome.stage}</span>
							</div>
							<h3 class="mt-4 text-h3 font-semibold">{outcome.title}</h3>
							<p class="mt-3 max-w-[52ch] text-ink-soft">{outcome.body}</p>

                            <p class="handoff" data-outcome-handoff aria-label={`${outcome.from} becomes ${outcome.to}`}><span>{outcome.from} → <strong>{outcome.to}</strong></span></p>
						</div>

						<figure class="proof-sheet">
							<figcaption>{outcome.stage} · sample kitchen record</figcaption>
							<div>
                                <a href={outcome.proof.src} target="_blank" rel="noopener noreferrer" aria-label={`Open full-size ${outcome.stage.toLowerCase()} screenshot in a new tab`}>
								<img
									src={outcome.proof.src}
									alt={outcome.proof.alt}
									width={outcome.proof.width}
									height={outcome.proof.height}
									loading="lazy"
									decoding="async"
									style={`width: ${outcome.proof.width / 2}px`}
								/>
                                <span class="block py-3 text-sm font-semibold text-green-deep underline">Open full-size (new tab)</span></a>
							</div>
						</figure>
					</li>
				))
			}
		</ol>

		<div class="loop-close" data-reveal>
			<svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
				<path d="M23 13a9 9 0 1 1-2.64-6.36" />
				<path d="M23 4v9h-9" />
			</svg>
			<div>
				<strong>The next quote starts with what you paid.</strong>
				<p>The loop closes without changing the price on the event you already confirmed.</p>
			</div>
		</div>

		<p class="mt-10 text-sm text-ink-soft" data-reveal>
			Need to check a specific feature? <a href="/features" class="btn-quiet">See everything it does, area by area</a>.
		</p>

		<SectionHandoff from="outcomes" />
	</div>
</section>

<style>
	.outcomes-guide { overflow: clip; }
	.outcomes-heading { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 28rem), 1fr)); gap: 2rem clamp(2.5rem, 7vw, 6rem); align-items: end; }
	.route-key { display: flex; flex-wrap: wrap; gap: .55rem; align-items: center; padding-block: 1rem; border-block: 1px solid var(--color-hairline-strong); color: var(--color-green-deep); font-size: var(--text-label-sm); font-weight: 700; letter-spacing: .05em; text-transform: uppercase; }
	.route-key svg, .stage-label svg, .handoff svg, .loop-close > svg { flex: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
	.route-key svg { color: var(--color-amber-deep); }
	.outcomes-route { margin-top: 2rem; }
	.outcome-step { position: relative; display: grid; grid-template-columns: 3.5rem minmax(0, 5fr) minmax(0, 7fr); gap: clamp(1.5rem, 4vw, 4rem); align-items: center; padding-bottom: 2rem; }
	.outcome-step::before { position: absolute; top: 2.5rem; bottom: 0; left: 1.72rem; width: 1px; background: var(--color-ticket-rule); content: ''; }
	.outcome-step:last-child { padding-bottom: 0; }
	.outcome-step:last-child::before { display: none; }
	.route-node { position: relative; z-index: 1; align-self: start; display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border: 1px solid var(--color-amber-deep); border-radius: 999px; background: var(--color-softgreen); color: var(--color-amber-deep); font-family: var(--font-body); font-size: var(--text-label-sm); font-weight: 700; font-variant-numeric: tabular-nums; }
	.outcome-copy { min-width: 0; }
	.stage-label { display: inline-flex; gap: .65rem; align-items: center; color: var(--color-green-deep); font-size: var(--text-label-sm); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
	.handoff { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: .75rem; align-items: center; margin-top: 1.5rem; padding-block: 1rem; border-block: 1px solid var(--color-hairline-strong); }
	.handoff > div { min-width: 0; }
	.handoff small, .handoff strong { display: block; }
	.handoff small { color: var(--color-ink-soft); font-size: var(--text-micro); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
	.handoff strong { margin-top: .25rem; font-size: var(--text-body-sm); line-height: 1.35; }
	.handoff svg { color: var(--color-amber-deep); }
	.handoff-result { color: var(--color-green-deep); }
	.proof-sheet { min-width: 0; border-block: 1px solid var(--color-ticket-rule); background: var(--color-paper); box-shadow: var(--shadow-ticket); }
	.proof-sheet figcaption { padding: .75rem 1rem; border-bottom: 1px solid var(--color-hairline); color: var(--color-amber-deep); font-size: var(--text-micro); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
	.proof-sheet > div { display: flex; min-height: 13rem; align-items: flex-start; justify-content: center; padding: clamp(1rem, 3vw, 1.75rem); }
	.proof-sheet img { height: auto; max-width: 100%; }
	.loop-close { display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: 1rem; max-width: 42rem; margin-top: clamp(3rem, 7vw, 5rem); margin-left: clamp(0rem, 8vw, 7.5rem); padding: 1.25rem 1.5rem; background: var(--color-green-deep); color: var(--color-paper); }
	.loop-close > svg { color: var(--color-amber-light); }
	.loop-close strong, .loop-close p { display: block; }
	.loop-close p { margin-top: .3rem; color: color-mix(in srgb, var(--color-paper) 82%, var(--color-green-deep)); font-size: var(--text-body-sm); line-height: 1.5; }

	@media (max-width: 63.99rem) {
		.outcome-step { grid-template-columns: 3rem minmax(0, 1fr); gap: 1.25rem; }
		.outcome-step::before { left: 1.47rem; }
		.route-node { width: 3rem; height: 3rem; }
		.proof-sheet { grid-column: 2; }
	}

	@media (max-width: 35rem) {
		.route-key { display: grid; grid-template-columns: minmax(0, 1fr) 1.25rem minmax(0, 1fr); }
		.route-key svg:nth-of-type(2) { display: none; }
		.outcome-step { grid-template-columns: 2.5rem minmax(0, 1fr); gap: 1rem; }
		.outcome-step::before { left: 1.22rem; }
		.route-node { width: 2.5rem; height: 2.5rem; font-size: var(--text-micro); }
		.handoff { grid-template-columns: minmax(0, 1fr); gap: .75rem; }
		.handoff svg { transform: rotate(90deg); }
		.proof-sheet > div { min-height: 0; padding: .75rem; }
		.loop-close { margin-left: 0; padding: 1.1rem; }
	}

    .handoff { display:block; margin-top: .75rem; padding-block:.75rem; font-size:var(--text-body-sm); }
    @media(max-width:63.99rem) { .outcome-step { grid-template-columns: minmax(0,1fr); gap:1rem; } .route-node,.outcome-step::before { display:none; } .proof-sheet { grid-column:1; } .proof-sheet > div { padding: .75rem; } }
</style>
