---
/**
 * FOUR answers, deliberately one per pain in TheProblem and in the same order.
 * The pairing is load-bearing: src/pages/index.astro records that promoting
 * SeeItRun above this section was justified partly BECAUSE the pairing was
 * never co-visible on a phone anyway, and it names the 1:1 mapping as the
 * condition that keeps that trade valid. If you add a pain there, add its
 * answer here, or go and re-measure.
 *
 *   old price          -> quote with the food cost in front of you
 *   rebuild four times -> change the count once
 *   retype to buy it   -> send the buying without retyping it   (RC-22, RC-26, RC-27)
 *   margin after       -> bring the real price back
 *
 * IMAGES, SINCE 2026-08-29. The 2026-08-26 note declined a crop here because
 * no single screen asserts what the section asserts and a four-up strip had
 * already failed at 390. Both halves of that are honoured differently now:
 * there is not one crop, there are FOUR, one per card, each arguing only that
 * card's quarter, and the grid is 2x2 rather than a strip. Every crop is a
 * frame of public/demo.mp4, the footage RC-33 already vouches for, cut at the
 * timestamp printed under it, so a reader who wants the moving version knows
 * where to scrub to. RC-48 records the frame rule: a homepage crop is a frame
 * of the shipped footage or a capture from the same demo world, never a
 * mockup, and its alt text reads off the pixels.
 *
 * The crops are 2x captures from the running app (scripts/capture-proof.mjs),
 * shown at half their pixel width, never upscaled. The two lists (prep, the
 * vendor group) are taken from the phone layout on purpose: the card is half
 * the page wide and a 1080px table shrunk into it is blur with numbers in it.
 *
 * story: docs/stories/homepage-visual-guidance.story.md
 */
import SectionHandoff from '../SectionHandoff.astro';

// Considered Decorator; not used because evidence labels are static content,
// not responsibilities added to proof objects at runtime.

const outcomes = [
	{
		title: 'Quote with the food cost in front of you',
		body: 'Pick the menu, enter guests and price per head, and see the job against your food-cost target before you say yes.',
		proof: {
			src: '/proof/outcome-quote.png',
			width: 512,
			height: 316,
			alt: 'Food-cost target panel: 39.7 percent food cost, marked critical, 9.7 percentage points over target. Food only: packaging, rentals, staff and anything you cook over the guarantee are outside this number.'
		}
	},
	{
		title: 'Change the count once',
		body: 'Recipes scale, shared ingredients roll together, whole packs recalculate, and Shop, Prep and Pack stay on one plan.',
		proof: {
			src: '/proof/outcome-prep.png',
			width: 696,
			height: 572,
			alt: 'Prep list for Braised Short Rib at 360 portions, with a Complete all checkbox. Beef short rib, boneless: 75.6 kilograms, no additional prep. Mirepoix Base: 21.6 kilograms, no additional prep.'
		}
	},
	{
		title: 'Send the buying without retyping it',
		body: 'The shopping list groups by supplier, and receiving records what actually arrived: short, over, substituted, or missing.',
		proof: {
			src: '/proof/outcome-po.png',
			width: 696,
			height: 984,
			alt: 'The shop list group for one supplier, Baldor, estimated at $690.82. Arugula: need 5.4 kilograms, buy 4 by 3 pound clamshell, $82.32, with an on-hand counter at 0 kilograms and a View buy calculation control. Baby spinach: need 19.8 kilograms, buy 15 by 3 pound clamshell, $410.40, on hand 0.'
		}
	},
	{
		title: 'Bring the real price back to the next quote',
		body: 'Record what you paid. Approved prices update future costing; the confirmed event stays frozen.',
		proof: {
			src: '/proof/outcome-price.png',
			width: 716,
			height: 680,
			alt: 'Live cost panel for baby spinach. Recipes use the usable cost after this ingredient is saved. Pack price $27.36, pack contains 3 pounds, purchased cost $20.11 a kilogram, trim yield 100 percent, usable cost $20.11 a kilogram.'
		}
	}
];
---

<section id="outcomes" class="bg-softgreen" aria-labelledby="outcomes-heading">
	<div class="container-page py-section">
		<div class="max-w-3xl" data-reveal>
			<!-- "What it does instead" is not a generic kicker. The four cards below
			     answer TheProblem's four pains one for one, and index.astro records
			     that pairing as the condition keeping the section order valid. At
			     390 the two sections sit 3,085px apart, so nothing on screen said
			     they were a pair. The eyebrow says it in three words. -->
			<p class="eyebrow">What it does instead</p>
			<h2 id="outcomes-heading" class="mt-4 text-h2 font-semibold">
				One order becomes the plan the whole kitchen can run.
			</h2>
			<p class="mt-5 max-w-[64ch] text-lede text-ink-soft">
				One order carries the work from the first price to the final delivery.
			</p>
		</div>

		<ol role="list" class="mt-12 grid gap-x-10 gap-y-12 sm:grid-cols-2">
			{
				outcomes.map((outcome, index) => (
					<li
						class="border-t border-hairline-strong pt-6"
						data-reveal
						style={`--reveal-delay: ${index * 70}ms`}
					>
						<p class="font-mono text-sm font-semibold tabular-nums text-amber-deep">
							{String(index + 1).padStart(2, '0')}
						</p>
						{/* The paper box grows to the crop; the crop is shown at half its 2x
						    pixel width and never cut. */}
						<div class="mt-4 flex items-start justify-center border border-hairline bg-paper p-4 shadow-ticket">
							<img
								src={outcome.proof.src}
								alt={outcome.proof.alt}
								width={outcome.proof.width}
								height={outcome.proof.height}
								loading="lazy"
								decoding="async"
								style={`width: ${outcome.proof.width / 2}px`}
								class="h-auto max-w-full"
							/>
						</div>
						<h3 class="mt-5 text-h3 font-semibold">{outcome.title}</h3>
						<p class="mt-3 text-ink-soft">{outcome.body}</p>
					</li>
				))
			}
		</ol>

		<p class="mt-10 text-sm text-ink-soft" data-reveal>
			Need the implementation detail? <a href="/features" class="btn-quiet">See everything it does, area by area</a>.
		</p>

		<SectionHandoff from="outcomes" />
	</div>
</section>
