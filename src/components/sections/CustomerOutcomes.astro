---
/**
 * FOUR answers, deliberately one per pain in TheProblem and in the same order.
 * The pairing is load-bearing: src/pages/index.astro records that promoting
 * SeeItRun above this section was justified partly BECAUSE the pairing was
 * never co-visible on a phone anyway, and it names the 1:1 mapping as the
 * condition that keeps that trade valid. If you add a pain there, add its
 * answer here, or go and re-measure.
 *
 *   old price          -> quote with the food cost in front of you
 *   rebuild four times -> change the count once
 *   retype to buy it   -> send the buying without retyping it   (RC-22, RC-26, RC-27)
 *   margin after       -> bring the real price back
 */
const outcomes = [
	{
		title: 'Quote with the food cost in front of you',
		body: 'Choose the menu, enter the guests and price per person, and see the event against your food-cost target before you say yes.'
	},
	{
		title: 'Change the count once',
		body: 'Recipes scale, shared ingredients roll together, whole packs recalculate, and the Shop, Prep, and Pack lists stay on the same plan.'
	},
	{
		title: 'Send the buying without retyping it',
		body: 'The shopping list groups by supplier, and receiving records what actually arrived: short, over, substituted, or missing.'
	},
	{
		title: 'Bring the real price back to the next quote',
		body: 'Record what you paid. Approved prices update future costing while the confirmed event remains frozen.'
	}
];
---

<section id="outcomes" class="bg-softgreen" aria-labelledby="outcomes-heading">
	<div class="container-page py-section">
		<div class="max-w-3xl" data-reveal>
			<h2 id="outcomes-heading" class="text-h2 font-semibold">
				One order becomes the plan the whole kitchen can run.
			</h2>
			<p class="mt-5 max-w-[64ch] text-lede text-ink-soft">
				CostCook connects the owner&rsquo;s quote to the quantities the kitchen buys, cooks,
				and packs. The same order carries the work from the first price to the final delivery.
			</p>
		</div>

		<ol role="list" class="mt-12 grid gap-x-12 sm:grid-cols-2 lg:grid-cols-4">
			{
				outcomes.map((outcome, index) => (
					<li
						class="border-t border-hairline-strong py-6"
						data-reveal
						style={`--reveal-delay: ${index * 70}ms`}
					>
						<p class="font-mono text-sm font-semibold tabular-nums text-amber-deep">
							{String(index + 1).padStart(2, '0')}
						</p>
						<h3 class="mt-3 text-h3 font-semibold">{outcome.title}</h3>
						<p class="mt-3 text-ink-soft">{outcome.body}</p>
					</li>
				))
			}
		</ol>

		<p class="mt-8 text-sm text-ink-soft" data-reveal>
			Need the implementation detail? <a href="/features" class="btn-quiet">See every shipped feature</a>.
		</p>
	</div>
</section>
