---
import { featureGroups } from '../../lib/features';
import { cta, demoCta, launchPlan } from '../../lib/site';

const purchasingGroup = featureGroups.find((group) => group.id === 'purchasing');
if (!purchasingGroup) throw new Error('Missing public feature group: purchasing');

const deliveryLines = [
	{ item: 'Chicken thigh · 10 kg case', ordered: '10', received: '9', orderedPrice: '$45.00', receivedPrice: '$47.00', state: 'Short 1', tone: 'short' },
	{ item: 'Baby spinach · 2 kg case', ordered: '4', received: '4', orderedPrice: '$18.00', receivedPrice: '$18.00', state: 'Received', tone: 'received' },
	{ item: 'Olive oil · 5 L tin', ordered: '2', received: '2', orderedPrice: '$72.00', receivedPrice: '$75.00', state: 'Substituted', tone: 'review' }
] as const;

const recoveryStates = [
	{ label: 'Send failed', action: 'Retry the same PO', note: 'The failure stays on the record.' },
	{ label: 'Short or missing', action: 'Keep it on the rebuy list', note: 'Mark handled or reopen it later.' },
	{ label: 'Unexpected line', action: 'Review before posting', note: 'Do not turn an unplanned item into a silent purchase.' }
] as const;

// Considered Strategy; not used because these FAQ and evidence rows are static
// editorial data, not interchangeable behavior selected at runtime.
const faqItems = [
	{
		question: 'Does CostCook send one purchase order to every supplier?',
		answer: 'CostCook offers a separate purchase order per supplier. You can review the exact email body, then email it, print it, or mark it as handled by you.'
	},
	{
		question: 'What happens if the supplier email fails?',
		answer: 'The purchase order is recorded as queued before CostCook attempts the email. If the send fails, that same record keeps the failure and remains safe to retry.'
	},
	{
		question: 'Do I have to type the delivery again?',
		answer: 'No. A sent purchase order creates its receiving checklist, so the lines at the back door begin with the order the supplier received.'
	},
	{
		question: 'How are shortages and substitutions handled?',
		answer: 'Short, over, substituted, missing, and unexpected lines keep distinct receiving states. Short and missing quantities become a durable follow-up list.'
	},
	{
		question: 'When do ingredient prices change?',
		answer: 'Committing the delivery posts the real purchases and updates current prices from what actually arrived. The posting is all-or-nothing.'
	}
] as const;
---

<!-- story: docs/stories/purchasing-and-receiving.story.md -->
<article class="purchasing-page">
	<section class="hero" aria-labelledby="purchasing-heading">
		<div class="container-page hero-grid">
			<div class="hero-copy">
				<nav aria-label="Breadcrumb" class="breadcrumb"><a href="/features">Every feature</a><span aria-hidden="true">/</span><span>Purchasing & receiving</span></nav>
				<h1 id="purchasing-heading">The order you sent should meet the delivery at the back door.</h1>
				<p class="hero-lede">Review one purchase order per supplier, receive against the same lines, and post the quantity and price that actually arrived.</p>
				<div class="hero-actions">
					<a href={cta.href} target={cta.target} rel={cta.rel} aria-label={cta.ariaLabel} class="btn-primary">{cta.label}</a>
					<a href={demoCta.href} target={demoCta.target} rel={demoCta.rel} aria-label={demoCta.ariaLabel} class="btn-outline">{demoCta.label}</a>
				</div>
				<p class="hero-terms">{launchPlan.trialDays} days free, then {launchPlan.displayPrice}. Charged $0 today.</p>
			</div>

			<figure class="handoff-ticket purchasing-enter">
				<p class="figure-note">Illustrative purchase record</p>
				<div class="ticket-top"><span>PO-1048 · Northline Foods</span><span class="status sent">PO sent</span></div>
				<div class="handoff-flow" aria-label="10 cases ordered, 9 cases received, 1 case left to rebuy">
					<div><small>Ordered</small><strong>10</strong><span>cases</span></div>
					<svg width="34" height="16" viewBox="0 0 34 16" aria-hidden="true"><path d="M1 8h29M24 2l6 6-6 6" /></svg>
					<div><small>Received</small><strong>9</strong><span>cases</span></div>
					<svg width="34" height="16" viewBox="0 0 34 16" aria-hidden="true"><path d="M1 8h29M24 2l6 6-6 6" /></svg>
					<div class="result"><small>Follow up</small><strong>1</strong><span>case</span></div>
				</div>
				<div class="ticket-line"><span>Chicken thigh · 10 kg case</span><b class="status short">Received · short 1</b></div>
				<figcaption>Illustrative values. The sent quantity, received quantity, and open shortfall stay together.</figcaption>
			</figure>
		</div>
	</section>

	<section class="problem" aria-labelledby="problem-heading">
		<div class="container-page problem-grid">
			<div><h2 id="problem-heading">Ten cases ordered. Nine at the back door is not ten in the walk-in.</h2><p>A tidy purchase order describes the promise. Receiving records the delivery as it is: short, over, substituted, missing, or unexpected.</p></div>
			<div class="door-scene" role="img" aria-label="An illustrative supplier order and receiving slip disagree by one case">
				<div><small>Supplier order</small><strong>10 cases</strong><span>Sent 27 Aug · 3:42 PM</span></div>
				<div class="door-mark" aria-hidden="true">≠</div>
				<div><small>Delivery slip</small><strong>9 cases</strong><span>Received 28 Aug · 6:18 AM</span></div>
			</div>
		</div>
	</section>

	<nav class="story-nav container-page" aria-label="On this page">
		<a href="#send-the-order"><span>Send what you reviewed</span><small>One stable PO per supplier, with the exact message visible.</small><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5" /></svg></a>
		<a href="#receive-the-delivery"><span>Post what arrived</span><small>Receive from the same lines and keep every variance actionable.</small><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5" /></svg></a>
	</nav>

	<section id="send-the-order" class="product-section send-section" aria-labelledby="send-heading">
		<div class="container-page">
			<div class="section-intro"><h2 id="send-heading">Start with the promise the supplier actually received.</h2><p>Confirming an event offers a purchase order for each supplier. Review the exact email, print a stable PO, or record that you handled it yourself.</p></div>
			<figure class="po-sheet">
				<div class="po-main">
					<div class="panel-bar"><span>Purchase order PO-1048</span><span>Review before sending</span></div>
					<div class="supplier"><div><small>Supplier</small><strong>Northline Foods</strong></div><div><small>Delivery</small><strong>28 Aug · before 7 AM</strong></div></div>
					<div class="email-copy"><small>Email body</small><p>Please deliver the lines below to CostCook Catering. PO-1048 must appear on the delivery slip.</p></div>
					<div class="po-row"><span>Chicken thigh · 10 kg case</span><b>10 cases</b></div>
					<div class="po-row"><span>Baby spinach · 2 kg case</span><b>4 cases</b></div>
				</div>
				<div class="po-actions"><span>Available handoffs</span><ul role="list"><li>Email supplier</li><li>Print PO</li><li>Handled by me</li></ul></div>
				<figcaption>Illustrative purchase order. The record starts queued before email is attempted; a failed send stays on the record and remains retryable.</figcaption>
			</figure>
		</div>
	</section>

	<section id="receive-the-delivery" class="product-section receive-section" aria-labelledby="receive-heading">
		<div class="container-page">
			<div class="section-intro"><h2 id="receive-heading">Once it is sent, those same lines are ready at the door.</h2><p>A sent purchase order creates the receiving checklist. Change ordered to arrived without building a second record from the delivery slip.</p></div>
			<figure class="receiving-board">
				<div class="receiving-head"><span>Receive PO-1048 · Northline Foods</span><span>Illustrative delivery</span></div>
				<div class="line-head"><span>Ingredient</span><span>Ordered</span><span>Arrived</span><span>Price / case</span><span>State</span></div>
				{deliveryLines.map((line) => <div class="receiving-line"><strong>{line.item}</strong><span class="quantity"><small>Ordered</small>{line.ordered}</span><span class="quantity"><small>Arrived</small>{line.received}</span><span class="price"><small>Price / case</small><span class="price-values" aria-hidden="true"><s>{line.orderedPrice}</s><b>→</b>{line.receivedPrice}</span><span class="sr-only">{line.orderedPrice} ordered, {line.receivedPrice} received per case</span></span><em class:list={['status', line.tone]}>{line.state}</em></div>)}
				<div class="post-bar"><span><strong>Ready to post</strong><small>3 lines · 1 follow-up</small></span><b>Post received delivery</b></div>
				<figcaption>Illustrative receiving checklist. The arrow runs from the ordered case price to the received case price; posting carries the received value forward.</figcaption>
			</figure>
		</div>
	</section>

	<section class="posting-proof" aria-labelledby="posting-heading">
		<div class="container-page posting-grid">
			<div><h2 id="posting-heading">The actual delivery becomes the buying fact.</h2><p>Commit once. Purchases and current ingredient prices update from received quantities and prices, all-or-nothing. Anything still open keeps its next action.</p></div>
			<div class="posting-record"><span>After posting · illustrative</span><div><small>Purchase recorded</small><strong>9 cases · $423.00</strong></div><div><small>Current pack price</small><strong>$47.00 / case</strong></div><div><small>Rebuy list</small><strong>1 case open</strong></div></div>
		</div>
	</section>

	<section class="recovery" aria-labelledby="recovery-heading">
		<div class="container-page recovery-grid">
			<div><h2 id="recovery-heading">A problem at the handoff keeps a recovery path.</h2><p>Send failures, short lines, and unexpected items do not collapse into one warning. Each one says what happened and what you can do next.</p></div>
			<div class="recovery-list">{recoveryStates.map((state) => <div><span class="status review">{state.label}</span><strong>{state.action}</strong><small>{state.note}</small></div>)}</div>
		</div>
	</section>

	<section class="capabilities" aria-labelledby="capabilities-heading">
		<div class="container-page capabilities-grid">
			<div><h2 id="capabilities-heading">The complete Purchasing & receiving list.</h2><p>Open the full shipped list when you want the details.</p><p class="count"><strong>{purchasingGroup.items.length}</strong><span>shipped capabilities</span></p></div>
			<details id="features-purchasing"><summary><span>See all {purchasingGroup.items.length} shipped capabilities</span><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 7l6 6 6-6" /></svg></summary><ul role="list">{purchasingGroup.items.map((item) => <li><strong>{item.lead}</strong> <span>{item.detail}</span></li>)}</ul></details>
		</div>
	</section>

	<section class="faq" aria-labelledby="faq-heading">
		<div class="container-page faq-grid"><div><h2 id="faq-heading">Frequently asked questions</h2><p>The practical questions behind moving a supplier order through the back door without losing the differences.</p></div><div class="faq-list">{faqItems.map((item) => <details><summary><span>{item.question}</span><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 7l6 6 6-6" /></svg></summary><p>{item.answer}</p></details>)}</div></div>
	</section>

	<section class="closing" aria-labelledby="closing-heading">
		<div class="container-page closing-grid"><div><h2 id="closing-heading">Walk back into prep with one record.</h2><p>Bring one real supplier order. Follow it from the message you send to the quantity, price, and shortfall you receive.</p></div><div class="closing-actions"><a href={demoCta.href} target={demoCta.target} rel={demoCta.rel} aria-label={demoCta.ariaLabel} class="btn-primary">{demoCta.label}</a><a href={cta.href} target={cta.target} rel={cta.rel} aria-label={cta.ariaLabel} class="btn-quiet">{cta.label}</a></div></div>
		<div class="container-page onward"><a href="/features">See every CostCook feature</a></div>
	</section>
</article>

<style>
	.purchasing-page { overflow-wrap: anywhere; }
	.hero { border-block: 1px solid var(--color-hairline); background: var(--color-cream); }
	.hero-grid { display: grid; gap: clamp(2rem, 5vw, 5rem); align-items: center; padding-block: clamp(2.5rem, 4vw, 4.75rem); }
	.hero-copy, .problem-grid > *, .section-intro > *, .posting-grid > *, .recovery-grid > *, .capabilities-grid > *, .faq-grid > *, .closing-grid > * { min-width: 0; }
	.breadcrumb { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; font-size: var(--text-eyebrow); line-height: var(--text-eyebrow--line-height); color: var(--color-ink-soft); }
	.breadcrumb a, .onward a { display: inline-flex; min-height: 44px; align-items: center; color: var(--color-green-deep); font-weight: 600; text-decoration: underline; text-decoration-color: var(--color-hairline); text-underline-offset: 4px; }
	.hero h1 { max-width: 16ch; margin-top: 1.15rem; font-size: var(--text-display); font-weight: 600; line-height: var(--text-display--line-height); letter-spacing: var(--text-display--letter-spacing); }
	.hero-lede { max-width: 56ch; margin-top: 1.35rem; font-size: var(--text-lede); line-height: 1.55; color: var(--color-ink-soft); }
	.hero-actions, .closing-actions { display: flex; flex-wrap: wrap; gap: .85rem; margin-top: 2rem; }
	.hero-terms { margin-top: .8rem; font-size: var(--text-eyebrow); line-height: 1.5; color: var(--color-ink-soft); }
	.btn-outline { display: inline-flex; min-height: 44px; align-items: center; padding: .9rem 1.6rem; border: 1px solid var(--color-green); border-radius: 999px; color: var(--color-green-deep); font-weight: 600; transition: background-color 150ms ease-out; }
	.btn-outline:hover { background: var(--color-softgreen); }
	.figure-note { margin-bottom: .7rem; font-size: var(--text-eyebrow); line-height: var(--text-eyebrow--line-height); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--color-amber-deep); }
	.handoff-ticket { min-width: 0; padding: clamp(1.2rem, 3vw, 1.8rem); background: var(--color-paper); box-shadow: var(--shadow-ticket); }
	.ticket-top, .panel-bar, .receiving-head, .line-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem 1rem; font-size: var(--text-eyebrow); line-height: var(--text-eyebrow--line-height); font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: var(--color-ink-soft); }
	.status { display: inline-flex; width: fit-content; max-width: 100%; align-items: center; min-height: 24px; padding: .2rem .55rem; border-radius: 999px; font-family: var(--font-body); font-size: var(--text-eyebrow); line-height: var(--text-eyebrow--line-height); font-weight: 700; font-style: normal; letter-spacing: .04em; text-align: center; text-transform: uppercase; white-space: normal; }
	.status.sent, .status.received { background: var(--color-softgreen); color: var(--color-green-deep); }
	.status.short, .status.review { background: var(--color-softamber); color: var(--color-amber-deep); }
	.handoff-flow { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; gap: .7rem; align-items: center; margin-top: 1.2rem; }
	.handoff-flow div { padding: .85rem; background: var(--color-cream); }
	.handoff-flow .result { background: var(--color-softamber); }
	.handoff-flow small, .supplier small, .email-copy small, .posting-record small, .receiving-line small { display: block; color: var(--color-ink-soft); font-size: var(--text-eyebrow); line-height: var(--text-eyebrow--line-height); }
	.handoff-flow strong { display: block; font-size: var(--text-h3); font-variant-numeric: tabular-nums; }
	.handoff-flow span { color: var(--color-ink-soft); font-size: var(--text-eyebrow); }
	.handoff-flow svg, .story-nav svg, summary svg { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; color: var(--color-amber-deep); }
	.ticket-line { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem 1rem; align-items: center; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--color-ticket-rule); }
	.handoff-ticket figcaption, .po-sheet figcaption, .receiving-board figcaption { margin-top: .85rem; font-size: var(--text-eyebrow); line-height: 1.45; color: var(--color-ink-soft); }
	.problem { border-bottom: 1px solid var(--color-hairline); background: var(--color-paper); }
	.problem-grid, .posting-grid, .recovery-grid { display: grid; gap: 3rem; align-items: center; padding-block: var(--spacing-section-tight); }
	.problem h2, .section-intro h2, .posting-grid h2, .recovery-grid h2, .capabilities h2, .faq h2, .closing h2 { font-size: var(--text-h2); font-weight: 600; line-height: 1.12; }
	.problem p, .section-intro p, .posting-grid > div > p, .recovery-grid > div > p, .capabilities-grid > div > p, .faq-grid > div > p, .closing p { max-width: 60ch; margin-top: 1.1rem; color: var(--color-ink-soft); line-height: 1.65; }
	.door-scene { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: center; }
	.door-scene > div:not(.door-mark) { padding: 1.35rem; border-top: 2px solid var(--color-ticket-rule); background: var(--color-cream); }
	.door-scene small, .door-scene span { display: block; color: var(--color-ink-soft); }
	.door-scene strong { display: block; margin-block: .4rem; font-size: var(--text-h3); font-variant-numeric: tabular-nums; }
	.door-mark { color: var(--color-amber-deep); font-family: var(--font-display); font-size: var(--text-h3); }
	.story-nav { display: grid; padding-block: 1.25rem; }
	.story-nav a { display: grid; min-height: 84px; grid-template-columns: 1fr auto; gap: .25rem 1rem; align-content: center; padding: 1.2rem 0; border-bottom: 1px solid var(--color-ticket-rule); color: var(--color-ink); }
	.story-nav a:first-child { border-top: 1px solid var(--color-ticket-rule); }
	.story-nav span { font-weight: 700; }
	.story-nav small { max-width: 48ch; color: var(--color-ink-soft); }
	.story-nav svg { grid-column: 2; grid-row: 1 / 3; color: var(--color-green-deep); }
	.product-section { scroll-margin-top: 1rem; padding-block: var(--spacing-section); }
	.send-section { background: var(--color-softgreen); }
	.receive-section { background: var(--color-cream); }
	.section-intro { display: grid; gap: 1.5rem 4rem; align-items: end; }
	.section-intro p { margin-top: 0; }
	.po-sheet { display: grid; gap: 1px; margin-top: clamp(2.5rem, 6vw, 4.5rem); background: var(--color-hairline-strong); box-shadow: var(--shadow-lift); }
	.po-main, .po-actions { background: var(--color-paper); }
	.po-main { padding: clamp(1.2rem, 3vw, 2rem); }
	.panel-bar { padding-bottom: .8rem; border-bottom: 1px solid var(--color-hairline); }
	.supplier { display: grid; gap: 1rem; grid-template-columns: 1fr 1fr; margin-top: 1rem; }
	.supplier strong { display: block; margin-top: .25rem; }
	.email-copy { margin-top: 1.2rem; padding: 1rem; background: var(--color-cream); }
	.email-copy p { margin-top: .35rem; color: var(--color-ink); }
	.po-row { display: flex; justify-content: space-between; gap: 1rem; padding-block: .8rem; border-bottom: 1px solid var(--color-hairline); }
	.po-row b { font-variant-numeric: tabular-nums; }
	.po-actions { display: grid; align-content: start; gap: .8rem; padding: 1.4rem; }
	.po-actions > span { color: var(--color-ink-soft); font-size: var(--text-eyebrow); line-height: var(--text-eyebrow--line-height); font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
	.po-actions li { padding-block: .75rem; border-top: 1px solid var(--color-hairline); font-weight: 600; }
	.po-actions li:last-child { border-bottom: 1px solid var(--color-hairline); }
	.po-sheet figcaption { grid-column: 1 / -1; margin: 0; padding: .85rem 1.2rem; background: var(--color-paper); }
	.receiving-board { margin-top: clamp(2.5rem, 6vw, 4.5rem); background: var(--color-paper); box-shadow: var(--shadow-ticket); }
	.receiving-head { padding: 1rem clamp(1rem, 3vw, 1.75rem); background: var(--color-ink); color: var(--color-paper); }
	.line-head, .receiving-line { display: grid; grid-template-columns: minmax(0, 1.35fr) .45fr .45fr minmax(0, .9fr) minmax(0, .75fr); gap: 1rem; align-items: center; padding: .85rem clamp(1rem, 3vw, 1.75rem); }
	.line-head { color: var(--color-ink-soft); border-bottom: 1px solid var(--color-hairline); }
	.receiving-line { border-bottom: 1px solid var(--color-hairline); }
	.receiving-line > span { min-width: 0; font-variant-numeric: tabular-nums; }
	.receiving-line small { display: none; }
	.receiving-line .price-values { display: flex; flex-wrap: wrap; gap: .3rem; align-items: center; }
	.receiving-line .price s { color: var(--color-ink-soft); }
	.receiving-line .price b { color: var(--color-amber-deep); }
	.post-bar { display: flex; justify-content: space-between; gap: 1rem; align-items: center; padding: 1rem clamp(1rem, 3vw, 1.75rem); border-top: 2px solid var(--color-green); }
	.post-bar span small { display: block; color: var(--color-ink-soft); }
	.post-bar > b { color: var(--color-green-deep); }
	.receiving-board figcaption { padding: 0 clamp(1rem, 3vw, 1.75rem) 1rem; }
	.posting-proof { background: var(--color-ink); color: var(--color-paper); }
	.posting-grid > div > p { color: var(--color-ink-muted); }
	.posting-record { background: var(--color-paper); color: var(--color-ink); box-shadow: var(--shadow-lift); }
	.posting-record > span { display: block; padding: .8rem 1rem; background: var(--color-softgreen); color: var(--color-green-deep); font-size: var(--text-eyebrow); line-height: var(--text-eyebrow--line-height); font-weight: 700; letter-spacing: .05em; text-transform: uppercase; }
	.posting-record > div { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem 1rem; padding: 1rem; border-bottom: 1px solid var(--color-hairline); }
	.posting-record strong { font-variant-numeric: tabular-nums; }
	.recovery { background: var(--color-paper); }
	.recovery-list { border-block: 1px solid var(--color-ticket-rule); }
	.recovery-list > div { display: grid; grid-template-columns: auto 1fr; gap: .45rem 1rem; padding: 1rem 0; border-bottom: 1px solid var(--color-ticket-rule); }
	.recovery-list > div:last-child { border-bottom: 0; }
	.recovery-list strong { align-self: center; }
	.recovery-list small { grid-column: 2; color: var(--color-ink-soft); }
	.capabilities { padding-block: var(--spacing-section); background: var(--color-offwhite); }
	.capabilities-grid, .faq-grid { display: grid; gap: 3rem; }
	.count { display: flex; align-items: baseline; gap: .75rem; }
	.count strong { font-family: var(--font-display); font-size: var(--text-h2); color: var(--color-green-deep); }
	.count span { font-size: var(--text-eyebrow); color: var(--color-ink-soft); }
	details summary { cursor: pointer; list-style: none; }
	details summary::-webkit-details-marker { display: none; }
	.capabilities details { scroll-margin-top: 1rem; border-block: 1px solid var(--color-ticket-rule); }
	.capabilities summary, .faq summary { display: flex; min-height: 64px; align-items: center; justify-content: space-between; gap: 1rem; font-weight: 700; }
	.capabilities details[open] summary, .faq details[open] summary { color: var(--color-green-deep); }
	.capabilities details[open] summary svg, .faq details[open] summary svg { transform: rotate(180deg); }
	.capabilities summary svg, .faq summary svg { flex: 0 0 auto; transition: transform 150ms ease-out; }
	.capabilities details ul { padding-bottom: 1.5rem; }
