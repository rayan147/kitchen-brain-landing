---
import FeatureTrialTerms from "../FeatureTrialTerms.astro";
import { featureSections, featureCount, inDevelopmentFeatureGroups, featureMenuSections, featureMenuHref } from '../../lib/features';
import { spellCapital } from '../../lib/words';
import { cta, demoCta } from '../../lib/site';
import FeatureAreaIcon from '../FeatureAreaIcon.astro';
import { comingDefinition } from '../../lib/availability';

// The /features HUB. Five cards, zero feature items.
//
// REBUILT 2026-08-23, replacing a single page that carried all 145 items under
// a sticky sub-nav. The sub-nav made the wall scrollable; it did not make it
// readable. A reader mid-shift does not scan 145 lines to find out whether
// purchasing is covered, and the previous page asked them to.
//
// The five areas are the /compare row-group titles verbatim, so a caterer who
// reads both reference pages meets the same five words in the same order.
// Each card says what the area is FOR before it says how much is in it: the
// count is reassurance for the diligence reader, not the reason to click.
//
// Nothing is hidden here — the whole set of five is on screen. Depth lives one
// click down, which is where depth belongs on a page a phone loads first.
//
// THE CARDS STAY TERSE. Each area page opens on a `wall` sentence, the moment
// in a kitchen that area is for, and that sentence is deliberately NOT rendered
// here: five cards each carrying a blurb, a count and a second sentence is the
// wall this hub was built to replace. The asymmetry is the decision. See the
// doc comment on SECTION_META in src/lib/features.ts.
//
// The lede does name the five as one chain taken apart, because a reader
// arriving from the homepage has just been shown that chain and a hub that
// reads as five unrelated departments loses it. It is the same order as
// /compare's row groups, which is the invariant this page cannot break.
---

<!-- story: docs/stories/features-navigation.story.md -->

<section class="border-y border-hairline bg-cream" aria-labelledby="features-hub-heading">
	<div class="container-page py-section">
		{/* break-words on the h1: MEASURED at 200% text on a 360px viewport,
		    "Everything" at display size is wider than the column and scrolled
		    the page sideways (WCAG 1.4.10). It only engages when a single word
		    genuinely cannot fit, so nothing changes at normal sizes. */}
		<div class="max-w-3xl" data-reveal>
			<p class="eyebrow">Explore by kitchen task</p>
			<h1 id="features-hub-heading" class="mt-4 text-display font-semibold break-words">
				Find the tools for your next catering job.
			</h1>
			<p class="mt-5 max-w-[66ch] text-lede text-ink-soft">
				Explore recipes, food costs, supplier prices and event lists. The {featureCount} available features below are grouped by kitchen task; future additions are marked Coming.
			</p>
			<p class="mt-4 max-w-[66ch] text-ink-soft">
				Choose the part of your week you want help with. Each guide shows what you enter, what you get and the limits to check before trying it.
			</p>
			<p class="mt-4 max-w-[66ch] text-ink-soft">
				{spellCapital(inDevelopmentFeatureGroups.length)} feature groups below contain work marked Coming. {comingDefinition}{' '}
				Those future capabilities do not count toward the {featureCount} shipped features.
			</p>
			<p class="mt-6">
				<a href="/#demo" class="btn-quiet">Watch the 2:53 product tour</a>
			</p>
		</div>

		<div class="mt-6"><a href={cta.href} target={cta.target} rel={cta.rel} aria-label={cta.ariaLabel} class="btn-primary">{cta.label}</a><FeatureTrialTerms /></div>

		<ul role="list" class="mt-12 grid gap-x-10 gap-y-10 sm:grid-cols-2">
			{
				featureSections.map((entry, i) => (
					<li class="border-t border-ticket-rule pt-6">
						{/* The same mark the header disclosure uses, from the same
						    component, keyed by the same slug. A reader who opened the
						    menu and clicked through arrives at the card carrying the
						    mark they just aimed at. */}
						<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
							<FeatureAreaIcon slug={entry.slug} class="shrink-0 text-amber-deep" />
							<p class="eyebrow">Area {i + 1} of {featureSections.length}</p>
							{/* The count, not the bare word. "Coming" alone beside an area
							    heading reads as though the whole area is unbuilt, and four of
							    the five things in this one ship today. */}
							{entry.comingCount > 0 && (
								<span class="inline-flex items-center rounded-full border border-ticket-rule bg-softamber px-2.5 py-0.5 font-mono text-xs font-semibold tracking-wide text-amber-deep">
									{entry.comingCount} coming
								</span>
							)}
						</div>
						<h2 class="mt-3 text-h3 font-semibold">
							{/* The whole heading is the link, so the tap target is the
							    line a reader is already looking at rather than a small
							    word underneath it. */}
							<a href={`/features/${entry.slug}`} class="underline decoration-ticket-rule decoration-1 underline-offset-4 transition-colors duration-150 hover:decoration-ink">
								{entry.section}
							</a>
						</h2>
						<p class="mt-3 max-w-[52ch] text-ink-soft">{entry.blurb}</p>
						<p class="mt-4 font-mono text-xs tracking-wide text-ink-soft">
							{entry.count} shipped · {entry.groups.map((group) => group.kicker).join(' · ')}
						</p>
					</li>
				))
			}
		</ul>

		{/* THE GUIDES, ADDED 2026-09-27. The dedicated guide pages were reachable
		    only from the header's Features menu, so a reader who scrolled this hub
		    never met them. This list renders the menu's own data
		    (featureMenuSections, featureMenuHref), so the two paths cannot drift:
		    a guide added to the menu appears here with the same label and link.
		    Labels only, no descriptions: the hub stays five signposts plus one
		    terse list of guide names, never the capability lines (the guard in
		    check-landing-claims.mjs B5 still forbids those).
		    Considered Composite; not used because this is the same fixed
		    two-level list the menu renders, with one rendering here. */}
		<section class="mt-16 border-t border-ticket-rule pt-8" aria-labelledby="feature-guides-heading" data-feature-guides>
			<h2 id="feature-guides-heading" class="text-h3 font-semibold">Or open one guide</h2>
			<p class="mt-3 max-w-[66ch] text-ink-soft">Each guide follows one job through the app, with its limits stated.</p>
			<div class="mt-6 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
				{featureMenuSections.map((group) => (
					<div>
						<p class="eyebrow">{group.label}</p>
						<ul role="list" class="mt-3">
							{group.items.map((guide) => (
								<li class="border-b border-hairline">
									<a href={featureMenuHref(guide.featureId, guide.coming === true)} class="inline-flex min-h-11 items-center font-semibold underline decoration-ticket-rule decoration-1 underline-offset-4 hover:decoration-ink">{guide.label}</a>
									{guide.coming && <span class="ml-2 font-mono text-xs text-amber-deep">Coming</span>}
								</li>
							))}
						</ul>
					</div>
				))}
			</div>
		</section>

		<p class="mt-16 max-w-[66ch] border-t border-ticket-rule pt-6 text-ink-soft">
			Want a guided look? Bring one menu to a 15-minute demo.{' '}
			<a href={demoCta.href} target={demoCta.target} rel={demoCta.rel} aria-label={demoCta.ariaLabel} class="btn-quiet"
				>{demoCta.label}</a
			>
		</p>
	</div>
</section>
