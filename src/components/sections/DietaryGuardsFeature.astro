---
import FeatureTrialTerms from "../FeatureTrialTerms.astro";
/**
 * /features/guest-restrictions-and-dietary-guards
 * story: docs/stories/dietary-guards.story.md · ledger: RC-60
 *
 * WHY THIS IS A PAGE AND NOT A SECTION OF THE NUTRITION GUIDE. That guide is
 * recipe-level: what is in the dish. This is order-level: who is eating it, and
 * whether this dish hurts them. The app's own two story trackers split on the
 * same seam (dietary-characteristics is the standing catalog, order-dietary-
 * guards is the per-order run), and they share one engine, which is why one page
 * can hold both halves and the nutrition guide could not hold either without
 * burying it.
 *
 * NO SCREENSHOTS, DELIBERATELY, AND THIS IS THE PaperIn.astro PRECEDENT. Nothing
 * in public/proof captures guards, guests' restrictions, the diet filter or the
 * allergen matrix, and none of them can be produced from here: the captures come
 * from scripts/capture-*.mjs against a running sandbox/demo. The honest options
 * were a gap or a mock, and a page whose argument is that the number never lies
 * does not mock a screen. So the page is figure-led with diagrams whose every
 * label is the engine's own vocabulary. When a capture exists it belongs in the
 * guard block below and its alt text is prospect-facing copy like every other
 * alt on this site.
 *
 * THE ONE THING THIS PAGE MAY NEVER BECOME is a safety promise. Every sentence
 * is a reason to look at an ingredient. src/lib/dietary.ts owns the wording, the
 * claim guard fails the build on safe, certified, guaranteed and allergen-free,
 * and scripts/check-guest-restrictions-page.mjs pins the four boundaries in the
 * built HTML so a friendly rewrite cannot quietly drop them.
 *
 * Considered Template Method (a FeatureGuide shell with overridable steps); not
 * used because the feature family shares semantic roles, not an algorithm, and
 * every guide's evidence sequence is its own. Same refusal recorded in
 * global.css for .feature-display.
 */
import { cta, demoCta } from '../../lib/site';
import { dietary, dietNames, guardOutcomes, allergenCount } from '../../lib/dietary';

// The engine's own outcome ranking, rendered as the reader meets it: worst
// first, because that is the order the order screen sorts in.
const outcomeTone: Record<string, string> = {
	Conflict: 'conflict',
	Check: 'check',
	Clear: 'clear'
};

const faqItems = [
	{
		q: 'Does a clear result mean the dish is fine to serve?',
		a: 'It means every ingredient in the dish was reviewed and none of them says otherwise. It is a reason to serve, not a promise about a guest. No screen in CostCook makes an allergen-free claim.'
	},
	{
		q: 'Why can halal and kosher only ever come back as a check?',
		a: 'Because the facts that decide them are not in a recipe. Halal meat depends on the slaughter and kosher meat on certification, and no ingredient row can carry either. CostCook checks what it can see, forbids pork and alcohol for halal and pork and shellfish for kosher, flags meat with dairy on a kosher order, and stops there.'
	},
	{
		q: 'What happens to dishes with ingredients nobody has reviewed?',
		a: 'They come back as a check, never as clear, and the order tells you how many ingredients are outstanding. The count is on the order once, not repeated on every dish, so it reads as a job to finish rather than noise.'
	},
	{
		q: 'Does the answer update if I change a recipe after confirming?',
		a: 'No, and the screen says so. Confirming an order freezes the reading it was checked on and carries the date it was checked. A later edit to a recipe does not silently restate it. Re-check reads the catalog again and appends a new reading beside the old one.'
	},
	{
		q: 'Do I have to tag every ingredient before this is useful?',
		a: 'Setup drafts the rows from your ingredient names so the repetitive part is not yours. Every draft stays editable, uncertainty stays as do not know, and only your confirmation becomes a fact the guards will use.'
	}
];
---

<!-- story: docs/stories/dietary-guards.story.md -->
<article id="features-guards" class="guards-page">
	<section class="hero" aria-labelledby="guards-heading">
		<div class="container-page hero-grid">
			<div class="hero-copy anim-enter">
				<nav aria-label="Breadcrumb" class="feature-breadcrumb">
					<a href="/features">Every feature</a>
					<span aria-hidden="true">/</span>
					<span>Guests&rsquo; restrictions &amp; dietary guards</span>
				</nav>
				<h1 id="guards-heading" class="feature-display">
					&ldquo;Two celiac, one halal, the bride is allergic to tree nuts.&rdquo;
				</h1>
				<p class="hero-lede">
					That is how the request arrives, and until now it stayed on your phone. Put it
					on the order instead, and every dish gets checked against it from the
					ingredient facts your kitchen confirmed.
				</p>
				<p class="hero-constraint">
					<strong>{dietary.boundary}</strong> A guard is a reason to look at an
					ingredient, not a promise about a guest.
				</p>
				<div class="hero-actions">
					<a href={cta.href} target={cta.target} rel={cta.rel} aria-label={cta.ariaLabel} class="btn-primary">{cta.label}</a>
					<a href={demoCta.href} target={demoCta.target} rel={demoCta.rel} aria-label={demoCta.ariaLabel} class="btn-quiet">{demoCta.label}</a>
				</div>
				<FeatureTrialTerms />
			</div>

			<!-- The order line as the cook meets it. Every word is the engine's:
			     outcome word, ingredient name, relationship in parentheses, and the
			     restriction label the order carries. -->
			<figure class="guard-ticket anim-enter" style="--enter-delay: 120ms" data-guard-example>
				<p class="ticket-label">SATURDAY &middot; RODRIGUEZ &middot; PACK LIST</p>
				<ol role="list" class="ticket-lines">
					<li class="conflict">
						<span class="outcome">Conflict</span>
						<strong>Pesto</strong>
						<small>walnuts (contains) &middot; bride, Tree nuts</small>
					</li>
					<li class="check">
						<span class="outcome">Check</span>
						<strong>Braised short rib</strong>
						<small>meat, halal depends on the source &middot; 1 guest</small>
					</li>
					<li class="clear">
						<span class="outcome">Clear</span>
						<strong>Roasted carrots</strong>
						<small>every ingredient reviewed &middot; 2 guests, Gluten-free</small>
					</li>
				</ol>
				<figcaption>
					Three dishes, three answers. Illustrative lines in the app&rsquo;s own wording;
					no capture of this screen is published yet.
				</figcaption>
			</figure>
		</div>
	</section>

	<section class="wall" aria-labelledby="wall-heading">
		<div class="container-page wall-grid">
			<div data-reveal>
				<h2 id="wall-heading">The catalog knew. Nothing ever asked it.</h2>
				<p>
					You entered the ingredients, priced them and costed the dish. At no point did
					anything ask what those ingredients carry, and at no point did the pack list
					mention the bride. The facts and the people were in two different places, and
					the only thing joining them was you, remembering.
				</p>
			</div>
			<div class="wall-path" data-reveal aria-label="A text message and a pack list that never meet">
				<div class="path-side"><span>On your phone</span><strong>bride, tree nuts</strong></div>
				<div class="path-gap" aria-hidden="true"><i></i></div>
				<div class="path-side warning"><span>On the hotel pan</span><strong>Pesto, 40 portions</strong></div>
			</div>
		</div>
	</section>

	<section id="who-is-eating" class="product-section" aria-labelledby="eating-heading">
		<div class="container-page">
			<div class="section-head" data-reveal>
				<h2 id="eating-heading">Say who is eating, once, on the order.</h2>
				<p>
					An allergen or a diet, a label so the kitchen knows who it is, and how many
					people. It lives on that order. Duplicating an order asks before it copies
					them, because the people at the next event are not the people at this one.
				</p>
			</div>
			<ul role="list" class="diet-row" data-diet-list>
				{dietNames.map((diet) => <li data-diet={diet}>{diet}</li>)}
			</ul>
			<p class="diet-note" data-reveal>
				Five diets, and the {allergenCount} major US allergens beside them. A diet is judged from the traits
				your ingredients carry, never from what an ingredient is called.
			</p>
		</div>
	</section>

	<section id="three-answers" class="product-section answers" aria-labelledby="answers-heading">
		<div class="container-page">
			<div class="section-head" data-reveal>
				<h2 id="answers-heading">Three answers, and there is no fourth.</h2>
				<p>Every dish on the order gets one, and the line names the ingredient that caused it.</p>
			</div>
			<ol role="list" class="outcome-grid">
				{guardOutcomes.map((outcome) => (
					<li class={outcomeTone[outcome.word]} data-guard-outcome={outcome.word} data-reveal>
						<strong>{outcome.word}</strong>
						<p>{outcome.detail}</p>
					</li>
				))}
			</ol>
			<p class="answers-note" data-reveal>
				The worst answer across the guests is the one the row carries, so a dish is never
				quieter than its most serious reason. The same reading prints on the order, the
				prep list and the pack list.
			</p>
		</div>
	</section>

	<section id="coverage" class="product-section coverage" aria-labelledby="coverage-heading">
		<div class="container-page coverage-grid">
			<div data-reveal>
				<h2 id="coverage-heading">A quiet screen should mean somebody looked.</h2>
				<p>
					Look at what nobody has reviewed yet. An ingredient nobody has
					reviewed is never counted as clear, and the order shows how many are still
					outstanding, right where you can see it. Silence here is not an all-clear.
					The count tells you how much of the answer is still missing.
				</p>
				<p class="coverage-snap">Unknown is never clear.</p>
			</div>
			<div class="coverage-ticket" data-reveal>
				<p class="ticket-label">ORDER SUMMARY</p>
				<dl>
					<div><dt>Conflicts</dt><dd>1</dd></div>
					<div><dt>Checks</dt><dd>3</dd></div>
					<div><dt>Ingredients not reviewed</dt><dd>4</dd></div>
				</dl>
				<p>Counted once for the order, not repeated on every dish.</p>
			</div>
		</div>
	</section>

	<section id="limits" class="product-section limits" aria-labelledby="limits-heading">
		<div class="container-page">
			<div class="section-head" data-reveal>
				<h2 id="limits-heading">What it will not tell you.</h2>
				<p>Check these limits before using a result to plan a guest’s meal.</p>
			</div>
			<ul role="list" class="limit-list">
				{dietary.notClaimed.map((line) => (
					<li data-dietary-limit data-reveal>{line}</li>
				))}
			</ul>
		</div>
	</section>

	<section id="standing-book" class="product-section" aria-labelledby="book-heading">
		<div class="container-page section-head" data-reveal>
			<h2 id="book-heading">Find recipes by diet before building the menu.</h2>
			<p>
				A client asks which of your dishes are vegan while you are mid-prep. Each recipe
				carries its own dietary characteristics, with the reason beside each one. The
				catalog filters the book by diet and tells you how many recipes it held back
				because they could only be a check. And the allergen matrix prints every recipe
				against every allergen, for the pass or the front of house.
			</p>
			<p class="matrix-legend">
				<span>C</span> contains <span>M</span> may contain <span>X</span> cross-contact
				<span>?</span> not sure. Blank is no confirmed claim.
			</p>
		</div>
	</section>

	<section id="guard-questions" class="faq" aria-labelledby="faq-heading">
		<div class="container-page faq-grid">
			<div data-reveal>
				<h2 id="faq-heading">Questions to settle first.</h2>
				<p>The ones a chef asks before trusting any of it.</p>
			</div>
			<div class="faq-list">
				{faqItems.map((item) => (
					<details data-reveal data-guard-disclosure>
						<summary><span>{item.q}</span><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 7l6 6 6-6" /></svg></summary>
						<p>{item.a}</p>
					</details>
				))}
			</div>
		</div>
	</section>

	<section class="closing" aria-labelledby="closing-heading">
		<div class="container-page closing-grid" data-reveal>
			<div>
				<h2 id="closing-heading">Put Saturday&rsquo;s request on the order.</h2>
				<p>
					Bring one event and the dietary requests you received. The cook
					reads the answer off the pan, and the text thread stays on your phone, where it
					belongs.
				</p>
			</div>
			<div class="closing-actions">
				<a href={cta.href} target={cta.target} rel={cta.rel} aria-label={cta.ariaLabel} class="btn-primary">{cta.label}</a>
				<a href={demoCta.href} target={demoCta.target} rel={demoCta.rel} aria-label={demoCta.ariaLabel} class="btn-quiet">{demoCta.label}</a>
			</div>
		</div>
		<nav class="container-page onward feature-onward" aria-label="Related feature guides">
			<a href="/features/nutrition-facts-and-allergens">Nutrition facts &amp; allergens</a>
			<a href="/features/recipes-and-costing">Recipes &amp; costing</a>
			<a href="/features">Every CostCook feature</a>
		</nav>
	</section>
</article>

<style>
	.guards-page { background: var(--color-cream); }
	.hero-grid, .wall-grid, .coverage-grid, .faq-grid, .closing-grid { display: grid; gap: clamp(2.5rem, 6vw, 6rem); align-items: center; }
	.hero-grid > *, .wall-grid > *, .coverage-grid > *, .faq-grid > *, .closing-grid > * { min-width: 0; }
	.hero-grid { padding-block: clamp(3rem, 6vw, 5rem) var(--spacing-section); }
	.wall-grid, .coverage-grid, .faq-grid { padding-block: var(--spacing-section); }
	.closing-grid { padding-block: var(--spacing-section-tight); }
	.product-section { border-top: 1px solid var(--color-hairline); padding-block: var(--spacing-section); }
	.feature-breadcrumb { margin-bottom: 1.6rem; }
	.hero-lede { margin-top: 1.5rem; max-width: 56ch; font-size: var(--text-lede); line-height: var(--text-lede--line-height); color: var(--color-ink-soft); }
	.hero-constraint { margin-top: 1.5rem; max-width: 56ch; padding-top: 1rem; border-top: 1px solid var(--color-hairline-strong); color: var(--color-ink-soft); }
	.hero-actions, .closing-actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2rem; }
	.hero-actions .btn-primary, .closing-actions .btn-primary { min-height: 48px; align-items: center; justify-content: center; padding-inline: 1.7rem; text-align: center; }

	h2 { font-family: var(--font-display); font-size: var(--text-h2); font-weight: 600; line-height: 1.12; text-wrap: balance; }
	.section-head { max-width: 62ch; }
	.section-head p, .wall-grid p, .coverage-grid p { margin-top: 1.25rem; color: var(--color-ink-soft); }

	@media (min-width: 60rem) {
		.hero-grid { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); }
		.wall-grid, .coverage-grid, .faq-grid, .closing-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
	}

	/* The ticket. Amber for the outcome word, and the three tones carry a rule
	   colour rather than a fill, so a conflict never reads as an error state the
	   reader has to clear. It is information, not an alarm. */
	.guard-ticket { padding: clamp(1.25rem, 3vw, 2rem); border: 1px solid var(--color-ticket-rule); background: var(--color-paper); box-shadow: var(--shadow-ticket); }
	.ticket-label { font-family: var(--font-mono); font-size: var(--text-eyebrow); font-weight: 600; letter-spacing: .12em; color: var(--color-amber-deep); }
	.ticket-lines { margin-top: 1.25rem; border-top: 1px solid var(--color-ticket-rule); }
	.ticket-lines > li { padding-block: .9rem; border-bottom: 1px dashed var(--color-ticket-rule); }
	.ticket-lines .outcome { display: inline-block; font-family: var(--font-mono); font-size: var(--text-micro); font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
	.ticket-lines .conflict .outcome { color: var(--color-amber-deep); }
	.ticket-lines .check .outcome { color: var(--color-ink); }
	.ticket-lines .clear .outcome { color: var(--color-green-deep); }
	.ticket-lines strong { display: block; margin-top: .3rem; }
	.ticket-lines small { display: block; margin-top: .2rem; font-size: var(--text-caption); color: var(--color-ink-soft); }
	.guard-ticket figcaption { margin-top: 1.25rem; font-size: var(--text-caption); color: var(--color-ink-soft); }

	.wall-path { display: grid; gap: 1rem; }
	.path-side { padding: 1.1rem 1.25rem; border: 1px solid var(--color-ticket-rule); background: var(--color-paper); }
	.path-side span { display: block; font-family: var(--font-mono); font-size: var(--text-micro); font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--color-ink-soft); }
	.path-side strong { display: block; margin-top: .35rem; }
	.path-side.warning { border-top: 3px solid var(--color-amber-deep); }
	.path-gap { display: grid; place-items: center; }
	.path-gap i { display: block; width: 100%; height: 1px; background: repeating-linear-gradient(90deg, var(--color-ticket-rule) 0 6px, transparent 6px 12px); }

	.diet-row { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 2rem; }
	.diet-row > li { padding: .55rem 1rem; border: 1px solid var(--color-hairline-strong); border-radius: 999px; font-weight: 600; }
	.diet-note { margin-top: 1.5rem; max-width: 62ch; color: var(--color-ink-soft); }

	.outcome-grid { display: grid; gap: 1.5rem; margin-top: 2.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); }
	.outcome-grid > li { padding-top: 1rem; border-top: 3px solid var(--color-hairline-strong); }
	.outcome-grid > li.conflict { border-top-color: var(--color-amber-deep); }
	.outcome-grid > li.clear { border-top-color: var(--color-green); }
	.outcome-grid strong { font-family: var(--font-display); font-size: var(--text-h3); font-weight: 600; }
	.outcome-grid p { margin-top: .5rem; font-size: var(--text-body-sm); line-height: 1.5; color: var(--color-ink-soft); }
	.answers-note { margin-top: 2.5rem; max-width: 66ch; color: var(--color-ink-soft); }

	.coverage { background: var(--color-softgreen); }
	.coverage-snap { margin-top: 2rem; font-family: var(--font-display); font-size: var(--text-h3); font-weight: 600; color: var(--color-ink); }
	.coverage-ticket { padding: clamp(1.25rem, 3vw, 2rem); border-top: 4px solid var(--color-green); background: var(--color-paper); box-shadow: var(--shadow-ticket); }
	.coverage-ticket dl { margin-top: 1.25rem; border-top: 1px solid var(--color-ticket-rule); }
	.coverage-ticket dl div { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .25rem 2rem; padding-block: .9rem; border-bottom: 1px solid var(--color-ticket-rule); }
	.coverage-ticket dt { min-width: 0; color: var(--color-ink-soft); }
	.coverage-ticket dd { font-weight: 750; font-variant-numeric: tabular-nums; }
	.coverage-ticket > p:last-child { margin-top: 1.25rem; font-size: var(--text-caption); color: var(--color-ink-soft); }

	.limit-list { display: grid; gap: 1.25rem; margin-top: 2.5rem; max-width: 76ch; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }
	.limit-list > li { padding-top: .9rem; border-top: 1px solid var(--color-hairline-strong); font-size: var(--text-body-sm); line-height: 1.55; color: var(--color-ink-soft); }

	.matrix-legend { margin-top: 1.75rem; font-size: var(--text-body-sm); color: var(--color-ink-soft); }
	.matrix-legend span { display: inline-block; min-width: 1.6rem; margin-right: .2rem; padding: .1rem .35rem; border: 1px solid var(--color-hairline-strong); font-family: var(--font-mono); font-weight: 700; text-align: center; color: var(--color-ink); }

	.faq { border-top: 1px solid var(--color-hairline); }
	.faq-list { display: grid; gap: .25rem; }
	.faq-list details { border-bottom: 1px solid var(--color-ticket-rule); }
	.faq-list summary { display: flex; gap: 1.5rem; align-items: center; justify-content: space-between; min-height: 44px; padding-block: 1rem; cursor: pointer; font-weight: 600; list-style: none; }
	.faq-list summary::-webkit-details-marker { display: none; }
	.faq-list summary:focus-visible { outline: 2px solid var(--color-green); outline-offset: 4px; }
	.faq-list svg { flex: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; fill: none; color: var(--color-green-deep); transition: transform 160ms ease-out; }
	.faq-list details[open] svg { transform: rotate(180deg); }
	.faq-list details p { padding-bottom: 1.25rem; max-width: 68ch; color: var(--color-ink-soft); }

	@media (prefers-reduced-motion: reduce) {
		.faq-list svg { transition: none; }
	}

	.closing { border-top: 1px solid var(--color-hairline); background: var(--color-paper); }
	.onward { display: flex; flex-wrap: wrap; gap: 1.5rem; padding-bottom: var(--spacing-section-tight); }
</style>
