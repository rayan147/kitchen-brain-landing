---
/**
 * Homepage close. Story: docs/stories/homepage-real-order-close.story.md
 *
 * One primary action, with the card and trial boundary visible before it.
 * RC-03/14 back the one-order path; RC-34 backs the launch terms.
 */
import { cta, demoCta, launchPlan } from '../../lib/site';

// Considered State; not used because inputs and returned plans form one fixed
// explanatory path, not runtime modes that change component behaviour.
const orderInputs = [
	{
		name: 'One menu',
		detail: 'The dishes you already quoted.',
		iconPaths: ['M5 4h14v16H5z', 'M8 8h8', 'M8 12h5', 'M8 16h7']
	},
	{
		name: 'Guest count',
		detail: 'The number on the order.',
		iconPaths: ['M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6', 'M4 20v-2c0-3 2-5 5-5s5 2 5 5v2', 'M16 8a2.5 2.5 0 1 1 0 5', 'M16 14c2.5 0 4 1.5 4 4v2']
	},
	{
		name: 'Current prices',
		detail: 'What your suppliers charge now.',
		iconPaths: ['M7 3h10v18l-2-1.5L13 21l-2-1.5L9 21l-2-1.5z', 'M10 8h4', 'M10 12h4', 'M10 16h2']
	}
] as const;

const orderOutputs = [
	{
		name: 'Food cost',
		detail: 'Per dish, per guest, and for the order.',
		iconPaths: ['M4 19h16', 'M6 17v-5', 'M12 17V7', 'M18 17V4']
	},
	{
		name: 'Shopping',
		detail: 'By supplier, in whole packs.',
		iconPaths: ['M3 5h2l2 10h10l2-7H6', 'M9 20h.01M17 20h.01']
	},
	{
		name: 'Prep',
		detail: 'Scaled batches and checks for the crew.',
		iconPaths: ['M5 6h14l-1 13H6z', 'M8 3h8', 'M9 11l2 2 4-4']
	},
	{
		name: 'Pack',
		detail: 'Dishes, quantities, and equipment.',
		iconPaths: ['M4 8h16v12H4z', 'M8 8V4h8v4', 'M8 13h8']
	}
] as const;

const trialFacts = [
	{ term: 'Today', value: '$0 charged' },
	{ term: 'Trial', value: `${launchPlan.trialDays} days` },
	{ term: 'First charge', value: `Day ${launchPlan.trialDays + 1}` },
	{ term: 'Then', value: launchPlan.displayPrice }
] as const;
---

<!-- story: docs/stories/homepage-real-order-close.story.md -->
<section id="start" class="border-y border-ticket-rule bg-cream" aria-labelledby="start-heading">
	<div class="container-page py-section">
		<div class="start-hero">
			<div class="max-w-3xl" data-reveal>
				<p class="eyebrow">Start here</p>
				<h2 id="start-heading" class="mt-4 text-h2 font-semibold">Put one real order through it.</h2>
				<p class="mt-5 max-w-[60ch] text-lede text-ink-soft">
					Bring the menu and guest count already on your calendar. Check the food cost,
					buy, prep and pack plan it gives back before you move the rest of the kitchen.
					Your numbers, not a sales demo&rsquo;s.
				</p>
			</div>

			<aside class="trial-ticket" aria-labelledby="trial-title" data-real-order-trial data-reveal>
				<div class="trial-heading">
					<div>
						<p>Your trial</p>
						<h3 id="trial-title">Start with the next order.</h3>
					</div>
					<strong>{launchPlan.displayPrice}</strong>
				</div>
				<dl>
					{trialFacts.map((fact) => <div><dt>{fact.term}</dt><dd>{fact.value}</dd></div>)}
				</dl>
				<p class="trial-boundary">
					Stripe holds the card. The workspace owner can cancel from Settings → Billing
					before day {launchPlan.trialDays + 1} and pay nothing.
				</p>
				<a
					href={cta.href}
					target={cta.target}
					rel={cta.rel}
					aria-label={cta.ariaLabel}
					class="btn-primary"
				>
					{cta.label}
				</a>
				<p class="trial-demo">
					Rather run it together?{' '}
					<a
						href={demoCta.href}
						target={demoCta.target}
						rel={demoCta.rel}
						aria-label={demoCta.ariaLabel}
						class="btn-quiet">Book 15 minutes</a
					>.
				</p>
			</aside>
		</div>

		<figure class="order-test" data-real-order-path data-reveal>
			<figcaption>
				<h3 class="text-h3 font-semibold">One order in. Four working plans out.</h3>
				<p>Missing prices or conversions stop the costing instead of quietly becoming zero.</p>
			</figcaption>
			<div class="order-path">
				<section aria-labelledby="order-inputs-title">
					<h4 id="order-inputs-title">You bring</h4>
					<ul role="list">
						{orderInputs.map((item) => (
							<li data-order-input={item.name}>
								<span aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none">{item.iconPaths.map((path) => <path d={path} />)}</svg></span>
								<div><strong>{item.name}</strong><small>{item.detail}</small></div>
							</li>
						))}
					</ul>
				</section>

				<div class="path-arrow" aria-hidden="true"><span></span></div>

				<section aria-labelledby="order-outputs-title">
					<h4 id="order-outputs-title">You inspect</h4>
					<ul role="list" class="output-list">
						{orderOutputs.map((item) => (
							<li data-order-output={item.name}>
								<span aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none">{item.iconPaths.map((path) => <path d={path} />)}</svg></span>
								<div><strong>{item.name}</strong><small>{item.detail}</small></div>
							</li>
						))}
					</ul>
				</section>
			</div>
		</figure>

		<section class="card-questions" aria-labelledby="card-questions-title" data-reveal>
			<div class="questions-heading">
				<h3 id="card-questions-title" class="text-h3 font-semibold">Before you hand over a card.</h3>
				<p>Three answers that should not be hidden behind the button.</p>
			</div>
			<dl>
				<div>
					<dt>How do I cancel?</dt>
					<dd>The workspace owner cancels from Settings → Billing through Stripe. No email, notice period, or retention call.</dd>
				</div>
				<div>
					<dt>Can I take my work with me?</dt>
					<dd>The whole recipe book exports as a spreadsheet. Ingredient prices do not export yet.</dd>
				</div>
				<div>
					<dt>What happens on day {launchPlan.trialDays + 1}?</dt>
					<dd>Billing starts at {launchPlan.displayPrice} if you did nothing, and at $0 if you cancelled first.</dd>
				</div>
			</dl>
			<p class="questions-link">
				More questions than three? <a href="/faq" class="btn-quiet">Every answer, on one page</a>.
			</p>
		</section>
	</div>
</section>

<style>
	.start-hero {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 27rem), 1fr));
		gap: clamp(3rem, 7vw, 6rem);
		align-items: start;
	}

	.trial-ticket {
		position: relative;
		background: var(--color-paper);
		box-shadow: var(--shadow-ticket);
	}

	.trial-heading {
		display: flex;
		gap: 1rem;
		justify-content: space-between;
		align-items: start;
		padding: 1.5rem;
		border-bottom: 1px solid var(--color-ticket-rule);
	}

	.trial-heading p,
	.order-path h4 {
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: var(--text-label-sm);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-amber-deep);
	}

	.trial-heading h3 {
		margin-top: 0.25rem;
		font-size: var(--text-h3);
		font-weight: 600;
	}

	.trial-heading > strong {
		white-space: nowrap;
		font-size: var(--text-h3);
		color: var(--color-green-deep);
	}

	.trial-ticket dl {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.trial-ticket dl > div {
		padding: 1rem 1.5rem;
		border-bottom: 1px solid var(--color-hairline-strong);
	}

	.trial-ticket dl > div:nth-child(odd) {
		border-right: 1px solid var(--color-hairline-strong);
	}

	.trial-ticket dt {
		font-size: var(--text-caption);
		color: var(--color-ink-soft);
	}

	.trial-ticket dd {
		margin-top: 0.15rem;
		font-weight: 700;
		font-variant-numeric: tabular-nums;
	}

	.trial-boundary,
	.trial-demo {
		margin: 1.25rem 1.5rem 0;
		font-size: var(--text-body-sm);
		line-height: 1.5;
		color: var(--color-ink-soft);
	}

	.trial-ticket > .btn-primary {
		margin: 1.5rem 1.5rem 0;
	}

	.trial-demo {
		margin-block: 1rem 1.5rem;
	}

	.order-test {
		margin-top: clamp(4rem, 8vw, 7rem);
		padding-block: 2rem;
		border-block: 1px solid var(--color-ticket-rule);
	}

	.order-test > figcaption {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 2rem;
		justify-content: space-between;
		align-items: baseline;
	}

	.order-test > figcaption p,
	.questions-heading p {
		max-width: 54ch;
		font-size: var(--text-body-sm);
		line-height: 1.5;
		color: var(--color-ink-soft);
	}

	.order-path {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.5rem;
		margin-top: 2rem;
	}

	.order-path section {
		min-width: 0;
	}

	.order-path ul {
		display: grid;
		margin-top: 0.75rem;
		border-top: 1px solid var(--color-hairline-strong);
	}

	.order-path li {
		display: grid;
		grid-template-columns: 3rem minmax(0, 1fr);
		gap: 1rem;
		align-items: center;
		padding-block: 0.8rem;
		border-bottom: 1px solid var(--color-hairline-strong);
	}

	.order-path li > span {
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		border: 1px solid var(--color-ticket-rule);
		border-radius: 999px;
		background: var(--color-paper);
		color: var(--color-amber-deep);
	}

	.order-path svg {
		stroke: currentColor;
		stroke-width: 1.7;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.order-path strong,
	.order-path small {
		display: block;
	}

	.order-path small {
		margin-top: 0.15rem;
		font-size: var(--text-caption);
		line-height: 1.4;
		color: var(--color-ink-soft);
	}

	.output-list li > span {
		border-color: var(--color-green);
		color: var(--color-green-deep);
	}

	.path-arrow {
		position: relative;
		height: 2rem;
	}

	.path-arrow span {
		position: absolute;
		top: 0;
		bottom: 0.4rem;
		left: 1.5rem;
		width: 1px;
		background: var(--color-amber-deep);
	}

	.path-arrow span::after {
		position: absolute;
		bottom: 0;
		left: -3px;
		width: 7px;
		height: 7px;
		border-right: 1.5px solid var(--color-amber-deep);
		border-bottom: 1.5px solid var(--color-amber-deep);
		content: '';
		transform: rotate(45deg);
	}

	.card-questions {
		margin-top: clamp(3rem, 6vw, 5rem);
	}

	.questions-heading {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 2rem;
		justify-content: space-between;
		align-items: baseline;
	}

	.card-questions dl {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
		gap: 1.5rem 2.5rem;
		margin-top: 1.5rem;
	}

	.card-questions dl > div {
		padding-top: 1rem;
		border-top: 1px solid var(--color-hairline-strong);
	}

	.card-questions dt {
		font-weight: 700;
	}

	.card-questions dd {
		margin-top: 0.5rem;
		font-size: var(--text-body-sm);
		line-height: 1.55;
		color: var(--color-ink-soft);
	}

	.questions-link {
		margin-top: 1.5rem;
		font-size: var(--text-body-sm);
		color: var(--color-ink-soft);
	}

	@media (min-width: 48rem) {
		.order-path {
			grid-template-columns: minmax(0, 5fr) 4rem minmax(0, 7fr);
			align-items: center;
		}

		.output-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: 1.5rem;
		}

		.path-arrow {
			height: 1px;
		}

		.path-arrow span {
			top: 0;
			right: 0;
			bottom: auto;
			left: 0;
			width: auto;
			height: 1px;
		}

		.path-arrow span::after {
			top: -3px;
			right: 0;
			bottom: auto;
			left: auto;
			transform: rotate(-45deg);
		}
	}

	@media (max-width: 30rem) {
		.trial-heading {
			display: grid;
		}

		.trial-ticket dl {
			grid-template-columns: minmax(0, 1fr);
		}

		.trial-ticket dl > div:nth-child(odd) {
			border-right: 0;
		}
	}
</style>
