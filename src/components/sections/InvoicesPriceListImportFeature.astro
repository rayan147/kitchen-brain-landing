---
import FeatureTrialTerms from "../FeatureTrialTerms.astro";
import { featureGroups } from '../../lib/features';
import { cta, demoCta } from '../../lib/site';

const importGroup = featureGroups.find((group) => group.id === 'import');
const ledgerGroup = featureGroups.find((group) => group.id === 'ledger');
if (!importGroup || !ledgerGroup) throw new Error('Missing import and purchase-ledger public feature groups.');

// Considered Strategy; not used because these are fixed editorial selections
// from shipped feature data, not algorithms selected or swapped at runtime.
const invoiceLeads = new Set([
	'Upload or paste.',
	'Check the document type.',
	'Check names and units.',
	'Review before saving.',
	'Invoices that check themselves.',
	'The original stays visible.',
	'No duplicate save.',
	'Unreadable means unread.'
]);
const priceListLeads = new Set([
	'Price sheets, row by row.',
	'Check every imported row.',
	'Spreadsheets with different columns.',
	'Word documents.',
	'Match supplier names.',
	'It learns your names.',
	'Batch imports tested.'
]);
const invoiceItems = importGroup.items.filter((item) => invoiceLeads.has(item.lead));
const priceListItems = importGroup.items.filter((item) => priceListLeads.has(item.lead));
if (invoiceItems.length !== invoiceLeads.size || priceListItems.length !== priceListLeads.size) {
	throw new Error('Invoices & price-list capability selection drifted.');
}

const capabilityGroups = [
	{ label: 'Invoice import', title: 'Review the purchase before it changes a price.', items: invoiceItems },
	{ label: 'Price-list import', title: 'Choose which supplier offers become current.', items: priceListItems }
] as const;
const capabilityCount = capabilityGroups.reduce((total, group) => total + group.items.length, 0);

const faqItems = [
	{
		question: 'What can I import into CostCook?',
		answer:
			'Upload a photo, PDF, spreadsheet or Word document, or paste text. Review the suggested items and prices against the original before saving.'
	},
	{
		question: 'Does an import update ingredient prices automatically?',
		answer:
			'No. Review and confirm the import first. Exact ingredient matches may be preselected; uncertain names, units and pack sizes need your decision.'
	},
	{
		question: 'What is the difference between an invoice and a price list?',
		answer:
			'An invoice records a purchase that happened. A supplier price list is an offer, not a purchase. CostCook lets you apply or skip price-list rows individually and will not silently apply a pack-size change.'
	},
	{
		question: 'What happens when CostCook cannot read a line?',
		answer:
			'Unreadable text stays beside the suggested details. Correct the row, leave it for later, replace the file or exclude it before saving.'
	},
	{
		question: 'How are duplicate invoices handled?',
		answer:
			'The invoice total is compared with the sum of its lines, and duplicate invoices are flagged. Saving the same import again returns the existing receipt without adding purchases twice.'
	},
	{
		question: 'Can an older invoice replace a newer ingredient price?',
		answer:
			'Current cost follows the newest qualifying purchase date, not the order in which documents were typed or imported. Backlogging an older invoice does not make it the current price.'
	}
] as const;
---

<!-- story: docs/stories/invoices-price-list-import.story.md -->
<article id="features-import" class="imports-page">
	<section class="hero" aria-labelledby="imports-heading">
		<div class="container-page hero-grid">
			<div class="hero-copy anim-enter">
				<nav aria-label="Breadcrumb" class="feature-breadcrumb">
					<a href="/features">Every feature</a>
					<span aria-hidden="true">/</span>
					<span>Invoices and price-list import</span>
				</nav>
				<h1 id="imports-heading" class="feature-display">Upload paperwork. Check prices before saving.</h1>
				<p class="hero-lede">Upload an invoice or price list as a photo, PDF or spreadsheet. Check the items, pack sizes and prices against the original before you save any changes.</p>
				<div class="hero-actions">
					<a href={cta.href} target={cta.target} rel={cta.rel} aria-label={cta.ariaLabel} class="btn-primary">{cta.label}</a>
					<a href={demoCta.href} target={demoCta.target} rel={demoCta.rel} aria-label={demoCta.ariaLabel} class="btn-quiet">{demoCta.label}</a>
				</div>
				<FeatureTrialTerms />
			</div>

			<figure class="intake-desk anim-enter" style="--enter-delay: 120ms">
				<figcaption>Illustrative source-to-review path</figcaption>
				<div class="source-stack" aria-hidden="true">
					<div class="source-sheet invoice-sheet"><span>Invoice</span><strong>Purchase</strong><i></i><i></i><i></i></div>
					<div class="source-sheet price-sheet"><span>Price list</span><strong>Offer</strong><i></i><i></i><i></i></div>
				</div>
				<div class="stage-sheet">
					<div class="sheet-head"><span>Details to review</span><span>Awaiting your review</span></div>
					<div class="stage-row stage-labels"><span>Item</span><span>Source</span><span>State</span></div>
					<div class="stage-row"><strong>Chicken thigh</strong><span>Invoice</span><em class="ready">Ready to review</em></div>
					<div class="stage-row"><strong>Roma tomato</strong><span>Price list</span><em class="check">Check pack</em></div>
					<div class="stage-row"><strong>Unreadable line</strong><span>Invoice</span><em class="check">Check the original</em></div>
					<div class="confirm-gate"><span>You confirm</span><strong>then save price changes</strong></div>
				</div>
				<div class="flow-key" aria-label="Upload the source, review the details, then confirm">
					<span>Source</span><i></i><span>Review</span><i></i><strong>You confirm</strong>
				</div>
				<p>Illustrative records. Review and confirmation are available today.</p>
			</figure>
		</div>
	</section>

	<section class="paper-wall" aria-labelledby="paper-wall-heading">
		<div class="container-page wall-grid">
			<div data-reveal>
				<h2 id="paper-wall-heading">The price changed on paper first.</h2>
				<p>
					The new case price is in a folded invoice. The supplier offer is in a photograph.
					Tomorrow's quote still reads the number you entered last month.
				</p>
			</div>
			<figure class="delay-line" data-reveal>
				<div><span>Source arrives</span><strong>today</strong></div>
				<i aria-hidden="true"></i>
				<div><span>Price gets keyed</span><strong>later</strong></div>
				<i aria-hidden="true"></i>
				<div><span>Quote goes out</span><strong>now</strong></div>
				<figcaption>Review the price before it changes the next quote.</figcaption>
			</figure>
		</div>
	</section>

	<nav class="product-nav container-page" aria-label="On this page">
		<a href="#invoice-import"><span>Invoice import</span><small>Check the purchase, its lines, and its total before posting.</small><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5" /></svg></a>
		<a href="#price-list-import"><span>Price-list import</span><small>Apply or skip supplier offers without inventing a purchase.</small><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5" /></svg></a>
	</nav>

	<section class="common-rule" aria-labelledby="common-rule-heading">
		<div class="container-page common-grid">
			<div data-reveal><h2 id="common-rule-heading">Upload, review and save.</h2><p>A photograph, PDF, spreadsheet, Word document, or pasted text can enter the same workspace. Each stays outside your real catalog until review is complete.</p></div>
			<ol class="queue-path" data-reveal>
				<li><span>1</span><strong>Bring in the source</strong><small>Keep the original attached.</small></li>
				<li><span>2</span><strong>Read and match</strong><small>Check names, units and prices.</small></li>
				<li class="gate"><span>3</span><strong>You confirm</strong><small>Resolve what is uncertain.</small></li>
				<li><span>4</span><strong>Save the reviewed details</strong><small>Save only the details you confirmed.</small></li>
			</ol>
		</div>
	</section>

	<section id="invoice-import" class="product-section invoice-import" aria-labelledby="invoice-heading">
		<div class="container-page">
			<div class="section-intro" data-reveal>
				<h2 id="invoice-heading">Invoice import that stops for a proper check.</h2>
				<p>An invoice says what you bought, when you bought it, and what the supplier charged. Review those facts together before they join the purchase ledger.</p>
			</div>

			<figure class="invoice-review" data-reveal>
				<div class="source-preview">
					<div class="preview-head"><span>Original source</span><strong>Invoice · PDF</strong></div>
					<div class="supplier-mark">GREEN VALLEY PRODUCE</div>
					<dl><div><dt>Invoice</dt><dd>GV-4471</dd></div><div><dt>Date</dt><dd>Jul 28, 2026</dd></div></dl>
					<div class="paper-lines"><i></i><i></i><i></i><i></i><i></i></div>
					<strong class="paper-total">Stated total <span>$86.65</span></strong>
				</div>
				<div class="review-ledger">
					<div class="preview-head"><span>Purchase to review</span><strong>3 lines</strong></div>
					<div class="review-row labels"><span>Match</span><span>Pack</span><span>Line total</span></div>
					<div class="review-row"><strong>Roma tomato</strong><span>25 lb case</span><b>$31.25</b></div>
					<div class="review-row flagged"><strong>Cucumber</strong><span>Check: 12 ct</span><b>$18.40</b></div>
					<div class="review-row"><strong>Baby spinach</strong><span>4 × 2.5 lb</span><b>$37.00</b></div>
					<div class="reconcile"><span>Computed from lines</span><strong>$86.65</strong><em>Matches stated total</em></div>
				</div>
				<figcaption>Illustrative values based on the CostCook walkthrough. The total remains visible beside the lines awaiting review.</figcaption>
			</figure>

			<div class="feature-scenes">
				<article data-reveal><h3>Keep the source in view.</h3><p>The photo or PDF sits beside the rows awaiting review, so a doubtful unit can be checked against the paper instead of memory.</p></article>
				<article data-reveal><h3>Reconcile before posting.</h3><p>Compare the invoice total with the sum of its lines. Check duplicate warnings before saving a purchase.</p></article>
				<article data-reveal><h3>Post once.</h3><p>Saving the same import twice returns its existing receipt. Ingredient prices follow the purchase date, so an older invoice does not replace a newer price.</p></article>
			</div>
	</div>
	</section>

	<section id="price-list-import" class="product-section price-list-import" aria-labelledby="price-list-heading">
		<div class="container-page">
			<div class="section-intro" data-reveal>
				<h2 id="price-list-heading">A supplier price list is an offer, not a purchase.</h2>
				<p>Read the sheet row by row. Apply the offers you want, skip the ones you do not, and stop when a pack-size change needs a closer look.</p>
			</div>

			<figure class="offer-review" data-reveal>
				<div class="offer-head"><div><span>Supplier price list</span><strong>North Coast Foods · Aug 2026</strong></div><em>4 rows to review</em></div>
				<div class="offer-row labels"><span>Supplier item</span><span>Current</span><span>Offered</span><span>Decision</span></div>
				<div class="offer-row"><strong>Chicken thigh</strong><span>$54.00 / case</span><b>$57.40 / case</b><em class="apply">Apply</em></div>
				<div class="offer-row changed"><strong>Heavy cream</strong><span>12 × 1 qt</span><b>6 × 2 qt</b><em class="review">Review pack</em></div>
				<div class="offer-row"><strong>Lemon</strong><span>$42.00 / case</span><b>$45.00 / case</b><em class="skip">Skip</em></div>
				<div class="offer-row"><strong>Tomato, Roma</strong><span>Existing match</span><b>$31.25 / case</b><em class="apply">Apply</em></div>
				<figcaption>Illustrative price-list review. Applying an asking price does not create a purchase.</figcaption>
			</figure>

			<p class="snap" data-reveal>A price list is an offer. An invoice is what happened. CostCook keeps the difference.</p>
			<div class="feature-scenes">
				<article data-reveal><h3>Map the sheet you received.</h3><p>For a spreadsheet with unfamiliar columns, check which column holds each detail before importing. Any ignored columns are shown.</p></article>
				<article data-reveal><h3>Match names without hiding doubt.</h3><p>Check uncertain ingredient matches. Confirmed supplier names can be remembered for the next review.</p></article>
				<article data-reveal><h3>Refuse the quiet pack change.</h3><p>A different pack size cannot slide through as if only the price changed. That row stops for a decision.</p></article>
			</div>
		</div>
	</section>

	<section class="exceptions" aria-labelledby="exceptions-heading">
		<div class="container-page exceptions-grid">
			<div data-reveal><h2 id="exceptions-heading">The awkward rows stay awkward on screen.</h2><p>Nothing unreadable, unmatched, duplicated, or structurally changed needs to be guessed into place.</p></div>
			<ul class="exception-list" role="list" data-reveal>
				<li><strong>Unreadable</strong><span>The source text is quoted back beside the row awaiting review.</span><em>Correct or leave waiting</em></li>
				<li><strong>Unmatched</strong><span>Candidate matches and their ambiguity remain visible.</span><em>Choose or add</em></li>
				<li><strong>Duplicate</strong><span>The existing invoice and receipt help you avoid saving the purchase twice.</span><em>Open the existing record</em></li>
				<li><strong>Pack changed</strong><span>The new pack is not treated as a simple price update.</span><em>Review the unit</em></li>
			</ul>
		</div>
	</section>

	<section class="capabilities" aria-labelledby="capabilities-heading">
		<div class="container-page">
			<div class="capability-heading" data-reveal><div><h2 id="capabilities-heading">The import details, kept close.</h2><p>Selected shipped capabilities for invoices and supplier price lists.</p></div><p class="count"><strong>{capabilityCount}</strong><span>capabilities</span></p></div>
			<div class="disclosures">
				{capabilityGroups.map((group) => (
					<details data-reveal data-import-disclosure><summary><span><strong>{group.label}</strong><small>{group.title}</small></span><span class="summary-count">{group.items.length}</span><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 7l6 6 6-6" /></svg></summary><ul>{group.items.map((item) => <li><strong>{item.lead}</strong> <span>{item.detail}</span></li>)}</ul></details>
				))}
			</div>
		</div>
	</section>

	<section class="faq" aria-labelledby="faq-heading">
		<div class="container-page faq-grid">
			<div class="faq-intro" data-reveal><h2 id="faq-heading">Frequently asked questions</h2><p>The practical questions to settle before supplier paperwork changes a working cost.</p></div>
			<div class="faq-list">{faqItems.map((item) => <details data-reveal data-import-disclosure><summary><span>{item.question}</span><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 7l6 6 6-6" /></svg></summary><p>{item.answer}</p></details>)}</div>
		</div>
	</section>

	<section class="closing" aria-labelledby="closing-heading">
		<div class="container-page closing-grid" data-reveal>
			<div><h2 id="closing-heading">Review your next supplier invoice.</h2><p>Bring in the next supplier document with every line still under your eye.</p></div>
			<div class="closing-actions"><a href={cta.href} target={cta.target} rel={cta.rel} aria-label={cta.ariaLabel} class="btn-primary">{cta.label}</a><a href={demoCta.href} target={demoCta.target} rel={demoCta.rel} aria-label={demoCta.ariaLabel} class="btn-quiet">{demoCta.label}</a></div>
		</div>
		<nav class="container-page onward feature-onward" aria-label="Related feature guides"><a href="/features/getting-prices-in">Purchases &amp; getting prices in</a><a href="/features/invoice-email">Invoice email</a><a href="/features/recipes-and-costing">Recipes &amp; food costing</a><a href="/features">Every CostCook feature</a></nav>
	</section>
</article>

<style>
	.imports-page { --rule: color-mix(in srgb, var(--color-ink) 17%, transparent); overflow: clip; }
	.hero { border-block: 1px solid var(--color-hairline); background: var(--color-cream); }
	.hero-grid { display: grid; gap: clamp(3rem, 6vw, 6rem); align-items: center; padding-block: clamp(4rem, 7vw, 7.25rem); }
	.hero h1 { max-width: 12ch; }
	.hero-lede { max-width: 39ch; margin-top: 1.75rem; font-size: var(--text-lede); line-height: 1.55; color: var(--color-ink-soft); }
	.hero-actions, .closing-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
	.hero-actions .btn-primary, .closing-actions .btn-primary { min-height: 48px; align-items: center; justify-content: center; padding-inline: 1.7rem; }
	.intake-desk { position: relative; min-width: 0; padding-top: 2.25rem; }
	.intake-desk > figcaption { position: absolute; top: 0; left: 0; font-size: var(--text-label-sm); font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: var(--color-amber-deep); }
	.source-stack { position: absolute; top: 3.2rem; left: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); width: min(82%, 26rem); }
	.source-sheet { min-height: 8.5rem; padding: 1rem; background: var(--color-paper); box-shadow: 0 9px 16px color-mix(in srgb, var(--color-ink) 9%, transparent); }
	.invoice-sheet { transform: rotate(-2deg); }
	.price-sheet { transform: translate(-0.6rem, -0.5rem) rotate(2deg); }
	.source-sheet span, .source-sheet strong { display: block; }
	.source-sheet span { font-family: var(--font-display); font-size: var(--text-body); }
	.source-sheet strong { margin-top: 0.1rem; font-size: var(--text-micro); letter-spacing: 0.07em; text-transform: uppercase; color: var(--color-ink-soft); }
	.source-sheet i { display: block; width: 76%; height: 1px; margin-top: 0.75rem; background: var(--color-ticket-rule); }
	.stage-sheet { position: relative; z-index: 1; width: 88%; margin: 6.2rem 0 0 auto; padding: clamp(1rem, 2.8vw, 1.5rem); border-top: 3px solid var(--color-green); background: var(--color-paper); box-shadow: 0 13px 23px color-mix(in srgb, var(--color-ink) 12%, transparent); }
	.sheet-head, .preview-head, .offer-head { display: flex; justify-content: space-between; gap: 1rem; align-items: start; }
	.sheet-head { padding-bottom: 0.9rem; border-bottom: 1px solid var(--rule); font-size: var(--text-micro); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-ink-soft); }
	.stage-row { display: grid; grid-template-columns: minmax(0, 1.15fr) 0.7fr auto; gap: 0.75rem; align-items: center; min-width: 0; padding-block: 0.65rem; border-bottom: 1px solid var(--rule); font-size: var(--text-label-sm); }
	.stage-labels { font-size: var(--text-micro); font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--color-ink-soft); }
	.stage-row em, .offer-row em { justify-self: end; padding: 0.28rem 0.48rem; font-size: var(--text-micro); font-style: normal; font-weight: 700; white-space: nowrap; }
	.ready, .apply { background: var(--color-softgreen); color: var(--color-green-deep); }
	.check, .review { background: var(--color-softamber); color: var(--color-amber-deep); }
	.confirm-gate { display: flex; justify-content: space-between; gap: 1rem; margin-top: 1rem; padding: 0.85rem; border: 1px solid var(--color-amber-deep); color: var(--color-amber-deep); font-size: var(--text-label-sm); }
	.confirm-gate span { font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; }
	.flow-key { display: flex; flex-wrap: wrap; gap: 0.55rem; align-items: center; margin-top: 1.1rem; font-size: var(--text-label-sm); color: var(--color-ink-soft); }
	.flow-key i { width: 1.6rem; height: 1px; background: var(--color-amber-deep); }
	.flow-key strong { color: var(--color-amber-deep); }
	.intake-desk > p { margin-top: 0.7rem; font-size: var(--text-label-sm); color: var(--color-ink-soft); }

	.paper-wall, .common-rule { padding-block: var(--spacing-section-tight); background: var(--color-ink); color: var(--color-paper); }
	.wall-grid, .common-grid { display: grid; gap: 3rem; align-items: center; }
	.wall-grid h2, .common-grid h2 { max-width: 14ch; }
	.wall-grid > div p, .common-grid > div p { max-width: 47ch; margin-top: 1rem; color: color-mix(in srgb, var(--color-paper) 72%, transparent); }
	.delay-line { display: grid; gap: 0.8rem; }
	.delay-line > div { padding-block: 0.9rem; border-block: 1px solid color-mix(in srgb, var(--color-paper) 23%, transparent); }
	.delay-line span, .delay-line strong { display: block; }
	.delay-line span { font-size: var(--text-micro); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-amber-light); }
	.delay-line strong { margin-top: 0.3rem; font-family: var(--font-display); font-size: var(--text-body-lg); }
	.delay-line i { width: 1px; height: 1.2rem; margin-inline: auto; background: var(--color-amber-light); }
	.delay-line figcaption { color: color-mix(in srgb, var(--color-paper) 78%, transparent); font-size: var(--text-caption); }

	.product-nav { display: grid; padding-inline: var(--spacing-page); }
	.product-nav a { display: grid; grid-template-columns: 1fr auto; gap: 0.25rem 1rem; min-height: 88px; align-content: center; padding: 1rem clamp(0rem, 2vw, 1.5rem); color: var(--color-ink); }
	.product-nav a + a { border-top: 1px solid var(--color-ticket-rule); }
	.product-nav span { font-weight: 700; }
	.product-nav small { grid-column: 1; color: var(--color-ink-soft); }
	.product-nav svg { grid-column: 2; grid-row: 1 / 3; align-self: center; fill: none; stroke: var(--color-green-deep); stroke-width: 1.5; }
	.common-rule { background: var(--color-green-deep); }
	.queue-path { display: grid; gap: 1px; background: color-mix(in srgb, white 28%, transparent); }
	.queue-path li { display: grid; grid-template-columns: 1.8rem 1fr; gap: 0.2rem 0.75rem; min-width: 0; padding: 1rem; background: var(--color-green-deep); }
	.queue-path li.gate { background: var(--color-paper); color: var(--color-ink); }
	.queue-path li > span { grid-row: 1 / 3; display: grid; width: 1.6rem; height: 1.6rem; place-items: center; border: 1px solid currentColor; border-radius: 50%; font-size: var(--text-micro); }
	.queue-path strong { font-size: var(--text-caption); }
	.queue-path small { color: color-mix(in srgb, currentColor 72%, transparent); }

	.product-section { scroll-margin-top: 1rem; padding-block: var(--spacing-section); }
	.invoice-import { background: var(--color-offwhite); }
	.price-list-import { border-top: 1px solid var(--color-hairline); background: var(--color-softgreen); }
	.section-intro { display: grid; gap: 1.25rem; align-items: end; }
	.section-intro h2 { max-width: 20ch; }
	.section-intro > p { max-width: 57ch; font-size: var(--text-lede); line-height: 1.55; color: var(--color-ink-soft); }
	.invoice-review { display: grid; gap: 1.25rem; margin-top: clamp(3rem, 6vw, 5rem); }
	.source-preview, .review-ledger, .offer-review { min-width: 0; padding: clamp(1.1rem, 3vw, 1.8rem); background: var(--color-paper); box-shadow: 0 10px 18px color-mix(in srgb, var(--color-ink) 9%, transparent); }
	.source-preview { border-top: 3px solid var(--color-amber-deep); }
	.review-ledger, .offer-review { border-top: 3px solid var(--color-green); }
	.preview-head { padding-bottom: 0.9rem; border-bottom: 1px solid var(--rule); font-size: var(--text-micro); text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-ink-soft); }
	.supplier-mark { margin-top: 1.5rem; font-family: var(--font-display); font-size: var(--text-body-lg); }
	.source-preview dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1.2rem; }
