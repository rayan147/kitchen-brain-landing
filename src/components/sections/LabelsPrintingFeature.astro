---
/**
 * The kitchen label printing feature page. story: docs/stories/labels-printing.story.md
 *
 * STATUS IS THE LEDGER'S. `LABELS_STATUS` in src/lib/labels.ts is the one
 * word; this page prints it in the eyebrow, says it in a full sentence under
 * the headline, and repeats it in the FAQ, so a skimmer and a reader get the
 * same fact. Nothing here may read as "available" while that word is Coming
 * (RC-35), and nothing may say a label reaches a printer on its own.
 *
 * Built with the site's utility classes rather than a scoped stylesheet: the
 * page is print discipline, type and hairlines, like the homepage stops.
 *
 * Considered Strategy; not used because the page is one fixed editorial
 * composition of static product data, nothing is swapped at runtime.
 */
import { labels, labelsAvailability, labelsStatusWord, LABELS_STATUS } from '../../lib/labels';
import { cta, demoCta, launchPlan } from '../../lib/site';

const coming = labelsAvailability.isComing;

const faqItems = [
	{
		question: 'Is kitchen label printing available now?',
		answer: labelsAvailability.pageSentence
	},
	{
		question: 'What does a label say?',
		answer:
			'The dish or ingredient, the batch quantity and storage condition, the use-by and made dates, the event and its date when the label is tied to an order, the kitchen name, who printed it, and its number in the run. Confirmed allergens print as Contains and May contain.'
	},
	{
		question: 'Where does the use-by date come from?',
		answer:
			'From you. A shelf life saved on the recipe or ingredient, a number of days, an exact date, or the made date only. Where the app has a sourced suggestion, such as the FDA Food Code seven-day rule for refrigerated food, it offers it, and tapping it is what saves the rule. The app never guesses a date.'
	},
	{
		question: 'What does it print on?',
		answer:
			'A 30-up sticker sheet on an office printer, a 58 or 62 mm continuous thermal roll, a 2 by 1 inch die-cut roll, or any stock you measure yourself. The kitchen chooses once in Settings. The sticker preview is sized in millimetres, so what you see is the print geometry.'
	},
	{
		question: 'Does it send labels straight to a label printer?',
		answer:
			'No. The output is your browser’s print dialog. A direct connection to a label printer is designed as a seam in the code and is not built, and the app does not claim that paper moved when it cannot know.'
	},
	{
		question: 'What happens when I reprint?',
		answer:
			'The exact labels that were recorded print again, unchanged, even if the recipe has changed since. Only the paper can differ: a reprint can go on the stock the kitchen has loaded now.'
	}
] as const;
---

<!-- story: docs/stories/labels-printing.story.md -->
<article id="features-labels" class="[overflow-wrap:anywhere]">
	<section class="border-b border-hairline bg-cream" aria-labelledby="labels-feature-heading">
		<div class="container-page pt-8 pb-12 sm:py-section-tight">
			<nav aria-label="Breadcrumb" class="text-sm">
				<a href="/features" class="btn-quiet">Every feature</a>
				<span class="text-ink-soft"> / Labels and printing</span>
			</nav>

			{/* Copy above, the dialog capture full width below: at 1040 CSS px the
			    capture needs the whole container to stay at reading size. */}
			<div class="mt-6 grid gap-6 sm:mt-8 sm:gap-12">
				<div class="max-w-3xl anim-enter">
					<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
						<p class="eyebrow">Labels and printing</p>
						<span
							class:list={[
								'inline-flex items-center rounded-full border border-ticket-rule px-2.5 py-0.5 font-mono text-xs font-semibold tracking-wide',
								coming ? 'bg-softamber text-amber-deep' : 'bg-paper text-ink'
							]}
							data-labels-status={LABELS_STATUS}
						>
							{labelsStatusWord}
						</span>
					</div>
					<h1 id="labels-feature-heading" class="mt-4 text-display font-semibold">
						The sticker says what you chose. Nothing more.
					</h1>
					<p class="mt-5 max-w-[58ch] text-lede text-ink">
						A date label is a food-safety claim on a physical container. So the app asks the
						cook the one thing it cannot know, never guesses a use-by date, and freezes what
						the sticker said the moment it prints.
					</p>
					{
						coming && (
							<p class="mt-5 max-w-[62ch] text-ink-soft" data-labels-status-sentence>
								{labelsAvailability.pageSentence}
							</p>
						)
					}
					<div class="mt-8 flex flex-wrap items-center gap-4">
						<a href="/features" class="btn-primary">See what ships today</a>
						<a href={demoCta.href} target={demoCta.target} rel={demoCta.rel} aria-label={demoCta.ariaLabel} class="btn-quiet">{demoCta.label}</a>
					</div>
				</div>

				<figure class="anim-enter" style="--enter-delay: 120ms">
					<p class="font-mono text-eyebrow font-semibold tracking-wide text-amber-deep">
						LABEL PREVIEW
					</p>
					<div class="mt-3 border border-hairline bg-paper p-1 shadow-ticket sm:p-2">
						{/* One responsive request: phones show the legible sticker instead of downloading the wide dialog too. */}
						<picture>
							<source media="(min-width: 40rem)" srcset={labels.proof.dialog.src} width={labels.proof.dialog.width} height={labels.proof.dialog.height} />
							<img
								src={labels.proof.sticker.src}
								alt={labels.proof.heroAlt}
								width={labels.proof.sticker.width}
								height={labels.proof.sticker.height}
								decoding="async"
								fetchpriority="high"
								class="mx-auto h-auto w-full max-w-[261px] sm:max-w-[1040px]"
							/>
						</picture>
					</div>
					<figcaption class="mt-3 max-w-[68ch] text-sm text-ink-soft">
						{labels.proof.caption} On a phone, the finished sticker stands in so its type stays legible.
						<a href={labels.proof.dialog.src} class="btn-quiet mt-2 w-fit" data-full-proof-link>Open full label-dialog capture</a>
					</figcaption>
				</figure>
			</div>
		</div>
	</section>

	<nav class="container-page py-4" aria-label="On this page">
		<ul role="list" class="flex flex-wrap gap-x-5 gap-y-1 border-y border-ticket-rule py-2 font-mono text-sm">
			<li><a href="#how-a-label-is-made" class="inline-flex min-h-11 items-center" data-labels-on-page-link>Make the label</a></li>
			<li><a href="#the-record" class="inline-flex min-h-11 items-center" data-labels-on-page-link>Keep the record</a></li>
			<li><a href="#what-it-prints-on" class="inline-flex min-h-11 items-center" data-labels-on-page-link>Choose the stock</a></li>
		</ul>
	</nav>

	<section id="how-a-label-is-made" class="container-page py-section" aria-labelledby="steps-heading">
		<div class="grid gap-12 lg:grid-cols-[5fr_7fr] lg:items-start lg:gap-16">
			<div class="max-w-3xl" data-reveal>
				<p class="eyebrow">How a label is made</p>
				<h2 id="steps-heading" class="mt-4 text-h2 font-semibold">Six steps at the bench, one record behind them.</h2>
				<p class="mt-5 max-w-[60ch] text-lede text-ink-soft">{labels.tagline}</p>
				<ol role="list" class="mt-8 border-t border-ticket-rule">
					{
						labels.steps.map((step, index) => (
							<li class="grid gap-x-4 gap-y-1 border-b border-dashed border-ticket-rule py-3 sm:grid-cols-[2.5rem_minmax(0,1fr)]">
								<p class="font-mono text-eyebrow font-semibold tabular-nums text-amber-deep">{String(index + 1).padStart(2, '0')}</p>
								<div class="min-w-0">
									<p class="font-semibold">{step.lead}</p>
									<p class="mt-1 max-w-[52ch] text-sm leading-relaxed text-ink-soft">{step.detail}</p>
								</div>
							</li>
						))
					}
				</ol>
			</div>

			<figure data-reveal>
				<p class="font-mono text-eyebrow font-semibold tracking-wide text-amber-deep">THE STICKER, AS PREVIEWED</p>
				<div class="mt-3 border border-hairline bg-paper p-4 shadow-ticket sm:p-6">
					<img
						src={labels.proof.sticker.src}
						alt={labels.proof.sticker.alt}
						width={labels.proof.sticker.width}
						height={labels.proof.sticker.height}
						loading="lazy"
						decoding="async"
						style={`width: ${labels.proof.sticker.width / 2}px; max-width: 100%`}
						class="mx-auto h-auto"
					/>
				</div>
				<figcaption class="mt-3 max-w-[60ch] text-sm text-ink-soft">
					Sized in millimetres in the dialog, so the preview is the print geometry. No allergen
					data on this recipe, so the sticker prints no allergen line, and the preview says a
					blank label is not an all-clear.
					<a href={labels.proof.sticker.src} class="btn-quiet mt-2 w-fit" data-full-proof-link>Open full sticker preview</a>
				</figcaption>
			</figure>
		</div>
	</section>

	<section id="the-record" class="border-t border-hairline bg-cream" aria-labelledby="record-heading">
		<div class="container-page py-section">
			<div class="grid gap-12 lg:grid-cols-[7fr_5fr] lg:items-start lg:gap-16">
				<figure data-reveal>
					<p class="font-mono text-eyebrow font-semibold tracking-wide text-amber-deep">THE PRINT VIEW · 2 OF 2 · REPRINTABLE</p>
					<div class="mt-3 border border-hairline bg-paper p-2 shadow-ticket sm:p-3">
						<img
							src={labels.proof.print.src}
							alt={labels.proof.print.alt}
							width={labels.proof.print.width}
							height={labels.proof.print.height}
							loading="lazy"
							decoding="async"
							style={`width: ${labels.proof.print.width / 2}px; max-width: 100%`}
							class="mx-auto h-auto"
						/>
					</div>
					<figcaption class="mt-3 max-w-[60ch] text-sm text-ink-soft">
						The print view opens your browser’s print dialog. These are the exact labels that were
						recorded; a reprint reproduces them unchanged even if the recipe changes later.
						<a href={labels.proof.print.src} class="btn-quiet mt-2 w-fit" data-full-proof-link>Open full print-sheet capture</a>
					</figcaption>
				</figure>
				<div class="max-w-3xl" data-reveal>
					<p class="eyebrow">The record</p>
					<h2 id="record-heading" class="mt-4 text-h2 font-semibold">A soaked sticker costs a tap.</h2>
					<p class="mt-5 max-w-[60ch] text-lede text-ink-soft">
						Printing records what the sticker said. The document is frozen without a stock size
						or a printer in it, so the same words go on a sheet today and a roll next month, and
						a reprint six weeks on is the label that went on the container, not a recomposition
						from a recipe that has moved.
					</p>
					<p class="mt-5 max-w-[60ch] text-ink-soft">
						Where a printed date came from is kept with the record, a recipe’s standing rule or a
						number typed at the bench, so an inspector or a caterer can tell the two apart later.
						It does not print.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section id="what-it-prints-on" class="container-page py-section" aria-labelledby="stock-heading">
		<div class="grid gap-12 lg:grid-cols-[5fr_7fr] lg:items-start lg:gap-16">
			<div class="max-w-3xl" data-reveal>
				<p class="eyebrow">What it prints on</p>
				<h2 id="stock-heading" class="mt-4 text-h2 font-semibold">Chosen once in Settings, so nobody is asked at 5 a.m.</h2>
				<p class="mt-5 max-w-[60ch] text-lede text-ink-soft">
					Sheet, continuous roll and die-cut roll print the same label content. Only the
					geometry changes, and it is measured in millimetres, not tied to a brand.
				</p>
				<ul role="list" class="mt-8 border-t border-ticket-rule">
					{
						labels.stock.map((s) => (
							<li class="grid gap-x-6 gap-y-1 border-b border-dashed border-ticket-rule py-3 sm:grid-cols-[minmax(0,12rem)_minmax(0,1fr)]">
								<p class="font-semibold">{s.name}</p>
								<div class="min-w-0">
									<p class="font-mono text-sm text-ink">{s.size}</p>
									<p class="mt-1 text-sm leading-relaxed text-ink-soft">{s.detail}</p>
								</div>
							</li>
						))
					}
				</ul>
			</div>
			<figure data-reveal>
				<p class="font-mono text-eyebrow font-semibold tracking-wide text-amber-deep">SETTINGS · LABELS AND PRINTING</p>
				<div class="mt-3 border border-hairline bg-paper p-1 shadow-ticket sm:p-2">
					<img
						src={labels.proof.stock.src}
						alt={labels.proof.stock.alt}
						width={labels.proof.stock.width}
						height={labels.proof.stock.height}
						loading="lazy"
						decoding="async"
						style={`width: ${labels.proof.stock.width / 2}px; max-width: 100%`}
						class="mx-auto h-auto"
					/>
				</div>
				<figcaption class="mt-3 max-w-[60ch] text-sm text-ink-soft">
					Measured choices from CostCook label settings.
					<a href={labels.proof.stock.src} class="btn-quiet mt-2 w-fit" data-full-proof-link>Open full stock-settings capture</a>
				</figcaption>
			</figure>
		</div>
	</section>

	<section id="what-it-is-not" class="border-t border-hairline bg-cream" aria-labelledby="not-heading">
		<div class="container-page py-section">
			<h2 id="not-heading" class="text-h2 font-semibold">What it is not.</h2>
			<ul role="list" class="mt-6 grid gap-x-12 gap-y-4 sm:grid-cols-2">
				{labels.notClaimed.map((line) => <li class="border-t border-hairline pt-3 text-sm leading-relaxed text-ink-soft">{line}</li>)}
			</ul>
		</div>
	</section>

	<section id="labels-faq" class="container-page py-section" aria-labelledby="faq-heading">
		<h2 id="faq-heading" class="text-h2 font-semibold">Frequently asked questions</h2>
		<div class="mt-8 border-t border-ticket-rule">
			{
				faqItems.map((item) => (
					<details class="group border-b border-dashed border-ticket-rule" data-labels-disclosure>
						<summary class="flex min-h-[72px] cursor-pointer list-none items-center py-4 font-semibold">
							<span class="mr-3 font-mono text-eyebrow text-amber-deep group-open:hidden">+</span>
							<span class="mr-3 hidden font-mono text-eyebrow text-amber-deep group-open:inline">−</span>
							{item.question}
						</summary>
						<p class="max-w-[66ch] pb-4 text-ink-soft">{item.answer}</p>
					</details>
				))
			}
		</div>
	</section>

	<section class="border-t border-hairline bg-cream" aria-labelledby="closing-heading">
		<div class="container-page py-section">
			<h2 id="closing-heading" class="text-h2 font-semibold">Print what you chose. Keep the record.</h2>
			<p class="mt-5 max-w-[60ch] text-lede text-ink-soft">
				Costing, ordering, prep, purchasing, inventory, and nutrition ship today. Start
				the trial for that work; labels remain excluded until the word above changes.
			</p>
			<div class="mt-8 flex flex-wrap items-center gap-4">
				<a href={cta.href} target={cta.target} rel={cta.rel} aria-label={cta.ariaLabel} class="btn-primary">{cta.label}</a>
				<a href="/features" class="btn-quiet">Every feature, area by area</a>
			</div>
			<p class="mt-4 text-sm text-ink-soft">
				{launchPlan.trialDays} days free, then {launchPlan.displayPrice}. Charged $0 today. Labels remain excluded while marked Coming.
			</p>
		</div>
	</section>
</article>
