---
// The depth-vs-breadth differentiator leads as the section headline; the
// remaining four stack as ruled rows.
const points = [
	{
		title: 'We speak kitchen',
		body: 'Twelve years on the line means it works the way you actually cook — yields, trim, sub-recipes, not abstractions.'
	},
	{
		title: 'You get the founder, not a ticket queue',
		body: 'Call and the person who built it picks up. Setup happens with you on the phone, and the next feature comes from a working kitchen’s request.'
	},
	{
		title: 'Live in an afternoon',
		body: 'Transparent pricing, cancel anytime, set up before dinner service.'
	},
	{
		title: 'Retire the spreadsheet nobody can fix',
		body: 'It replaces the fragile sheet everyone rebuilds and nobody can untangle in the middle of prep.'
	}
];
---

<section id="why" class="container-page grid gap-12 py-section lg:grid-cols-[5fr_7fr] lg:gap-20">
	<div>
		<p class="eyebrow">Why us</p>
		<h2 class="mt-4 text-h2 font-semibold">
			The big platforms do everything. We do the kitchen.
		</h2>
		<p class="mt-5 max-w-md text-lede text-ink-soft">
			All-in-one tools bolt production math on as an afterthought. For us, it&rsquo;s the
			whole product.
		</p>
	</div>

	<ul role="list" class="lg:mt-2">
		{
			points.map((point) => (
				<li class="border-t border-hairline py-6 first:border-t-0 first:pt-0 lg:py-7">
					<h3 class="text-h3 font-semibold">{point.title}</h3>
					<p class="mt-2 max-w-lg text-ink-soft">{point.body}</p>
				</li>
			))
		}
	</ul>
</section>
