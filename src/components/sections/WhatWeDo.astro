---
// The five things, in the order they are sold. Each one names the problem it
// kills before it describes itself — a feature is the receipt, not the pitch.
//
// One per row rather than a grid: five items in two columns orphans the fifth,
// and these are meant to be read as a numbered five, not scanned as tiles.
// Mono micro-labels speak in the hero ticket's voice, the one accent device
// this page repeats on purpose.
const features = [
	{
		tag: 'PLATE COST',
		title: 'What the plate actually costs',
		body: 'Trim and yield are charged where they happen, so five pounds of peeled shallots is costed as the five pounds eleven ounces you really bought. Every dish with something to peel has been quietly costing more than your sheet said.'
	},
	{
		tag: 'NO DATA ENTRY',
		title: 'You don’t type your binder in',
		// Two claims used to live here that the code does not support. The app reads
		// photographed recipe cards; it refuses a photographed invoice outright with
		// "Invoice intake currently requires a PDF", and caps intake at 6 files and
		// 4 MB, so "a week of invoices" does not go in as photos in one pass either.
		// This also used to contradict WhyUs, which said the owner types everything
		// in by hand: software does it or a person does it, and a reader who hears
		// both inside ten minutes stops believing the rest of the page.
		body: 'Photograph the binder and send it. The software reads the recipe cards, I do the invoices by hand, and either way it lands on me rather than on you, and you are costing orders the same week. This is the step that kills every other costing tool in week two, so it is the step I do for you.'
	},
	{
		tag: 'BEFORE YOU SAY YES',
		title: 'Know the margin before you quote',
		body: 'Put in the guest count and your per-head price, see the food cost against your target. A busy season that made no money was decided months earlier, on the phone, by somebody saying a number that sounded about right.'
	},
	{
		tag: 'ONE NUMBER MOVES',
		title: 'Change the count, everything follows',
		body: 'The shopping list in cases and grouped by vendor. The prep sheet in whole batches, because nobody makes five and three quarter pots. The pack list with the chafers on it. Including the sauce that lives inside three dishes.'
	},
	{
		tag: 'TUESDAY’S PRICES',
		// Not "on their own": the body immediately says a person does the tapping,
		// and promising automation only to withdraw it one line later is the one
		// place this page overclaimed — on the objection most likely to be top of
		// mind ("who keeps prices current, me?"). "Photograph" is checked, not
		// assumed: import accepts JPEG/PNG/WebP for a price sheet, and the
		// PDF-only rule applies to invoices alone.
		title: 'Prices stay current from a photo',
		body: 'Photograph the price board or the order guide. You tap through what changed, not the whole sheet, and every recipe using those ingredients re-costs itself. A costing sheet that was right in January and wrong by June is worse than no sheet at all.'
	}
];
---

<section id="what" class="bg-softgreen">
	<div class="container-page py-section-tight">
		<div class="max-w-2xl" data-reveal>
			<p class="eyebrow">What it does</p>
			<h2 class="mt-4 text-h2 font-semibold">Five things, and they are all the same numbers.</h2>
			<p class="mt-5 text-lede text-ink-soft">
				Type in the menu and the guest count. All five fall out of that one
				entry, which is why nothing has to be kept in sync by hand.
			</p>
		</div>

		<!-- role="list": Tailwind preflight's list-style:none makes VoiceOver
		     drop list semantics without it. -->
		<ol role="list" class="mt-12">
			{
				features.map((item, i) => (
					<li
						class="border-t border-hairline-strong py-7 lg:py-8"
						data-reveal
						style={`--reveal-delay: ${Math.min(i, 2) * 70}ms`}
					>
						<div class="grid gap-x-10 gap-y-3 lg:grid-cols-[3fr_5fr]">
							<div class="flex items-baseline gap-3">
								<span
									class="font-mono text-eyebrow font-semibold text-ink-soft tabular-nums"
									aria-hidden="true"
								>
									{String(i + 1).padStart(2, '0')}
								</span>
								<div>
									<p class="font-mono text-eyebrow font-semibold tracking-wide text-amber-deep">
										{item.tag}
									</p>
									<h3 class="mt-2 text-h3 font-semibold">{item.title}</h3>
								</div>
							</div>
							<p class="max-w-xl text-ink-soft lg:pt-1">{item.body}</p>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>
