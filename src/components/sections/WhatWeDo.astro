---
// Mono micro-labels speak in the hero ticket's voice — the one accent
// device this page repeats on purpose.
const items = [
	{
		tag: 'SHOP · PREP · PACK',
		title: 'Order to production',
		body: 'Enter a menu and a guest count. Get a consolidated shopping list, prep list, and pack list — scaled exactly, nothing forgotten.'
	},
	{
		tag: '$ PER PLATE',
		title: 'Real food cost',
		body: 'Enter what you paid and see plate cost and margin, dish by dish. Catch the ones quietly losing you money.'
	},
	{
		tag: 'PAPER · TEXTS · CSV',
		title: 'Nothing to swap out',
		body: 'Works with however you already take orders. Type them in or import a CSV — keep the rest of your setup exactly as it is.'
	},
	{
		tag: '5:00 AM',
		title: 'Built for the line',
		body: 'Prep sheets a cook can actually follow at five in the morning — big and clear.'
	}
];
---

<section id="what" class="bg-softgreen">
	<div class="container-page py-section-tight">
		<div data-reveal>
			<p class="eyebrow">What it does</p>
			<h2 class="mt-4 max-w-xl text-h2 font-semibold">
				Everything between the order and the van.
			</h2>
		</div>

		<!-- role="list": Tailwind preflight's list-style:none makes VoiceOver
		     drop list semantics without it. -->
		<ul role="list" class="mt-12 grid gap-y-10 lg:grid-cols-2 lg:gap-x-16 lg:gap-y-12">
			{
				items.map((item, i) => (
					<li
						class="border-t border-hairline-strong pt-6"
						data-reveal
						style={`--reveal-delay: ${(i % 2) * 90}ms`}
					>
						<p class="font-mono text-eyebrow font-semibold tracking-wide text-amber-deep">
							{item.tag}
						</p>
						<h3 class="mt-3 text-h3 font-semibold">{item.title}</h3>
						<p class="mt-2 max-w-md text-ink-soft">{item.body}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
