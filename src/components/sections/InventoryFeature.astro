---
import FeatureTrialTerms from "../FeatureTrialTerms.astro";
import { featureGroups } from '../../lib/features';
import { cta, demoCta } from '../../lib/site';

const inventoryGroup = featureGroups.find((group) => group.id === 'inventory');
if (!inventoryGroup) throw new Error('Missing public feature group: inventory');

const movements = [
	// US units (chef audit 2026-10-07). 52 + 20 − 17 = 55 lb; one 20 lb Northline
	// case at $46.80 is $2.34 a lb, the ingredients guide's price. The count is
	// Aug 31, after PO-1048 moved the price on Aug 28, so $2.34 is the cost
	// frozen at count; the +20 lb is the case PO-1048 came up short (chef
	// review 2026-10-07).
	{ date: 'Aug 31 · 7:10 AM', label: 'Physical count', amount: '52 lb', kind: 'baseline' },
	{ date: 'Aug 31 · 11:40 AM', label: 'Northline rebuy received', amount: '+20 lb', kind: 'in' },
	{ date: 'Sep 1 · 5:20 AM', label: 'Packed for two orders', amount: '−17 lb', kind: 'out' }
] as const;

const trustStates = [
	{ ingredient: 'Chicken thigh', quantity: '55 lb', state: 'Fresh', note: 'Recent count. It can cut the buy.', tone: 'fresh' },
	{ ingredient: 'Baby spinach', quantity: '18 lb', state: 'Stale', note: 'Shown so you know. Count again before you rely on it.', tone: 'stale' },
	{ ingredient: 'Olive oil', quantity: '—', state: 'Never counted', note: 'Nothing guessed. The buy stays as it was.', tone: 'missing' }
] as const;

// Considered Strategy; not used because the FAQ and evidence rows vary as
// static editorial data, not interchangeable behavior selected at runtime.
const faqItems = [
	{
		question: 'How is on-hand inventory calculated?',
		answer:
			'Count an ingredient and record the date. Later purchases add stock; logged waste and completed packing subtract it. The history shows each change.'
	},
	{
		question: 'What do Fresh, Stale, and Never counted mean?',
		answer:
			'Fresh means the count can be used to reduce buying. Stale means count it again. Never counted means enter a first physical count before using stock in the calculation.'
	},
	{
		question: 'Will a stale count reduce what the shopping list buys?',
		answer:
			'No. Only trusted on-hand quantity reduces estimated buying. A stale or unsupported estimate can remain visible for context, but it is not allowed to quietly subtract from the buy.'
	},
	{
		question: 'Does a par level automatically add food to the shopping list?',
		answer: `Yes, when you build the kitchen shopping list. A par level can mark an ingredient below par, at or above par, unevaluable, or without a par. Inventory > Build shopping list builds what to buy for confirmed events and your par, by supplier. Only a recent count is taken off the buy. The shopping list on one order is separate and covers that order.`
	},
	{
		question: 'What happens when a count is corrected later?',
		answer:
			'A correction adds a dated record. Earlier counts and the unit costs saved with them stay in the history.'
	},
	{
		question: 'Can I see what the shelf was worth on an earlier date?',
		answer:
			'Yes. Inventory can show shelf value as of a selected date, using the count and movement history available for that point in time.'
	}
] as const;
---

<!-- story: docs/stories/inventory.story.md -->
<!-- story: docs/stories/inventory.story.md -->
<article class="inventory-page">
	<section class="hero" aria-labelledby="inventory-heading">
		<div class="container-page hero-grid">
			<div class="hero-copy anim-enter">
				<nav aria-label="Breadcrumb" class="feature-breadcrumb">
					<a href="/features">Every feature</a><span aria-hidden="true">/</span><span>Inventory</span>
				</nav>
				<h1 id="inventory-heading" class="feature-display">Check your stock before you buy more.</h1>
				<p class="hero-lede">Count it first. After that, deliveries you record, waste you log and orders you pack move the number. An old count, or no count at all, does not take anything off the shopping list.</p>
				<div class="hero-actions">
					<a href={cta.href} target={cta.target} rel={cta.rel} aria-label={cta.ariaLabel} class="btn-primary">{cta.label}</a>
					<a href={demoCta.href} target={demoCta.target} rel={demoCta.rel} aria-label={demoCta.ariaLabel} class="btn-quiet">{demoCta.label}</a>
				</div>
				<FeatureTrialTerms />
			</div>

			<figure class="shelf-ticket inventory-enter">
				<p class="figure-note">Illustrative shelf record</p>
				<div class="ticket-head"><span>Walk-in · Protein</span><span class="state fresh">Fresh</span></div>
				<div class="ticket-title"><div><strong class="record-title">Chicken thigh</strong><p>Computed from the last trusted count</p></div><strong>55 lb</strong></div>
				<div class="equation" aria-label="52 pounds counted, plus 20 pounds received, minus 17 pounds packed, equals 55 pounds on hand">
					<div><small>Counted</small><strong>52</strong><span>lb</span></div><b aria-hidden="true">+</b>
					<div><small>Received</small><strong>20</strong><span>lb</span></div><b aria-hidden="true">−</b>
					<div><small>Packed</small><strong>17</strong><span>lb</span></div><b aria-hidden="true">=</b>
					<div class="result"><small>On hand</small><strong>55</strong><span>lb</span></div>
				</div>
				<div class="ticket-foot"><span>Baseline: Aug 31 · 7:10 AM</span><span>3 dated movements</span></div>
				<figcaption>Illustrative values. The state and every movement stay attached to the result.</figcaption>
			</figure>
		</div>
	</section>

	<section class="problem" aria-labelledby="problem-heading">
		<div class="container-page problem-grid">
			<div><h2 id="problem-heading">The screen said one case. The shelf was empty.</h2><p>Nobody had counted in twelve days. Prep opened the walk-in and found nothing. A number with no count date can look exact and still be wrong.</p></div>
			<figure class="stale-scene">
				<div><span>On screen</span><strong>1 case</strong><small>Last counted 12 days ago</small></div>
				<svg width="56" height="22" viewBox="0 0 56 22" aria-hidden="true"><path d="M1 11h47M41 4l7 7-7 7" /></svg>
				<div><span>On the shelf</span><strong>Empty</strong><small>Prep starts at 5:30 AM</small></div>
				<figcaption>A stale count does not mean you are low. It means somebody needs to go look.</figcaption>
			</figure>
		</div>
	</section>

	<nav class="story-nav container-page" aria-label="On this page">
		<a href="#count-and-trust"><span>Record a stock count</span><small>Record a physical count and see when it was taken.</small><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5" /></svg></a>
		<a href="#plan-the-gap"><span>Work out what to buy</span><small>Use current stock to reduce buying, with manual changes kept separate.</small><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5" /></svg></a>
	</nav>

	<section id="count-and-trust" class="product-section count-chapter" aria-labelledby="count-heading">
		<div class="container-page">
			<div class="section-intro"><h2 id="count-heading">Count it once. Then deliveries, packing and waste move the number.</h2><p>After a physical count, recorded purchases add to it. Logged waste and finished packing take away. The dated history shows how you got to today’s number.</p></div>

			<figure class="movement-workspace">
				<div class="movement-main">
					<div class="panel-bar"><span>Chicken thigh · movement history</span><span>As of Sep 1</span></div>
					<ol role="list">
						{movements.map((movement) => (
							<li class={movement.kind}><time>{movement.date}</time><span><strong>{movement.label}</strong><small>{movement.kind === 'baseline' ? 'Starting physical count' : 'Change since count'}</small></span><b>{movement.amount}</b></li>
						))}
					</ol>
					<div class="movement-total"><span>Computed on hand</span><strong>55 lb</strong></div>
				</div>
				<div class="movement-side">
					<div><span>Count status</span><strong>Fresh</strong><small>Based on a recent physical count</small></div>
					<div><span>Shelf value</span><strong>$128.70</strong><small>Illustrative value as of Sep 1</small></div>
					<div><span>Unit cost at count</span><strong>$2.34 / lb</strong><small>Frozen at count time</small></div>
				</div>
				<figcaption>Illustrative movement history built only from shipped inventory behavior.</figcaption>
			</figure>

			<div class="feature-scenes">
				<article><h3>Every count is kept.</h3><p>Each count is saved with its date. What came in, got used or got thrown out after that date is how you get today’s quantity.</p></article>
				<article><h3>You can see how old the count is.</h3><p>Fresh, Stale or Never counted sits right next to the quantity, where you see it before you plan.</p></article>
				<article><h3>History keeps its old price.</h3><p>The pack cost freezes at count time, so a later correction does not rewrite what the shelf was worth then.</p></article>
			</div>
		</div>
	</section>

	<section id="plan-the-gap" class="product-section gap-chapter" aria-labelledby="gap-heading">
		<div class="container-page">
			<div class="section-intro"><h2 id="gap-heading">Use recent counts to work out what to buy.</h2><p>Start with what the next orders need. A recent count can take some off the buy. A stale count, or a number with nothing behind it, cannot. Overriding the list is still your call, made separately.</p></div>

			<figure class="gap-sheet">
				<div class="gap-head"><span>Chicken thigh · next jobs</span><span>Illustrative gap</span></div>
				<div class="gap-equation">
					<div><small>Orders need</small><strong>68 lb</strong><span>Two confirmed jobs</span></div>
					<b aria-hidden="true">−</b>
					<div><small>Trusted shelf</small><strong>55 lb</strong><span>Fresh count state</span></div>
					<b aria-hidden="true">=</b>
					<div class="gap-result"><small>Left to cover</small><strong>13 lb</strong><span>Before whole-pack rounding</span></div>
				</div>
				<div class="buy-line"><span><strong>Shopping list</strong><small>Northline Foods · 20 lb case</small></span><b>1 case</b></div>
				<figcaption>Example: 68 lb needed − 55 lb on hand = 13 lb to buy. Sold in 20 lb cases, so buy one case and keep 7 lb.</figcaption>
			</figure>

			<div class="trust-board">
				<div class="trust-head"><h3>Each count status gets its own answer.</h3><p>You can see a quantity and still not trust it enough to change the buy.</p></div>
				<ul role="list">
					{trustStates.map((item) => (
						<li><span><strong>{item.ingredient}</strong><small>{item.note}</small></span><b>{item.quantity}</b><em class:list={['state', item.tone]}>{item.state}</em></li>
					))}
				</ul>
			</div>
		</div>
	</section>

	<section class="trust-proof" aria-labelledby="trust-proof-heading">
		<div class="container-page trust-proof-grid">
			<div><h2 id="trust-proof-heading">Never counted means nothing gets guessed.</h2><p>When there is not enough to go on, the status says what is missing and the buy stays as it was. The fix is simple: go count it.</p></div>
			<div class="recovery-list">
				<div><span class="state fresh">Fresh</span><strong>Use to reduce buying</strong><small>A recent count, plus the changes since, backs this number up.</small></div>
				<div><span class="state stale">Stale</span><strong>Count again</strong><small>Keep the old quantity visible, but do not subtract it.</small></div>
				<div><span class="state missing">Never counted</span><strong>Record the first count</strong><small>Nothing is estimated before the first physical count.</small></div>
			</div>
		</div>
	</section>

	<section class="capabilities" aria-labelledby="capabilities-heading">
		<div class="container-page capabilities-grid">
			<div><h2 id="capabilities-heading">What is in Inventory.</h2><p>Open the details to check what is available today.</p><p class="count"><strong>{inventoryGroup.items.length}</strong><span>shipped capabilities</span></p></div>
			<details id="features-inventory"><summary><span>Inventory</span><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 7l6 6 6-6" /></svg></summary><ul role="list">{inventoryGroup.items.map((item) => <li><strong>{item.lead}</strong> <span>{item.detail}</span></li>)}</ul></details>
		</div>
	</section>

	<section class="faq" aria-labelledby="faq-heading">
		<div class="container-page faq-grid">
			<div><h2 id="faq-heading">Frequently asked questions</h2><p>What people ask before they let a shelf count change what they buy.</p></div>
			<div class="faq-list">{faqItems.map((item) => <details><summary><span>{item.question}</span><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 7l6 6 6-6" /></svg></summary><p>{item.answer}</p></details>)}</div>
		</div>
	</section>

	<section class="closing" aria-labelledby="closing-heading">
		<div class="container-page closing-grid">
			<div><h2 id="closing-heading">Count one shelf before your next shop.</h2><p>Bring one real shopping list and count one shelf. Watch the count, and every change after it, move what you need to buy.</p></div>
			<div class="closing-actions"><a href={cta.href} target={cta.target} rel={cta.rel} aria-label={cta.ariaLabel} class="btn-primary">{cta.label}</a><a href={demoCta.href} target={demoCta.target} rel={demoCta.rel} aria-label={demoCta.ariaLabel} class="btn-quiet">{demoCta.label}</a></div>
		</div>
		<div class="container-page onward feature-onward"><a href="/features">See every CostCook feature</a></div>
	</section>
</article>

<style>
	.inventory-page { overflow: clip; }
	.hero { border-block: 1px solid var(--color-hairline); background: var(--color-cream); }
	.hero-grid { display: grid; gap: clamp(3rem, 6vw, 6.5rem); align-items: center; padding-block: clamp(4rem, 7vw, 7.5rem); }
	.hero h1 { max-width: 12ch; margin-top: 1.5rem; }
	.hero-lede { max-width: 55ch; margin-top: 1.75rem; font-size: var(--text-lede); line-height: 1.55; color: var(--color-ink-soft); }
	.hero-actions, .closing-actions { display: flex; flex-wrap: wrap; gap: .85rem; margin-top: 2rem; }
	.figure-note { margin-bottom: .7rem; font-size: var(--text-label-sm); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--color-amber-deep); }
	.shelf-ticket { position: relative; min-width: 0; padding: clamp(1.2rem, 3vw, 1.8rem); border-top: 1px solid var(--color-green); background: var(--color-paper); box-shadow: var(--shadow-ticket); }
	.ticket-head, .panel-bar, .gap-head { display: flex; justify-content: space-between; gap: 1rem; font-size: var(--text-micro); font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: var(--color-ink-soft); }
	.state { display: inline-flex; width: fit-content; align-items: center; min-height: 24px; padding: .2rem .55rem; border-radius: 999px; font-family: var(--font-body); font-size: var(--text-micro); font-weight: 700; font-style: normal; letter-spacing: .05em; text-transform: uppercase; }
	.state.fresh { background: var(--color-softgreen); color: var(--color-green-deep); }
	.state.stale { background: var(--color-softamber); color: var(--color-amber-deep); }
	.state.missing { border: 1px solid var(--color-hairline); color: var(--color-ink-soft); }
	.ticket-title { display: flex; justify-content: space-between; gap: 1rem; align-items: end; margin-top: 1.1rem; padding-bottom: 1.2rem; border-bottom: 1px solid var(--color-ticket-rule); }
	.ticket-title .record-title { display: block; font-family: var(--font-display); font-size: var(--text-record); font-weight: 600; }
	.ticket-title p { margin-top: .2rem; font-size: var(--text-caption); color: var(--color-ink-soft); }
	.ticket-title > strong { color: var(--color-green-deep); font-size: var(--text-record); font-variant-numeric: tabular-nums; }
	.equation { display: grid; grid-template-columns: repeat(7, auto); gap: .45rem; align-items: center; margin-top: 1.2rem; }
	.equation > div { min-width: 0; }
	.equation small, .gap-equation small { display: block; font-size: var(--text-micro); color: var(--color-ink-soft); }
	.equation strong { font-size: var(--text-body-lg); font-variant-numeric: tabular-nums; }
	.equation span { margin-left: .2rem; font-size: var(--text-label-sm); color: var(--color-ink-soft); }
	.equation b, .gap-equation > b { color: var(--color-amber-deep); font-size: var(--text-body-lg); }
	.equation .result { padding: .7rem; background: var(--color-softgreen); }
	.ticket-foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem 1rem; margin-top: 1rem; padding-top: .8rem; border-top: 1px solid var(--color-ticket-rule); font-size: var(--text-label-sm); color: var(--color-ink-soft); }
	.shelf-ticket figcaption, .movement-workspace figcaption, .gap-sheet figcaption { margin-top: .85rem; font-size: var(--text-label-sm); line-height: 1.45; color: var(--color-ink-soft); }
	.problem { border-bottom: 1px solid var(--color-hairline); background: var(--color-paper); }
	.problem-grid { display: grid; gap: 3rem; align-items: center; padding-block: var(--spacing-section-tight); }
	.problem h2, .section-intro h2, .trust-proof h2, .capabilities h2, .faq h2, .closing h2 { font-size: var(--text-h2); font-weight: 600; line-height: 1.12; }
	.problem p, .section-intro p, .trust-proof-grid > div > p, .capabilities-grid > div > p, .faq-grid > div > p, .closing p { max-width: 58ch; margin-top: 1.1rem; color: var(--color-ink-soft); line-height: 1.65; }
	.stale-scene { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: center; }
	.stale-scene div { padding: 1.35rem; border-top: 2px solid var(--color-ticket-rule); background: var(--color-cream); }
	.stale-scene span, .movement-side span { display: block; font-size: var(--text-micro); font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: var(--color-amber-deep); }
	.stale-scene strong { display: block; margin-top: .45rem; font-size: var(--text-record); }
	.stale-scene small { color: var(--color-ink-soft); }
	.stale-scene svg, .story-nav svg, summary svg { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
	.stale-scene svg { color: var(--color-amber-deep); }
	.stale-scene figcaption { grid-column: 1 / -1; color: var(--color-ink-soft); font-size: var(--text-caption); }
	.story-nav { display: grid; padding-block: 1.25rem; }
	.story-nav a { display: grid; min-height: 84px; grid-template-columns: 1fr auto; gap: .25rem 1rem; align-content: center; padding: 1.2rem 0; border-bottom: 1px solid var(--color-ticket-rule); color: var(--color-ink); }
	.story-nav a:first-child { border-top: 1px solid var(--color-ticket-rule); }
	.story-nav span { font-weight: 700; }
	.story-nav small { max-width: 48ch; color: var(--color-ink-soft); }
	.story-nav svg { grid-column: 2; grid-row: 1 / 3; color: var(--color-green-deep); }
	.product-section { scroll-margin-top: 1rem; padding-block: var(--spacing-section); }
	.count-chapter { background: var(--color-softgreen); }
	.gap-chapter { background: var(--color-cream); }
	.section-intro { display: grid; gap: 1.5rem 4rem; align-items: end; }
	.section-intro p { margin-top: 0; }
	.movement-workspace { display: grid; gap: 1px; margin-top: clamp(2.5rem, 6vw, 4.5rem); background: var(--color-hairline-strong); box-shadow: var(--shadow-lift); }
	.movement-main, .movement-side > div { background: var(--color-paper); }
	.movement-main { padding: clamp(1.2rem, 3vw, 2rem); }
	.panel-bar { padding-bottom: .8rem; border-bottom: 1px solid var(--color-hairline); }
	.movement-main ol { margin-top: .8rem; }
	.movement-main li { display: grid; grid-template-columns: minmax(8.5rem, .8fr) 1fr auto; gap: 1rem; align-items: center; padding-block: .85rem; border-bottom: 1px solid var(--color-hairline); }
	.movement-main time { font-size: var(--text-label-sm); color: var(--color-ink-soft); }
	.movement-main li span small { display: block; color: var(--color-ink-soft); }
	.movement-main li b { font-variant-numeric: tabular-nums; }
	.movement-main li.baseline b { color: var(--color-green-deep); }
	.movement-main li.out b { color: var(--color-amber-deep); }
	.movement-total { display: flex; justify-content: space-between; gap: 1rem; margin-top: 1rem; padding: 1rem; background: var(--color-softgreen); }
	.movement-total strong { color: var(--color-green-deep); font-variant-numeric: tabular-nums; }
	.movement-side { display: grid; gap: 1px; }
	.movement-side > div { padding: 1.25rem; }
	.movement-side strong, .movement-side small { display: block; margin-top: .4rem; }
	.movement-side small { color: var(--color-ink-soft); }
	.feature-scenes { display: grid; gap: 2rem; margin-top: 3rem; }
	.feature-scenes article { padding-top: 1.25rem; border-top: 1px solid var(--color-hairline-strong); }
	.feature-scenes h3, .trust-board h3 { font-size: var(--text-record-sm); font-weight: 600; }
	.feature-scenes p { margin-top: .65rem; color: var(--color-ink-soft); line-height: 1.6; }
	.gap-sheet { margin-top: clamp(2.5rem, 6vw, 4.5rem); background: var(--color-paper); box-shadow: var(--shadow-ticket); }
	.gap-head { padding: 1rem clamp(1rem, 3vw, 1.75rem); background: var(--color-ink); color: var(--color-paper); }
	.gap-equation { display: grid; grid-template-columns: repeat(5, auto); gap: 1rem; align-items: center; padding: clamp(1.2rem, 4vw, 2rem); }
	.gap-equation > div { min-width: 0; }
	.gap-equation strong { display: block; margin-top: .25rem; font-size: var(--text-record); font-variant-numeric: tabular-nums; }
	.gap-equation span { display: block; margin-top: .2rem; font-size: var(--text-label-sm); color: var(--color-ink-soft); }
	.gap-result { padding: 1rem; background: var(--color-softgreen); }
	.buy-line { display: flex; justify-content: space-between; gap: 1rem; align-items: center; padding: 1.15rem clamp(1rem, 3vw, 1.75rem); border-top: 2px solid var(--color-green); }
	.buy-line span small { display: block; color: var(--color-ink-soft); }
	.buy-line > b { color: var(--color-green-deep); font-size: var(--text-record-sm); }
	.gap-sheet figcaption { padding: 0 clamp(1rem, 3vw, 1.75rem) 1rem; }
	.trust-board { display: grid; gap: 2rem; margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--color-ticket-rule); }
	.trust-head p { margin-top: .6rem; color: var(--color-ink-soft); }
	.trust-board li { display: grid; grid-template-columns: 1fr auto auto; gap: 1rem; align-items: center; padding-block: .9rem; border-bottom: 1px solid var(--color-ticket-rule); }
	.trust-board li span small { display: block; max-width: 45ch; color: var(--color-ink-soft); }
	.trust-board li > b { font-variant-numeric: tabular-nums; }
	.trust-proof { padding-block: var(--spacing-section); background: var(--color-ink); color: var(--color-paper); }
	.trust-proof-grid { display: grid; gap: 3rem; align-items: center; }
	.trust-proof-grid > div > p { color: var(--color-ink-muted); }
	.recovery-list { background: var(--color-paper); color: var(--color-ink); box-shadow: var(--shadow-lift); }
	.recovery-list > div { display: grid; grid-template-columns: auto 1fr; gap: .5rem 1rem; padding: 1.1rem; border-bottom: 1px solid var(--color-hairline); }
	.recovery-list > div:last-child { border-bottom: 0; }
	.recovery-list strong { align-self: center; }
	.recovery-list small { grid-column: 2; color: var(--color-ink-soft); }
	.capabilities { padding-block: var(--spacing-section); background: var(--color-paper); }
	.capabilities-grid { display: grid; gap: 3rem; }
	.count { display: flex; align-items: baseline; gap: .75rem; }
	.count strong { font-family: var(--font-display); font-size: var(--text-h2); color: var(--color-green-deep); }
