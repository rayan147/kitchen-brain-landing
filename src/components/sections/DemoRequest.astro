---
import { booking, cta } from '../../lib/site';
import { DEMO_TRAP_FIELD } from '../../lib/demo-request';

/**
 * WHAT CHANGED, 2026-09-06. This form used to end in a mailto:. The submit
 * handler built a draft, waited 1800ms, and set window.location.href, so a
 * demo request existed only if the visitor had a mail client, saw the draft,
 * and pressed send. On a phone mid-shift, which is who this page is written
 * for, that is a coin flip, and support@costcook.io was never a recipient at
 * all. The old step 3 said so in its own copy, which is honesty about a design
 * that should not have existed rather than a working form.
 *
 * It now posts to /api/demo-request, which mails rayan@ and support@ through
 * Resend, and step 3 appears ONLY after that send returns ok. The page can
 * therefore say "sent" and mean it.
 *
 * The calendar is embedded rather than linked. Booking used to open
 * calendar.app.google in a new tab beside an "Email Rayan directly" exit, so
 * the last thing the page did was hand the visitor two ways to leave. Now the
 * schedule is on the page. That needs frame-src in vercel.json to name
 * calendar.google.com; check-demo-page.mjs holds the two together, because a
 * CSP is a deploy-only header and a blank calendar would reach production
 * without a single local check noticing.
 *
 * Considered Strategy for the scripted and no-script submit paths; not used
 * because there is one behaviour with one enhancement, not two interchangeable
 * algorithms. The no-script path is the form element's own default, which is
 * why the action and method are real attributes in the HTML.
 */
---

<!-- story: docs/stories/request-demo.story.md -->
<div class="demo-page">
	<section class="demo-hero" aria-labelledby="demo-title">
		<div class="container-page demo-hero-grid">
			<div class="demo-intro">
				<h1 id="demo-title">Put one real job on the screen.</h1>
				<p class="demo-lede">
					Tell Rayan what your kitchen needs to run. In 15 minutes, follow that work through
					CostCook and leave knowing whether it fits.
				</p>
				<p class="demo-snap">Bring the menu you would otherwise price twice.</p>

				<ol class="demo-path" aria-label="Your demo path">
					<li>
						<span class="path-mark" aria-hidden="true">1</span>
						<span><strong>Name the work</strong><small>Menu, quote, order, prep plan, or supplier paper.</small></span>
					</li>
					<li>
						<span class="path-mark" aria-hidden="true">2</span>
						<span><strong>See it connected</strong><small>Cost, shopping, prep, and pack work from the same plan.</small></span>
					</li>
					<li>
						<span class="path-mark" aria-hidden="true">3</span>
						<span><strong>Decide with the work visible</strong><small>Leave knowing what fits and what setup would take.</small></span>
					</li>
				</ol>
			</div>

			<div class="demo-ticket">
				<div class="ticket-head">
					<div>
						<p class="ticket-title">Prepare your demo</p>
						<p class="ticket-time">15 minutes · with Rayan</p>
					</div>
					<svg width="42" height="42" viewBox="0 0 42 42" fill="none" aria-hidden="true">
						<rect x="5.5" y="4.5" width="31" height="33" rx="3" stroke="currentColor" stroke-width="1.5" />
						<path d="M13 2.5v6M29 2.5v6M11 15h20M13 21h6M13 27h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
					</svg>
				</div>

				<div class="step-status" aria-live="polite">
					<span data-step-indicator="1" aria-current="step">Kitchen</span>
					<span class="step-rule" aria-hidden="true"></span>
					<span data-step-indicator="2">You</span>
					<span class="step-rule" aria-hidden="true"></span>
					<span data-step-indicator="3">Time</span>
				</div>

				<form
					class="demo-form"
					data-demo-form
					data-current-step="1"
					data-phase="idle"
					action="/api/demo-request"
					method="post"
				>
					<fieldset data-step="1">
						<legend>Start with the job.</legend>
						<p class="step-copy">These details decide what goes on screen. They do not qualify you for a sales queue.</p>

						<div class="field-grid">
							<label class="field field-wide">
								<span>Business name</span>
								<input name="business" autocomplete="organization" required maxlength="100" />
							</label>

							<label class="field">
								<span>Your role</span>
								<select name="role" required>
									<option value="">Choose one</option>
									<option>Owner or chef-owner</option>
									<option>Catering or events manager</option>
									<option>Restaurant manager</option>
									<option>Kitchen or operations lead</option>
									<option>Consultant or partner</option>
									<option>Something else</option>
								</select>
							</label>

							<label class="field">
								<span>Kitchen type</span>
								<select name="kitchen" required>
									<option value="">Choose one</option>
									<option>Catering and private events</option>
									<option>Restaurant with event work</option>
									<option>Private chef</option>
									<option>Meal prep or dated production</option>
									<option>Something else</option>
								</select>
							</label>

							<label class="field">
								<span>Locations</span>
								<select name="locations" required>
									<option value="">Choose one</option>
									<option value="1">1 location</option>
									<option value="2-5">2–5 locations</option>
									<option value="6+">6 or more locations</option>
								</select>
							</label>

							<label class="field field-wide">
								<span>What should we put through CostCook?</span>
								<textarea name="workflow" rows="3" maxlength="600" placeholder="For example: a 180-guest wedding menu, this week's supplier sheet, or the prep plan for Friday."></textarea>
							</label>
						</div>

						<div class="form-actions">
							<button type="button" class="btn-primary" data-next>Continue to your details</button>
						</div>
					</fieldset>

					<fieldset data-step="2">
						<legend>Now name the person bringing it.</legend>
						<p class="step-copy">This goes to Rayan's inbox when you send it. Then you pick your time here, without leaving the page.</p>

						<div class="field-grid">
							<label class="field">
								<span>First name</span>
								<input name="firstName" autocomplete="given-name" required maxlength="80" />
							</label>
							<label class="field">
								<span>Last name</span>
								<input name="lastName" autocomplete="family-name" required maxlength="80" />
							</label>
							<label class="field field-wide">
								<span>Work email</span>
								<input name="email" type="email" inputmode="email" autocomplete="email" required maxlength="160" />
							</label>
							<label class="field field-wide">
								<span>Phone <small>Optional</small></span>
								<input name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="40" />
							</label>
						</div>

						<!-- A field no human sees and no human fills. Deliberately NOT
						     named "company": the business-name input above carries
						     autocomplete="organization", so Chrome treats this form as an
						     address profile and would autofill a field with that name,
						     discarding a real caterer's request while telling them it
						     sent. The name lives in src/lib/demo-request.ts so the form
						     and the endpoint cannot disagree about it. -->
						<div class="trap" aria-hidden="true">
							<label for="demo-ticket-ref">Leave this field empty</label>
							<input
								id="demo-ticket-ref"
								name={DEMO_TRAP_FIELD}
								type="text"
								tabindex="-1"
								autocomplete="off"
							/>
						</div>

						<p class="safety-note">Do not include passwords, payment card details, or other sensitive information.</p>
						<p class="send-status" data-send-status role="status" aria-live="polite"></p>
						<div class="form-actions form-actions-split">
							<button type="button" class="btn-quiet" data-back>Back to kitchen</button>
							<button type="submit" class="btn-primary" data-send>Send my demo request</button>
						</div>
					</fieldset>

					<section class="prepared-step" data-step="3" aria-labelledby="prepared-title" tabindex="-1">
						<svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true">
							<circle cx="24" cy="24" r="19" stroke="currentColor" stroke-width="1.5" />
							<path d="m15.5 24.5 5.5 5.5 11.5-13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
						<h2 id="prepared-title">Sent. Now take your 15 minutes.</h2>
						<p>Rayan has what you brought. Pick a time on his calendar below and Google sends you both the invite.</p>

						<!--
						  THE SRC IS SET BY SCRIPT, AFTER STEP 3 HAS SETTLED, AND THAT IS
						  NOT AN OPTIMISATION.

						  MEASURED: with src in the markup, the calendar rendered as a
						  single ~150px column of wrapped text inside a 980px frame. Chrome
						  deliberately does NOT lazy-load a display:none iframe, it loads it
						  eagerly, so Google laid its page out against the degenerate
						  viewport of a hidden panel and never reflowed. Reassigning src
						  afterwards did not fix it. Waiting until the panel is open and
						  sized does.

						  It also means nothing reaches Google until the visitor has
						  actually sent something, which is the behaviour we want anyway.
						  /demo/sent carries a plain src instead: it is a visible, full-width
						  page from first paint, and it is where a visitor without
						  JavaScript lands.

						  The height attribute is not decoration either. transitionTo()
						  animates the ticket to the incoming step's measured height, and an
						  empty iframe with no height measures near zero, which collapses the
						  panel it is supposed to open.
						-->
						<div class="booking-frame">
							<iframe
								title="Book a 15-minute CostCook demo with Rayan"
								width="100%"
								height="700"
								data-booking-frame
								data-booking-src={booking.embedUrl}
							></iframe>
						</div>

						<div class="prepared-actions">
							<a href={booking.url} target="_blank" rel="noopener noreferrer" class="btn-quiet">Calendar not loading? Open it in a new tab</a>
						</div>
						<p class="prepared-truth">Your request is sent. A time is booked only once you choose one above and Google confirms it.</p>
					</section>

					<noscript>
						<p class="noscript-note">JavaScript is off, so both steps stay open and the calendar sits below them. Send the form and you land on a page that confirms it arrived.</p>
					</noscript>
				</form>
			</div>
		</div>
	</section>

	<section class="demo-agenda" aria-labelledby="agenda-title">
		<div class="container-page agenda-grid">
			<div>
				<h2 id="agenda-title">A working session, not a feature parade.</h2>
				<p>We start with the job you named. That keeps the call on the decision you need to make.</p>
			</div>
			<ol class="agenda-list">
				<li><strong>First five minutes</strong><span>Put in the menu, head count, recipe, or supplier paper you brought.</span></li>
				<li><strong>Next five minutes</strong><span>Follow the cost into shopping, prep, pack, or the workflow you asked to see.</span></li>
				<li><strong>Last five minutes</strong><span>See the setup work, the limits, and whether CostCook fits the way your kitchen runs.</span></li>
			</ol>
		</div>
	</section>

	<section class="demo-alternatives" aria-labelledby="alternatives-title">
		<div class="container-page alternatives-grid">
			<div>
				<h2 id="alternatives-title">Not ready for a call?</h2>
				<p>You can still see the working product or start with your own data.</p>
			</div>
			<div class="alternative-actions">
				<a href="/tour/main" class="btn-outline">Take the product tour</a>
				<a href={cta.href} target={cta.target} rel={cta.rel} aria-label={cta.ariaLabel} class="btn-quiet">{cta.label}</a>
			</div>
		</div>
	</section>
</div>

<script>
	const form = document.querySelector<HTMLFormElement>('[data-demo-form]');
	if (form) {
		// Considered State; not used because the three fixed presentation frames
		// share one transition mechanic and do not have distinct object behavior.
		let transitioning = false;
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		const updateProgress = (step: number) => {
			for (const indicator of form.closest('.demo-ticket')?.querySelectorAll<HTMLElement>('[data-step-indicator]') ?? []) {
				if (indicator.dataset.stepIndicator === String(step)) indicator.setAttribute('aria-current', 'step');
				else indicator.removeAttribute('aria-current');
			}
		};

		const transitionTo = async (step: number, focusTarget: string) => {
			if (transitioning || form.dataset.currentStep === String(step)) return false;
			const outgoing = form.querySelector<HTMLElement>(`[data-step="${form.dataset.currentStep}"]`);
			const incoming = form.querySelector<HTMLElement>(`[data-step="${step}"]`);
			if (!outgoing || !incoming) return false;

			transitioning = true;
			form.dataset.phase = 'leaving';
			form.setAttribute('aria-busy', 'true');

			// Every animation started here is collected so it can be cancelled once
			// the step has settled. A finished animation with a fill keeps holding
			// the property it animated, and the animations origin outranks the style
			// attribute, so `form.style.removeProperty('height')` below cannot undo
			// it. MEASURED before this fix: after a failed send the form was pinned
			// at the 577px it needed when step 2 first drew, the error sentence grew
			// the fieldset to 637px, and the button row hung 22.6px below the
			// ticket's bottom border. Cancelling is not a pattern, it is the API's
			// own undo; considered dropping the fills instead, but a fill is what
			// keeps the last frame from flashing back before this code runs.
			const settling: Animation[] = [];

			if (!reducedMotion.matches) {
				const leaveAnimation = outgoing.animate(
					[
						{ opacity: 1, transform: 'translateY(0)' },
						{ opacity: 0, transform: 'translateY(-6px)' }
					],
					{ duration: 160, easing: 'cubic-bezier(0.4, 0, 1, 1)', fill: 'forwards' }
				);
				settling.push(leaveAnimation);
				await leaveAnimation.finished;
			}

			const fromHeight = form.getBoundingClientRect().height;
			form.style.height = `${fromHeight}px`;
			form.style.overflow = 'hidden';
			form.dataset.currentStep = String(step);
			form.dataset.phase = 'entering';
			updateProgress(step);

			if (!reducedMotion.matches) {
				const toHeight = incoming.getBoundingClientRect().height;
				const [heightAnimation, enterAnimation] = [
					form.animate(
						[{ height: `${fromHeight}px` }, { height: `${toHeight}px` }],
						{ duration: 280, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'forwards' }
					),
					incoming.animate(
						[
							{ opacity: 0, transform: 'translateY(8px)' },
							{ opacity: 1, transform: 'translateY(0)' }
						],
						{ duration: 220, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'both' }
					)
				];
				settling.push(heightAnimation, enterAnimation);
				await Promise.all([heightAnimation.finished, enterAnimation.finished]);
			}

			// Cancel and unset in the same synchronous block: no frame is painted
			// between them, so the box never flashes back to the height it started
			// from before layout takes over again.
			for (const animation of settling) animation.cancel();
			form.style.removeProperty('height');
			form.style.removeProperty('overflow');
			form.dataset.phase = 'idle';
			form.removeAttribute('aria-busy');
			transitioning = false;
			form.querySelector<HTMLElement>(focusTarget)?.focus();
			form.dispatchEvent(new CustomEvent('demo-step-settled', { detail: { step } }));
			return true;
		};

		const firstStepFields = [...form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-step="1"] input, [data-step="1"] select')];
		form.querySelector('[data-next]')?.addEventListener('click', () => {
			const invalid = firstStepFields.find((field) => !field.checkValidity());
			if (invalid) {
				invalid.reportValidity();
				return;
			}
			void transitionTo(2, '[data-step="2"] input');
		});

		form.querySelector('[data-back]')?.addEventListener('click', () => {
			void transitionTo(1, '[data-step="1"] input');
		});

		const sendButton = form.querySelector<HTMLButtonElement>('[data-send]');
		const sendStatus = form.querySelector<HTMLElement>('[data-send-status]');

		const sayFailed = (message: string) => {
			if (!sendStatus) return;
			sendStatus.dataset.tone = 'error';
			sendStatus.textContent = message;
		};

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (!form.reportValidity()) return;

			const data = new FormData(form);
			const value = (name: string) => String(data.get(name) ?? '').trim();
			const payload = {
				business: value('business'),
				role: value('role'),
				kitchen: value('kitchen'),
				locations: value('locations'),
				workflow: value('workflow'),
				firstName: value('firstName'),
				lastName: value('lastName'),
				email: value('email'),
				phone: value('phone'),
				ticketRef: value('ticketRef')
			};

			if (sendStatus) {
				sendStatus.dataset.tone = 'sending';
				sendStatus.textContent = 'Sending your request…';
			}
			if (sendButton) {
				sendButton.disabled = true;
				sendButton.setAttribute('aria-busy', 'true');
				sendButton.textContent = 'Sending…';
			}
			form.dataset.sendState = 'sending';

			try {
				const response = await fetch('/api/demo-request', {
					method: 'POST',
					headers: { 'content-type': 'application/json', accept: 'application/json' },
					body: JSON.stringify(payload)
				});
				const result = (await response.json()) as { ok: boolean; message?: string };
				if (!response.ok || !result.ok) {
					form.dataset.sendState = 'failed';
					sayFailed(
						result.message ??
							'Your request could not be sent. Everything you typed is still here, so please try again.'
					);
					return;
				}
			} catch {
				form.dataset.sendState = 'failed';
				sayFailed(
					'Your request could not be sent. Everything you typed is still here, so please try again.'
				);
				return;
			} finally {
				if (sendButton) {
					sendButton.disabled = false;
					sendButton.removeAttribute('aria-busy');
					sendButton.textContent = 'Send my demo request';
				}
			}

			// Step 3 says "Sent", so it may not appear until the send has actually
			// returned ok. Everything the visitor typed stays on screen otherwise.
			form.dataset.sendState = 'sent';
			if (sendStatus) {
				sendStatus.dataset.tone = '';
				sendStatus.textContent = '';
			}
			await transitionTo(3, '[data-step="3"]');

			// Only now, with the panel open and at its final width. See the comment
			// on the iframe: a hidden iframe is loaded eagerly by Chrome, not
			// lazily, and Google lays the schedule out once, against whatever
			// viewport it first sees.
			const frame = form.querySelector<HTMLIFrameElement>('[data-booking-frame]');
			if (frame && !frame.src && frame.dataset.bookingSrc) frame.src = frame.dataset.bookingSrc;
		});
	}
</script>

<style>
	.demo-page { overflow: clip; }
	.demo-hero { padding-block: clamp(3.5rem, 7vw, 7rem) clamp(4.5rem, 8vw, 8rem); }
	.demo-hero-grid { display: grid; gap: clamp(3rem, 6vw, 6.5rem); align-items: start; }
	.demo-intro { max-width: 39rem; }
	.demo-intro h1 { font-size: var(--text-display); line-height: 1.02; letter-spacing: -0.02em; font-weight: 600; }
	.demo-lede { margin-top: 1.5rem; max-width: 55ch; color: var(--color-ink-soft); font-size: var(--text-lede); line-height: 1.55; }
	.demo-snap { margin-top: 1.75rem; padding-block: 1rem; border-block: 1px solid var(--color-ticket-rule); font-family: var(--font-display); font-size: var(--text-record-sm); font-weight: 600; color: var(--color-green-deep); }
	.demo-path { margin-top: 2rem; display: grid; gap: 1.2rem; }
	.demo-path li { display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: 0.85rem; align-items: start; position: relative; }
	.demo-path li:not(:last-child)::after { content: ''; position: absolute; top: 2rem; bottom: -1.2rem; left: 0.96rem; width: 1px; background: var(--color-ticket-rule); }
	.path-mark { position: relative; z-index: 1; display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 999px; background: var(--color-softamber); color: var(--color-amber-deep); font-size: var(--text-caption); font-weight: 700; }
	.demo-path strong, .demo-path small { display: block; }
	.demo-path strong { line-height: 1.35; }
	.demo-path small { margin-top: 0.2rem; color: var(--color-ink-soft); font-size: var(--text-body-sm); line-height: 1.45; }

	.demo-ticket { background: var(--color-paper); border: 1px solid var(--color-ticket-rule); box-shadow: var(--shadow-ticket); }
	.ticket-head { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 1.35rem clamp(1.25rem, 3vw, 2rem); border-bottom: 1px solid var(--color-ticket-rule); background: var(--color-cream); color: var(--color-green-deep); }
	.ticket-title { font-family: var(--font-display); font-size: var(--text-record-sm); font-weight: 600; color: var(--color-ink); }
	.ticket-time { margin-top: 0.15rem; font-size: var(--text-body-sm); color: var(--color-ink-soft); }
	.step-status { display: grid; grid-template-columns: auto 1fr auto 1fr auto; align-items: center; gap: 0.65rem; padding: 1rem clamp(1.25rem, 3vw, 2rem); border-bottom: 1px solid var(--color-hairline); font-size: var(--text-caption); color: var(--color-ink-soft); }
	.step-status span[aria-current='step'] { color: var(--color-green-deep); font-weight: 700; }
	.step-rule { height: 1px; background: var(--color-hairline); }
	.demo-form fieldset, .prepared-step { padding: clamp(1.5rem, 4vw, 2.25rem); }
	.demo-form legend { float: left; width: 100%; font-family: var(--font-display); font-size: var(--text-h3); line-height: 1.2; font-weight: 600; }
	.demo-form legend + * { clear: both; }
	.step-copy { padding-top: 0.65rem; color: var(--color-ink-soft); font-size: var(--text-body-sm); line-height: 1.5; }
	.field-grid { display: grid; gap: 1rem; margin-top: 1.5rem; }
	.field { display: grid; gap: 0.45rem; align-content: start; }
	.field > span { font-size: var(--text-body-sm); font-weight: 650; }
	.field small { margin-left: 0.25rem; color: var(--color-ink-soft); font-weight: 400; }
	.field input, .field select, .field textarea { width: 100%; min-height: 48px; border: 1px solid var(--color-ink-rule); border-radius: 0; background: var(--color-paper); padding: 0.72rem 0.8rem; color: var(--color-ink); font: inherit; }
	.field textarea { min-height: 6.5rem; resize: vertical; line-height: 1.45; }
	.field input::placeholder, .field textarea::placeholder { color: color-mix(in srgb, var(--color-ink-soft) 82%, white); opacity: 1; }
	.field input:hover, .field select:hover, .field textarea:hover { border-color: var(--color-green); }
	.field input:focus-visible, .field select:focus-visible, .field textarea:focus-visible { border-color: var(--color-green); outline: 2px solid var(--color-green); outline-offset: 2px; }
	.form-actions { display: flex; justify-content: flex-end; margin-top: 1.5rem; }
	.form-actions-split { justify-content: space-between; align-items: center; gap: 1rem; }
	.safety-note, .prepared-truth { margin-top: 1.1rem; font-size: var(--text-caption); line-height: 1.5; color: var(--color-ink-soft); }
	/* Off-screen rather than display:none or hidden: a bot reading the DOM sees
	   an ordinary field, and no sighted or screen-reader user meets it. */
	.trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
	/* NOT display:none when empty. A display:none element is out of the
	   accessibility tree, so a live region that is hidden until it has something
