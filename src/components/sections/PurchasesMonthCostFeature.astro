---
import FeatureTrialTerms from "../FeatureTrialTerms.astro";
import { featureGroups } from '../../lib/features';
import { cta, demoCta } from '../../lib/site';

const ledgerGroup = featureGroups.find((group) => group.id === 'ledger');
if (!ledgerGroup) throw new Error('Missing public feature group: ledger');

// Labels are the app's (MonthFoodCostHeader on kitchen-brain main):
// "Should have cost (recipe estimate)", "Did cost", "Unaccounted gap"
// (chef review 2026-10-07).
const purchaseSources = [
	{ source: 'Invoice import', record: 'Northline Foods · INV-8831', amount: '$2,184.30' },
	// The whole delivery: 9 × $46.80 chicken, 4 × $18 spinach, 2 × $75 oil.
	{ source: 'Receiving', record: 'PO-1048 · received delivery', amount: '$643.20' },
	{ source: 'Order log', record: 'Harbor wedding · market run', amount: '$186.40' },
	{ source: 'Quick log', record: 'Produce top-up · cash receipt', amount: '$74.20' }
] as const;

const historyRows = [
	// The same packs and prices as PO-1048 on the receiving guide.
	{ label: 'Chicken thigh · 20 lb case', before: '$42.10', after: '$46.80', change: '+11.2%' },
	{ label: 'Baby spinach · 4 lb case', before: '$18.60', after: '$18.00', change: '−3.2%' },
	{ label: 'Olive oil · 1 gal tin', before: '$72.00', after: '$75.00', change: '+4.2%' }
] as const;

const recoveryStates = [
	{ label: 'Late purchase', action: 'Keep its purchase date', note: 'Current cost follows when the purchase happened, not when it was typed.' },
	{ label: 'Wrong amount', action: 'Record a correction and reason', note: 'The correction keeps your reason beside the original amount.' },
	{ label: 'Missing trusted count', action: 'Add counts before viewing turnover', note: 'Stock turnover needs a trusted count at each end of the period.' }
] as const;

// Considered Strategy; not used because the FAQ and evidence rows are static
// editorial data, not interchangeable behavior selected at runtime.
const faqItems = [
	{
		question: 'Where do purchase records come from?',
		answer: 'Type a purchase, import an invoice, record an event purchase or save a delivery. Each entry keeps its source. A whole invoice can be saved together.'
	},
	{
		question: 'What does the month verdict compare?',
		answer: 'It compares ingredient use calculated from orders with recorded purchase spending. The difference is not automatically classified as waste.'
	},
	{
		question: 'How does logged waste affect the gap?',
		answer: 'Logged waste explains part of the difference using the cost saved with that waste record. Any remaining amount stays unexplained.'
	},
	{
		question: 'Can I correct an old purchase?',
		answer: 'Corrections are signed adjustments with a required reason. The adjustment joins the record, so the original history is not silently edited.'
	},
	{
		question: 'When does inventory turnover appear?',
		answer: 'Only when two trusted inventory counts bracket the selected period. Without those rails, CostCook does not manufacture a turnover number.'
	}
] as const;
---

<!-- story: docs/stories/purchases-month-cost.story.md -->
<article class="ledger-page">
	<section class="hero" aria-labelledby="ledger-heading">
		<div class="container-page hero-grid">
			<div class="hero-copy anim-enter">
				<nav aria-label="Breadcrumb" class="feature-breadcrumb"><a href="/features">Every feature</a><span aria-hidden="true">/</span><span>Purchases & month cost</span></nav>
				<h1 id="ledger-heading" class="feature-display">Compare planned food cost with what you spent.</h1>
				<p class="hero-lede">Put your purchases in one place and hold the month’s spending up against what your orders say you should have used. Then look at the gap: what logged waste explains, and what nothing explains yet.</p>
				<div class="hero-actions">
					<a href={cta.href} target={cta.target} rel={cta.rel} aria-label={cta.ariaLabel} class="btn-primary">{cta.label}</a>
					<a href={demoCta.href} target={demoCta.target} rel={demoCta.rel} aria-label={demoCta.ariaLabel} class="btn-quiet">{demoCta.label}</a>
				</div>
				<FeatureTrialTerms />
			</div>

			<figure class="month-sheet ledger-enter">
				<p class="figure-note">Illustrative August close</p>
				<div class="sheet-top"><span>Food-cost review · Aug 1–31</span><span class="status review">Review</span></div>
				<div class="month-working" aria-label="Should have cost 18,420 dollars, did cost 19,135 dollars, difference 715 dollars">
					<div><small>Should have cost</small><strong>$18,420</strong></div>
					<span aria-hidden="true">→</span>
					<div><small>Did cost</small><strong>$19,135</strong></div>
					<div class="difference"><small>Difference</small><strong>+$715</strong></div>
				</div>
				<div class="gap-split"><span><small>Logged waste</small><strong>$286</strong></span><span><small>Unaccounted gap</small><strong>$429</strong></span></div>
				<figcaption>Illustrative amounts. The difference stays open until the supporting records explain it.</figcaption>
			</figure>
		</div>
	</section>

	<section class="problem" aria-labelledby="problem-heading">
		<div class="container-page problem-grid">
			<div><h2 id="problem-heading">A $715 gap is not automatically $715 of waste.</h2><p>Waste explains the part you logged. Late purchases, corrections and shaky counts can explain more of it, or limit what you can say. Whatever is left stays on the page, named, with nobody blamed.</p></div>
			<div class="gap-scene" role="img" aria-label="An illustrative 715 dollar gap separates into 286 dollars of logged waste and 429 dollars still unaccounted">
				<div><small>Month difference</small><strong>$715</strong><span>Needs review</span></div>
				<div class="gap-mark" aria-hidden="true">=</div>
				<div><small>Known + open</small><strong>$286 + $429</strong><span>Waste + unaccounted</span></div>
			</div>
		</div>
	</section>

	<nav class="story-nav container-page" aria-label="On this page">
		<a href="#purchase-ledger"><span>See every purchase source</span><small>Keep imported, received, order, and quick-log entries in one dated record.</small><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5" /></svg></a>
		<a href="#month-close"><span>Explain the month</span><small>Compare what the food should have cost with what it did cost, then keep known and unknown parts distinct.</small><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5" /></svg></a>
	</nav>

	<section id="purchase-ledger" class="product-section ledger-section" aria-labelledby="purchase-ledger-heading">
		<div class="container-page">
			<div class="section-intro"><h2 id="purchase-ledger-heading">Every purchase in one list, however it came in.</h2><p>Import the supplier’s invoice, save a received PO, put spend on an event, or log a single item fast. Each row says where it came from.</p></div>
			<figure class="ledger-sheet">
				<div class="ledger-head"><span>Purchase ledger · illustrative</span><span>August · 47 rows</span></div>
				<div class="line-head"><span>Source</span><span>Record</span><span>Amount</span></div>
				{purchaseSources.map((row) => <div class="ledger-line"><span class="source-tag">{row.source}</span><strong>{row.record}</strong><b>{row.amount}</b></div>)}
				<div class="ledger-foot"><span><strong>History stays attached</strong><small>Source · purchase date · correction trail</small></span><b>$19,135.00</b></div>
				<figcaption>Illustrative month: four of 47 purchase records shown; $19,135 is the total of all 47. Filter by ingredient and date to find a purchase.</figcaption>
			</figure>
		</div>
	</section>

	<section id="month-close" class="product-section close-section" aria-labelledby="month-close-heading">
		<div class="container-page">
			<div class="section-intro"><h2 id="month-close-heading">Make the month show its math.</h2><p>What your orders say the ingredients should have cost sits next to what you actually paid. Logged waste may cover part of the difference. The rest stays open until you look into it.</p></div>
			<figure class="reconciliation">
				<div class="recon-head"><span>August food-cost bridge</span><span>Illustrative amounts</span></div>
				<div class="recon-line"><span>Should have cost (recipe estimate)</span><strong>$18,420</strong></div>
				<div class="recon-line actual"><span>Did cost (what you paid)</span><strong>$19,135</strong></div>
				<div class="recon-line variance"><span>Difference to explain</span><strong>+$715</strong></div>
				<div class="recon-breakdown"><div><small>Explained by logged waste</small><strong>$286</strong><span>Cost saved with the waste record</span></div><div><small>Unaccounted gap</small><strong>$429</strong><span>Kept open for review</span></div></div>
				<figcaption>Illustrative reconciliation. The unaccounted gap is named without being auto-classified as waste.</figcaption>
			</figure>
		</div>
	</section>

	<section class="history" aria-labelledby="history-heading">
		<div class="container-page history-grid">
			<div><h2 id="history-heading">Old numbers stay the way they were.</h2><p>Ingredient prices follow the purchase date. Pick a date range to see what went up and what came down. Fix a wrong amount by adding an adjustment and a reason. The original record stays.</p></div>
			<figure class="history-sheet">
				<div class="history-top"><span>Price movement · illustrative</span><span>Aug 1–31</span></div>
				{historyRows.map((row) => <div class="history-line"><strong>{row.label}</strong><span>{row.before} → {row.after}</span><b>{row.change}</b></div>)}
				<div class="adjustment"><span class="status adjusted">Adjusted</span><strong>Produce receipt +$12.40</strong><small>Reason required · original row retained</small></div>
				<figcaption>Illustrative items, prices, changes, and correction. Signed percentages show direction over the selected window.</figcaption>
			</figure>
		</div>
	</section>

	<section class="recovery" aria-labelledby="recovery-heading">
		<div class="container-page recovery-grid">
			<div><h2 id="recovery-heading">It stops where the records stop.</h2><p>A late purchase keeps its real date. A correction keeps its reason. Turnover waits until you have counts you trust. Each one tells you what to do next.</p></div>
			<div class="recovery-list">{recoveryStates.map((state) => <div><span class="status attention">{state.label}</span><strong>{state.action}</strong><small>{state.note}</small></div>)}</div>
		</div>
	</section>

	<section class="capabilities" aria-labelledby="capabilities-heading">
		<div class="container-page capabilities-grid">
			<div><h2 id="capabilities-heading">What is in Purchases & month cost.</h2><p>Open the details to check what is available today.</p><p class="count"><strong>{ledgerGroup.items.length}</strong><span>shipped capabilities</span></p></div>
			<details id="features-ledger"><summary><span>Purchases & month cost</span><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 7l6 6 6-6" /></svg></summary><ul role="list">{ledgerGroup.items.map((item) => <li><strong>{item.lead}</strong> <span>{item.detail}</span></li>)}</ul></details>
		</div>
	</section>

	<section class="faq" aria-labelledby="faq-heading">
		<div class="container-page faq-grid"><div><h2 id="faq-heading">Frequently asked questions</h2><p>The practical questions behind turning purchase history into a month result without outrunning the evidence.</p></div><div class="faq-list">{faqItems.map((item) => <details><summary><span>{item.question}</span><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 7l6 6 6-6" /></svg></summary><p>{item.answer}</p></details>)}</div></div>
	</section>

	<section class="closing" aria-labelledby="closing-heading">
		<div class="container-page closing-grid"><div><h2 id="closing-heading">Close the month with the known and unknown parts still visible.</h2><p>Bring one real month. Put every purchase in and check the result against the records behind it.</p></div><div class="closing-actions"><a href={cta.href} target={cta.target} rel={cta.rel} aria-label={cta.ariaLabel} class="btn-primary">{cta.label}</a><a href={demoCta.href} target={demoCta.target} rel={demoCta.rel} aria-label={demoCta.ariaLabel} class="btn-quiet">{demoCta.label}</a></div></div>
		<div class="container-page onward feature-onward"><a href="/features">See every CostCook feature</a></div>
	</section>
</article>

<style>
	.ledger-page { overflow: clip; }
	.hero { border-block: 1px solid var(--color-hairline); background: var(--color-cream); }
	.hero-grid { display: grid; gap: clamp(3rem, 6vw, 6.5rem); align-items: center; padding-block: clamp(4rem, 7vw, 7.5rem); }
	.hero h1 { max-width: 13ch; margin-top: 1.5rem; }
	.hero-lede { max-width: 56ch; margin-top: 1.75rem; font-size: var(--text-lede); line-height: 1.55; color: var(--color-ink-soft); }
	.hero-actions, .closing-actions { display: flex; flex-wrap: wrap; gap: .85rem; margin-top: 2rem; }
	.figure-note { margin-bottom: .7rem; font-size: var(--text-label-sm); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--color-amber-deep); }
	.month-sheet, .ledger-sheet, .reconciliation, .history-sheet { min-width: 0; background: var(--color-paper); box-shadow: var(--shadow-ticket); }
	.month-sheet { padding: clamp(1.15rem, 3vw, 1.75rem); }
	.sheet-top, .ledger-head, .line-head, .recon-head, .history-top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .3rem 1rem; font-size: var(--text-micro); font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: var(--color-ink-soft); }
	.status { display: inline-flex; width: fit-content; align-items: center; min-height: 24px; padding: .2rem .55rem; border-radius: 999px; font-family: var(--font-body); font-size: var(--text-micro); font-weight: 700; font-style: normal; letter-spacing: .04em; text-transform: uppercase; }
	.status.review, .status.attention { background: var(--color-softamber); color: var(--color-amber-deep); }
	.status.adjusted { background: var(--color-softgreen); color: var(--color-green-deep); }
	.month-working { display: grid; grid-template-columns: 1fr auto 1fr; gap: .65rem; align-items: center; margin-top: 1.15rem; }
	.month-working > div { padding: .85rem; background: var(--color-cream); }
	.month-working > span { color: var(--color-amber-deep); font-family: var(--font-display); font-size: var(--text-record-sm); }
	.month-working .difference { grid-column: 1 / -1; display: flex; justify-content: space-between; align-items: baseline; border-top: 2px solid var(--color-amber-deep); background: var(--color-softamber); }
	.month-working small, .gap-split small, .recon-breakdown small { display: block; color: var(--color-ink-soft); font-size: var(--text-micro); }
	.month-working strong { display: block; margin-top: .2rem; font-size: var(--text-record); font-variant-numeric: tabular-nums; }
	.month-working .difference strong { color: var(--color-amber-deep); }
	.gap-split { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; margin-top: 1px; background: var(--color-ticket-rule); }
	.gap-split span { display: flex; justify-content: space-between; gap: .75rem; padding: .75rem .85rem; background: var(--color-paper); }
	.gap-split strong { font-variant-numeric: tabular-nums; }
	.month-sheet figcaption, .ledger-sheet figcaption, .reconciliation figcaption, .history-sheet figcaption { margin-top: .8rem; font-size: var(--text-label-sm); line-height: 1.45; color: var(--color-ink-soft); }
	.problem { border-bottom: 1px solid var(--color-hairline); background: var(--color-paper); }
	.problem-grid, .history-grid, .recovery-grid { display: grid; gap: 3rem; align-items: center; padding-block: var(--spacing-section-tight); }
	.problem h2, .section-intro h2, .history h2, .recovery h2, .capabilities h2, .faq h2, .closing h2 { font-size: var(--text-h2); font-weight: 600; line-height: 1.12; }
	.problem p, .section-intro p, .history-grid > div > p, .recovery-grid > div > p, .capabilities-grid > div > p, .faq-grid > div > p, .closing p { max-width: 60ch; margin-top: 1.1rem; color: var(--color-ink-soft); line-height: 1.65; }
	.gap-scene { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: 1rem; align-items: center; }
	.gap-scene > div:not(.gap-mark) { padding: 1.35rem; border-top: 2px solid var(--color-ticket-rule); background: var(--color-cream); }
	.gap-scene small, .gap-scene span { display: block; color: var(--color-ink-soft); }
	.gap-scene strong { display: block; margin-block: .4rem; font-size: var(--text-record); font-variant-numeric: tabular-nums; }
	.gap-mark { color: var(--color-amber-deep); font-family: var(--font-display); font-size: var(--text-record); }
	.story-nav { display: grid; padding-block: 1.25rem; }
	.story-nav a { display: grid; min-height: 84px; grid-template-columns: 1fr auto; gap: .25rem 1rem; align-content: center; padding: 1.2rem 0; border-bottom: 1px solid var(--color-ticket-rule); color: var(--color-ink); }
	.story-nav a:first-child { border-top: 1px solid var(--color-ticket-rule); }
	.story-nav span { font-weight: 700; }
	.story-nav small { max-width: 48ch; color: var(--color-ink-soft); }
	.story-nav svg, summary svg { grid-column: 2; grid-row: 1 / 3; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; color: var(--color-green-deep); }
	.product-section { scroll-margin-top: 1rem; padding-block: var(--spacing-section); }
	.ledger-section { background: var(--color-softgreen); }
	.close-section { background: var(--color-cream); }
	.section-intro { display: grid; gap: 1.5rem 4rem; align-items: end; }
	.section-intro p { margin-top: 0; }
	.ledger-sheet, .reconciliation { margin-top: clamp(2.5rem, 6vw, 4.5rem); }
	.ledger-head, .recon-head, .history-top { padding: 1rem clamp(1rem, 3vw, 1.75rem); background: var(--color-ink); color: var(--color-paper); }
	.line-head, .ledger-line { display: grid; grid-template-columns: minmax(0, .65fr) minmax(0, 1.5fr) minmax(0, .55fr); gap: 1rem; align-items: center; padding: .85rem clamp(1rem, 3vw, 1.75rem); }
	.line-head, .ledger-line { border-bottom: 1px solid var(--color-hairline); }
	.ledger-line b { justify-self: end; font-variant-numeric: tabular-nums; }
	.source-tag { width: fit-content; color: var(--color-green-deep); font-size: var(--text-label-sm); font-weight: 700; }
	.ledger-foot { display: flex; justify-content: space-between; gap: 1rem; align-items: center; padding: 1rem clamp(1rem, 3vw, 1.75rem); border-top: 2px solid var(--color-green); }
	.ledger-foot small { display: block; color: var(--color-ink-soft); }
	.ledger-foot > b { color: var(--color-green-deep); font-variant-numeric: tabular-nums; }
	.ledger-sheet figcaption, .reconciliation figcaption, .history-sheet figcaption { padding: 0 clamp(1rem, 3vw, 1.75rem) 1rem; }
	.recon-line { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; padding: 1rem clamp(1rem, 3vw, 1.75rem); border-bottom: 1px solid var(--color-hairline); }
	.recon-line strong { font-variant-numeric: tabular-nums; }
	.recon-line.actual { background: var(--color-cream); }
	.recon-line.variance { border-top: 2px solid var(--color-amber-deep); background: var(--color-softamber); color: var(--color-amber-deep); font-weight: 700; }
	.recon-breakdown { display: grid; grid-template-columns: 1fr 1fr; }
	.recon-breakdown > div { padding: 1.2rem clamp(1rem, 3vw, 1.75rem); border-right: 1px solid var(--color-ticket-rule); }
	.recon-breakdown > div:last-child { border-right: 0; }
	.recon-breakdown strong { display: block; margin-block: .35rem; font-size: var(--text-record); font-variant-numeric: tabular-nums; }
	.recon-breakdown span { color: var(--color-ink-soft); font-size: var(--text-caption); }
	.history { background: var(--color-paper); }
	.history-line { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 1rem; padding: .9rem clamp(1rem, 3vw, 1.75rem); border-bottom: 1px solid var(--color-hairline); }
	.history-line span, .history-line b { font-variant-numeric: tabular-nums; }
	.history-line span { color: var(--color-ink-soft); }
	.history-line b { min-width: 5ch; text-align: right; color: var(--color-green-deep); }
	.adjustment { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: .4rem 1rem; padding: 1rem clamp(1rem, 3vw, 1.75rem); background: var(--color-softgreen); }
	.adjustment strong { align-self: center; }
	.adjustment small { grid-column: 2; color: var(--color-ink-soft); }
	.recovery { background: var(--color-ink); color: var(--color-paper); }
	.recovery-grid > div > p { color: var(--color-ink-muted); }
	.recovery-list { border-block: 1px solid var(--color-ticket-rule); }
	.recovery-list > div { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: .45rem 1rem; padding: 1rem 0; border-bottom: 1px solid var(--color-ticket-rule); }
	.recovery-list > div:last-child { border-bottom: 0; }
	.recovery-list strong { align-self: center; }
	.recovery-list small { grid-column: 2; color: var(--color-ink-muted); }
	.capabilities { padding-block: var(--spacing-section); background: var(--color-offwhite); }
	.capabilities-grid, .faq-grid { display: grid; gap: 3rem; }
	.count { display: flex; align-items: baseline; gap: .75rem; }
	.count strong { font-family: var(--font-display); font-size: var(--text-h2); color: var(--color-green-deep); }
	.count span { font-size: var(--text-caption); color: var(--color-ink-soft); }
	details summary { cursor: pointer; list-style: none; }
	details summary::-webkit-details-marker { display: none; }
	.capabilities details { scroll-margin-top: 1rem; border-block: 1px solid var(--color-ticket-rule); }
	.capabilities summary, .faq summary { display: flex; min-height: 64px; align-items: center; justify-content: space-between; gap: 1rem; font-weight: 700; }
	.capabilities details[open] summary, .faq details[open] summary { color: var(--color-green-deep); }
	.capabilities details[open] summary svg, .faq details[open] summary svg { transform: rotate(180deg); }
	.capabilities summary svg, .faq summary svg { flex: 0 0 auto; transition: transform 150ms ease-out; }
	.capabilities details ul { padding-bottom: 1.5rem; }
	.capabilities details li { padding-block: .75rem; border-top: 1px solid var(--color-hairline); line-height: 1.5; }
	.capabilities details li span { color: var(--color-ink-soft); }
	.faq { padding-block: var(--spacing-section); border-top: 1px solid var(--color-hairline); background: var(--color-paper); }
	.faq-list details { border-top: 1px solid var(--color-ticket-rule); }
	.faq-list details:last-child { border-bottom: 1px solid var(--color-ticket-rule); }
	.faq-list summary { padding-block: .7rem; }
	.faq-list details p { max-width: 64ch; padding: 0 2.5rem 1.35rem 0; color: var(--color-ink-soft); line-height: 1.6; }
	.closing { border-top: 1px solid var(--color-hairline-strong); background: var(--color-softgreen); }
	.closing-grid { display: grid; gap: 2rem; align-items: center; padding-block: var(--spacing-section-tight); }
	.onward { padding-block: 1.4rem; border-top: 1px solid var(--color-hairline-strong); }

	/* REFLOW AT 200% TEXT (issue #79): a grid with no column template sizes
	   its one track to its content, so at 200% text on a phone the layout
	   grew past the screen and its right edge was cut off. One shrinkable
	   track below the breakpoints; label-and-value rows wrap. */
	.problem-grid, .history-grid, .recovery-grid, .section-intro, .faq-grid, .closing-grid { grid-template-columns: minmax(0, 1fr); }

	@media (min-width: 720px) {
		.hero-grid { grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); }
		.problem-grid, .section-intro, .history-grid, .recovery-grid, .faq-grid, .closing-grid { grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); }
