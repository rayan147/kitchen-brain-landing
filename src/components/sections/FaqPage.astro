---
import FeatureTrialTerms from '../FeatureTrialTerms.astro';
import { faq, faqCount } from '../../lib/faq';
import { contactCta, cta, demoCta, launchPlan } from '../../lib/site';
import SageIcon from '../SageIcon.astro';

type GroupGuide = {
	description: string;
	shortLabel: string;
};

const groupGuides: Record<string, GroupGuide> = {
	money: {
		shortLabel: 'Money',
		description: 'What you pay, when the card gets charged, and how to walk away.'
	},
	fit: {
		shortLabel: 'Fit',
		description: 'The kind of kitchen it suits, and the limits that could rule it out for yours.'
	},
	how: {
		shortLabel: 'The work',
		description: 'What happens to a quote once it is real: the buy, the truck, the shelf, the prep and the pack.'
	},
	start: {
		shortLabel: 'Getting started',
		description: 'Getting your prices and recipes in, using it on a phone, and who picks up when you write.'
	}
};

const decisionFacts = [
	{ term: 'Trial', value: `${launchPlan.trialDays} days at $0`, href: '#trial' },
	{ term: 'Card', value: 'Required via Stripe', href: '#card' },
	{ term: 'First charge', value: `Day ${launchPlan.trialDays + 1}`, href: '#trial' },
	{ term: 'Cancel', value: 'Settings → Billing', href: '#cancel' }
] as const;

// Considered Template Method; not used because this read-first reference route
// has one fixed composition, not an algorithm whose steps vary by page subtype.
---

<!-- story: docs/stories/faq.story.md -->
<div class="faq-page">
	<section class="faq-hero" aria-labelledby="faq-title">
		<div class="container-page faq-hero-grid">
			<div class="faq-hero-copy">
				<h1 id="faq-title">Questions before you try CostCook?</h1>
				<p>
					Straight answers on the money, the fit, and the catch. All {faqCount} are open on this page, so read the ones you came for.
				</p>
				<div class="hero-actions">
					<a class="btn-quiet" href="#money">Read the trial and billing answers</a>
					<a class="btn-quiet hero-contact" href={contactCta.href}>{contactCta.label}</a>
				</div>
			</div>

			<aside class="decision-ticket" aria-labelledby="decision-ticket-title">
				<div class="ticket-heading">
					<h2 id="decision-ticket-title">Before you start</h2>
					<span>{launchPlan.displayPrice}</span>
				</div>
				<dl>
					{
						decisionFacts.map((fact) => (
							<a href={fact.href}>
								<div>
									<dt>{fact.term}</dt>
									<dd>{fact.value}</dd>
								</div>
								<svg width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true">
									<path d="M1 6h13M10 2l4 4-4 4" />
								</svg>
							</a>
						))
					}
				</dl>
				<p>Per kitchen. Cancel before day 16 to avoid the first charge.</p>
			</aside>
		</div>
	</section>

	<nav class="question-map" aria-label="Question groups">
		<div class="container-page question-map-inner">
			<p>Jump to a topic</p>
			<ul role="list">
				{
					faq.map((group) => (
						<li>
							<a href={`#${group.id}`}>
								<span>{groupGuides[group.id].shortLabel}</span>
								<small>{group.entries.length} answers</small>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</nav>

	<div class="container-page faq-chapters">
		{
			faq.map((group) => (
				<section id={group.id} class="faq-chapter" aria-labelledby={`${group.id}-title`}>
					<header class="chapter-heading">
						<h2 id={`${group.id}-title`}>{group.title}</h2>
						<div>{groupGuides[group.id].description}</div>
						<a href="#faq-title">Back to the top</a>
					</header>

					<dl class="answer-list">
						{group.entries.map((entry) => (
							<div
								id={entry.id}
								data-faq-entry
								data-snap-question={entry.id === 'guests' ? '' : undefined}
								class:list={['answer-row', entry.id === 'guests' && 'answer-row-snap', entry.icon === 'sage' && 'answer-row-sage']}
							>
								<dt>
									{entry.icon === 'sage' && <SageIcon size={24} context="faq" />}
									<span>{entry.question}</span>
								</dt>
								{entry.answer.map((paragraph) => <dd set:html={paragraph} />)}
							</div>
						))}
					</dl>
				</section>
			))
		}

		<section class="faq-close" aria-labelledby="faq-close-title" data-sticky-end>
			<div>
				<h2 id="faq-close-title">Put one real order through it.</h2>
				<p>
					Bring a menu and a guest count you already quoted. See what comes back before
					you move the rest of the kitchen.
				</p>
			</div>
			<div class="close-actions">
				<a href={cta.href} target={cta.target} rel={cta.rel} aria-label={cta.ariaLabel} class="btn-primary">
					{cta.label}
				</a>
				<a href={demoCta.href} target={demoCta.target} rel={demoCta.rel} aria-label={demoCta.ariaLabel} class="btn-quiet">
					{demoCta.label}
				</a>
				<FeatureTrialTerms />
			</div>
		</section>
	</div>
</div>

<style>
  /* Keep the decision ticket and actions inside the reading width at 200% text. */
  .faq-hero-grid > * { min-width: 0; }
  .hero-actions a, .close-actions a { max-width: 100%; overflow-wrap: anywhere; }
  .ticket-heading { flex-wrap: wrap; }
  .decision-ticket dl a > div { min-width: 0; }

	/* Cream, like the header above it, so the bar and the hero are one
	   surface (owner, 2026-10-07). The ticket moves to paper to stay a ticket
	   on it, and its torn edge is cut in the hero's cream. */
	.faq-hero {
		padding-block: clamp(3.5rem, 7vw, 7rem);
		background: var(--color-cream);
	}

	.faq-hero-grid {
		display: grid;
		gap: clamp(3rem, 7vw, 7rem);
		align-items: center;
	}

	.faq-hero-copy h1 {
        overflow-wrap: anywhere;
		max-width: 12ch;
		font-size: clamp(2.8rem, 2rem + 3.5vw, 5.25rem);
		font-weight: 600;
		line-height: 0.98;
		letter-spacing: -0.025em;
	}

	.faq-hero-copy > p {
		max-width: 56ch;
		margin-top: 1.5rem;
		font-size: var(--text-lede);
		line-height: 1.55;
		color: var(--color-ink-soft);
	}

	.hero-actions,
	.close-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		/* 1.5rem rows: btn-quiet's tap area reaches .75rem past its text. */
		gap: 1.5rem;
		margin-top: 2rem;
	}

	.hero-contact {
		min-height: 44px;
	}

	.decision-ticket {
		position: relative;
		background: var(--color-paper);
		box-shadow: var(--shadow-ticket);
	}

	.decision-ticket::before,
	.decision-ticket::after {
		position: absolute;
		inset-inline: 0;
		height: 8px;
		content: '';
		background: linear-gradient(135deg, var(--color-cream) 4px, transparent 0) 0 0 / 8px 8px repeat-x;
	}

	.decision-ticket::before {
		top: -1px;
	}

	.decision-ticket::after {
		bottom: -1px;
		transform: rotate(180deg);
	}

	.ticket-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding: 2rem 2rem 1.25rem;
		border-bottom: 1px solid var(--color-ticket-rule);
	}

	.ticket-heading h2 {
		font-size: 1.45rem;
		font-weight: 600;
	}

	.ticket-heading span {
		font-variant-numeric: tabular-nums;
		font-weight: 700;
		color: var(--color-green-deep);
	}

	.decision-ticket dl a {
		display: flex;
		min-height: 64px;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.9rem 2rem;
		border-bottom: 1px solid var(--color-ticket-rule);
		transition: background-color 150ms ease-out;
	}

	@media (hover: hover) {
		.decision-ticket dl a:hover {
			background: var(--color-softamber);
		}
	}

	.decision-ticket dl div {
		display: grid;
		grid-template-columns: minmax(6rem, 0.7fr) minmax(8rem, 1fr);
		gap: 1rem;
		width: 100%;
	}

	.decision-ticket dt {
		color: var(--color-ink-soft);
	}

	.decision-ticket dd {
		font-weight: 700;
		font-variant-numeric: tabular-nums;
	}

	.decision-ticket svg {
		flex: 0 0 auto;
		stroke: var(--color-green-deep);
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.decision-ticket > p {
		padding: 1.25rem 2rem 1.75rem;
		font-size: 0.875rem;
		color: var(--color-ink-soft);
	}

	.question-map {
		border-block: 1px solid var(--color-ticket-rule);
		background: var(--color-paper);
	}

	.question-map-inner {
		display: grid;
		gap: 1rem;
		padding-block: 1.25rem;
	}

	.question-map-inner > p {
		align-self: center;
		font-size: 0.875rem;
		font-weight: 700;
		color: var(--color-ink-soft);
	}

	.question-map ul {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.5rem 1rem;
	}

	.question-map a {
		display: flex;
		min-height: 52px;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		border-bottom: 1px solid var(--color-hairline);
		font-weight: 700;
		transition: border-color 150ms ease-out, color 150ms ease-out;
	}

	@media (hover: hover) {
		.question-map a:hover {
			border-color: var(--color-green);
			color: var(--color-green-deep);
		}
	}

	.question-map small {
		font-size: 0.75rem;
		font-weight: 500;
		white-space: nowrap;
		color: var(--color-ink-soft);
	}

	.faq-chapter {
		display: grid;
		gap: clamp(2.5rem, 6vw, 6rem);
		padding-block: var(--spacing-section-tight);
		border-bottom: 1px solid var(--color-hairline);
		scroll-margin-top: 1rem;
	}

	.chapter-heading h2 {
		max-width: 12ch;
		font-size: var(--text-h2);
		font-weight: 600;
	}

	.chapter-heading > div {
		max-width: 36ch;
		margin-top: 1.25rem;
		line-height: 1.6;
		color: var(--color-ink-soft);
	}

	.chapter-heading > a {
		display: inline-flex;
		min-height: 44px;
		align-items: center;
		margin-top: 1rem;
		font-size: 0.875rem;
		font-weight: 700;
		color: var(--color-green-deep);
		text-decoration: underline;
		text-decoration-color: var(--color-hairline);
		text-underline-offset: 4px;
	}

	.answer-row {
		padding-block: 1.75rem;
		border-top: 1px solid var(--color-ticket-rule);
		scroll-margin-top: 1rem;
	}

	.answer-row:first-child {
		padding-top: 0;
		border-top: 0;
	}

	.answer-row dt {
		max-width: 38ch;
		font-family: var(--font-display);
		font-size: var(--text-h3);
		font-weight: 600;
		line-height: 1.25;
		text-wrap: balance;
	}

	.answer-row-sage dt {
		display: flex;
		align-items: center;
		gap: .75rem;
		color: var(--color-green-deep);
	}

	.answer-row-sage dt span {
		color: var(--color-ink);
	}

	.answer-row dd {
		max-width: 68ch;
		margin-top: 0.75rem;
		line-height: 1.65;
		color: var(--color-ink-soft);
	}

	.answer-row :global(a) {
		font-weight: 700;
		color: var(--color-green-deep);
		text-decoration: underline;
		text-decoration-color: var(--color-hairline);
		text-underline-offset: 4px;
	}

	.answer-row-snap {
		margin-block: 1rem;
		padding: clamp(1.5rem, 4vw, 2.5rem);
		border: 0;
		background: var(--color-softgreen);
	}

	.answer-row-snap dt {
		max-width: 24ch;
		font-size: clamp(1.5rem, 1.25rem + 1.1vw, 2.25rem);
	}

	.answer-row-snap dd:first-of-type {
		font-family: var(--font-display);
		font-size: 1.35rem;
		font-weight: 650;
		color: var(--color-green-deep);
	}

	.faq-close {
		display: grid;
		gap: 2.5rem;
		align-items: end;
		margin-block: var(--spacing-section-tight);
		padding: clamp(2rem, 5vw, 4rem);
		background: var(--color-softgreen);
	}

	.faq-close h2 {
		max-width: 15ch;
		font-size: var(--text-h2);
		font-weight: 600;
	}

	.faq-close p {
		max-width: 54ch;
		margin-top: 1rem;
		font-size: var(--text-lede);
		line-height: 1.55;
		color: var(--color-ink-soft);
	}

	.close-actions {
		margin-top: 0;
	}

	@media (min-width: 48rem) {
		.faq-hero-grid {
			grid-template-columns: minmax(0, 1.05fr) minmax(22rem, 0.95fr);
		}

		.question-map-inner {
			grid-template-columns: minmax(10rem, 0.45fr) minmax(0, 1.55fr);
		}

		.question-map ul {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.question-map a {
			align-items: flex-start;
			flex-direction: column;
			justify-content: center;
			gap: 0.2rem;
		}

		.faq-chapter {
			grid-template-columns: minmax(14rem, 0.65fr) minmax(0, 1.35fr);
		}

		.chapter-heading {
			position: sticky;
			top: 2rem;
			align-self: start;
		}

		.faq-close {
			grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
		}
	}

	@media (max-width: 35rem) {
		.faq-hero-copy h1 {
			font-size: clamp(2.55rem, 12vw, 3.4rem);
		}

		.hero-actions,
		.close-actions {
			align-items: stretch;
			flex-direction: column;
		}

		/* The trial fills the width; quiet links stay left under the copy. */
		.hero-actions .btn-primary,
		.close-actions .btn-primary {
			justify-content: center;
			width: 100%;
		}

		.ticket-heading,
		.decision-ticket dl a,
		.decision-ticket > p {
			padding-inline: 1.25rem;
		}

		.decision-ticket dl div {
			grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr);
            overflow-wrap: anywhere;
		}

		.question-map ul {
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.decision-ticket {
			animation: faq-ticket-land 800ms cubic-bezier(0.22, 1, 0.36, 1) both;
		}

		.decision-ticket:has(:focus-visible) {
			animation: none;
		}
	}

	@keyframes faq-ticket-land {
		from {
			opacity: 0;
			clip-path: inset(0 0 14% 0);
			transform: translateY(18px) rotate(0.6deg);
			box-shadow: 0 1px 2px rgb(31 36 33 / 0.02), 0 2px 4px rgb(31 36 33 / 0.02);
		}
	}
</style>
