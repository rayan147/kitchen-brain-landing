---
import FeatureTrialTerms from '../FeatureTrialTerms.astro';
import { cta, demoCta } from '../../lib/site';

const fitSignals = [
	{
		title: 'Catering and private events',
		body: 'Each job has its own menu, date, guest count, and price to defend.'
	},
	{
		title: 'Restaurant event work',
		body: 'Regular service stays regular while special dinners and catering get their own plans.'
	},
	{
		title: 'Meal prep and dated production',
		body: 'You buy and make for a delivery date, a batch, or a changing head count.'
	},
	{
		title: 'Menus that keep changing',
		body: 'Recipes, quantities, buying, and food cost need to follow the latest plan.'
	}
] as const;

const workPath = [
	{ label: 'Menu + guests', href: '/features/menus-and-quotes', note: 'Set the dated plan.' },
	{ label: 'Recipes', href: '/features/recipes-and-costing', note: 'Scale the food.' },
	{ label: 'Shop · Prep · Pack', href: '/features/order-shop-prep-pack', note: 'Run the kitchen.' },
	{ label: 'Purchases + cost', href: '/features/purchases-and-month-cost', note: 'See what was spent.' }
] as const;

const limits = [
	'Stock counts and combined reporting across several kitchens.',
	'Lot tracking for a facility operating under FSMA 204 traceability rules.',
	'Hiding cost screens from selected teammates. Staff can open recipe costs and Analytics.'
] as const;
---

<!-- story: docs/stories/who-its-for.story.md -->
<article class="audience-page">
	<section class="audience-hero" aria-labelledby="audience-heading">
		<div class="container-page hero-layout">
			<div class="hero-copy">
				<nav aria-label="Breadcrumb" class="breadcrumb">
					<a href="/">Home</a><span aria-hidden="true">/</span><span>Who it's for</span>
				</nav>
				<h1 id="audience-heading">Is CostCook right for your kitchen?</h1>
				<p class="hero-lede">
					If you cost changing menus and buy for a date and guest count, start here. CostCook connects recipes, shopping, prep and packing for one kitchen.
				</p>
				<div class="hero-actions">
					<a href="#fit-test" class="btn-quiet">Check your kitchen’s needs</a>
					<a href="#limits-heading" class="btn-quiet">See what is not supported</a>
				</div>
			</div>

			<figure class="service-ticket" aria-labelledby="service-ticket-title">
				<div class="ticket-head">
					<p id="service-ticket-title">One kitchen · two kinds of service</p>
					<span>This week</span>
				</div>
				<div class="service-plans">
					<div class="service-plan recurring">
						<span>Tuesday</span>
						<h2>Regular service</h2>
						<p>House menu</p>
						<small>Your regular service</small>
					</div>
					<div class="ticket-stitch" aria-hidden="true"><span></span></div>
					<div class="service-plan event">
						<span>Saturday</span>
						<h2>Private dinner</h2>
						<p>Dated menu + guest count</p>
						<small>Plan this event in CostCook</small>
					</div>
				</div>
				<figcaption>The same kitchen can run Tuesday service and Saturday's private dinner.</figcaption>
			</figure>
		</div>
	</section>

	<section id="fit-test" class="fit-test" aria-labelledby="fit-heading">
		<div class="container-page fit-layout">
			<div class="section-copy">
				<h2 id="fit-heading">Look at the calendar, not the category.</h2>
				<p>
					CostCook fits the part of your kitchen that begins with a menu, a date, and a guest count.
					Your business can do that work all the time or alongside regular restaurant service.
				</p>
			</div>
			<ul role="list" class="fit-signals">
				{fitSignals.map((signal) => <li><h3>{signal.title}</h3><p>{signal.body}</p></li>)}
			</ul>
		</div>
	</section>

	<section class="work-together" aria-labelledby="work-heading">
		<div class="container-page">
			<div class="section-copy">
				<h2 id="work-heading">When the event moves, the working plan moves with it.</h2>
				<p>
					CostCook carries the dated plan through recipe quantities, shopping, prep, pack,
					purchasing, and food cost. Regular service can keep its own rhythm beside it.
				</p>
			</div>
			<ol class="work-path">
				{workPath.map((step, index) => (
					<li>
						<a href={step.href}>
							<span class="path-index">{index + 1}</span>
							<strong>{step.label}</strong>
							<small>{step.note}</small>
							<svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M3 9h11M10 5l4 4-4 4" /></svg>
						</a>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="limits-section" aria-labelledby="limits-heading">
		<div class="container-page limits-layout">
			<div>
				<h2 id="limits-heading">Fit also means knowing where it stops.</h2>
				<p>
					CostCook does not support these three requirements. If any is essential to your kitchen, compare the alternatives before starting a trial.
				</p>
				<a href="/compare" class="btn-quiet">Read the full product comparison</a>
			</div>
			<div class="limits-ticket">
				<p>Before you start</p>
				<ul role="list">{limits.map((limit) => <li>{limit}</li>)}</ul>
			</div>
		</div>
	</section>

	<section class="audience-close" aria-labelledby="close-heading">
		<div class="container-page close-layout">
			<div>
				<h2 id="close-heading">Bring one real menu and one guest count.</h2>
				<p>See whether CostCook matches the work you need to price and run next.</p>
			</div>
			<!-- Considered Composite; not used because this is a fixed pair of
                 content groups. Bounded columns keep billing text from shrinking the heading. -->
            <div class="closing-decision">
                <div class="close-actions">
				<a href={cta.href} target={cta.target} rel={cta.rel} aria-label={cta.ariaLabel} class="btn-primary">{cta.label}</a>
				<a href={demoCta.href} target={demoCta.target} rel={demoCta.rel} aria-label={demoCta.ariaLabel} class="btn-quiet">{demoCta.label}</a>
			</div>
                <FeatureTrialTerms />
            </div>
		</div>
	</section>
</article>

<style>
    .closing-decision { min-width: 0; }
  /* The real caption owns its separator; a positioned rule could cross wrapped text. */
  .service-ticket::after { display: none; }
  .service-ticket figcaption { border-top: 1px dashed var(--color-ticket-rule); }

	.audience-page { overflow: clip; }
	.audience-hero { padding: clamp(3.5rem, 7vw, 7rem) 0 clamp(4.5rem, 8vw, 8rem); }
	.hero-layout { display: grid; align-items: center; gap: clamp(3rem, 7vw, 6.5rem); }
	.hero-copy { max-width: 42rem; }
	.breadcrumb { display: flex; min-height: 2.75rem; align-items: center; gap: .6rem; color: var(--color-ink-soft); font-size: .875rem; }
	.breadcrumb a { display: inline-flex; min-height: 2.75rem; align-items: center; text-decoration: underline; text-decoration-color: var(--color-hairline); text-underline-offset: .25rem; }
	h1 { max-width: 12ch; font-family: var(--font-display); font-size: clamp(2.65rem, 6.3vw, 5.75rem); font-weight: 600; line-height: .98; letter-spacing: -.035em; }
	.hero-lede { max-width: 62ch; margin-top: 1.5rem; color: var(--color-ink-soft); font-size: clamp(1.125rem, 1.5vw, 1.35rem); line-height: 1.6; }
	.hero-actions, .close-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.25rem; margin-top: 2rem; }
	.service-ticket { position: relative; border: 1px solid var(--color-ticket-rule); background: var(--color-paper); box-shadow: var(--shadow-ticket); transform: rotate(1deg); animation: ticket-settle 760ms cubic-bezier(.16, 1, .3, 1) both; }
	.service-ticket::before, .service-ticket::after { position: absolute; left: .75rem; width: calc(100% - 1.5rem); border-top: 1px dashed var(--color-ticket-rule); content: ''; }
	.service-ticket::before { top: 3.6rem; }
	.service-ticket::after { bottom: 3.35rem; }
	.ticket-head { display: flex; min-height: 3.6rem; align-items: center; justify-content: space-between; gap: 1rem; padding: .8rem 1.25rem; color: var(--color-amber-deep); font-family: var(--font-body); font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
	.ticket-head span { color: var(--color-ink-soft); }
	.service-plans { display: grid; padding: 1.5rem 1.25rem; }
	.service-plan { min-width: 0; padding: 1rem .75rem; }
	.service-plan > span { color: var(--color-amber-deep); font-size: .78rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
	.service-plan h2 { margin-top: .7rem; font-family: var(--font-display); font-size: clamp(1.55rem, 2.4vw, 2.15rem); font-weight: 600; line-height: 1.1; }
	.service-plan p { margin-top: .75rem; font-weight: 650; }
	.service-plan small { display: block; margin-top: .3rem; color: var(--color-ink-soft); line-height: 1.45; }
	.ticket-stitch { display: flex; align-items: center; padding: .25rem .75rem; }
	.ticket-stitch span { width: 100%; border-top: 1px dashed var(--color-ticket-rule); }
	.service-ticket figcaption { padding: 1rem 1.25rem 1.15rem; font-size: .9rem; font-weight: 650; line-height: 1.5; }
	.fit-test, .limits-section { border-block: 1px solid var(--color-hairline); background: var(--color-paper); }
	.fit-test, .work-together, .limits-section { padding: clamp(4.5rem, 8vw, 8rem) 0; }
	.fit-layout, .limits-layout { display: grid; gap: 3rem; }
	.section-copy { max-width: 43rem; }
	.section-copy h2, .limits-layout h2, .audience-close h2 { max-width: 17ch; font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3.25rem); font-weight: 600; line-height: 1.08; letter-spacing: -.025em; }
	.section-copy p, .limits-layout > div:first-child > p, .audience-close p { max-width: 65ch; margin-top: 1.25rem; color: var(--color-ink-soft); font-size: 1.05rem; line-height: 1.7; }
	.fit-signals { border-top: 1px solid var(--color-hairline); }
	.fit-signals li { display: grid; gap: .65rem 2rem; padding: 1.35rem 0; border-bottom: 1px solid var(--color-hairline); }
	.fit-signals h3 { font-size: 1.05rem; font-weight: 700; }
	.fit-signals p { max-width: 47ch; color: var(--color-ink-soft); line-height: 1.55; }
	.work-path { display: grid; margin-top: 3rem; border-block: 1px solid var(--color-hairline); }
	.work-path li + li { border-top: 1px solid var(--color-hairline); }
	.work-path a { display: grid; min-height: 6.5rem; grid-template-columns: 2rem minmax(0, 1fr) auto; align-items: center; gap: .75rem; padding: 1rem .75rem; transition: background-color 150ms ease; }
	.work-path a:hover { background: var(--color-paper); }
	.path-index { color: var(--color-amber-deep); font-family: var(--font-body); font-size: .8rem; }
	.work-path strong { font-family: var(--font-display); font-size: 1.35rem; font-weight: 600; }
	.work-path small { grid-column: 2; color: var(--color-ink-soft); }
	.work-path svg { grid-column: 3; grid-row: 1 / span 2; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.5; }
	.limits-layout > div:first-child > .btn-quiet { margin-top: 1.25rem; }
	.limits-ticket { border: 1px solid var(--color-ticket-rule); background: var(--color-cream); padding: 1.35rem clamp(1.25rem, 3vw, 2rem); box-shadow: var(--shadow-ticket); }
	.limits-ticket > p { color: var(--color-amber-deep); font-family: var(--font-body); font-size: .78rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
	.limits-ticket ul { margin-top: 1rem; }
	.limits-ticket li { position: relative; padding: 1rem 0 1rem 1.5rem; border-top: 1px dashed var(--color-ticket-rule); line-height: 1.55; }
	.limits-ticket li::before { position: absolute; top: 1.38rem; left: .15rem; width: .5rem; height: .5rem; border: 1px solid var(--color-amber-deep); content: ''; }
	.audience-close { background: var(--color-softgreen); padding: clamp(4rem, 7vw, 6.5rem) 0; }
	.close-layout { display: grid; gap: 2rem; align-items: center; }
	.close-actions { margin-top: 0; }
	@keyframes ticket-settle { from { filter: blur(4px); transform: translateY(1.2rem) rotate(2.5deg); box-shadow: none; } }
	@media (min-width: 48rem) {
		.hero-layout { grid-template-columns: minmax(0, 1.08fr) minmax(22rem, .92fr); }
		.service-plans { grid-template-columns: 1fr auto 1fr; }
		.ticket-stitch { padding: .75rem; }
		.ticket-stitch span { width: 1px; height: 100%; border-top: 0; border-left: 1px dashed var(--color-ticket-rule); }
		.fit-layout, .limits-layout { grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: clamp(3rem, 8vw, 7rem); }
		.fit-signals li { grid-template-columns: minmax(10rem, .7fr) minmax(0, 1.3fr); }
		.work-path { grid-template-columns: repeat(4, minmax(0, 1fr)); }
		.work-path li + li { border-top: 0; border-left: 1px solid var(--color-hairline); }
		.work-path a { min-height: 10rem; grid-template-columns: 1fr auto; align-content: center; padding: 1.5rem; }
		.path-index { grid-column: 1 / -1; }
		.work-path strong { margin-top: .75rem; }
		.work-path small { grid-column: 1 / -1; margin-top: .25rem; }
		.work-path svg { grid-column: 2; grid-row: 2; }
		.close-layout { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); }
	}
	@media (prefers-reduced-motion: reduce) { .service-ticket { animation: none; transform: none; } }
</style>
