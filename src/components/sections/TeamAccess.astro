---
/** Homepage team-and-access introduction. story: docs/stories/team-and-access.story.md */
import SectionHandoff from '../SectionHandoff.astro';

// Considered Strategy; not used because these fixed role summaries are static
// story data and the page does not swap access behavior at runtime.
const roles = [
	{ name: 'Owner', detail: 'Billing and owner-only recipe lifecycle decisions.' },
	{ name: 'Manager', detail: 'Setup, teammates and protected Sage work.' },
	{ name: 'Staff', detail: 'The shared kitchen workspace without higher-role actions.' }
] as const;
---

<section id="access" class="border-t border-hairline bg-cream" aria-labelledby="access-heading">
	<div class="container-page py-section">
		<div class="grid gap-12 lg:grid-cols-[7fr_5fr] lg:items-center lg:gap-20">
			<div data-reveal>
				<h2 id="access-heading" class="max-w-[15ch] text-h2 font-semibold">Three roles. A short list of real boundaries.</h2>
				<p class="mt-5 max-w-[58ch] text-lede text-ink-soft">Bring the crew into one workspace. Owner, Manager and Staff protect specific sensitive actions, while the operational record stays shared.</p>
				<div class="mt-8 border-t border-ticket-rule">
					{roles.map((role) => (
						<div class="grid gap-2 border-b border-dashed border-ticket-rule py-4 sm:grid-cols-[8rem_minmax(0,1fr)]">
							<strong>{role.name}</strong><span class="text-ink-soft">{role.detail}</span>
						</div>
					))}
				</div>
				<p class="mt-7 max-w-[60ch] text-ink-soft"><strong class="text-ink">The limit:</strong> there is no custom role or per-screen permission grid. <a href="/features/team-and-access" class="btn-quiet">See every access boundary</a>.</p>
			</div>

			<figure class="access-ticket" data-reveal>
				<p class="font-mono text-eyebrow font-semibold tracking-wide text-amber-deep">ACCESS CHECK · ONE KITCHEN</p>
				<dl class="mt-5 border-t border-ticket-rule">
					<div><dt>Role-aware actions</dt><dd>Yes</dd></div>
					<div><dt>Fine-grained screens</dt><dd>No</dd></div>
					<div><dt>New invitations</dt><dd>Staff</dd></div>
				</dl>
				<figcaption>A role is a boundary, not a badge.</figcaption>
			</figure>
		</div>
		<SectionHandoff from="access" />
	</div>
</section>

<style>
	.access-ticket { padding: clamp(1.25rem, 3vw, 2rem); border-top: 4px solid var(--color-green); background: var(--color-paper); box-shadow: var(--shadow-ticket); }
	.access-ticket dl div { display: flex; justify-content: space-between; gap: 2rem; padding-block: .9rem; border-bottom: 1px solid var(--color-ticket-rule); }
	.access-ticket dt { color: var(--color-ink-soft); }
	.access-ticket dd { font-weight: 750; }
	.access-ticket figcaption { margin-top: 2rem; font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2.2rem); font-weight: 600; line-height: 1.15; }
</style>
