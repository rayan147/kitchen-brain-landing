---
import { contactCta, site } from '../../lib/site';
import SectionHandoff from '../SectionHandoff.astro';

// Considered State; not used because portrait, provenance and product consequences form one
// fixed editorial scene, not runtime modes that change behaviour.
const consequences = [
	{
		id: 'missing',
		title: 'Missing facts stop the total',
		body: 'A missing price or conversion stays visible. It never quietly becomes zero.',
		icon: 'alert'
	},
	{
		id: 'connected',
		title: 'One event keeps one guest count',
		body: 'The quote, shopping list, prep plan and pack list stay connected as the order changes.',
		icon: 'route'
	},
	{
		id: 'event',
		title: 'Built for event production',
		body: 'For catering, meal-prep, and restaurant kitchens that plan work from menus and guest counts. Not a POS and not an online-ordering system.',
		icon: 'calendar'
	}
];
---

<!-- story: docs/stories/homepage-founder-trust.story.md -->
<section
	id="trust"
	class="container-page py-section"
	aria-labelledby="trust-heading"
	data-founder-trust
>
	<div class="founder-scene">
		<div class="founder-portrait-wrap" data-reveal>
			<div class="founder-portrait-frame">
				<img
					src="/founder.jpg"
					alt={`${site.founderName}, chef and founder of CostCook`}
					width="384"
					height="384"
					loading="lazy"
					class="founder-portrait"
					data-founder-portrait
				/>
			</div>
			<div class="founder-signature">
				<span class="founder-signature-line" aria-hidden="true"></span>
				<p>
					<span class="block font-display text-xl font-medium text-ink">{site.founderName}</span>
					<span class="mt-0.5 block text-sm text-ink-soft">Chef and founder</span>
				</p>
			</div>
		</div>

		<div class="min-w-0" data-reveal>
			<p class="eyebrow">Who made it</p>
			<h2 id="trust-heading" class="mt-4 max-w-[19ch] text-h2 font-semibold break-words">
				I cooked professionally for twelve years before I built CostCook.
			</h2>
			<p class="mt-5 max-w-[55ch] text-lede text-ink-soft">
				I wanted one menu to become the quote, shopping list, prep plan and pack list
				without losing the cost on the way.
			</p>
			<a
				href={contactCta.href}
				class="founder-contact mt-6 inline-flex min-h-11 items-center gap-2 font-semibold text-ink underline decoration-accent decoration-2 underline-offset-4 transition-colors hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
				data-founder-contact
			>
				{contactCta.label}
				<svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none">
					<path d="M3.75 9h10.5M10.25 5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
			</a>

			<div class="consequences mt-10 border-t border-hairline pt-7">
				<p class="font-body text-sm font-semibold uppercase tracking-[0.13em] text-ink-soft">
					What that changed in the product
				</p>
				<ul role="list" class="mt-2">
					{
						consequences.map((consequence) => (
							<li class="consequence" data-founder-consequence={consequence.id}>
								<div class="consequence-icon" aria-hidden="true">
									{consequence.icon === 'alert' && (
										<svg width="22" height="22" viewBox="0 0 22 22" fill="none">
											<path d="M11 3.25 19 18H3L11 3.25Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
											<path d="M11 8v4.5M11 15.5v.1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
										</svg>
									)}
									{consequence.icon === 'route' && (
										<svg width="22" height="22" viewBox="0 0 22 22" fill="none">
											<circle cx="5" cy="6" r="2" stroke="currentColor" stroke-width="1.5" />
											<circle cx="17" cy="16" r="2" stroke="currentColor" stroke-width="1.5" />
											<path d="M7 6h3a2 2 0 0 1 2 2v6a2 2 0 0 0 2 2h1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
										</svg>
									)}
									{consequence.icon === 'calendar' && (
										<svg width="22" height="22" viewBox="0 0 22 22" fill="none">
											<rect x="3" y="4.5" width="16" height="14" rx="2" stroke="currentColor" stroke-width="1.5" />
											<path d="M7 2.75v3.5M15 2.75v3.5M3 9h16M7 12.5h2M7 15.5h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
										</svg>
									)}
								</div>
								<div class="min-w-0">
									<h3 class="font-body text-base font-semibold text-ink">{consequence.title}</h3>
									<p class="mt-1 max-w-[60ch] text-ink-soft">{consequence.body}</p>
								</div>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>

	<SectionHandoff from="trust" />
</section>

<style>
	.founder-scene {
		display: grid;
		gap: clamp(2.5rem, 6vw, 6rem);
		align-items: start;
	}

	.founder-portrait-wrap {
		width: min(100%, 20rem);
	}

	.founder-portrait-frame {
		position: relative;
		padding: 0.5rem;
		background: var(--color-paper);
		box-shadow: var(--shadow-ticket);
		transform: rotate(-1.25deg);
	}

	.founder-portrait-frame::after {
		position: absolute;
		inset: 0.5rem;
		border: 1px solid rgb(255 255 255 / 0.55);
		content: '';
		pointer-events: none;
	}

	.founder-portrait {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 1;
		object-fit: cover;
	}

	.founder-signature {
		display: flex;
		align-items: center;
		gap: 0.875rem;
		margin-top: 1.5rem;
		padding-left: 0.25rem;
	}

	.founder-signature-line {
		width: 2.75rem;
		height: 1px;
		background: var(--color-accent);
	}

	.consequence {
		display: grid;
		grid-template-columns: 2.75rem minmax(0, 1fr);
		gap: 1rem;
		padding-block: 1.25rem;
		border-bottom: 1px solid var(--color-hairline);
	}

	.consequence-icon {
		display: grid;
		width: 2.75rem;
		height: 2.75rem;
		place-items: center;
		border: 1px solid var(--color-hairline);
		border-radius: 999px;
		color: var(--color-accent);
		background: var(--color-paper);
	}

	@media (min-width: 52rem) {
		.founder-scene {
			grid-template-columns: minmax(15rem, 4fr) minmax(0, 7fr);
		}

		.founder-portrait-wrap {
			position: sticky;
			top: 7rem;
		}
	}

	@media (max-width: 51.99rem) {
		.founder-portrait-wrap {
			width: min(76vw, 18rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.founder-contact {
			transition: none;
		}
	}
</style>
