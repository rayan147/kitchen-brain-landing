---
import { site } from '../../lib/site';
import SectionHandoff from '../SectionHandoff.astro';

const safeguards = [
	{
		title: 'Start with the kitchen you already have',
		body: 'Use one real menu, supplier sheet or order. Guided setup shows what is done and lets you come back without duplicating it.'
	},
	/* "You approve what becomes true" was the second entry here until 2026-08-26.
	   It was PaperIn's whole section said again 700px further down the page:
	   staged for review, you decide what is saved, suggested not applied. A claim
	   that good does not get stronger by being made twice in a row, and the page
	   was spending 22 words to make it the second time. PaperIn owns it. If
	   PaperIn is ever cut, this comes back before anything else does. */
	{
		title: 'Built for event production',
		body: 'For catering and meal-prep kitchens that work from menus and guest counts. Not a POS and not an online-ordering system.'
	}
];
---

<section id="trust" class="container-page py-section" aria-labelledby="trust-heading">
	<!-- min-w-0 on the grid children. A grid item defaults to min-width:auto, so it
     refuses to shrink below its longest word; at 200% text that floor was wider
     than the column and the whole page scrolled sideways at 360. -->
	<div class="grid items-start gap-12 lg:grid-cols-[5fr_7fr] lg:gap-20">
		<div class="min-w-0" data-reveal>
			<!-- Eyebrow added 2026-08-26 with the page-wide role register (see
			     src/pages/index.astro). -->
			<p class="eyebrow">Who made it</p>
			<h2 id="trust-heading" class="mt-4 text-h2 font-semibold break-words">
				Built by a chef. Set up with your real work.
			</h2>
			<p class="mt-5 max-w-[52ch] text-lede text-ink-soft">
				CostCook is the system I wanted when one menu had to become a quote, a shopping
				list, a prep plan and a pack list without losing the cost along the way.
			</p>
			<div class="mt-6 flex flex-wrap items-center gap-4">
				<img
					src="/founder.jpg"
					alt={`${site.founderName}, the chef who built CostCook`}
					width="384"
					height="384"
					loading="lazy"
					class="w-20 shrink-0 -rotate-[1.5deg] bg-paper p-1 shadow-ticket"
				/>
				<p class="font-display text-xl font-medium">{site.founderName}</p>
			</div>
		</div>

		<ul role="list" class="min-w-0 border-t border-hairline" data-reveal>
			{
				safeguards.map((safeguard) => (
					<li class="grid gap-2 border-b border-hairline py-6 sm:grid-cols-[4fr_6fr] sm:gap-8">
						<h3 class="font-body text-base font-semibold">{safeguard.title}</h3>
						<p class="text-ink-soft">{safeguard.body}</p>
					</li>
				))
			}
		</ul>
	</div>

	<SectionHandoff from="trust" />
</section>
