---
/**
 * The one piece of arithmetic that gets a homepage section to itself.
 * Story: docs/stories/homepage-yield-cost-guide.story.md
 *
 * RC-16 backs pack price, yield, conversions and supplier context. RC-19
 * backs used quantity, amount to buy, preparation and cost contribution.
 * The figures below are read from the shipped Roma tomato disclosure in
 * public/proof/yield-lines-mobile.png; they are not an invented example.
 */
import SectionHandoff from '../SectionHandoff.astro';

// Considered State; not used because these are fixed terms in one displayed
// calculation, not runtime modes that change the component's behaviour.
const costStages = [
	{
		op: null,
		name: 'Used in recipe',
		value: '60 g',
		detail: 'Usable tomato in the dish.',
		iconPaths: ['M5 9h14l-1 9H6z', 'M8 6h8', 'M12 3v3']
	},
	{
		op: '÷',
		name: 'Trim yield',
		value: '0.91',
		detail: '91% remains after coring.',
		iconPaths: ['M7 4c3 2 7 2 10 0', 'M6 7c1 7 4 11 6 13 2-2 5-6 6-13', 'M9 11h6']
	},
	{
		op: '=',
		name: 'Required to buy',
		value: '66 g',
		detail: 'As-purchased quantity.',
		iconPaths: ['M5 7h14v13H5z', 'M8 7a4 4 0 0 1 8 0', 'M8 11h8']
	},
	{
		op: '×',
		name: 'Purchase cost',
		value: '$2.57/kg',
		detail: 'From the recorded case.',
		iconPaths: ['M7 3h10v18l-2-1.5L13 21l-2-1.5L9 21l-2-1.5z', 'M10 8h4', 'M10 12h4', 'M10 16h2']
	},
	{
		op: '=',
		name: 'Line cost',
		value: '$0.17',
		detail: '12% of the recipe-line subtotal.',
		iconPaths: ['M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z', 'M15 8.5c-.7-.7-1.7-1-3-1-1.7 0-3 .8-3 2s1.3 1.8 3 2 3 .8 3 2-1.3 2-3 2c-1.3 0-2.3-.3-3-1', 'M12 5.5v13']
	}
] as const;
---

<!-- story: docs/stories/homepage-yield-cost-guide.story.md -->
<section id="yield" class="container-page border-t border-hairline py-section" aria-labelledby="yield-heading">
	<div class="yield-layout">
		<div>
			<div class="max-w-2xl" data-reveal>
				<p class="eyebrow">The hard part</p>
				<h2 id="yield-heading" class="mt-4 text-h2 font-semibold">
					The case has the skins on it. Your recipe does not.
				</h2>
				<p class="mt-5 text-lede text-ink-soft">
					The recipe uses 60 grams of cored tomato. The case price still has to pay for
					the part trimmed away. Follow that one line from the quantity in the dish to
					the cost on the recipe.
				</p>
			</div>

			<figure class="cost-working" data-yield-path data-reveal>
				<div class="purchase-source">
					<span aria-hidden="true">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none">
							<path d="M4 7h16v13H4z" />
							<path d="M7 7V4h10v3M8 11h8M8 15h5" />
						</svg>
					</span>
					<p><strong>Recorded purchase</strong><small>25 lb case · $29.14 · $2.57/kg as purchased</small></p>
				</div>

				<p class="sr-only">
					Sixty grams used in the recipe, divided by a trim yield of zero point nine one,
					equals sixty-six grams required to buy. Sixty-six grams at two dollars and
					fifty-seven cents per kilogram equals a seventeen-cent line cost.
				</p>
				<ol role="list" class="yield-equation" aria-hidden="true">
					{costStages.map((stage, index) => (
						<li data-yield-stage={stage.name} class:list={{ result: index === costStages.length - 1 }}>
							{stage.op && <span class="yield-operator">{stage.op}</span>}
							<span class="stage-icon">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none">
									{stage.iconPaths.map((path) => <path d={path} />)}
								</svg>
							</span>
							<div class="stage-copy">
								<small>{stage.name}</small>
								<strong>{stage.value}</strong>
								<p>{stage.detail}</p>
							</div>
						</li>
					))}
				</ol>
				<figcaption>
					Set yield on the recipe line once. The amount to buy and the line cost move
					together; every ingredient stays at 100% until you change it.
				</figcaption>
			</figure>
		</div>

		<figure class="yield-proof" data-yield-proof data-reveal>
			<p class="proof-label">The same working, open on the recipe line</p>
			<div>
				<img
					src="/proof/yield-lines-mobile.png"
					alt="One recipe line on a phone, with its calculation open. Roma tomato, prep cored and wedged, $0.17. Used in recipe 60 grams. Trim yield 91 percent. Required to buy 66 grams. Share of plate cost 12 percent. View line calculation: used in recipe 60 grams usable quantity; trim yield 91 percent; required as purchased 60 grams divided by 0.91 equals 66 grams; current purchase cost, 25 pound case at $29.14 per 25 pounds, $2.57 a kilogram; line cost $0.17, 12 percent of the recipe-line subtotal. Recorded purchase, supplier Green Valley Produce, effective 2026-07-28."
					width="712"
					height="1112"
					loading="lazy"
					decoding="async"
				/>
			</div>
			<figcaption>
				No waste percentage is added at the end. The yield stays on the ingredient
				line, beside the quantity, preparation and cost it changes.
			</figcaption>
		</figure>
	</div>

	<SectionHandoff from="yield" />
</section>

<style>
	.yield-layout {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 29rem), 1fr));
		gap: clamp(3rem, 6vw, 5rem);
		align-items: start;
	}

	.cost-working {
		margin-top: 2.5rem;
	}

	.purchase-source {
		display: grid;
		grid-template-columns: 3rem minmax(0, 1fr);
		gap: 1rem;
		align-items: center;
		padding: 1rem;
		border-block: 1px solid var(--color-ticket-rule);
		background: var(--color-softamber);
	}

	.purchase-source > span,
	.stage-icon {
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		border: 1px solid var(--color-ticket-rule);
		border-radius: 999px;
		background: var(--color-paper);
		color: var(--color-amber-deep);
	}

	.purchase-source svg,
	.stage-icon svg {
		stroke: currentColor;
		stroke-width: 1.7;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.purchase-source strong,
	.purchase-source small {
		display: block;
	}

	.purchase-source small {
		margin-top: 0.15rem;
		font-size: var(--text-caption);
		color: var(--color-ink-soft);
	}

	.yield-equation {
		display: grid;
	}

	.yield-equation li {
		position: relative;
		display: grid;
		grid-template-columns: 3rem minmax(0, 1fr);
		gap: 1rem;
		align-items: center;
		min-width: 0;
		padding-block: 1rem;
		border-bottom: 1px solid var(--color-hairline-strong);
	}

	.yield-equation li:not(:last-child)::after {
		position: absolute;
		top: 4rem;
		bottom: -1rem;
		left: calc(1.5rem - 0.5px);
		width: 1px;
		background: var(--color-ticket-rule);
		content: '';
	}

	.yield-operator {
		position: absolute;
		z-index: 2;
		top: -0.7rem;
		left: 0.9rem;
		display: grid;
		place-items: center;
		width: 1.25rem;
		height: 1.25rem;
		border: 1px solid var(--color-ticket-rule);
		border-radius: 999px;
		background: var(--color-paper);
		font-weight: 700;
		line-height: 1;
		color: var(--color-amber-deep);
	}

	.stage-icon {
		position: relative;
		z-index: 1;
	}

	.stage-copy {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 0.2rem 1rem;
		align-items: baseline;
	}

	.stage-copy small {
		font-size: var(--text-caption);
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-ink-soft);
	}

	.stage-copy strong {
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: clamp(1.2rem, 1rem + 1vw, 1.65rem);
		font-variant-numeric: tabular-nums;
		color: var(--color-green-deep);
	}

	.stage-copy p {
		grid-column: 1 / -1;
		font-size: var(--text-caption);
		color: var(--color-ink-soft);
	}

	.yield-equation .result {
		margin-top: 0.5rem;
		padding-inline: 1rem;
		border-bottom: 0;
		background: var(--color-softgreen);
	}

	.yield-equation .result .stage-icon {
		border-color: var(--color-green);
		color: var(--color-green-deep);
	}

	.cost-working > figcaption,
	.yield-proof > figcaption {
		margin-top: 1rem;
		font-size: var(--text-body-sm);
		line-height: 1.55;
		color: var(--color-ink-soft);
	}

	.yield-proof {
		width: 100%;
		max-width: 30rem;
		justify-self: center;
	}

	.proof-label {
		max-width: 24rem;
		font-weight: 700;
	}

	.yield-proof > div {
		margin-top: 1rem;
		padding: clamp(1rem, 3vw, 2rem);
		border-block: 1px solid var(--color-hairline-strong);
		background: var(--color-softgreen);
	}

	.yield-proof img {
		display: block;
		width: 100%;
		max-width: 22.25rem;
		height: auto;
		margin-inline: auto;
		border: 1px solid var(--color-hairline);
		background: var(--color-paper);
		box-shadow: var(--shadow-ticket);
	}

	@media (max-width: 30rem) {
		.stage-copy {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.1rem;
		}

		.stage-copy p {
			grid-column: auto;
		}
	}
</style>
