---
import FeatureTrialTerms from "../FeatureTrialTerms.astro";
import { featureGroups } from '../../lib/features';
import { cta, demoCta } from '../../lib/site';

const ingredientGroup = featureGroups.find((group) => group.id === 'ingredients');
if (!ingredientGroup) throw new Error('Missing public feature group: ingredients');

// US units, one price change (chef audit 2026-10-07: the recipe impacts did
// not follow from the $4.70 case increase, and "last costed" was not the
// previous price in the history). $42.10 → $46.80 on a 20 lb case at 91%
// usable (the tour's and the recipes guide's yield) is $0.2582 more per usable lb; each recipe moves by its usable lb.
const packFacts = [
	{ label: 'Pack', left: '20 lb case', right: '25 lb case' },
	{ label: 'Case price', left: '$46.80', right: '$61.50' },
	{ label: 'Trim yield', left: '91%', right: '95%' },
	{ label: 'Usable cost', left: '$2.57 / lb', right: '$2.59 / lb' }
] as const;

const affectedRecipes = [
	// Not the tour's herb roast chicken (Harbor, 40 lb case): this is the
	// guides' kitchen, buying thighs from Northline (chef review 2026-10-07).
	{ name: 'Chicken pot pie', use: '4 lb', change: '+$1.03' },
	{ name: 'Grain bowl', use: '1.5 lb', change: '+$0.39' },
	{ name: 'Canapé tray', use: '1 lb', change: '+$0.26' }
] as const;

// Considered Strategy; not used because these questions and comparison rows
// vary as static editorial data, not interchangeable behavior at runtime.
const faqItems = [
	{
		question: 'Can one ingredient have prices from more than one supplier?',
		answer:
			'Yes. Concurrent supplier offers sit on the same ingredient and compare per usable unit, cheapest first. You choose which offer becomes the current price.'
	},
	{
		question: 'How does CostCook compare different pack sizes?',
		answer:
			'Each offer keeps its pack quantity, purchase unit, price, and trim yield. CostCook converts those facts to the same usable-unit cost so a case and a bag can be compared on equal terms.'
	},
	{
		question: 'Where did the current price come from?',
		answer:
			'Every current price carries its source, supplier, and effective date. Purchase history remains underneath the ingredient instead of being replaced by one unexplained number.'
	},
	{
		question: 'What happens when a supplier price changes?',
		answer:
			'Before you adopt the change, CostCook shows the recipes and menus that use the ingredient. Once applied, recipes using it recost from the new ingredient price.'
	},
	{
		question: 'What if a price or conversion is missing?',
		answer:
			'The catalog names ingredients that still need a fact. Recipe totals that cannot be fully costed stay marked partial rather than quietly treating the missing line as free.'
	},
	{
		question: 'Can I bring in existing ingredient data?',
		answer:
			'Yes. Import ingredients from a CSV spreadsheet, or upload supplier paperwork. Review and confirm the suggested details before they change costs.'
	}
] as const;
---

<!-- story: docs/stories/ingredients-supplier-prices.story.md -->
<article class="ingredients-prices">
	<section class="hero" aria-labelledby="ingredients-prices-heading">
		<div class="container-page hero-grid">
			<div class="hero-copy anim-enter">
				<nav aria-label="Breadcrumb" class="feature-breadcrumb">
					<a href="/features">Every feature</a>
					<span aria-hidden="true">/</span>
					<span>Ingredients and supplier prices</span>
				</nav>
				<h1 id="ingredients-prices-heading" class="feature-display">Compare supplier prices by what you can use.</h1>
				<p class="hero-lede">Put in the case price, the pack size and the trim yield for one ingredient. Compare suppliers by what you can actually use, per pound, kilo or each, and see which recipes a price change hits.</p>
				<div class="hero-actions">
					<a href={cta.href} target={cta.target} rel={cta.rel} aria-label={cta.ariaLabel} class="btn-primary">
						{cta.label}
					</a>
					<a
						href={demoCta.href}
						target={demoCta.target}
						rel={demoCta.rel}
						aria-label={demoCta.ariaLabel}
						class="btn-quiet"
					>
						{demoCta.label}
					</a>
				</div>
				<FeatureTrialTerms />
			</div>

			<figure class="offer-board anim-enter" style="--enter-delay: 120ms">
				<p class="figure-note">Illustrative supplier comparison</p>
				<div class="ingredient-record">
					<div class="record-head"><span>Ingredient</span><span>Current</span></div>
					<div class="ingredient-title">
					<div><strong class="record-title">Chicken thigh</strong><p>Purchased by weight · usable after trim</p></div>
						<strong>$2.57 / lb</strong>
					</div>
				</div>
				<div class="offer-join" aria-hidden="true"><span></span><span></span></div>
				<div class="offers">
					<div class="offer preferred">
						<div class="record-head"><span>Northline Foods</span><span>In use</span></div>
						<strong>$46.80</strong><small>20 lb case · 91% usable</small>
						<p>$2.57 per usable lb</p>
					</div>
					<div class="offer">
						<div class="record-head"><span>Market Supply</span><span>Offer</span></div>
						<strong>$61.50</strong><small>25 lb case · 95% usable</small>
						<p>$2.59 per usable lb</p>
					</div>
				</div>
				<figcaption>Illustrative values. Every offer keeps its source, supplier, and effective date.</figcaption>
			</figure>
		</div>
	</section>

	<section class="problem" aria-labelledby="problem-heading">
		<div class="container-page problem-grid">
			<div data-reveal>
				<h2 id="problem-heading">The old price still looks right.</h2>
				<p>
					The invoice went up and the case size changed, but your spreadsheet still has the old
					number. By the time the food cost looks wrong, you may have already quoted it to a client.
				</p>
			</div>
			<figure class="price-drift" data-reveal>
				<div><span>Last costed</span><strong>$42.10</strong><small>20 lb case</small></div>
				<svg width="56" height="22" viewBox="0 0 56 22" aria-hidden="true"><path d="M1 11h47M41 4l7 7-7 7" /></svg>
				<div><span>This invoice</span><strong>$46.80</strong><small>20 lb case</small></div>
				<figcaption>The new case costs $4.70 more. Check the recipes that use it before quoting again.</figcaption>
			</figure>
		</div>
	</section>

	<nav class="story-nav container-page" aria-label="On this page">
		<a href="#ingredient-records">
			<span>Ingredient records</span>
			<small>What you buy, the yield, where it is stored and its allergens, all on the ingredient.</small>
			<svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5" /></svg>
		</a>
		<a href="#supplier-prices">
			<span>Supplier prices</span>
			<small>Compare different case sizes by what you can use, and keep where each price came from.</small>
			<svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5" /></svg>
		</a>
	</nav>

	<section id="ingredient-records" class="product-section ingredient-chapter" aria-labelledby="ingredient-records-heading">
		<div class="container-page">
			<div class="section-intro" data-reveal>
				<h2 id="ingredient-records-heading">Set up the ingredient once. Every recipe uses it.</h2>
				<p>
					Start from scratch, from a USDA reference or from a purchase. The buying unit, trim
					yield, conversions, suppliers, allergens, storage area and par level all live on it.
				</p>
			</div>

			<figure class="ingredient-workspace" data-reveal>
				<div class="workspace-main">
					<div class="panel-bar"><span>Ingredient record</span><span>Costable</span></div>
					<div class="workspace-title"><h3>Chicken thigh</h3><p>Protein · purchased by weight</p></div>
					<dl class="fact-grid">
						<div><dt>Purchase unit</dt><dd>20 lb case</dd></div>
						<div><dt>Trim yield</dt><dd>91%</dd></div>
						<div><dt>Purchased cost</dt><dd>$2.34 / lb</dd></div>
						<div><dt>Usable cost</dt><dd>$2.57 / lb</dd></div>
					</dl>
					<div class="source-line"><span>Current source</span><strong>Northline Foods · effective Aug 28</strong></div>
				</div>
				<div class="workspace-side">
					<div><span>Kitchen facts</span><strong>Walk-in · Meat</strong><small>Par level 40 lb</small></div>
					<div><span>Conversions</span><strong>1 case = 20 lb</strong><small>Unit and yield chosen, never guessed</small></div>
					<div><span>Used by</span><strong>3 recipes · 2 menus</strong><small>Checked before a change or delete</small></div>
				</div>
				<figcaption>Illustrative ingredient record built only from shipped CostCook fields and behavior.</figcaption>
			</figure>

			<div class="feature-scenes">
				<article><h3>Add it where you run into it.</h3><p>Create an ingredient from the catalog, from a purchase, or inside the recipe you are already building.</p></article>
				<article><h3>Keep purchased and usable separate.</h3><p>Both costs sit side by side. Trim and cooking loss show as numbers you can see, never buried in the price.</p></article>
				<article><h3>See what still needs a price.</h3><p>The ingredient list shows which items can be costed and which still need a price or unit conversion.</p></article>
			</div>
		</div>
	</section>

	<section id="supplier-prices" class="product-section supplier-chapter" aria-labelledby="supplier-prices-heading">
		<div class="container-page">
			<div class="section-intro supplier-intro" data-reveal>
				<h2 id="supplier-prices-heading">A cheaper case can cost you more.</h2>
				<p>
					Pack size and yield change the math. Each offer comes down to the same usable unit and
					keeps its source and date. Then you pick the price you want to use.
				</p>
			</div>

			<figure class="comparison-table" data-reveal>
				<div class="comparison-head"><span>Chicken thigh</span><span>Northline Foods</span><span>Market Supply</span></div>
				{packFacts.map((fact) => (
					<div class:list={['comparison-row', fact.label === 'Usable cost' && 'result-row']}>
						<strong>{fact.label}</strong><span>{fact.left}</span><span>{fact.right}</span>
					</div>
				))}
				<div class="comparison-result"><span>Preferred offer</span><strong>Northline Foods</strong><small>2¢ less per usable lb</small></div>
				<figcaption>Illustrative comparison. CostCook orders concurrent offers by usable-unit cost.</figcaption>
			</figure>

			<div class="history-impact">
				<div class="history" data-reveal>
					<h3>The source stays with the number.</h3>
					<ol role="list">
						<li><time>Aug 28</time><span><strong>$46.80</strong> Northline delivery, PO-1048</span></li>
						<li><time>Aug 14</time><span><strong>$42.10</strong> Northline purchase</span></li>
						<li><time>Jul 31</time><span><strong>$61.50</strong> Market Supply list, 25 lb case</span></li>
					</ol>
				</div>
				<div class="impact" data-reveal>
					<h3>See which recipes it hits first.</h3>
					<ul role="list">
						{affectedRecipes.map((recipe) => (
							<li><span><strong>{recipe.name}</strong><small>{recipe.use} in recipe</small></span><b>{recipe.change}</b></li>
						))}
					</ul>
					<p>Illustrative recipe impact from adopting the changed supplier price.</p>
				</div>
			</div>
		</div>
	</section>

	<section class="evidence" aria-labelledby="evidence-heading">
		<div class="container-page evidence-grid">
			<div data-reveal>
				<h2 id="evidence-heading">The price follows the ingredient into the recipe.</h2>
				<p>
					Inside a recipe the ingredient keeps its own line: what you bought, the trim yield, how
					much to buy, the prep state and what it adds to the cost.
				</p>
				<ul role="list">
					<li>Missing prices are named instead of reading as zero.</li>
					<li>Every ingredient line adds up to the recipe total.</li>
					<li>Open the math whenever a number needs checking.</li>
				</ul>
			</div>
			<figure class="screenshot-frame" data-reveal>
				<picture>
					<source media="(max-width: 63.99rem)" srcset="/proof/yield-lines-mobile.png" width="748" height="1102" />
					<img src="/proof/yield-lines.png" width="1490" height="1042" loading="lazy" decoding="async" alt="CostCook recipe lines for a Greek salad: bell pepper 0.25 each at 82% yield, cucumber 0.3 each at 90%, and Roma tomato 2.1 oz at 91% yield, 2.3 oz to buy, 12% of cost, $0.17. Roma tomato is opened: 2.1 oz usable quantity, trim yield 91%, required as purchased 2.1 oz ÷ 0.91 = 2.3 oz, a 25 lb case at $29.14, line cost $0.17, and the recorded purchase it came from." />
				</picture>
				<figcaption>Real CostCook interface: each ingredient carries its working into the recipe.</figcaption>
			</figure>
		</div>
	</section>

	<section class="capabilities" aria-labelledby="capabilities-heading">
		<div class="container-page capabilities-grid">
			<div data-reveal>
				<h2 id="capabilities-heading">What is in Ingredients.</h2>
				<p>Open the details to check what is available today.</p>
				<p class="count"><strong>{ingredientGroup.items.length}</strong><span>shipped capabilities</span></p>
			</div>
			<details id="features-ingredients" data-reveal>
				<summary><span>Ingredients and supplier prices</span><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 7l6 6 6-6" /></svg></summary>
				<ul role="list">
					{ingredientGroup.items.map((item) => <li><strong>{item.lead}</strong> <span>{item.detail}</span></li>)}
				</ul>
			</details>
		</div>
	</section>

	<section class="faq" aria-labelledby="faq-heading">
		<div class="container-page faq-grid">
			<div data-reveal><h2 id="faq-heading">Frequently asked questions</h2><p>What people ask before they trust a supplier price.</p></div>
			<div class="faq-list">
				{faqItems.map((item) => (
					<details data-reveal><summary><span>{item.question}</span><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 7l6 6 6-6" /></svg></summary><p>{item.answer}</p></details>
				))}
			</div>
		</div>
	</section>

	<section class="closing" aria-labelledby="closing-heading">
		<div class="container-page closing-grid" data-reveal>
			<div><h2 id="closing-heading">Know where every price came from before you quote.</h2><p>Bring one supplier sheet and one real ingredient. Follow the case price into the recipe, with the math showing.</p></div>
			<div class="closing-actions">
				<a href={cta.href} target={cta.target} rel={cta.rel} aria-label={cta.ariaLabel} class="btn-primary">{cta.label}</a>
				<a href={demoCta.href} target={demoCta.target} rel={demoCta.rel} aria-label={demoCta.ariaLabel} class="btn-quiet">{demoCta.label}</a>
			</div>
		</div>
		<div class="container-page onward feature-onward"><a href="/features">See every CostCook feature</a></div>
	</section>
</article>

<style>
	.ingredients-prices { overflow: clip; }
	.hero { border-block: 1px solid var(--color-hairline); background: var(--color-cream); }
	.hero-grid { display: grid; gap: clamp(3rem, 6vw, 6.5rem); align-items: center; padding-block: clamp(4rem, 7vw, 7.5rem); }
	.hero h1 { max-width: 12ch; margin-top: 1.5rem; }
	.hero-lede { max-width: 55ch; margin-top: 1.75rem; font-size: var(--text-lede); line-height: 1.55; color: var(--color-ink-soft); }
	.hero-actions, .closing-actions { display: flex; flex-wrap: wrap; gap: .85rem; margin-top: 2rem; }
	.figure-note { margin-bottom: .7rem; font-size: var(--text-label-sm); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--color-amber-deep); }
	.ingredient-record, .offer { min-width: 0; padding: clamp(1.1rem, 2.5vw, 1.6rem); background: var(--color-paper); box-shadow: var(--shadow-ticket); }
	.ingredient-record { border-top: 3px solid var(--color-green); }
	.record-head { display: flex; justify-content: space-between; gap: 1rem; font-size: var(--text-micro); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--color-ink-soft); }
	.ingredient-title { display: flex; justify-content: space-between; gap: 1rem; align-items: end; margin-top: .9rem; }
	.ingredient-title .record-title { display: block; font-family: var(--font-display); font-size: var(--text-record); font-weight: 600; }
	.ingredient-title p { margin-top: .2rem; font-size: var(--text-caption); color: var(--color-ink-soft); }
	.ingredient-title > strong { color: var(--color-green-deep); font-size: var(--text-record-sm); font-variant-numeric: tabular-nums; }
	.offer-join { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; height: 1.65rem; padding-inline: 16%; }
	.offer-join span { border-right: 1px solid var(--color-amber-deep); border-bottom: 1px solid var(--color-amber-deep); }
	.offer-join span:first-child { border-left: 1px solid var(--color-amber-deep); border-right: 0; }
	.offers { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
	.offer { border-top: 3px solid var(--color-ticket-rule); }
	.offer.preferred { border-top-color: var(--color-amber-deep); }
	.offer > strong { display: block; margin-top: 1rem; font-size: var(--text-record); font-variant-numeric: tabular-nums; }
	.offer > small { display: block; margin-top: .15rem; color: var(--color-ink-soft); }
	.offer > p { margin-top: 1rem; padding-top: .8rem; border-top: 1px solid var(--color-ticket-rule); color: var(--color-green-deep); font-weight: 700; font-variant-numeric: tabular-nums; }
	.offer-board figcaption, .ingredient-workspace figcaption, .comparison-table figcaption, .screenshot-frame figcaption { margin-top: .85rem; font-size: var(--text-label-sm); line-height: 1.45; color: var(--color-ink-soft); }
	.problem { border-bottom: 1px solid var(--color-hairline); background: var(--color-paper); }
	.problem-grid { display: grid; gap: 3rem; align-items: center; padding-block: var(--spacing-section-tight); }
	.problem h2, .section-intro h2, .evidence h2, .capabilities h2, .faq h2, .closing h2 { font-size: var(--text-h2); font-weight: 600; line-height: 1.12; }
	.problem p, .section-intro p, .evidence-grid > div > p, .capabilities-grid > div > p, .faq-grid > div > p, .closing p { max-width: 58ch; margin-top: 1.1rem; color: var(--color-ink-soft); line-height: 1.65; }
	.price-drift { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: center; }
	.price-drift div { padding: 1.35rem; border-top: 2px solid var(--color-ticket-rule); background: var(--color-cream); }
	.price-drift span, .workspace-side span { display: block; font-size: var(--text-micro); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--color-amber-deep); }
	.price-drift strong { display: block; margin-top: .45rem; font-size: var(--text-record); font-variant-numeric: tabular-nums; }
	.price-drift small { color: var(--color-ink-soft); }
	.price-drift svg, .story-nav svg, summary svg { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
	.price-drift svg { color: var(--color-amber-deep); }
	.price-drift figcaption { grid-column: 1 / -1; color: var(--color-ink-soft); font-size: var(--text-caption); }
	.story-nav { display: grid; padding-block: 1.25rem; }
	.story-nav a { display: grid; min-height: 84px; grid-template-columns: 1fr auto; gap: .25rem 1rem; align-content: center; padding: 1.2rem 0; border-bottom: 1px solid var(--color-ticket-rule); color: var(--color-ink); }
	.story-nav a:first-child { border-top: 1px solid var(--color-ticket-rule); }
	.story-nav span { font-weight: 700; }
	.story-nav small { max-width: 48ch; color: var(--color-ink-soft); }
	.story-nav svg { grid-column: 2; grid-row: 1 / 3; color: var(--color-green-deep); }
	.product-section { scroll-margin-top: 1rem; padding-block: var(--spacing-section); }
	.ingredient-chapter { background: var(--color-softgreen); }
	.supplier-chapter { background: var(--color-cream); }
	.section-intro { display: grid; gap: 1.5rem 4rem; align-items: end; }
	.section-intro p { margin-top: 0; }
	.ingredient-workspace { display: grid; gap: 1px; margin-top: clamp(2.5rem, 6vw, 4.5rem); background: var(--color-hairline-strong); box-shadow: var(--shadow-lift); }
	.workspace-main, .workspace-side > div { background: var(--color-paper); }
	.workspace-main { padding: clamp(1.3rem, 4vw, 2.2rem); }
	.panel-bar { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: .8rem; border-bottom: 1px solid var(--color-hairline); font-size: var(--text-label-sm); font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: var(--color-ink-soft); }
	.workspace-title { margin-top: 1.5rem; }
	.workspace-title h3 { font-size: var(--text-record); font-weight: 600; }
	.workspace-title p { color: var(--color-ink-soft); }
	.fact-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; margin-top: 1.5rem; background: var(--color-hairline); }
	.fact-grid div { padding: 1rem; background: var(--color-offwhite); }
	.fact-grid dt { font-size: var(--text-label-sm); color: var(--color-ink-soft); }
	.fact-grid dd { margin-top: .3rem; font-weight: 700; font-variant-numeric: tabular-nums; }
	.source-line { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .4rem 1rem; margin-top: 1rem; font-size: var(--text-caption); }
	.source-line span { color: var(--color-ink-soft); }
	.workspace-side { display: grid; gap: 1px; }
	.workspace-side > div { padding: 1.25rem; }
	.workspace-side strong, .workspace-side small { display: block; margin-top: .4rem; }
	.workspace-side small { color: var(--color-ink-soft); }
	.feature-scenes { display: grid; gap: 2rem; margin-top: 3rem; }
	.feature-scenes article { padding-top: 1.25rem; border-top: 1px solid var(--color-hairline-strong); }
	.feature-scenes h3, .history h3, .impact h3 { font-size: var(--text-record-sm); font-weight: 600; }
	.feature-scenes p { margin-top: .65rem; color: var(--color-ink-soft); line-height: 1.6; }
	.comparison-table { margin-top: clamp(2.5rem, 6vw, 4.5rem); border: 1px solid var(--color-ticket-rule); background: var(--color-paper); box-shadow: var(--shadow-ticket); }
	.comparison-head, .comparison-row { display: grid; grid-template-columns: 1.05fr 1fr 1fr; gap: 1rem; padding: 1rem clamp(1rem, 3vw, 1.75rem); }
	.comparison-head { background: var(--color-ink); color: var(--color-paper); font-size: var(--text-label-sm); font-weight: 700; letter-spacing: .05em; }
	.comparison-row { border-top: 1px solid var(--color-ticket-rule); }
	.comparison-row strong { color: var(--color-ink-soft); font-size: var(--text-caption); }
	.comparison-row span { font-weight: 600; font-variant-numeric: tabular-nums; }
	.result-row { background: var(--color-softgreen); }
	.comparison-result { display: flex; flex-wrap: wrap; align-items: baseline; gap: .4rem 1rem; padding: 1.2rem clamp(1rem, 3vw, 1.75rem); border-top: 2px solid var(--color-green); }
	.comparison-result span { font-size: var(--text-label-sm); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--color-green-deep); }
