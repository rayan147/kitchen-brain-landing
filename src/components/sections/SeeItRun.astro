---
import { cta, launchPlan } from '../../lib/site';
import SectionHandoff from '../SectionHandoff.astro';

// Considered Composite; not used because this guide is a fixed, shallow sequence:
// eight handoffs and one scale note have no recursive child behaviour.
//
// EIGHT SINCE 2026-09-06, not six. The film gained a nutrition beat and a Sage
// beat (walkthrough v5), and this list is the film in writing: a step here that
// the footage does not show, or a beat the footage shows and this list does not,
// is the same defect in two directions. check-dist.mjs holds the ids.
const guideSteps = [
	{
		id: 'quote',
		label: 'Quote',
		title: 'Check the food cost before you quote',
		body: 'The pricing panel puts the guest count, quoted price, food cost, target and the price needed to meet it in one decision.',
		from: 'Menu + 180 guests',
		to: 'Food cost before send'
	},
	{
		id: 'shop',
		label: 'Shop',
		title: 'Turn the wedding into whole packs',
		body: 'The same order becomes a shopping list grouped by supplier, with sub-recipes kept out of the buy list as batches to make.',
		from: 'Same wedding',
		to: 'Supplier-grouped packs'
	},
	{
		id: 'prep',
		label: 'Prep',
		title: 'Scale the kitchen work to the count',
		body: 'The prep list carries the same guest count into every ingredient and sub-recipe, with a check-off box on each line.',
		from: 'Same guest count',
		to: 'Scaled prep list'
	},
	{
		id: 'nutrition',
		label: 'Nutrition',
		title: 'Answer the nutrition question off the same recipe',
		body: 'Calories and protein per portion sit on the dish you already costed, computed from the sources you matched. Rows the source will not report stay blank, with the ingredient named.',
		from: 'Same costed recipe',
		to: 'Panel, blanks named'
	},
	{
		id: 'send',
		label: 'Buy',
		title: 'Send each supplier its purchase order',
		body: 'Confirmation creates one purchase order per supplier. The film opens the capture inbox so you can see the email that went out.',
		from: 'Shopping need',
		to: 'Purchase orders sent'
	},
	{
		id: 'receive',
		label: 'Receive',
		title: 'Record the delivery you actually got',
		body: 'A short arugula line and extra spinach stay beside what was ordered. The difference is recorded instead of smoothed over.',
		from: 'Expected delivery',
		to: 'Received quantity + value'
	},
	{
		id: 'update',
		label: 'Update',
		title: 'Carry the paid price back to costing',
		body: 'The received price becomes the current ingredient cost. The confirmed quote stays held while today’s comparison moves.',
		from: 'What actually arrived',
		to: 'Current cost for next time'
	},
	{
		id: 'ask',
		label: 'Ask',
		title: 'Ask about the job and check the answer',
		body: 'Sage reads the records this order has built and answers in plain words. The film asks what needs attention, and the answer carries the same 39.6 percent food cost the pricing panel worked out, with the orders it read listed under it.',
		from: 'The records so far',
		to: 'Answer with its sources'
	}
];

// Screen tour of the actual build (public/demo.mp4, H.264 + AAC).
//
// WALKTHROUGH v4 (2026-08-22): the silent, card-captioned cut follows ONE
// order — the Alvarez-Whitman wedding in the Maple & Main demo world, named on
// screen in the opening beat — from the food cost that lands before the quote
// goes out, through the shop list and the prep list (the same order, one tab to
// the right each time), the ACTUAL email send (the capture inbox is on camera),
// an imperfect delivery, and the quoted-versus-today result. One inset partway
// through shows three events planned as a single production run. There is no
// speech track and there will not be one; a generated music bed plays and every
// claim is written on screen. The cards are burned into the frames by the
// capture step.
//
// v4 added the prep beat and the sub-recipe cards on the shop beat. The title
// card had promised "prep it" since the first cut and no frame had ever shown a
// prep list; the sub-recipe panel had been in every frame of the shop beat with
// no card mentioning it. Both are ledger-backed already (RC-24, RC-18) and both
// were verified against the seeded wedding before they were written: its
// Braised Short Rib carries Mirepoix Base and House Beef Stock as sub-recipes,
// so the claims and the through-line stay on the same dish.
//
// WALKTHROUGH v5 (2026-09-06): two beats added for the two things the app
// shipped after v4, and the cut ran from 2:30 to 2:53 to hold them.
//
// The nutrition panel, straight after the prep list, on the Wild Mushroom
// Polenta from the SAME Wedding Plated Dinner menu: 531 calories a portion off
// a recipe the film has already costed, with seven label rows left blank and
// the ingredient whose source will not report each one named beside it. Not
// the Braised Short Rib the rest of the cut follows, and that was a truth
// decision: the short rib's stock enters by volume, which leaves the portion
// weight unknown, and the stock's nutrients are the sum of its inputs
// including the beef bones that get strained out. The polenta's four lines are
// all weighed in grams. Nothing on the panel is a compliance claim and no card
// makes it one; the printed sheet says so on the sheet.
//
// Sage, between the price carrying back and the quoted-versus-today result,
// asked in plain words what needs attention for the wedding. The answer reads
// back 39.6 percent against a 30 percent target, which is what the pricing
// panel worked out ninety seconds earlier, and the records it read are listed
// under it. Sage's PROSE is not deterministic; its figures are, because they
// are read off the order. The capture asserts the figures this transcript
// names and refuses to keep a frame without them (SAGE_MUST_SHOW in beats.mjs).
//
// The written guide below gained a step for each. The app's own demo world had
// no nutrition data at all until the app repo's seed was given four verified
// USDA FoodData Central sources; see demo/nutrition-curation.ts there.
//
// THESE MOVE WITH THE FOOTAGE, EVERY TIME. The list said six and was short by
// three, which is how the duration has now drifted twice: commit 3e8d136 left
// the chip reading 48 sec over a 39.5s cut, and an earlier cut narrated a
// different menu than the order it quoted.
//
//   1. the play chip's duration, below
//   2. the sr-only transcript, below, IN ORDER and carrying every card's figure
//   3. the video's aria-label, below
//   4. `guideSteps` above: one step per beat, or the writing and the film differ
//   5. `public/demo-poster.jpg`, which the assembler writes
//   6. `public/demo-poster-mobile.jpg`, which it does NOT: rebuild it with
//      `python3 scripts/build-mobile-poster.py` or the phone keeps the old one
//   7. the hero link's duration in `Hero.astro`
//   8. the same link on `/compare` and on the features index
//   9. the guard literal in `check-landing-claims.mjs`, asserted three times
//
// After a re-record: `grep -rn "2:53\|2 min 53" src scripts --exclude-dir=venv`
// should find all five copies of the running time. scripts/demo-video/README.md
// carries the same table.
//
// THE MULTI-EVENT INSET CLAIMS PLANNING ONLY (RC-36). /orders/batch exposes
// on-hand entry and nothing else: confirming an order, freezing its prices and
// sending its purchase orders all stay per order. Nothing here, in the
// transcript or in the footage, may suggest the combined run confirms or buys.
//
// Regenerate (app repo first: `npm run demo:seed`, then `npm run demo:capture`,
// Mailpit up; then `./demo/serve.sh` there to leave a preview on :4181):
//   APP=http://localhost:4181 node scripts/demo-video/capture-silent.mjs
//   node scripts/demo-video/assemble-silent.mjs   (ffmpeg-static + playwright-core)
// The assembler prints the encoded duration and the three places that have to
// agree with it. See docs/demo-video-rebuild-2026-08-21.md.
---

<!-- story: docs/stories/homepage-guided-video.story.md -->
	<section id="demo" class="container-page py-section-tight">
		<div data-reveal>
			<!-- Eyebrow added 2026-08-26 with the page-wide role register (see
			     src/pages/index.astro). This one names the register itself: the
			     section either side of it argues, and this one shows.

			     IT IS THE SECTION'S h2 SINCE 2026-09-06, when this section moved to
			     second and its two h3 would otherwise have been the first headings
			     under the page h1, with no h2 anywhere between them. The heading
			     removed on 2026-09-06 is NOT restored: its line lives in the hero
			     now, and putting it back here would say the same thing twice one
			     screen apart. Promoting the eyebrow costs nothing visually (the
			     utility sets its own family, size and colour) and names the section
			     in the same three words the hand-off arrows and src/lib/stops.ts
			     use. This is the fix the note below anticipated. -->
			<h2 class="eyebrow">See it run</h2>
			<!-- HEADING REMOVED 2026-09-06. Its line moved into the hero, where the
			     fold now carries the promise this section used to make. Removing it
			     was asked for explicitly, so the section runs on its eyebrow and
			     lede. Known cost, recorded here so it is not mistaken for an
			     oversight: the two h3 below (the written guide, and "Three events.
			     One production run.") were left following the page h1 with no h2
			     between them. RESOLVED 2026-09-06 by the eyebrow above, which is
			     now this section's h2; see the note on it. The line itself stays
			     in the hero.
			     story: docs/stories/homepage-fold-promise.story.md -->
			<!-- THE DURATION CAME OUT OF THIS LEDE 2026-09-06, when the section moved
			     to second. The hero's proof link ("Watch the 2:53 product tour", pinned
			     in check-landing-claims.mjs) and the play chip ("2 min 53 sec") now sit
			     within a screen and a half of it, so the running time was being stated
			     three times in that stretch. It is still stated twice, in the two places
			     a reader looks for it. Nothing else in the sentence changed. -->
			<p class="mt-4 max-w-[68ch] text-lede text-ink-soft">
				This is the working product, not a mockup. The food cost before the quote goes
				out, the shopping and prep lists it turns into, the nutrition panel on the same
				recipe, purchase orders that really send, a delivery that arrives wrong, the price
				carried back, and Sage answering a question about the job.
			</p>
			<!-- HIDDEN UNDER lg SINCE 2026-09-09, and only under lg. This link exists
			     to carry a reader from the player down to a block that used to sit a
			     long way below it. On a phone the guide is now a control immediately
			     under the video saying the same four words, so the link and the
			     summary were the same sentence twice within one screen. It stays in
			     the served HTML (check-dist.mjs reads data-demo-guide-jump) and it
			     stays visible at the widths where the guide is open by default and
			     the intro is a sticky column some distance down the page. Hiding a
			     duplicate route to adjacent content costs a reader nothing;
			     principle 3 is about content, and this is not content. -->
			<a
				href="#demo-guide-heading"
				class="demo-guide-jump mt-5 hidden min-h-11 items-center gap-2 font-semibold text-green-deep underline decoration-hairline-strong decoration-2 underline-offset-4 hover:text-green focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-green lg:inline-flex"
				data-demo-guide-jump
			>
				Follow the order in writing
				<svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
					<path d="M9 3.5v10M5 9.5l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
			</a>
		<!-- WCAG 1.2.1 and CLAUDE.md principle 4: this stands in for the footage
		     for anyone who cannot watch it, so it describes the cut IN ORDER and
		     carries every figure the cards carry. It is also a truth-pass
		     surface, scanned against the forbidden-claims list like everything
		     else in this file. Rewrite it whenever the cut is re-recorded. -->
		<p id="demo-transcript" class="sr-only">
				A silent, captioned screen recording of CostCook following one catering order
				from quote to shelf. There is no narration; a music bed plays and every claim
				is written on screen, so nothing is carried by audio alone. A title card:
				cost it, buy it, prep it, pack it, enter the numbers once. A year of jobs on
				the books, with the next one named: the Alvarez-Whitman wedding, 180 guests,
				three days out. The order&rsquo;s pricing panel: 180 guests at $68 a head is $12,240.00 of revenue
				against $4,847.96 of food, which is 39.6 percent food cost against a 30
				percent target, and the panel names $89.78 a guest as the price that would
				meet it, all before the quote is sent. The same order as a shopping list
				grouped by vendor in the whole packs you actually buy, Baldor totalling
				$690.82, beside a sub-recipe panel that treats the stock and the mirepoix as
				batches to make rather than as things to shop for: eight batches of Mirepoix
				Base, six of House Beef Stock, with an on-hand entry that reduces the
				purchasing when you have already made some. The same order&rsquo;s prep list:
				thirty-four items scaled to the job, 75.6 kilograms of boneless beef short rib
				among them, sub-recipes carried as their own tagged lines, and a check-off box
				on every row that keeps its state. The Wild Mushroom Polenta from the same
				wedding menu, opened on its Nutrition section: a calculated estimate per
				portion of 531 calories, 18.5 grams of protein, 77.2 grams of carbohydrate and
				18.6 grams of fat, computed from the USDA FoodData Central records matched to
				its four ingredients, with seven label rows left blank rather than counted as
				zero because the matched source does not report them, each blank naming the
				ingredient responsible. An aside: three events in the same week,
				280 guests between them,
				planned as one production run and submitted together as three orders, opening
				on a combined Shop, Prep and Pack workspace that totals the shopping and the
				prep across all three while the pack list keeps a by-event column so each
				event&rsquo;s trays stay separate. Each order still gets its own confirmation
				and its own purchase orders; the combined run does not confirm or buy. Back on
				the wedding: a capture inbox showing the purchase orders the confirmation
				actually emailed, one per vendor, each with its own number, and the one
				addressed to Green Valley Produce opened as the vendor receives it, five items
				in whole packs with a $516.08 subtotal. Receiving: arugula received three of
				four three-pound clamshells, the missing clamshell saved for purchasing
				follow-up; baby spinach ordered as fifteen three-pound clamshells and
				delivered as sixteen, $477.16 of received value against the $410.40 ordered.
				The ingredient&rsquo;s cost panel showing the price actually paid as the
				current cost, $21.91 a kilogram, with the receiving it came from on record.
				Sage, the in-app assistant, asked in plain words what needs attention for the
				Alvarez-Whitman Wedding, answering from the records: the food cost is 39.6
				percent against the 30 percent target, the same figure the pricing panel worked
				out at the start of the film, and 22 ingredients are still unreviewed for
				dietary checks. Under the answer, a &ldquo;Where this came from&rdquo; list of
				the order records it read, the wedding among them. Finally the order&rsquo;s comparison band: quoted at $26.93 a guest, $27.13 at
				today&rsquo;s prices, a 0.7 percent rise with the quote still holding. An end card: one job, quote to shelf, the same numbers
				the whole way.
			</p>

		<!-- Not styled as a ticket: real product footage should read as real,
		     not as another branded artifact. The poster names the price either
		     way: the ring on "Charge at least $89.78 per guest". Chosen by card
		     in assemble-silent.mjs, so re-timing b02 moves the wide one too.
		
		     TWO POSTERS SINCE 2026-08-23, and the phone gets the default.
		     MEASURED at 390: the wide frame carries its caption band across the
		     bottom 23% of the image, which is exactly where the native control
		     bar draws, so "Charge $89.78 a head to hit 30." rendered half
		     covered, over an app screenshot too dense to read at that scale.
		     The previous fix for this swapped WHICH dense frame was used and
		     did not survive the device.
		
		     demo-poster-mobile.jpg is built from the wide one by
		     scripts/build-mobile-poster.py: the same caption band moved to the
		     TOP, over a crop of the Next-step panel alone. The bottom of the
		     frame is deliberately empty so the control bar covers nothing. If
		     the cut is re-recorded, re-run that script rather than cropping by
		     hand. -->
		<!-- Centred and capped at the capture width: the footage is 1600x1000, and
		     stretching it past that only blurs it. -->
		<div class="relative mt-8 mx-auto max-w-[1600px]">
			<video
				controls
				playsinline
				preload="none"
				poster="/demo-poster-mobile.jpg"
				width="1600"
				height="1000"
				class="w-full border border-hairline bg-paper shadow-ticket"
				aria-label="Silent, captioned screen recording: CostCook prices a 180-guest wedding before the quote goes out, turns it into a vendor shopping list and a scaled prep list, computes the nutrition panel on a dish from the same menu, plans three events as one production run, emails its purchase orders, records a delivery that arrived wrong, and answers a question about the job from its own records"
				aria-describedby="demo-transcript"
			>
				<source src="/demo.webm" type="video/webm" />
				<source src="/demo.mp4" type="video/mp4" />
				<p>
					Your browser can&rsquo;t play this video.
					<a href="/demo.mp4" class="btn-quiet">Download it instead</a>
				</p>
			</video>
			<!-- Play affordance for the WIDE poster only. That frame is an app
			     screenshot and reads as a static image without it. Dark chip echoes
			     the footage's own caption chips. Decorative (the video carries the
			     labels), lets taps fall through to the video, removed on first play;
			     shown only when scripting can remove it, so no-JS playback is never
			     covered.
			
			     NOT ON THE PHONE, since 2026-08-23. The mobile poster opens on its
			     own caption band, so it never reads as a screenshot and needs no
			     chip to say it moves. Pinned top-left it sat straight on top of that
			     caption and covered "Charge $89.78 a", which is the one line the
			     poster exists to deliver. Below sm the native control bar draws its
			     own play button anyway. -->
			<span
				id="demo-play-badge"
				class="pointer-events-none absolute top-3 left-3 hidden items-center gap-2 rounded-full bg-ink/85 px-3.5 py-1.5 text-sm font-medium text-offwhite shadow-ticket sm:[@media(scripting:enabled)]:inline-flex"
				aria-hidden="true"
			>
				<svg width="10" height="12" viewBox="0 0 10 12" fill="currentColor" aria-hidden="true">
					<path d="M0 0l10 6-10 6z"></path>
				</svg>
				Watch · 2 min 53 sec
			</span>
		</div>

		<!-- PHONE-ONLY DISCLOSURE SINCE 2026-09-09. MEASURED at 390x844: this guide
		     is 2,975px, or 3.5 mobile viewports, of a page that measured 31,999px
		     (37.9 viewports) whole. It is the one block on the homepage that is
		     explicitly an ALTERNATIVE to something the reader has just been given -
		     its own heading says "without pressing play" - so it is the only stop
		     that can be folded without taking an argument off the page. Folding it
		     returns roughly 2,400px, about 7.5% of the scroll, to a reader who
		     watched the film. See BRIEF-mobile-view-2026-09-09.md section 4A.

		     OPEN IN THE MARKUP, CLOSED BY SCRIPT, AND THAT ORDER IS THE POINT.
		     Principle 3 says nothing is hidden from a no-JS visitor, so the served
		     HTML carries the guide open and the script below only ever CLOSES it,
		     and only under 52rem. JS off, or the script failing, leaves the whole
		     guide readable. The failure direction is "too much content", never
		     "missing content".

		     WHY THE COLLAPSE IS NOT A VISIBLE JUMP, given the CSP. vercel.json
		     ships script-src 'self', so the no-flash trick (an is:inline script
		     right after the element) is not available here and the script is
		     bundled and deferred like every other one in this repo. It therefore
		     runs after paint - but this block starts at 2,626px, three viewports
		     below the fold, so the reflow happens in a part of the document the
		     reader has not reached and will never see move. Nothing above the fold
		     shifts.

		     NO NEW COPY. The summary reads the jump link's own words ("Follow the
		     order in writing"); the hint reads the lede's ("handoffs"). Nothing here
		     is a sentence that has not already passed the claim scan.

		     THE COUNT IS NOW READ OFF guideSteps, IN BOTH PLACES. It was written
		     out as "six" in the lede and the array holds eight: the guide gained
		     nutrition and ask and the sentence above it did not. Caught 2026-09-09
		     while adding the summary, which would have repeated the wrong number.
		     A hand-typed count is a claim that drifts silently every time the
		     array changes, and no guard in this repo counts steps against prose.
		     Neither string can be wrong again. -->
		<section
			id="demo-guide"
			class="demo-guide mt-12 border-y border-ticket-rule py-10 sm:mt-16 sm:py-12"
			aria-labelledby="demo-guide-heading"
			data-demo-guide
		>
			<details class="demo-guide-disclosure" open data-demo-guide-disclosure>
				<summary class="demo-guide-summary">
					<span class="demo-guide-summary-text">
						<span class="demo-guide-summary-title">Follow the order in writing</span>
						<span class="demo-guide-summary-hint">{guideSteps.length} handoffs</span>
					</span>
					<svg
						class="demo-guide-summary-chevron"
						width="18"
						height="18"
						viewBox="0 0 18 18"
						fill="none"
						aria-hidden="true"
					>
						<path
							d="M5 7l4 4 4-4"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
				</summary>

			<div class="demo-guide-layout">
				<header class="demo-guide-intro">
					<h3 id="demo-guide-heading" tabindex="-1" class="max-w-[17ch] text-h3 font-semibold">
						Follow the order without pressing play.
					</h3>
					<p class="mt-4 max-w-[42ch] text-ink-soft">
						Read the same 180-guest wedding in {guideSteps.length} handoffs. Each line shows
						what goes in and what the next part of the job receives.
					</p>
				</header>

				<ol class="demo-route" aria-label="The wedding from quote to current cost">
					{
						guideSteps.map((step, index) => (
							<li class="demo-route-step" data-demo-guide-step={step.id}>
								<div class="demo-route-marker" aria-hidden="true">
									<span>{String(index + 1).padStart(2, '0')}</span>
								</div>
								<div class="min-w-0">
									<p class="demo-route-label">{step.label}</p>
									<h4 class="mt-1 font-display text-xl font-semibold text-ink">{step.title}</h4>
									<p class="mt-2 max-w-[60ch] text-ink-soft">{step.body}</p>
									<div class="demo-route-change" aria-label={`${step.from} becomes ${step.to}`}>
										<span>{step.from}</span>
										<svg width="26" height="14" viewBox="0 0 26 14" fill="none" aria-hidden="true">
											<path d="M1 7h22M18 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
										<strong>{step.to}</strong>
									</div>
								</div>
							</li>
						))
					}
				</ol>
			</div>

			<div class="multi-run mt-10 bg-cream px-5 py-7 sm:px-8 sm:py-8" data-demo-multi-run>
				<div class="multi-run-copy">
					<p class="demo-route-label">Then, the scale test</p>
					<h3 class="mt-2 text-h3 font-semibold">Three events. One production run.</h3>
					<p class="mt-3 max-w-[58ch] text-ink-soft">
						Combined production totals Shop and Prep across all three. Pack keeps a
						by-event column, and confirmation and purchase orders still stay with each order.
					</p>
				</div>

				<div
					class="multi-run-diagram"
					role="img"
					aria-label="Three separate event plans feed one combined Shop and Prep plan while Pack remains separated by event"
				>
					<div class="multi-run-events" aria-hidden="true">
						<span>Event 1</span>
						<span>Event 2</span>
						<span>Event 3</span>
					</div>
					<div class="multi-run-line" aria-hidden="true"></div>
					<div class="multi-run-output" aria-hidden="true">
						<strong>Combined Shop + Prep</strong>
						<span>Pack stays by event</span>
					</div>
				</div>
			</div>
			</details>
		</section>

		<!-- One primary, restored 2026-08-23. It was pulled when this section
		     competed with six next-actions; the page now carries two primaries
		     and three quiet links, so the condition that justified pulling it is
		     gone. MEASURED at 390 before this went back: the hero primary ended
		     at 520px and the next one appeared at 9,043px of a 9,604px page,
		     leaving 8,523px (10.1 viewports) with nothing to click, and the
		     header is position:static so it scrolls away rather than covering it.
		
		     The other half of that old note still holds and is why this sits
		     AFTER the player rather than beside it: a reader mid-film is still
		     being shown the thing. It renders cta.label like every other primary
		     on the page, so the page still opens, middles and closes on one
		     action. -->
		<div class="mt-10 border-t border-ticket-rule pt-6" data-reveal>
			<p class="max-w-[54ch] text-ink-soft">
				That was one real order, start to finish. Yours will have different numbers.
			</p>
			<a
				href={cta.href}
				target={cta.target}
				rel={cta.rel}
				aria-label={cta.ariaLabel}
				class="btn-primary mt-5"
			>
				{cta.label}
			</a>
			<p class="mt-4 text-sm text-ink-soft">
				{launchPlan.trialDays} days free. Card up front, charged $0 today.
			</p>
		</div>

		<SectionHandoff from="demo" />
	</div>
</section>

<script>
	const video = document.querySelector<HTMLVideoElement>('#demo video');

	// Clear the play chip once the footage is rolling.
	const badge = document.getElementById('demo-play-badge');
	if (video && badge) {
		video.addEventListener('play', () => badge.remove(), { once: true });
	}

	// POSTER SWAPS UP, NOT DOWN. The mobile composite is the server-rendered
	// default and the wide frame is the enhancement, because the reader most
	// likely to have JS off is on the phone, and the phone is the width where
	// the desktop poster fails: MEASURED at 390, its caption band lands under
	// Chromium's native control bar and the app screenshot behind it is too
	// dense to read. Failing this check leaves a legible poster on a big
	// screen, which is the harmless direction.
	if (video && window.matchMedia('(min-width: 640px)').matches) {
		video.setAttribute('poster', '/demo-poster.jpg');
	}

	// THE GUIDE FOLDS DOWN, IT NEVER FOLDS UP. The served HTML has the <details>
	// open, so a reader with no JS, or one this script never reaches, gets the
	// whole guide. All this does is close it under 52rem, which is where its
	// 2,975px cost 3.5 viewports of a 37.9-viewport page.
	//
	// Bundled, never is:inline: the CSP in vercel.json is script-src 'self'.
	// That means this runs after paint, which is fine here and only here - the
	// guide begins 2,626px down, so the reflow happens three viewports below the
	// fold and nothing the reader is looking at moves.
	const guide = document.querySelector<HTMLDetailsElement>('[data-demo-guide-disclosure]');
	if (guide && window.matchMedia('(max-width: 51.99rem)').matches) {
		guide.open = false;

		// The jump link under the player targets the heading INSIDE the guide.
		// Closed, that anchor resolves to nothing, so open it first and let the
		// browser's own anchor handling do the rest. Not preventDefault'd: the
		// hash still lands, focus still moves to the tabindex="-1" heading, and
		// a reader who then collapses it again keeps that choice.
		document.querySelector('[data-demo-guide-jump]')?.addEventListener('click', () => {
			guide.open = true;
		});
	}
</script>

