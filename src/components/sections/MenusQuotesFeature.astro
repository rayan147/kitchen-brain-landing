---
import FeatureTrialTerms from "../FeatureTrialTerms.astro";
import { featureGroups } from '../../lib/features';
import { cta, demoCta } from '../../lib/site';

const menuGroup = featureGroups.find((group) => group.id === 'menus');
const orderGroup = featureGroups.find((group) => group.id === 'orders');
if (!menuGroup || !orderGroup) throw new Error('Missing Menus & Quotes public feature groups.');

// Considered Strategy; not used because this page selects a fixed, editorially
// relevant subset of static feature data rather than interchangeable behavior.
const quoteLeads = new Set([
	'Costed before commitment.',
	'Pinned money bar.',
	'Confirm freezes everything.',
	'Honest reopen.',
	'Clean duplication.',
	'Quoted vs today.',
	'Aged plans flagged.',
	'Frozen prep notes.'
]);
const quoteItems = orderGroup.items.filter((item) => quoteLeads.has(item.lead));
if (quoteItems.length !== quoteLeads.size) throw new Error('Menus & Quotes capability selection drifted.');

const capabilityGroups = [
	{ id: 'menus', label: 'Menu management', title: menuGroup.title, items: menuGroup.items },
	{ id: 'quotes', label: 'Quote and confirmation', title: 'Price the draft, then protect the commitment.', items: quoteItems }
] as const;
const capabilityCount = capabilityGroups.reduce((total, group) => total + group.items.length, 0);

const quoteSteps = [
	{ label: 'Menu', note: 'Choose what each guest receives.' },
	{ label: 'Date', note: 'Put the job on the calendar.' },
	{ label: 'Guests', note: 'Set the count the kitchen must serve.' },
	{ label: 'Price', note: 'Test the number against food cost.' },
	{ label: 'Confirm', note: 'Freeze plan, math, and money.' }
] as const;

const faqItems = [
	{
		question: 'What is menu management software?',
		answer:
			'Menu management software keeps dishes, portions per guest, the default selling price, and reusable equipment counts together. In CostCook, the menu can then become the starting point for a costed event.'
	},
	{
		question: 'How does CostCook calculate a catering quote?',
		answer:
			'A draft combines a menu, date, guest count, and price. CostCook computes the food cost per guest and food-cost percentage, then shows the price that would meet the configured target before you confirm.'
	},
	{
		question: 'How does the client see the price?',
		answer:
			'As a proposal on their own page: the event\u2019s costed menu goes into it, and they accept it or ask for changes on their phone. The whole path is on the Events & proposals guide.'
	},
	{
		question: 'Can an event use a different price from the menu default?',
		answer:
			'Yes. The menu carries the default per-guest price, and an individual order can override it without changing the reusable menu.'
	},
	{
		question: 'What happens when I confirm a quote?',
		answer:
			'Confirming saves the event plan, calculations and quoted price together. Later ingredient prices do not rewrite the quote you gave.'
	},
	{
		question: 'Will later ingredient prices change the quote I already gave?',
		answer:
			'No. A confirmed event keeps its frozen prices. CostCook can compare the original quote with current prices later without silently rewriting the commitment.'
	},
	{
		question: 'Can I reopen a confirmed event?',
		answer:
			'You can reopen while preserving the frozen prices, and the screen says that clearly. Once purchasing has started, reopening is refused so completed work is not invalidated.'
	}
] as const;
---

<!-- story: docs/stories/menus-and-quotes-redesign.story.md -->
<!-- 2026-09-27 (gap report S5, W3). The quote an event's client sees is now a
     proposal on their own page, and that path has its own guide. This page
     keeps what it truly owns: the costed menu, the price per guest against the
     food-cost target, and the draft order a job taken by phone starts as. The
     name and URL stay, because the Features menu, the tour and five contracts
     pin "Menus & quotes", and a hand-made draft order still carries a quote. -->
<article class="menus-quotes">
	<section class="hero" aria-labelledby="menus-quotes-heading">
		<div class="container-page hero-grid">
			<div class="hero-copy anim-enter">
				<nav aria-label="Breadcrumb" class="feature-breadcrumb">
					<a href="/features">Every feature</a>
					<span aria-hidden="true">/</span>
					<span>Menus and quotes</span>
				</nav>
				<h1 id="menus-quotes-heading" class="feature-display">Build your menu. Check the price per guest.</h1>
				<p class="hero-lede">Choose your dishes and portions, then add the event date, guest count and selling price. Check the food cost before confirming the quote and the kitchen plan together.</p>
				<div class="hero-actions">
					<a href={cta.href} target={cta.target} rel={cta.rel} aria-label={cta.ariaLabel} class="btn-primary">
						{cta.label}
					</a>
					<a
						href={demoCta.href}
						target={demoCta.target}
						rel={demoCta.rel}
						aria-label={demoCta.ariaLabel}
						class="btn-quiet"
					>
						{demoCta.label}
					</a>
				</div>
				<FeatureTrialTerms />
			</div>

			<figure class="commitment-flow anim-enter" style="--enter-delay: 120ms">
				<figcaption>Illustrative menu-to-quote record</figcaption>
				<div class="record-pair">
					<div class="menu-ledger">
						<div class="record-head"><span>Menu</span><span>180 guests</span></div>
						<strong class="record-title">Summer wedding dinner</strong>
						<div class="ledger-head"><span>Dish</span><span>Per guest</span></div>
						<ul role="list" class="dish-lines">
							<li><span>Herb roast chicken</span><strong>1 portion</strong></li>
							<li><span>Lemon herb potatoes</span><strong>6 oz</strong></li>
							<li><span>Seasonal green salad</span><strong>4 oz</strong></li>
							<li><span>Lemon tart</span><strong>1 slice</strong></li>
						</ul>
						<dl class="ledger-summary">
							<div><dt>Default price</dt><dd>$68.00 / guest</dd></div>
							<div><dt>Equipment</dt><dd>3 chafers</dd></div>
						</dl>
					</div>

					<div class="record-join" aria-hidden="true"><span></span></div>

					<div class="quote-timeline">
						<div class="record-head"><span>Quote path</span><span>Same menu</span></div>
						<ol>
							<li class="done"><span></span><div><small>Draft</small><strong>Menu + 180 guests</strong></div></li>
							<li class="current"><span></span><div><small>Review the number</small><strong>$26.93 food / guest</strong></div></li>
							<li><span></span><div><small>Confirm</small><strong>$68.00 / guest quoted</strong></div></li>
						</ol>
						<div class="quote-decision">
							<small>Price for a 30% food-cost target</small>
							<strong>$89.78 / guest</strong>
							<span>39.6% food cost at the quoted price</span>
						</div>
					</div>
				</div>
				<p class="evidence-note">The film’s sample event. The dishes shown are examples, not its cost breakdown. Food cost excludes labor, rentals, tax and profit.</p>
			</figure>
		</div>
	</section>

	<section class="handoff-problem" aria-labelledby="handoff-heading">
		<div class="container-page problem-grid">
			<div data-reveal>
				<h2 id="handoff-heading">Three files. One client waiting.</h2>
				<p>
					The dishes are in a menu document. The revised count is in an email. The number you
					plan to send is in a spreadsheet. The copying only looks harmless while all three agree.
				</p>
			</div>
			<figure class="handoff" data-reveal>
				<div><span>Menu document</span><strong>What they chose</strong></div>
				<svg width="36" height="18" viewBox="0 0 36 18" aria-hidden="true"><path d="M1 9h28M24 3l6 6-6 6" /></svg>
				<div><span>Guest-count email</span><strong>What changed</strong></div>
				<svg width="36" height="18" viewBox="0 0 36 18" aria-hidden="true"><path d="M1 9h28M24 3l6 6-6 6" /></svg>
				<div><span>Quote sheet</span><strong>What you say</strong></div>
				<figcaption>One event record should carry what the client chose and what the kitchen has to run.</figcaption>
			</figure>
		</div>
	</section>

	<nav class="product-nav container-page" aria-label="On this page">
		<a href="#menu-management">
			<span>Menu management</span>
			<small>Build what each guest gets, priced and ready to reuse.</small>
			<svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5" /></svg>
		</a>
		<a href="#catering-quotes">
			<span>Catering quotes</span>
			<small>Test the number, confirm it, and keep the original commitment.</small>
			<svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5" /></svg>
		</a>
	</nav>

	<section id="menu-management" class="product-section menu-management" aria-labelledby="menu-management-heading">
		<div class="container-page">
			<div class="section-intro" data-reveal>
				<h2 id="menu-management-heading">Make the menu runnable before you make it presentable.</h2>
				<p>
					Keep dishes, portions per guest, the default price, and the equipment the menu always
					needs in one workspace.
				</p>
			</div>

			<figure class="menu-workspace" data-reveal>
				<div class="workspace-main">
					<div class="workspace-bar"><span>Menu workspace</span><span>Illustrative</span></div>
					<div class="workspace-title">
						<div><small>Menu</small><strong>Garden wedding supper</strong></div>
						<div><small>Default</small><strong>$28 / guest</strong></div>
					</div>
					<div class="menu-table" role="table" aria-label="Illustrative menu workspace">
						<div class="menu-row menu-row-head" role="row">
							<span role="columnheader">Dish</span><span role="columnheader">Per guest</span><span role="columnheader">Cost</span>
						</div>
						<!-- The product tour's menu (src/lib/tour.ts), not the film's: this
						     block used the film's menu name with a different cost, so one
						     menu showed two answers (chef audit 2026-10-07). -->
						<div class="menu-row" role="row"><span role="cell">Herb roast chicken</span><strong role="cell">1 portion</strong><span role="cell">$2.70</span></div>
						<div class="menu-row active" role="row"><span role="cell">Charred market vegetables</span><strong role="cell">6 oz</strong><span role="cell">$0.72</span></div>
						<div class="menu-row" role="row"><span role="cell">Rosemary focaccia</span><strong role="cell">2 pieces</strong><span role="cell">$0.43</span></div>
						<div class="menu-row" role="row"><span role="cell">Citrus salad</span><strong role="cell">4 oz</strong><span role="cell">$0.30</span></div>
					</div>
				</div>
				<div class="workspace-side">
					<div class="price-check">
						<span>Menu pricing</span>
						<dl>
							<div><dt>Food cost / guest</dt><dd>$8.29</dd></div>
							<div><dt>Selling price / guest</dt><dd>$28.00</dd></div>
							<div><dt>Price / guest for 30% food cost</dt><dd>$27.62</dd></div>
						</dl>
					</div>
					<div class="equipment-sheet">
						<span>Equipment template</span>
						<ul role="list"><li><span>Chafers</span><strong>3</strong></li><li><span>Sheet trays</span><strong>6</strong></li><li><span>Service utensils</span><strong>8</strong></li></ul>
						<small>Counts stay fixed when guest count changes.</small>
					</div>
				</div>
				<figcaption>The product tour’s garden wedding, a different menu from the one above. Four of its seven dishes are shown; all seven cost $8.29 a guest, 29.6% of $28.00. At the kitchen’s 30% target, $1,491.38 ÷ 180 ÷ 0.30 = $27.62 a guest. Equipment counts are fixed; they do not scale with guests.</figcaption>
			</figure>

			<div class="feature-scenes" data-reveal>
				<article><h3>Build what each guest receives.</h3><p>Dishes and portions per guest stay together, so the menu already carries the quantities an event will need.</p></article>
				<article><h3>Price the menu from its food.</h3><p>Read cost per guest against the selling price, including the price that would meet your configured target.</p></article>
				<article><h3>Keep the reusable plan safe.</h3><p>Attach fixed equipment counts, override details on one event, and check where a menu is used before deleting it.</p></article>
			</div>
		</div>
	</section>

	<section id="catering-quotes" class="product-section catering-quotes" aria-labelledby="catering-quotes-heading">
		<div class="container-page">
			<div class="section-intro" data-reveal>
				<h2 id="catering-quotes-heading">Know what the quote is carrying before you confirm it.</h2>
				<p>
					A new event starts with a menu, date, guest count, and price. See the food cost while
					the job is still a draft, then freeze the plan, math, and money together.
				</p>
			</div>
			<p class="proposal-bridge" data-proposal-bridge data-reveal>
				When a client is waiting on a price, the same costed menu goes into a proposal they
				accept on their phone; <a href="/features/events-and-proposals">see events and proposals</a>.
			</p>

			<figure class="quote-path" data-reveal>
				<ol role="list">
					{quoteSteps.map((step, index) => (
						<li><span>{index + 1}</span><strong>{step.label}</strong><p>{step.note}</p></li>
					))}
				</ol>
				<figcaption>Review happens before confirmation, while the number can still be changed deliberately.</figcaption>
			</figure>

			<div class="pricing-proof">
				<div class="proof-copy" data-reveal>
					<h3>Cost before commitment.</h3>
					<p>
						For the 180-guest summer wedding in these screens, $68 per guest puts food cost at 39.6%. The same panel
						names $89.78 as the price that would meet the 30% target.
					</p>
					<ul role="list">
						<li>The order price can override the menu default.</li>
						<li>Guest-count changes update the draft estimate.</li>
						<li>Confirmation freezes the agreed plan and money.</li>
					</ul>
				</div>
				<figure class="screenshot-frame" data-reveal>
					<picture>
						<source media="(max-width: 639px)" srcset="/proof/hero-pricing-mobile.png" />
						<img
							src="/proof/hero-pricing.png"
							width="2208"
							height="554"
							loading="lazy"
							decoding="async"
							alt="CostCook order price panel for 180 guests at $68.00 a guest, $27.00 below the menu’s $95.00. Food cost 39.6% against a 30% target: sales $12,240.00, food $4,847.95 ($26.93 a guest), food margin $7,392.05. Get to 30%: charge $89.78 a guest, $16,160.40 total, or use the menu price, $95.00, 28.4%, within target."
						/>
					</picture>
					<figcaption>Captured from CostCook, sample event.</figcaption>
				</figure>
			</div>

			<div class="confirmed-proof" data-reveal>
				<figure>
					<img
						src="/demo-poster.jpg"
						width="1600"
						height="1000"
						loading="lazy"
						decoding="async"
						alt="Confirmed CostCook event showing 180 guests at $68 per guest, quoted food cost of $26.93 per guest, current food cost of $27.13, and Shop, Prep, and Pack tabs below."
					/>
				</figure>
				<div>
					<h3>Compare without rewriting.</h3>
					<p>
						The confirmed quote stays frozen while today's cost remains visible beside it. The
						original number does not disappear just because a supplier price moved later.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section class="connected-proof" aria-labelledby="connected-heading">
		<div class="container-page connected-grid">
			<div data-reveal>
				<h2 id="connected-heading">The quote should know what the kitchen has to pack.</h2>
				<p>
					Confirmation is not the end of the record. The same frozen event becomes the source
					for Shop, Prep, and Pack, so the kitchen runs the job that was priced.
				</p>
			</div>
			<figure class="commitment-map" data-reveal>
				<ol role="list">
					<li><span>Build menu</span></li><li><span>Set guests</span></li><li><span>Review cost</span></li><li><span>Set price</span></li><li class="confirmed"><span>Confirm</span></li>
				</ol>
				<div class="branch-rule" aria-hidden="true"></div>
				<ul role="list"><li>Shop</li><li>Prep</li><li>Pack</li></ul>
				<figcaption>One confirmed event feeds three working views without rebuilding the menu or guest count.</figcaption>
			</figure>
		</div>
	</section>

	<section class="capabilities" aria-labelledby="capabilities-heading">
		<div class="container-page">
			<div class="capability-heading" data-reveal>
				<div><h2 id="capabilities-heading">The complete Menus & Quotes list.</h2><p>Only the shipped capabilities directly involved in building, pricing, and confirming the job.</p></div>
				<p class="count"><strong>{capabilityCount}</strong><span>relevant capabilities</span></p>
			</div>
			<div class="disclosures">
				{capabilityGroups.map((group) => (
					<details id={`features-${group.id}`} data-reveal>
						<summary><span><strong>{group.label}</strong><small>{group.title}</small></span><span class="summary-count">{group.items.length}</span><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 7l6 6 6-6" /></svg></summary>
						<ul role="list">{group.items.map((item) => <li><strong>{item.lead}</strong> <span>{item.detail}</span></li>)}</ul>
					</details>
				))}
			</div>
		</div>
	</section>

	<section class="faq" aria-labelledby="faq-heading">
		<div class="container-page faq-grid">
			<div class="faq-intro" data-reveal><h2 id="faq-heading">Frequently asked questions</h2><p>The practical questions to settle before the number leaves your kitchen.</p></div>
			<div class="faq-list">
				{faqItems.map((item) => (
					<details data-reveal><summary><span>{item.question}</span><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 7l6 6 6-6" /></svg></summary><p>{item.answer}</p></details>
				))}
			</div>
		</div>
	</section>

	<section class="closing" aria-labelledby="closing-heading">
		<div class="container-page closing-grid" data-reveal>
			<div><h2 id="closing-heading">Ready for the client. Ready for the kitchen.</h2><p>Bring one real menu, set the guest count, and follow the number into the plan the kitchen will run.</p></div>
			<div class="closing-actions">
				<a href={cta.href} target={cta.target} rel={cta.rel} aria-label={cta.ariaLabel} class="btn-primary">{cta.label}</a>
				<a href={demoCta.href} target={demoCta.target} rel={demoCta.rel} aria-label={demoCta.ariaLabel} class="btn-quiet">{demoCta.label}</a>
			</div>
		</div>
		<nav class="container-page onward feature-onward" aria-label="Related feature guides"><a href="/features/events-and-proposals">Events &amp; proposals</a><a href="/features/recipes-and-costing">Recipes &amp; food costing</a><a href="/features">Every CostCook feature</a></nav>
	</section>
</article>

<style>
	.menus-quotes { --rule: color-mix(in srgb, var(--color-ink) 18%, transparent); overflow: clip; }
	.hero { border-block: 1px solid var(--color-hairline); background: var(--color-cream); }
	.hero-grid { display: grid; gap: clamp(3rem, 6vw, 6rem); align-items: center; padding-block: clamp(4rem, 7vw, 7.25rem); }
	.hero-copy { min-width: 0; }
	.hero h1 { max-width: 13ch; }
	.hero-lede { max-width: 37ch; margin-top: 1.75rem; font-size: var(--text-lede); line-height: 1.55; color: var(--color-ink-soft); }
	.hero-actions, .closing-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
	.hero-actions .btn-primary, .closing-actions .btn-primary { min-height: 48px; align-items: center; justify-content: center; padding-inline: 1.7rem; }
	.commitment-flow > figcaption { margin-bottom: 0.8rem; font-size: var(--text-label-sm); font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: var(--color-amber-deep); }
	.record-pair { display: grid; gap: 1rem; align-items: center; }
	.menu-ledger, .quote-timeline { min-width: 0; padding: clamp(1.1rem, 2.5vw, 1.7rem); background: var(--color-paper); box-shadow: var(--shadow-ticket); }
	.menu-ledger { border-top: 3px solid var(--color-green); }
	.quote-timeline { border-top: 3px solid var(--color-amber-deep); }
	.record-head { display: flex; justify-content: space-between; gap: 1rem; font-size: var(--text-micro); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-ink-soft); }
	.menu-ledger .record-title { display: block; margin-top: 1.4rem; font-family: var(--font-display); font-size: var(--text-record); }
	.ledger-head, .dish-lines li { display: grid; grid-template-columns: 1fr auto; gap: 1rem; align-items: center; }
	.ledger-head { margin-top: 1.4rem; padding-block: 0.55rem; border-block: 1px solid var(--rule); font-size: var(--text-micro); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-ink-soft); }
	.dish-lines li { padding-block: 0.62rem; border-bottom: 1px solid var(--rule); font-size: var(--text-caption); }
	.dish-lines strong, .ledger-summary dd, .quote-decision strong { font-variant-numeric: tabular-nums; }
	.ledger-summary { display: grid; gap: 0.55rem; margin-top: 1.3rem; }
	.ledger-summary div { display: flex; justify-content: space-between; gap: 1rem; font-size: var(--text-label-sm); }
	.ledger-summary dd { font-weight: 700; }
	.record-join { display: none; }
	.quote-timeline ol { position: relative; display: grid; gap: 1.25rem; margin-top: 1.5rem; }
	.quote-timeline ol::before { position: absolute; top: 0.4rem; bottom: 0.4rem; left: 0.37rem; width: 1px; background: var(--color-ticket-rule); content: ''; }
	.quote-timeline li { position: relative; display: grid; grid-template-columns: 0.8rem 1fr; gap: 0.8rem; align-items: start; }
	.quote-timeline li > span { position: relative; z-index: 1; width: 0.8rem; height: 0.8rem; margin-top: 0.2rem; border: 2px solid var(--color-amber-deep); border-radius: 50%; background: var(--color-paper); }
	.quote-timeline li.done > span { background: var(--color-green); border-color: var(--color-green); }
	.quote-timeline li.current > span { box-shadow: 0 0 0 3px var(--color-paper), 0 0 0 4px var(--color-amber-deep); background: var(--color-amber-deep); }
	.quote-timeline small { display: block; font-size: var(--text-micro); font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--color-amber-deep); }
	.quote-timeline strong { display: block; margin-top: 0.18rem; font-size: var(--text-caption); }
	.quote-decision { margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--rule); }
	.quote-decision small, .quote-decision span { display: block; color: var(--color-ink-soft); }
	.quote-decision small { font-size: var(--text-micro); font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; }
	.quote-decision strong { display: block; margin-top: 0.25rem; font-family: var(--font-display); font-size: var(--text-record); color: var(--color-amber-deep); }
	.quote-decision span { margin-top: 0.35rem; font-size: var(--text-label-sm); line-height: 1.45; }
	.evidence-note { margin-top: 0.85rem; font-size: var(--text-label-sm); color: var(--color-ink-soft); }

	.handoff-problem { padding-block: var(--spacing-section-tight); background: var(--color-ink); color: var(--color-paper); }
	.problem-grid { display: grid; gap: 3rem; align-items: center; }
	.problem-grid h2 { max-width: 14ch; }
	.problem-grid > div p { max-width: 46ch; margin-top: 1rem; color: color-mix(in srgb, var(--color-paper) 72%, transparent); }
