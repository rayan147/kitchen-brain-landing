---
import { availableFeatureGroups, inDevelopmentFeatureGroups, featureCount } from '../../lib/features';
import { demoCta } from '../../lib/site';

// The complete shipped-feature list (src/lib/features.ts, written from the
// code audit). This is the body of the /features reference page — the home
// page carries only a quiet link from CustomerOutcomes, per Krug's
// billboard rule. Shape follows the density rule: a low-frequency,
// high-density read wants information architecture, not disclosure — group
// headers carry the words a buyer scans for, every item stays visible (no
// accordions, no JS), and the jump list is the scannable entry point.
---

<section id="everything" class="border-y border-hairline bg-cream" aria-labelledby="everything-heading">
	<div class="container-page py-section">
		<div class="max-w-3xl" data-reveal>
			<p class="eyebrow">The complete list</p>
			<h1 id="everything-heading" class="mt-4 text-display font-semibold">
				Everything CostCook does today. All {featureCount} things.
			</h1>
			<p class="mt-5 max-w-[66ch] text-lede text-ink-soft">
				This list is written from the code, not the roadmap. Every line is shipped and
				working in the app you would see on a demo call. If something is not on this
				list, CostCook does not do it yet.
			</p>
		</div>

		<nav aria-label="Feature groups" class="mt-8" data-reveal>
			<ul role="list" class="flex flex-wrap gap-x-6 gap-y-1">
				{
					availableFeatureGroups.map((group) => (
						<li>
							<a
								href={`#features-${group.id}`}
								class="inline-flex min-h-11 items-center gap-2 text-sm font-medium text-ink-soft transition-colors duration-150 hover:text-ink"
							>
								{group.kicker}
								<span class="font-mono text-xs text-amber-deep" aria-hidden="true">{group.items.length}</span>
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="mt-10 space-y-14">
			{
				availableFeatureGroups.map((group, index) => (
					<div id={`features-${group.id}`} class="scroll-mt-24 border-t border-ticket-rule pt-6">
						<div class="flex items-baseline gap-3">
							<span class="font-mono text-sm font-semibold tabular-nums text-amber-deep" aria-hidden="true">
								{String(index + 1).padStart(2, '0')}
							</span>
							<p class="eyebrow">{group.kicker}</p>
						</div>
						<!-- h2, not h3: these groups sit directly under the page h1. -->
						<h2 class="mt-3 max-w-2xl text-h3 font-semibold">{group.title}</h2>
						<ul role="list" class="mt-5 gap-x-12 sm:columns-2">
							{
								group.items.map((item) => (
									<li class="break-inside-avoid border-t border-hairline py-2.5 text-sm leading-relaxed">
										<strong class="font-semibold text-ink">{item.lead}</strong>
										<span class="text-ink-soft"> {item.detail}</span>
									</li>
								))
							}
						</ul>
					</div>
				))
			}
		</div>

		<div class="mt-14 border-t border-ticket-rule pt-6">
			<p class="eyebrow">In development</p>
			<h2 class="mt-3 text-h3 font-semibold">Clearly separate from what you can buy today.</h2>
			<div class="mt-5 grid gap-4 sm:grid-cols-2">
				{inDevelopmentFeatureGroups.map((group) => (
					<article class="border-t border-hairline py-4">
						<h3 class="font-semibold">{group.kicker}</h3>
						<p class="mt-2 text-sm leading-relaxed text-ink-soft">{group.items[0].detail}</p>
					</article>
				))}
			</div>
		</div>

		<p class="mt-12 border-t border-ticket-rule pt-6 max-w-[66ch] text-ink-soft">
			That is the whole list. If it covers your kitchen, bring one real menu and see it run.
			<a href={demoCta.href} target={demoCta.target} rel={demoCta.rel} aria-label={demoCta.ariaLabel} class="btn-quiet"
				>Book 15 minutes</a
			>
		</p>
	</div>
</section>
