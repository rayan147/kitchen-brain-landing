---
import FeatureTrialTerms from '../FeatureTrialTerms.astro';
import { tourSeedKey, tourStops } from '../../lib/tour';
import { cta, demoCta } from '../../lib/site';
import SageIcon from '../SageIcon.astro';
---

<!-- story: docs/stories/product-tour.story.md -->
<article class="product-tour">
	<section class="tour-hero" aria-labelledby="tour-heading">
		<div class="container-page tour-hero-grid">
			<div class="tour-hero-copy anim-enter">
				<nav aria-label="Breadcrumb" class="tour-breadcrumb">
					<a href="/features">Features</a>
					<span aria-hidden="true">/</span>
					<span>Product tour</span>
				</nav>
				<h1 id="tour-heading">Follow one event from quote to pack list.</h1>
				<p>
					Sample screens from one 180-guest wedding, from what the recipes cost through the buying, the prep and the pack. No account needed. Start wherever you like.
				</p>
				<div class="tour-hero-actions">
					<!-- Quiet, not btn-primary: on this site the green button is only ever the
					     trial (design audit 2026-10-07). -->
					<a href="#guided-tour" class="btn-quiet">Start the guided tour</a>
					<a href={demoCta.href} target={demoCta.target} rel={demoCta.rel} aria-label={demoCta.ariaLabel} class="btn-quiet">{demoCta.label}</a>
				</div>
			</div>
			<div class="tour-ticket anim-enter" style="--enter-delay: 120ms" aria-label="Illustrative tour dataset summary">
				<div class="tour-ticket-head"><span>Sample event</span><span>Illustrative</span></div>
				<strong>Garden wedding supper</strong>
				<dl>
					<div><dt>Event</dt><dd>Saturday, Aug 29</dd></div>
					<div><dt>Guests</dt><dd>180</dd></div>
					<div><dt>Menu</dt><dd>Garden wedding supper</dd></div>
					<div><dt>Quote</dt><dd>$28.00 per guest</dd></div>
				</dl>
				<p>{tourStops.length} stops. Start with recipes, or jump to the job you came to see.</p>
			</div>
		</div>
	</section>

	<section id="guided-tour" class="tour-workspace" aria-labelledby="guided-tour-heading" data-tour data-seed-key={tourSeedKey}>
		<div class="container-page">
			<div class="tour-heading-row">
				<div>
					<h2 id="guided-tour-heading">Take the product tour</h2>
					<p>Pick a stop, or press Next and follow the event through. These are sample screens; each one links to its feature guide.</p>
				</div>
				<p class="tour-truth">All figures are illustrative. Each stop follows its public status.</p>
			</div>

			<div class="tour-mobile-control">
				<label for="tour-stop-select">Tour stop</label>
				<select id="tour-stop-select" data-tour-select>
					{tourStops.map((stop, index) => <option value={index}>{index + 1}. {stop.label}</option>)}
				</select>
			</div>

			<div class="tour-shell">
				<nav class="tour-rail" aria-label="Product tour stops">
					<div class="tour-rail-head">
						<span>Juniper & Stone</span>
						<small>Guided workspace</small>
					</div>
					<div role="tablist" aria-label="Choose a feature to inspect" aria-orientation="vertical">
						{tourStops.map((stop, index) => (
							<button
								type="button"
								role="tab"
								id={`tour-tab-${stop.id}`}
								aria-controls={`tour-panel-${stop.id}`}
								aria-selected={index === 0 ? 'true' : 'false'}
								tabindex={index === 0 ? 0 : -1}
								data-tour-tab
								data-index={index}
							>
								<span>{String(index + 1).padStart(2, '0')}</span>
								<strong class:list={[stop.icon === 'sage' && 'sage-stop-label']}>
									{stop.icon === 'sage' && <SageIcon size={18} context="tour" />}
									{stop.label}
								</strong>
							</button>
						))}
					</div>
				</nav>

				<div class="tour-stage">
					<div class="app-topbar">
						<div class="app-brand"><span>CC</span><strong>Juniper & Stone Catering</strong></div>
						<div class="app-search" aria-hidden="true">Search CostCook</div>
						<div class="app-user" role="img" aria-label="Signed in as Alex R">AR</div>
					</div>

					<div class="tour-progress" aria-live="polite" aria-atomic="true">
						<span data-tour-progress>Stop 1 of {tourStops.length}</span>
						<div aria-hidden="true"><span data-tour-progress-bar style={`--tour-progress-scale: ${1 / tourStops.length}`}></span></div>
					</div>

					{tourStops.map((stop, index) => (
						<section
							role="tabpanel"
							id={`tour-panel-${stop.id}`}
							aria-labelledby={`tour-tab-${stop.id}`}
							data-tour-scene
							data-index={index}
							data-stop-id={stop.id}
							data-stop-label={stop.label}
							tabindex="0"
							hidden={index !== 0}
						>
							<div class="app-page-head">
								<div>
									<p>{stop.appArea}</p>
									<h3>{stop.title}</h3>
								</div>
								<span class="seed-chip">Illustrative tour data</span>
							</div>

							<div class="metric-strip">
								{stop.metrics.map((metric) => (
									<div data-tone={metric.tone || 'plain'}>
										<span>{metric.label}</span>
										<strong>{metric.value}</strong>
										{metric.note && <small>{metric.note}</small>}
									</div>
								))}
							</div>

							<div class="app-content-grid">
								<div class="app-table-wrap" data-pan data-pan-hint="Scroll sideways to see the whole table." tabindex="0" role="region" aria-label={`${stop.title}: table`}>
									<table>
										<thead><tr>{stop.columns.map((column) => <th scope="col">{column}</th>)}</tr></thead>
										<tbody>{stop.rows.map((row) => <tr>{row.map((cell, cellIndex) => cellIndex === 0 ? <th scope="row">{cell}</th> : <td data-label={stop.columns[cellIndex]}>{cell}</td>)}</tr>)}</tbody>
									</table>
								</div>

								<aside class="app-aside" aria-label={stop.aside.title}>
									<div class="app-aside-head">
										<h4>{stop.aside.title}</h4>
										{stop.aside.status && <span>{stop.aside.status}</span>}
									</div>
									<dl>
										{stop.aside.lines.map((line) => <div data-tone={line.tone || 'plain'}><dt>{line.label}</dt><dd>{line.value}</dd></div>)}
									</dl>
									<p>{stop.aside.footnote}</p>
								</aside>
							</div>

							<div class="tour-coach">
								<div>
									<h4>{stop.callout}</h4>
									<p>{stop.intro}</p>
								</div>
								<a href={stop.featureHref}>Read the feature guide</a>
							</div>
						</section>
					))}

					<div class="tour-controls">
						<button type="button" data-tour-prev disabled>Previous stop</button>
						<button type="button" data-tour-next>Next: {tourStops[1].label}</button>
					</div>
				</div>
			</div>

			<noscript>
				<p class="tour-noscript">The guided controls need JavaScript. Every feature is still available from <a href="/features">the complete feature index</a>.</p>
			</noscript>
		</div>
	</section>

	<section class="tour-close" aria-labelledby="tour-close-heading" data-sticky-end>
		<div class="container-page tour-close-grid">
			<div>
				<h2 id="tour-close-heading">Start with one real menu and take it all the way to the back door.</h2>
				<p>Bring the recipes and supplier prices you already have. The plan and its numbers stay tied together from the quote to the pack list.</p>
			</div>
			<!-- Considered Composite; not used because this is a fixed pair of
                 content groups. Bounded columns keep billing text from shrinking the heading. -->
            <div class="closing-decision">
                <div class="tour-close-actions">
				<a href={cta.href} target={cta.target} rel={cta.rel} aria-label={cta.ariaLabel} class="btn-primary">{cta.label}</a>
				<a href={demoCta.href} target={demoCta.target} rel={demoCta.rel} aria-label={demoCta.ariaLabel} class="btn-quiet">{demoCta.label}</a>
			</div>
                <FeatureTrialTerms />
            </div>
		</div>
	</section>
</article>

<!--
  NOT is:inline, AND NOT define:vars. The production CSP in vercel.json is
  `script-src 'self'` with no 'unsafe-inline', no nonce and no hash, so Chrome
  refuses to execute any inline script on costcook.io:

    Executing inline script violates the following Content Security Policy
    directive 'script-src 'self''. The action has been blocked.

  This script WAS inline, so every rail stop, the Next button, the mobile
  select and the progress readout were dead in production while passing in dev
  and in `astro preview`, neither of which sends the header. The tour opened on
  stop 1 and stayed there, so nobody reading costcook.io ever reached stop 12.

  `define:vars` implies is:inline, so it cannot be kept either. The two arrays
  it used to inject are read off the DOM instead: every panel already carries
  data-stop-id, and now carries data-stop-label beside it. Importing
  src/lib/tour.ts here would work but would ship all twelve stops' table rows
  to the client for two arrays of strings.

  scripts/check-dist.mjs now fails the build on any executable inline script in
  dist/, because no local server sends the CSP that would catch this.

  Considered Observer for the tab/panel wiring; not used because there is one
  producer and one render path, so direct calls are the honest description.
-->
<script>
	/**
	 * TYPED BECAUSE IT IS BUNDLED. This block moved from is:inline to a bundled
	 * script so the CSP would stop blocking it, and a bundled script is
	 * typechecked. Untyped queries returned Element, so every .dataset, .value,
	 * .hidden and .disabled below was an error and `astro check` reported 22 of
	 * them. Generics on the queries and one guard for the controls fix all of
	 * them at the source. No behaviour changed here: same elements, same calls,
	 * same order.
	 */
	const root = document.querySelector<HTMLElement>('[data-tour]');
	const select = root?.querySelector<HTMLSelectElement>('[data-tour-select]') ?? null;
	const previous = root?.querySelector<HTMLButtonElement>('[data-tour-prev]');
	const next = root?.querySelector<HTMLButtonElement>('[data-tour-next]');
	const progress = root?.querySelector<HTMLElement>('[data-tour-progress]');
	const progressBar = root?.querySelector<HTMLElement>('[data-tour-progress-bar]');

	// The select is genuinely optional: it is the mobile control and is absent
	// above the breakpoint. Everything else is required for the tour to run at
	// all, so one guard here replaces a null check at every use below.
	if (root && previous && next && progress && progressBar) {
		const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tour-tab]'));
		const scenes = Array.from(root.querySelectorAll<HTMLElement>('[data-tour-scene]'));
		const stopIds = scenes.map((scene) => scene.dataset.stopId);
		const stopLabels = scenes.map((scene) => scene.dataset.stopLabel);
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		let current = 0;
		// Structural rather than the ViewTransition lib type: this only ever needs
		// the two members it uses, and the API is still behind a feature check.
		let activeSceneTransition: { skipTransition: () => void; finished: Promise<unknown> } | undefined;

		const renderStop = (requestedIndex: number, moveFocus = false): void => {
			const index = Math.max(0, Math.min(tabs.length - 1, requestedIndex));
			current = index;
			tabs.forEach((tab, tabIndex) => {
				tab.setAttribute('aria-selected', String(tabIndex === index));
				tab.setAttribute('tabindex', tabIndex === index ? '0' : '-1');
			});
			scenes.forEach((scene, sceneIndex) => { scene.hidden = sceneIndex !== index; });
			if (select) select.value = String(index);
			previous.disabled = index === 0;
			next.textContent = index === tabs.length - 1 ? 'Finish the tour' : `Next: ${stopLabels[index + 1]}`;
			progress.textContent = `Stop ${index + 1} of ${tabs.length}: ${stopLabels[index]}`;
			progressBar.style.setProperty('--tour-progress-scale', String((index + 1) / tabs.length));
			history.replaceState(null, '', `#tour-${stopIds[index]}`);
			if (moveFocus) tabs[index].focus();
		};

		// Considered State; not used because every stop follows one stable render
		// path and differs only by data, so separate state objects would add indirection.
		const show = (requestedIndex: number, moveFocus = false): void => {
			const index = Math.max(0, Math.min(tabs.length - 1, requestedIndex));
			if (index === current) {
				if (moveFocus) tabs[index].focus();
				return;
			}

			const startViewTransition = document.startViewTransition?.bind(document);
			if (!startViewTransition) {
				renderStop(index, moveFocus);
				return;
			}

			activeSceneTransition?.skipTransition();
			document.documentElement.dataset.tourDirection = index > current ? 'forward' : 'backward';
			const transition = startViewTransition(() => renderStop(index, moveFocus));
			activeSceneTransition = transition;
			// A quick second tab skips this transition, which rejects `ready`
			// (AbortError). Nothing waits on it, so an unhandled rejection is all
			// it would produce; the scene itself is rendered either way.
			transition.ready.catch(() => {});
			transition.finished
				.catch(() => {})
				.finally(() => {
					if (activeSceneTransition !== transition) return;
					activeSceneTransition = undefined;
					delete document.documentElement.dataset.tourDirection;
				});
		};

		tabs.forEach((tab, index) => {
			tab.addEventListener('click', () => show(index));
			tab.addEventListener('keydown', (event) => {
				if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
				event.preventDefault();
				if (event.key === 'Home') show(0, true);
				else if (event.key === 'End') show(tabs.length - 1, true);
				else show((index + (event.key === 'ArrowDown' ? 1 : -1) + tabs.length) % tabs.length, true);
			});
		});

		select?.addEventListener('change', () => show(Number(select.value)));
		// Previous and Next sit under the stop. On a phone the stop is about
		// 1,500px tall, so swapping it in place left the reader at the end of the
		// new stop (mobile review 2026-10-09). When the top of the tour shell has
		// scrolled off, bring it back and put focus on the new stop, so the reader
		// (and a screen reader) starts the stop at its heading. Stops already in
		// view (desktop) are left alone and focus stays on the button.
		const shell = root.querySelector<HTMLElement>('.tour-shell');
		// The scene renders inside a view transition's callback, so focus waits
		// until the new scene is no longer hidden (a few frames at most).
		const focusWhenShown = (scene: HTMLElement, frames = 30): void => {
			if (!scene.hidden) scene.focus({ preventScroll: true });
			else if (frames > 0) requestAnimationFrame(() => focusWhenShown(scene, frames - 1));
		};
		const go = (index: number): void => {
			const outOfView = !!shell && shell.getBoundingClientRect().top < 0;
			show(index);
			if (!outOfView || !shell) return;
			shell.scrollIntoView({ behavior: reducedMotion.matches ? 'auto' : 'smooth', block: 'start' });
			focusWhenShown(scenes[Math.max(0, Math.min(scenes.length - 1, index))]);
		};
		previous?.addEventListener('click', () => go(current - 1));
		next?.addEventListener('click', () => {
			if (current < tabs.length - 1) go(current + 1);
			else document.querySelector('#tour-close-heading')?.scrollIntoView({ behavior: reducedMotion.matches ? 'auto' : 'smooth', block: 'center' });
		});

		const hashIndex = stopIds.findIndex((id) => location.hash === `#tour-${id}`);
		renderStop(hashIndex >= 0 ? hashIndex : 0);
		if (hashIndex >= 0) {
			const revealDeepLink = () => {
				document.documentElement.classList.add('tour-deep-link-jump');
				root.scrollIntoView({ behavior: 'auto', block: 'start' });
				requestAnimationFrame(() => document.documentElement.classList.remove('tour-deep-link-jump'));
			};
			revealDeepLink();
			window.addEventListener('load', revealDeepLink, { once: true });
		}
	}
</script>

<style>
    .closing-decision { min-width: 0; }
  /* Long labels must wrap when text is enlarged; grid children may shrink. */
  .tour-hero-grid > *, .tour-heading-row > *, .tour-close .container-page > * { min-width: 0; }
  .tour-hero-actions a, .tour-close-actions a { max-width: 100%; white-space: normal; overflow-wrap: anywhere; text-align: center; }
  .tour-ticket-head, .tour-ticket dl div { flex-wrap: wrap; }

	:global(html.tour-deep-link-jump) { scroll-behavior: auto; }
	.product-tour { color: var(--color-ink); }
	.tour-hero { border-block: 1px solid var(--color-hairline); background: var(--color-cream); }
	.tour-hero-grid { display: grid; gap: 3rem; align-items: center; padding-block: clamp(4.5rem, 8vw, 8rem); }
	.tour-hero-copy { max-width: 43rem; }
	.tour-breadcrumb { display: flex; align-items: center; gap: .65rem; color: var(--color-ink-soft); font-size: .875rem; }
	.tour-breadcrumb a { color: var(--color-green-deep); text-decoration: underline; text-decoration-color: var(--color-ticket-rule); text-underline-offset: 4px; }
	.tour-hero h1 { max-width: 14ch; margin-top: 1.5rem; font-family: var(--font-display); font-size: clamp(2.75rem, 6vw, 5.75rem); font-weight: 600; line-height: .98; letter-spacing: -.03em; text-wrap: balance; }
	.tour-hero-copy > p { max-width: 62ch; margin-top: 1.5rem; color: var(--color-ink-soft); font-size: clamp(1.05rem, 1.6vw, 1.25rem); line-height: 1.65; }
	.tour-hero-actions, .tour-close-actions { display: flex; flex-wrap: wrap; gap: 1.5rem; margin-top: 2rem; }
	.tour-ticket { position: relative; width: min(100%, 28rem); justify-self: end; background: var(--color-paper); padding: 1.5rem; box-shadow: var(--shadow-ticket); }
	.tour-ticket::before { position: absolute; inset: .45rem; border: 1px solid var(--color-ticket-rule); content: ''; pointer-events: none; }
	.tour-ticket-head { display: flex; justify-content: space-between; gap: 1rem; border-bottom: 1px solid var(--color-ticket-rule); padding-bottom: .9rem; color: var(--color-amber-deep); font-size: var(--text-micro); font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
	.tour-ticket > strong { display: block; margin-top: 1.35rem; font-family: var(--font-display); font-size: 1.55rem; line-height: 1.15; }
	.tour-ticket dl { margin-top: 1rem; }
	.tour-ticket dl div { display: flex; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--color-hairline); padding-block: .72rem; }
	.tour-ticket dt { color: var(--color-ink-soft); }
	.tour-ticket dd { font-weight: 650; text-align: right; }
	.tour-ticket > p { border-top: 1px solid var(--color-ticket-rule); margin-top: .5rem; padding-top: 1rem; color: var(--color-ink-soft); font-size: .9rem; line-height: 1.5; }

	.tour-workspace { scroll-margin-top: 1rem; padding-block: clamp(4rem, 8vw, 7rem); background: #eef1ed; }
	.tour-heading-row { display: grid; gap: 1.5rem; align-items: end; margin-bottom: 2rem; }
	.tour-heading-row h2, .tour-close h2 { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3.6rem); font-weight: 600; line-height: 1.05; letter-spacing: -.025em; text-wrap: balance; }
	.tour-heading-row > div > p { margin-top: .75rem; color: var(--color-ink-soft); font-size: 1.05rem; }
	.tour-truth { max-width: 48ch; color: var(--color-ink-soft); font-size: .85rem; line-height: 1.55; }
	.tour-mobile-control { display: none; margin-bottom: 1rem; }
	.tour-mobile-control label { display: block; margin-bottom: .4rem; font-size: .8rem; font-weight: 700; }
	.tour-mobile-control select { width: 100%; min-height: 3rem; border: 1px solid #bac7bd; border-radius: .6rem; background: var(--color-paper); padding: .65rem 2.4rem .65rem .8rem; color: var(--color-ink); }
	/* The one frame (homepage rule 6): 8px, one shadow, token colours. The app
	   palette inside the shell imitates the app itself and stays. */
	.tour-shell { overflow: hidden; border: 1px solid var(--color-hairline-strong); border-radius: 8px; background: var(--color-paper); box-shadow: var(--shadow-lift); }
	.tour-rail { display: none; background: #202823; color: #f8faf8; }
	.tour-rail-head { padding: 1.35rem 1.25rem 1.1rem; border-bottom: 1px solid rgba(255,255,255,.11); }
	.tour-rail-head span, .tour-rail-head small { display: block; }
	.tour-rail-head span { font-family: var(--font-display); font-size: 1.15rem; font-weight: 600; }
	.tour-rail-head small { margin-top: .2rem; color: #aebbb2; }
	.tour-rail [role='tablist'] { padding: .65rem; }
	.tour-rail button { display: grid; width: 100%; min-height: 3.15rem; grid-template-columns: 1.6rem 1fr; align-items: center; gap: .55rem; border-radius: .45rem; padding: .55rem .65rem; color: #c9d2cb; text-align: left; transition: background-color 150ms ease-out, color 150ms ease-out; }
	@media (hover: hover) {
		.tour-rail button:hover { background: rgba(255,255,255,.07); color: #fff; }
	}
	.tour-rail button[aria-selected='true'] { background: #e5f1ea; color: #1f3b2d; }
	.tour-rail button span { font-variant-numeric: tabular-nums; font-size: .75rem; letter-spacing: .08em; }
	.tour-rail button strong { font-size: var(--text-eyebrow); line-height: 1.25; }
	.tour-rail .sage-stop-label { display: flex; align-items: center; gap: .45rem; }
	.tour-rail .sage-stop-label svg { flex: 0 0 auto; }
	.tour-stage { min-width: 0; background: #f7f9f7; }
	.app-topbar { display: grid; grid-template-columns: minmax(0, 1fr) minmax(12rem, 22rem) auto; align-items: center; gap: 1rem; min-height: 4.2rem; border-bottom: 1px solid #dce3dd; background: #fff; padding: .75rem 1.2rem; }
	.app-brand { display: flex; min-width: 0; align-items: center; gap: .7rem; }
	.app-brand > span { display: grid; width: 2rem; height: 2rem; place-items: center; border-radius: .5rem; background: var(--color-green); color: #fff; font-size: .75rem; font-weight: 800; }
	.app-brand strong { overflow: hidden; font-size: var(--text-eyebrow); text-overflow: ellipsis; white-space: nowrap; }
	.app-search { overflow: hidden; border: 1px solid #d9e0da; border-radius: .45rem; padding: .55rem .8rem; color: #68736b; font-size: var(--text-eyebrow); white-space: nowrap; }
	.app-user { display: grid; width: 2.25rem; height: 2.25rem; place-items: center; border-radius: 50%; background: #f0e3c9; color: #654112; font-size: .75rem; font-weight: 800; }
	.tour-progress { display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid #dce3dd; background: #fff; padding: .6rem 1.2rem; color: #4d5951; font-size: var(--text-eyebrow); font-weight: 650; }
	.tour-progress > div { height: .25rem; flex: 1; overflow: hidden; border-radius: 999px; background: #e3e8e4; }
	.tour-progress > div span { display: block; width: 100%; height: 100%; border-radius: inherit; background: var(--color-green); transform: scaleX(var(--tour-progress-scale)); transform-origin: left; transition: transform 260ms cubic-bezier(.22,1,.36,1); }
	[data-tour-scene] { padding: clamp(1rem, 2vw, 1.6rem); }
	[data-tour-scene]:not([hidden]) { view-transition-name: tour-scene; }
	:global(::view-transition-group(tour-scene)) { animation-duration: 320ms; animation-timing-function: cubic-bezier(.16,1,.3,1); }
	:global(::view-transition-old(tour-scene)),
	:global(::view-transition-new(tour-scene)) { height: 100%; mix-blend-mode: normal; }
	:global(html[data-tour-direction='forward']::view-transition-old(tour-scene)) { animation: tour-scene-out-forward 180ms ease-in both; }
