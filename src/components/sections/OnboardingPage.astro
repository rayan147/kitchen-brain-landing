---
import { cta } from '../../lib/site';

// Considered Template Method and Strategy for the three parts; not used
// because the parts are one fixed composition with no runtime variation.
// The stage, guard and after-setup tables are data, not a variant
// hierarchy.

/**
 * What the reader should have within reach before pressing Start. Read off
 * `sandbox/demo` on 2026-09-06: stage two opens on "Import an invoice or
 * price sheet" and stage four on "Build with Sage", and both take a photo
 * or a PDF (`ImportDropzone.svelte` accepts jpeg, png, webp, pdf, csv, xlsx,
 * docx). The point of this list is Krug's: the reader should never have to
 * work out what the next screen wants from them.
 */
const haveReady = [
	{
		lead: 'One invoice from the supplier you buy the most from.',
		body: 'A photo of the paper is fine. So is the PDF they emailed you. A price sheet works the same way.'
	},
	{
		lead: 'The recipe for one dish you know well.',
		body: 'The card, a photo of the card, a PDF, a link to it, or the text. It does not need to be tidy.'
	},
	{
		lead: 'Your phone, or the laptop you are reading this on.',
		body: 'Setup works on either. The photo can come straight off the phone.'
	}
] as const;

/**
 * The five stages as scenes. Each is one short paragraph in the reader's
 * second person, the app's own capture beside it, and the app's own last
 * checkmark. Labels are read off `sandbox/demo` on 2026-09-06 and every
 * capture is taken by `scripts/capture-setup-proof.mjs` from an empty
 * kitchen on that branch (RC-48): the reader sees the button, they do not
 * read a list of taps.
 */
const stages = [
	{
		n: '1',
		label: 'Kitchen and suppliers',
		body: 'The first screen wants three things you already know: the kitchen’s name, which it has from sign-up, the supplier you buy the most from, and the share of a selling price food should take. Type the supplier’s name. The invoice you are about to upload fills in the rest of them.',
		done: 'Add one supplier',
		shot: {
			src: '/proof/setup/01-kitchen.png',
			width: 2880,
			height: 1062,
			alt: 'The CostCook setup screen with Sage open beside it. A rail down the left lists five stages: Kitchen and suppliers ticked complete, Ingredients numbered 2 as the stage in progress, Food facts, Recipes and Menu and first order still locked. The header reads “Harbor & Hearth Catering, stage 1 of 5, saves after each stage” and carries an Ask Sage action. The stage is headed “Identify your kitchen”, explains why it exists, then ticks three things off: Name the kitchen, Set the food-cost target, Add one supplier. On the right, a panel headed “Ask your first question” offers “What does the Kitchen and suppliers stage need from me?”, “Why does setup ask for kitchen and suppliers now?”, “What is left to finish setup?”, “What is a target food cost percentage?” and “Do I need a supplier to cost a recipe?”.',
			caption: 'Stage one, with the five stages down the left and Sage open beside it. The stages stay there the whole way, ticking off as you go.'
		}
	},
	{
		n: '2',
		label: 'Ingredients',
		body: 'This is the screen where the old tools wanted your walk-in. This one opens on a choice, and the first card is “Import an invoice or price sheet”. Tap it, tap “Choose files”, and pick the photo of the invoice off your phone. What comes back is the supplier, the packs and the prices, laid out on a screen called “Review extracted records” for you to confirm, not type. A line it could not read is quoted back to you as it appeared. Tap “Back to Ingredients” and your list is there, each ingredient with a usable cost beside it.',
		aside: 'No invoice handy? “Import an ingredient list” takes a spreadsheet or a typed list, and “Add ingredients manually” is the form. It is the fallback, not the plan.',
		done: 'Review the food facts CostCook found',
		shot: {
			src: '/proof/setup/02-choices.png',
			width: 2880,
			height: 1494,
			alt: 'The Ingredients stage, headed “Add the ingredients for Roast chicken plate”, stage 2 of 5, with Kitchen and suppliers ticked in the rail. Under “On this screen”: Add the ingredients for one dish, Review the food facts CostCook found. Then three cards. “Import an invoice or price sheet: Upload or photograph one. Supplier, packs, and prices come back for you to confirm, not type.” “Import an ingredient list: A spreadsheet or a typed list. Sage reads it into one review batch.” “Add ingredients manually: Best when you know one dish and its pack prices by heart.”',
			caption: 'Stage two on an empty kitchen. The first card is the invoice; the form is the third.'
		},
		shot2: {
			src: '/proof/setup/02-dropzone.png',
			width: 2880,
			height: 1304,
			alt: 'The import screen behind that first card, headed “Import and review”. A bar above it reads “Adding ingredients for setup. Review the document here, then return to build your first recipe” with a “Back to Ingredients” button. A card headed “Add sources” holds a dashed box: “Drop files here. PDF, photo, CSV, Excel, or DOCX”, a “Choose files” button and “Paste text instead”. Beside it, “Review import batch: Your import batch will appear here.”',
			caption: 'Behind the first card. “Choose files” opens your camera roll on a phone; the review lands in the panel on the right.'
		}
	},
	{
		n: '3',
		label: 'Food facts',
		body: 'Allergens and diet facts, drafted for each ingredient where CostCook could, and yours to confirm with one tap per chip. Not sure about one? “Skip for now”, and every order that uses it reads “check”, never “clear”.',
		done: 'Answer every ingredient once',
		shot: {
			src: '/proof/setup/03-chips.png',
			width: 1668,
			height: 1216,
			alt: 'One ingredient on the Food facts stage: Chicken thigh, badged “Draft, review needed”, with the line “Drafted from the ingredient name only. Don’t know stays a check until you confirm the package or source.” A Nutrition box shows the match and a Preparation form set to Raw. Under Allergens, ten chips from Crustacean shellfish to Wheat, each reading “don’t know”. Under Diet facts, five chips: Animal product, Meat, poultry or fish, Pork, Shellfish, Alcohol. Two buttons close it: “Confirm Chicken thigh” and “Skip for now”.',
			caption: 'One ingredient’s card. Every chip starts at “don’t know”, and don’t know is never read as clear.'
		}
	},
	{
		n: '4',
		label: 'Recipes',
		body: 'The recipe card goes in the way the invoice did. Tap “Build with Sage”, then “Choose files”, then the photo of the card. Read the draft: the dish, its lines, each one matched to an ingredient from stage two, and where a match is unsure the row asks you. Then the plate cost, with the arithmetic behind it.',
		aside: 'Or “Build the dish by hand”, if you know the amounts by heart.',
		done: 'Check the plate cost',
		shot: {
			src: '/proof/setup/04-choices.png',
			width: 2880,
			height: 1534,
			alt: 'The Recipes stage, headed “Build your first dish”, stage 4 of 5, with the first three stages ticked in the rail. It asks “How do you want to build your first dish?” and offers two cards. “Build with Sage: Add a recipe card, photo, PDF, pasted text, or link. Sage drafts dishes, batch components, ingredients, yields, and links for you to review.” “Build the dish by hand: Best when you know the ingredients and amounts for one dish.”',
			caption: 'Stage four opens on the same shape as stage two. Sage first, the form second.'
		}
	},
	{
		n: '5',
		label: 'Menu and first order',
		body: 'A date and a guest count. The menu is already named after your dish and already holds it. Cost the order, and it becomes a shopping list, a prep list, a pack list, and a food-cost result for the event.',
		done: 'Add guests and a date, then cost the order'
	}
] as const;

/**
 * The page map. Three parts, three questions a reader arrives with, one
 * finish line each. The hero ticket renders it and every row is an in-page
 * anchor, so the first choice on the page is a mindless one.
 */
const parts = [
	{
		n: '1',
		id: 'before',
		label: 'Before you start',
		done: 'Done when one invoice and one recipe are within reach.'
	},
	{
		n: '2',
		id: 'stages',
		label: 'The five stages',
		done: 'Done when one dish has a plate cost you can check on paper.'
	},
	{
		n: '3',
		id: 'after',
		label: 'After setup',
		done: 'Done when the next dish and the first teammate are in.'
	}
] as const;

/**
 * Verified 2026-08-17 against an empty kitchen on `sandbox/demo`
 * (`artifacts/onboarding-rehearsal/260817a/results.md`, case D-NOSUB). The
 * misc line is the 2% default and is labelled as such: it is a business-wide
 * setting, so the total is conditional on nobody having changed it.
 */
const arithmetic = [
	{ left: '$32.00 ÷ 4,535.92 g', right: '$0.0070548 / g', note: 'as purchased' },
	{ left: '÷ 0.80 trim yield', right: '$0.0088185 / g', note: 'usable' },
	{ left: '× 180 g on the plate', right: '$1.59', note: 'ingredient lines' },
	{ left: '+ 2% misc (the default)', right: '$0.03', note: 'its own line' }
] as const;

const guards = [
	'Leave a pack price blank and the ingredient does not go on. The screen says what it needs and puts your cursor in the field.',
	'Ask for 100 ml of something sold by weight and it stops, and it names the fix: pick a weight unit, or give the ingredient a density.',
	'Press “Start over” by mistake and your ingredients, recipes, menus and orders stay. Only the guide’s progress resets.',
	'Lose the wifi mid-save and nothing is written and nothing is claimed. What you typed is still on screen, and the same button retries.'
] as const;

/**
 * Part 3. Every line read off `sandbox/demo` on 2026-09-06.
 * 3a: `src/lib/components/setup/SetupCompletionSummary.svelte`.
 * 3b: the import queue (RC-38, RC-39), Sage's recipe door (RC-58), later
 *     prices (RC-08). Nothing about how accurate a read is (RC-55).
 * 3c: `src/routes/settings/team/+page.svelte` and `+page.server.ts`
 *     (`INVITED_ROLE = 'STAFF'`), RC-52. No role behaviour beyond that row.
 */
const completion = {
	heading: 'Your kitchen is ready',
	items: ['Costing settings', 'Business profile', '1 supplier', 'Your ingredients', 'Dish: the one you named', 'Menu', 'Order for your guests'],
	next: 'Next: check what you need to buy',
	actions: ['Open shopping list', 'Go to Today']
} as const;

const menuTrack = [
	{
		lead: 'The same way the first dish came in.',
		body: 'Upload, then confirm. One queue takes a photo, a PDF, a spreadsheet, a Word document or pasted text, and comes back as staged facts for you to confirm. What it could not read is quoted back as it appeared, never guessed.'
	},
	{
		lead: 'A recipe card goes to Sage.',
		body: 'Hand it a card, a photo, a PDF, text or a link and read the draft it makes. The dish is yours before it is costed.'
	},
	{
		lead: 'Prices keep moving. Orders do not.',
		body: 'Every purchase you log updates the catalog and any draft costs, without rewriting confirmed orders. The plate cost you checked tonight is still checkable next month.'
	}
] as const;

const crewTrack = [
	{
		lead: 'Settings, then Team.',
		body: 'Type an email address. They receive a one-time link to join this kitchen. No password is needed.'
	},
	{
		lead: 'They join as Staff.',
		body: 'Staff works from the shared kitchen record. Manager adds setup, teammate administration and the Sage checks that show price movement. Owner adds billing and the recipe lifecycle.'
	},
	{
		lead: 'Know the boundary before you send.',
		body: 'Staff can open cost screens, and there is no custom role. If that is a problem for your kitchen, read the full boundary first.'
	}
] as const;
---

<!-- story: docs/stories/onboarding.story.md -->
<article class="first-dish">
	<section class="fd-hero" aria-labelledby="fd-heading">
		<div class="container-page fd-hero-layout">
			<div class="fd-hero-copy">
				<nav aria-label="Breadcrumb" class="feature-breadcrumb">
					<a href="/">Home</a><span aria-hidden="true">/</span><span>Your initial setup</span>
				</nav>
				<p class="eyebrow">Your initial setup</p>
				<h1 id="fd-heading" class="feature-display">You do not need to enter your whole walk-in.</h1>
				<p class="fd-lede">
					Setup asks for one dish you already cook and takes about fifteen minutes. You do not
					type its ingredients in: you upload one invoice and one recipe, as a photo or a PDF,
					and confirm what CostCook read. Four stages in, it prints that dish&rsquo;s plate cost
					with the arithmetic beside it. This page walks every screen, then says what comes
					after, and how the rest of your kitchen gets in.
				</p>
				<div class="fd-actions">
					<a href={cta.href} target={cta.target} rel={cta.rel} aria-label={cta.ariaLabel} class="btn-primary">{cta.label}</a>
					<a href="#the-number" class="btn-quiet">See the number it ends on</a>
				</div>
			</div>

			<figure class="fd-ticket anim-enter" aria-labelledby="fd-ticket-title">
				<div class="fd-ticket-head">
					<p id="fd-ticket-title">This page</p>
					<span>3 parts &middot; 5 stages &middot; 1 dish</span>
				</div>
				<ol class="fd-ticket-stages fd-map" role="list">
					{parts.map((part) => (
						<li>
							<a href={`#${part.id}`} class="fd-map-link">
								<span class="fd-ticket-n fd-map-n">{part.n}</span>
								<span class="fd-map-text">
									<span class="fd-map-label">{part.label}</span>
									<span class="fd-map-done">{part.done}</span>
								</span>
							</a>
						</li>
					))}
				</ol>
				<figcaption>Pick the question you came with. Each part ends with one next step.</figcaption>
			</figure>
		</div>
	</section>

	<section class="fd-band fd-part" id="before" aria-labelledby="fd-before-heading">
		<div class="container-page" data-reveal>
			<div class="fd-prose">
				<p class="eyebrow fd-part-label">Part 1 of 3 &middot; Before you start</p>
				<h2 id="fd-before-heading">Have two pieces of paper within reach. That is the preparation.</h2>
				<p>
					You have done this before. The last tool wanted your whole catalog typed in before it
					would do anything, and the half-filled spreadsheet is still on the desktop.
				</p>
				<p>
					CostCook wants what is already written down: one invoice, one recipe. Everything
					setup needs about your first dish is on those two, and you confirm what it read
					instead of typing it.
				</p>
			</div>
			<ul class="fd-doors-list fd-have" role="list" aria-label="What to have ready">
				{haveReady.map((item) => (
					<li>
						<p class="fd-track-lead">{item.lead}</p>
						<p class="fd-track-body">{item.body}</p>
					</li>
				))}
			</ul>
			<div class="fd-prose">
				<p>
					Sign-up asks for your kitchen&rsquo;s name and nothing else. Then a welcome asks
					what kind of kitchen you run and the name of one dish you know well. Name it, and
					every screen after says its name back to you.
				</p>
				<p class="fd-handoff">Those answers take a minute. These five stages are the work.</p>
			</div>
		</div>
	</section>

	<section class="fd-band fd-part" id="stages" aria-labelledby="fd-stages-heading">
		<div class="container-page" data-reveal>
			<div class="fd-prose">
				<p class="eyebrow fd-part-label">Part 2 of 3 &middot; The five stages</p>
				<h2 id="fd-stages-heading">Five stages is one dish&rsquo;s worth of facts, and two of them are uploads.</h2>
				<p>
					Each stage asks for the next thing that one dish needs, and nothing else. Here is
					each one as you will meet it.
				</p>
			</div>
			<ol class="fd-stage-list" role="list">
				{stages.map((stage) => (
					<li class="fd-stage fd-scene">
						<p class="fd-stage-head">
							<span class="fd-stage-n" aria-hidden="true">{stage.n}</span>
							<span class="fd-stage-label">{stage.label}</span>
						</p>
						<div class="fd-stage-copy">
							<p class="fd-stage-body">{stage.body}</p>
							{'aside' in stage && <p class="fd-stage-aside">{stage.aside}</p>}
							<p class="fd-stage-done"><span class="fd-stage-done-k">Done when</span> {stage.done}.</p>
						</div>
						{'shot' in stage && (
							<figure class="fd-shot fd-scene-shot">
								<img src={stage.shot.src} width={stage.shot.width} height={stage.shot.height} loading="lazy" decoding="async" alt={stage.shot.alt} />
								<figcaption>{stage.shot.caption}</figcaption>
							</figure>
						)}
						{'shot2' in stage && (
							<figure class="fd-shot fd-scene-shot">
								<img src={stage.shot2.src} width={stage.shot2.width} height={stage.shot2.height} loading="lazy" decoding="async" alt={stage.shot2.alt} />
								<figcaption>{stage.shot2.caption}</figcaption>
							</figure>
						)}
					</li>
				))}
			</ol>

			<p class="fd-doors-gate">
				Nothing that comes in through an upload is written to your kitchen until you confirm it,
				line by line, and what CostCook could not read is quoted back to you rather than guessed
				at. Reading a screen of lines is still work. It is a different kind of work from a hundred
				packs and a form at nine at night.
			</p>

			<p class="fd-sage">
				Sage stays open beside whichever stage you are on. Its questions are the ones that
				stage raises, and it answers from the records you have entered so far. It reads them;
				it never fills a stage in for you.
			</p>

			<p class="fd-handoff">Stage four ends on a number.</p>
		</div>
	</section>

	<section class="fd-band fd-band-cream" id="the-number" aria-labelledby="fd-number-heading">
		<div class="container-page fd-number-layout" data-reveal>
			<div class="fd-prose">
				<p class="eyebrow">The number</p>
				<h2 id="fd-number-heading">One line of one dish, costed from the case price you actually pay.</h2>
				<p>
					180 g of chicken thigh, bought at $32.00 for a 10 lb case, 80% of it surviving the trim.
				</p>
				<p class="fd-snap">
					A $32 case of thighs, 80% of it surviving the knife, 180 g on the plate: $1.62. Check it
					on paper. We would rather you did.
				</p>
			</div>

			<figure class="fd-maths" aria-labelledby="fd-maths-title">
				<p id="fd-maths-title" class="fd-maths-title">Plate cost, as the screen prints it</p>
				<div
					class="fd-maths-scroll"
					tabindex="0"
					role="group"
					aria-label="Plate cost arithmetic, scrollable"
				>
					<table>
						<caption class="sr-only">
							How a $32.00 ten-pound case of chicken thigh becomes a $1.62 plate cost.
						</caption>
						<thead>
							<tr>
								<th scope="col">Step</th>
								<th scope="col">Result</th>
								<th scope="col">Reading</th>
							</tr>
						</thead>
						<tbody>
							{arithmetic.map((row) => (
								<tr>
									<th scope="row">{row.left}</th>
									<td class="fd-maths-value">{row.right}</td>
									<td class="fd-maths-note">{row.note}</td>
								</tr>
							))}
							<tr class="fd-maths-total">
								<th scope="row">Plate cost</th>
								<td class="fd-maths-value">$1.62</td>
								<td class="fd-maths-note">per portion</td>
							</tr>
						</tbody>
					</table>
				</div>
				<figcaption>
					Misc is a business-wide percentage, 2% until you change it, and it stays on its own line.
				</figcaption>
			</figure>
		</div>
	</section>

	<section class="fd-band" aria-labelledby="fd-guards-heading">
		<div class="container-page" data-reveal>
			<div class="fd-prose">
				<p class="eyebrow">What it refuses to do</p>
				<h2 id="fd-guards-heading">A number you can check is only half of it.</h2>
				<p>The other half is what happens when you get something wrong.</p>
			</div>
			<ul class="fd-guards" role="list">
				{guards.map((guard) => <li>{guard}</li>)}
			</ul>
			<p class="fd-handoff">Which leaves the question the old page never answered: what happens after stage five.</p>
		</div>
	</section>

	<section class="fd-band fd-band-cream fd-part" id="after" aria-labelledby="fd-after-heading">
		<div class="container-page" data-reveal>
			<div class="fd-prose">
				<p class="eyebrow fd-part-label">Part 3 of 3 &middot; After setup</p>
				<h2 id="fd-after-heading">Stage five ends on a screen that says your kitchen is ready. Here is what it offers next.</h2>
			</div>
			<figure class="fd-completion" aria-labelledby="fd-completion-title">
				<div class="fd-ticket-head">
					<p id="fd-completion-title">{completion.heading}</p>
					<span>Setup &middot; complete</span>
				</div>
				<ul class="fd-completion-items" role="list">
					{completion.items.map((item) => <li>{item}</li>)}
				</ul>
				<p class="fd-completion-next">{completion.next}</p>
				<p class="fd-completion-actions">
					{completion.actions.map((label) => <span class="fd-completion-action">{label}</span>)}
				</p>
				<figcaption>
					The completion screen as the app prints it. If you named a goal at the welcome, the first
					line answers it in your words: what the event really costs, what to buy for a date, or whether
					a price change hurt you.
				</figcaption>
			</figure>
			<p class="fd-handoff">The first dish was the hard one. The rest come in the same way: upload, then confirm.</p>
		</div>
	</section>

	<section class="fd-band fd-part" id="after-menu" aria-labelledby="fd-menu-heading">
		<div class="container-page" data-reveal>
			<div class="fd-prose">
				<p class="eyebrow">The rest of your menu</p>
				<h2 id="fd-menu-heading">The next forty dishes are not forty evenings.</h2>
			</div>
			<ul class="fd-doors-list fd-after-track" role="list" aria-labelledby="fd-menu-heading">
				{menuTrack.map((row) => (
					<li>
						<p class="fd-track-lead">{row.lead}</p>
						<p class="fd-track-body">{row.body}</p>
					</li>
				))}
			</ul>
			<p class="fd-handoff">A catalog nobody else opens is a spreadsheet with a login. This is how the crew gets one.</p>
		</div>
	</section>

	<section class="fd-band fd-band-cream fd-part" id="after-crew" aria-labelledby="fd-crew-heading">
		<div class="container-page" data-reveal>
			<div class="fd-prose">
				<p class="eyebrow">The rest of your crew</p>
				<h2 id="fd-crew-heading">Two emails, two links, no passwords.</h2>
				<p>
					Invite after the first order exists, so they arrive to a shopping list and a prep list,
					not an empty kitchen. Whoever works this week first; the rest can follow.
				</p>
			</div>
			<ul class="fd-doors-list fd-after-track" role="list" aria-labelledby="fd-crew-heading">
				{crewTrack.map((row) => (
					<li>
						<p class="fd-track-lead">{row.lead}</p>
						<p class="fd-track-body">{row.body}</p>
					</li>
				))}
			</ul>
			<p class="fd-doors-gate">
				Invited teammates join as Staff today. The full Owner, Manager and Staff boundary, and what
				each can and cannot open, is on the <a href="/features/team-and-access">Team and Access guide</a>.
			</p>
		</div>
	</section>

	<section class="fd-band fd-close" aria-labelledby="fd-close-heading">
		<div class="container-page" data-reveal>
			<div class="fd-prose">
				<p class="eyebrow">Where this leaves you</p>
				<h2 id="fd-close-heading">One dish with a price on it, and a list your crew can open without you.</h2>
				<p>
					The shopping list is where the <a href="/tour/main">product tour</a> picks up. The alternative
					is another season where the number in your head and the number on the invoice are two
					different numbers, and the crew works from a text message.
				</p>
				<p class="fd-final">One dish, and you will know. Then they will too.</p>
				<div class="fd-actions">
					<a href={cta.href} target={cta.target} rel={cta.rel} aria-label={cta.ariaLabel} class="btn-primary">{cta.label}</a>
				</div>
			</div>
		</div>
	</section>
</article>

<style>
	.fd-hero {
		padding-block: clamp(2.5rem, 6vw, 4.5rem);
	}

	.fd-hero-layout {
		display: grid;
		gap: clamp(2rem, 5vw, 3.5rem);
		align-items: start;
