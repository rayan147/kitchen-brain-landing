				<ol class="fd-stage-list" role="list">
					{part.scenes.map((scene) => (
						<li class="fd-after-scene fd-scene">
							<p class="fd-stage-head"><span class="fd-stage-label">{scene.label}</span></p>
							<div class="fd-stage-copy">
								<p class="fd-stage-body">{scene.body}</p>
							</div>
							<figure class={`fd-shot fd-scene-shot${scene.shot.phone ? '' : ' fd-phone-only'}`} style={scene.shot.phone ? undefined : shotStyle(scene.shot)}>
								<div class="shot-pan" tabindex="0" role="region" aria-label={`${scene.label}, screenshot`}>
									<picture>
										{scene.shot.phone && <source media="(min-width: 64rem)" srcset={scene.shot.src} width={scene.shot.width} height={scene.shot.height} />}
										<img src={(scene.shot.phone ?? scene.shot).src} width={(scene.shot.phone ?? scene.shot).width} height={(scene.shot.phone ?? scene.shot).height} style={shotStyle(scene.shot)} loading="lazy" decoding="async" alt={scene.shot.alt} />
									</picture>
								</div>
								<figcaption>{scene.shot.caption} <a class="fd-full" href={scene.shot.src} target="_blank" rel="noopener noreferrer">Open full-size (new tab)</a></figcaption>
							</figure>
						</li>
					))}
				</ol>
				{part.id === 'after-crew' && (
					<p class="fd-gate">
						A teammate joins as Staff or Manager, and you can change the role later. Staff never see
						costs, billing stays with you, and what each role can open is on the <a href="/features/team-and-access">Team and Access guide</a>.
					</p>
				)}
				{part.handoff && <p class="fd-handoff">{part.handoff}</p>}
			</div>
		</section>
	))}

	<section class="fd-band fd-close" aria-labelledby="fd-close-heading">
		<div class="container-page" data-reveal>
			<div class="fd-prose">
				<p class="eyebrow">Where this leaves you</p>
				<h2 id="fd-close-heading">Check one dish’s cost. Then add your next recipe and invite the crew.</h2>
				<p>
					The alternative is another season where the number in your head and the number on the
					invoice are two different numbers, and the crew works from a text message.
				</p>
				<p class="fd-final">One dish, and you will know. Then they will too.</p>
				<div class="fd-actions">
					<a href={cta.href} target={cta.target} rel={cta.rel} aria-label={cta.ariaLabel} class="btn-primary">{cta.label}</a>
				</div>
			</div>
		</div>
	</section>
</article>

