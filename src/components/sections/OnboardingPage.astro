					</picture>
				</div>
				<figcaption>{readyShot.caption}</figcaption>
			</figure>
			<p class="fd-handoff">The first dish was the hard one. The rest come in the same way: upload, then confirm.</p>
		</div>
	</section>

	{afterScenes.map((part) => (
		<section class={`fd-band fd-part${part.id === 'after-crew' ? ' fd-band-cream' : ''}`} id={part.id} aria-labelledby={`fd-${part.id}-heading`}>
			<div class="container-page" data-reveal>
				<div class="fd-prose">
					<p class="eyebrow">{part.eyebrow}</p>
