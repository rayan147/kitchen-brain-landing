---
import FeatureTrialTerms from '../FeatureTrialTerms.astro';
import { cta } from '../../lib/site';

// Considered Template Method and Strategy for the three parts; not used
// because the parts are one fixed composition with no runtime variation.
// The stage, guard and after-setup tables are data, not a variant
// hierarchy.

/**
 * What the reader should have within reach before pressing Start. Read off
 * local kitchen-brain develop c90d3b9c2 on 2026-10-10: stage two opens on
 * "Import an invoice or price sheet" and stage four on "Build with Sage",
 * and both take a photo or a file ("Take photo", "Choose files"). The point of this list is Krug's: the reader should never have to
 * work out what the next screen wants from them.
 */
const haveReady = [
	{
		lead: 'One invoice from the supplier you buy the most from.',
		body: 'A photo of the paper is fine. So is the PDF they emailed you. A price sheet works the same way.'
	},
	{
		lead: 'The recipe for one dish you know well.',
		body: 'The card, a photo of the card, a PDF, a link to it, or the text. It does not need to be tidy.'
	},
	{
		lead: 'Your phone, or the laptop you are reading this on.',
		body: 'Setup works on either. The photo can come straight off the phone.'
	}
] as const;

/**
 * The five stages as scenes. Each is one short paragraph in the reader's
 * second person, the app's own capture beside it, and the app's own last
 * checkmark. Labels are read off local kitchen-brain develop c90d3b9c2 on
 * 2026-10-10, and every capture is taken by `scripts/capture-setup-proof.mjs`
 * from an empty kitchen on that build (RC-48): the reader sees the button,
 * they do not read a list of taps.
 *
 * Each capture is shot twice in one walk: at 1440 (`src`, served from 64rem)
 * and at 390 (`phone`, the img every narrower screen gets), so a phone reads
 * the app's own phone layout at its own size instead of panning across a
 * shrunk desktop capture (mobile review 2026-10-09). One alt serves both, so
 * it names only what both show, or says which width shows the rest.
 */
type Capture = { src: string; width: number; height: number };
type Shot = Capture & { phone?: Capture; alt: string; caption: string };

const stages: readonly {
	n: string;
	label: string;
	body: string;
	done: string;
	shots: readonly Shot[];
}[] = [
	{
		n: '1',
		label: 'Kitchen and suppliers',
		body: 'Name the supplier you buy the most from, pick pounds or kilos, check the food-cost target, and tap “Save and continue”; the invoice adds the rest of the supplier’s details.',
		done: 'Add one supplier',
		shots: [{
			src: '/proof/setup/01-kitchen.png',
			width: 2880,
			height: 868,
			phone: { src: '/proof/setup/01-kitchen-mobile.png', width: 780, height: 1180 },
			alt: 'Stage one of setup for Harbor & Hearth Catering, headed “Identify your kitchen”: your name for purchase orders, the units your invoices use, one supplier, and a food-cost target. “Why this stage” says prices belong to a supplier and every plate cost is judged against one target. Three items under “On this screen”, all ticked: Name the kitchen, Choose units and check the food-cost target, Add one supplier. On a computer the header reads “Set up your kitchen, Harbor & Hearth Catering, stage 1 of 5, your saves are kept” beside Ask Sage, Support and Exit setup; the five stages run down the left from Kitchen and suppliers, ticked, to Menu and first order; and Sage is open on the right with questions for the next stage. On a phone a bar reads “Step 1 of 5, Kitchen and suppliers”.',
			caption: 'Stage one. The five stages tick off as you go, down the left on a computer and along the top on a phone.'
		}]
	},
	{
		n: '2',
		label: 'Ingredients',
		body: 'Tap “Import an invoice or price sheet”, then “Take photo” or “Choose files”, and confirm the supplier, packs and prices on “Review extracted records” instead of typing them.',
		done: 'Confirm the ingredients, pack sizes and prices',
		shots: [{
			src: '/proof/setup/02-choices.png',
			width: 2264,
			height: 1260,
			phone: { src: '/proof/setup/02-choices-mobile.png', width: 780, height: 1592 },
			alt: 'The Ingredients stage, headed “Add the ingredients for Roast chicken plate. Start with Roast chicken plate: add what you have prices for now.” Under “On this screen”: Add at least one ingredient for the dish, Review the food facts CostCook found. Then three cards. “Import an invoice or price sheet: Upload or photograph one. Supplier, packs, and prices come back for you to confirm; anything it cannot read, you type.” “Import an ingredient list: A spreadsheet or a typed list. Sage, CostCook’s assistant, reads it into one list for you to check.” “Add ingredients manually: Best when you know one dish and its pack prices by heart.”',
			caption: 'Stage two on an empty kitchen. The first card is the invoice; the form is the third.'
		}, {
			src: '/proof/setup/02-dropzone.png',
			width: 2264,
			height: 1616,
			phone: { src: '/proof/setup/02-dropzone-mobile.png', width: 780, height: 1666 },
			alt: 'The import screen behind that first card. A bar reads “Adding ingredients for setup. Review the document here, then return to build your first recipe” with a “Back to Ingredients” button. Under “Import and review”, a card headed “Add documents” asks “What are you bringing in?” with Recipe, Price sheet, Ingredient list and Invoice, and Invoice picked: “What you paid for a delivery. It updates your costs.” A dashed box holds a “Take photo” button and a “Choose files” button, and under it: “Use the invoice PDF or a photo of it. Every detected record stays in review until you approve it.”',
			caption: 'Behind the first card. “Take photo” opens the camera on a phone, and nothing goes in until you approve it.'
		}]
	},
	{
		n: '3',
		label: 'Food facts',
		body: 'Sage drafts what it can tell from each ingredient’s name and leaves the rest to you; answer the rest, or tap “Skip for now” and any order using that ingredient reads “check”, never “clear”.',
		done: 'Review each ingredient or leave it marked for checking',
		shots: [{
			src: '/proof/setup/03-chips.png',
			width: 1652,
			height: 1700,
			phone: { src: '/proof/setup/03-chips-mobile.png', width: 664, height: 2520 },
			alt: 'One ingredient on the Food facts stage: Chicken thigh, badged “Draft: review needed”. Under it: “Sage drafted Animal product: Yes, Meat, poultry or fish: Yes, Pork: No, Shellfish: No, Alcohol: No. Nothing is recorded until you take it or answer yourself”, and a button, “Use Sage’s answers for Chicken thigh”. A Nutrition box reads “Sage nutrition estimate: review needed. Estimated from ingredient name, per 100 g edible portion”, with “Change nutrition match” and a Preparation form set to Raw. Under Allergens, nine chips from Crustacean shellfish to Wheat, none answered, and a “Free from the rest” button. Under Diet facts, the same five questions, still open until you take Sage’s answers. Two buttons close it: “Save Chicken thigh” and “Skip for now”.',
			caption: 'One ingredient’s card. Sage drafted the diet facts from the name, and the allergens wait for you: a name can tell Sage that butter has milk, not that chicken has none.'
		}]
	},
	{
		n: '4',
		label: 'Recipes',
		body: 'Tap “Build with Sage”, then “Take photo” or “Choose files” for the recipe card, and go through Sage’s draft, ingredients and amounts first, then the food cost per portion.',
		done: 'Check the plate cost',
		shots: [{
			src: '/proof/setup/04-choices.png',
			width: 2264,
			height: 1028,
			phone: { src: '/proof/setup/04-choices-mobile.png', width: 780, height: 1218 },
			alt: 'The Recipes stage, headed “Build your first dish. A recipe turns current pack prices and yields into a real cost per portion.” Under “On this screen”: Name the dish, Add its ingredients and amounts, Check the plate cost. Two cards. “Build with Sage: Add a recipe card, photo, PDF, pasted text, or link. Sage drafts dishes, sub-recipes, ingredients, yields, and links for you to review.” “Build the dish by hand: Best when you know the ingredients and amounts for one dish.”',
			caption: 'Stage four opens on the same shape as stage two. Sage first, the form second.'
		}]
	},
	{
		n: '5',
		label: 'Menu and first order',
		body: 'Fill in “Guests” and the “Event date”, say whether anyone has an allergy, and tap “Create first order”; the menu is already named after your dish.',
		done: 'Add guests and a date, then cost the order',
		shots: [{
			src: '/proof/setup/05-first-order.png',
			width: 2264,
			height: 1284,
			phone: { src: '/proof/setup/05-first-order-mobile.png', width: 748, height: 1612 },
			alt: 'The order card on stage five, headed “Order details: Set the event information and choose what will be served. This is event 1.” Under Event information: a “Client or event” field, an “Event date” field reading “Choose a date”, and “Guests” filled in with 80. Under Menu: “One portion per guest. Rename it here, or on the menu later.” The Menu name reads “Roast chicken plate menu”, and under “Dish on the menu” a ticked row reads “Roast chicken plate, $1.62 per portion”. On a computer a Live quote card sits beside it: Revenue not set, Food cost $129.39, Food cost per guest $1.62, Selling price not set, Charge at least $5.40 per guest, Estimated whole packs to buy $128.00.',
			caption: 'Stage five. Your dish’s cost is there before you type a thing: $1.62 a guest, the $1.59 portion plus your 2% miscellaneous cost. All that’s left is the date, the guest count and the allergy question.'
		}]
	}
];

/**
 * The page map. Three parts, three questions a reader arrives with, one
 * finish line each. The hero ticket renders it and every row is an in-page
 * anchor, so the first choice on the page is a mindless one.
 */
const parts = [
	{
		n: '1',
		id: 'before',
		label: 'Before you start',
		done: 'Done when one invoice and one recipe are within reach.'
	},
	{
		n: '2',
		id: 'stages',
		label: 'The five stages',
		done: 'Done when one dish has a plate cost you can check on paper.'
	},
	{
		n: '3',
		id: 'after',
		label: 'After setup',
		done: 'Done when the next dish and the first teammate are in.'
	}
] as const;

/**
 * Verified 2026-08-17 against an empty kitchen on `sandbox/demo`
 * (`artifacts/onboarding-rehearsal/260817a/results.md`, case D-NOSUB). The
 * misc line is the 2% default and is labelled as such: it is a business-wide
 * setting, so the total is conditional on nobody having changed it.
 */
const arithmetic = [
	{ left: '$32.00 ÷ 4,535.92 g', right: '$0.0070548 / g', note: 'as purchased' },
	{ left: '÷ 0.80 trim yield', right: '$0.0088185 / g', note: 'usable' },
	{ left: '× 6.3 oz (180 g) on the plate', right: '$1.59', note: 'ingredient lines' },
	{ left: '+ 2% misc (the default)', right: '$0.03', note: 'its own line' }
] as const;

const guards = [
	'Leave a pack price blank and the ingredient does not go on. The screen says what it needs and puts your cursor in the field.',
	'Ask for 2 cups of something sold by weight and it stops, and it names the fix: pick a weight unit, or give the ingredient a density.',
	'Press “Start over” by mistake and your ingredients, recipes, menus and orders stay. Only the guide’s progress resets.',
	'Lose the wifi mid-save and nothing is written and nothing is claimed. What you typed is still on screen, and the same button retries.'
] as const;

/**
 * Part 3 as scenes. Every line and every capture read off local
 * kitchen-brain develop c90d3b9c2 on 2026-10-10, after the first order was
 * created: the summary behind "See what setup built", the Purchases page
 * with "Import invoice" (in its More menu on a phone; RC-38, RC-39, RC-08),
 * the import box outside setup, and Settings > Team & access, where an
 * invite now picks Staff or Manager (RC-52). One sentence each; the screen
 * carries the rest.
 */
const afterScenes: readonly {
	id: string;
	eyebrow: string;
	heading: string;
	scenes: readonly { label: string; body: string; shot: Shot }[];
	handoff: string | null;
}[] = [
	{
		id: 'after-menu',
		eyebrow: 'The rest of your menu',
		heading: 'The next invoice and the next dish go into the same box.',
		scenes: [
			{
				label: 'The next invoice',
				body: 'Open Purchases, tap “Import invoice” (under “More” on a phone) and confirm the lines; the purchase is logged and your ingredient costs and draft orders update, without rewriting confirmed orders.',
				shot: {
					// One phone capture at every width: the desktop header is a
					// 1,200px strip that no column can show at a readable size.
					src: '/proof/setup/07-records-mobile.png',
					width: 780,
					height: 1440,
					alt: 'The Purchases page on a phone, headed “Purchases, October 2026, 0 purchases. Receipts, food cost and price changes, month by month.” Its More menu is open over the Food cost card: “Import invoice” first, then Log one item, Log waste, Stock turnover, Shelf check, Sent purchase orders, Receiving follow-up, Supplier invoices and Invoice inbox. At the bottom, a “Log purchase” button and the “More” button.',
					caption: 'Purchases on a phone, with More open. On a computer “Import invoice” sits beside “Log purchase”.'
				}
			},
			{
				label: 'The next dish',
				body: 'A recipe card goes into the same box as a photo, a PDF, a spreadsheet, a Word document or pasted text, and comes back as a draft for you to confirm, with anything it could not read quoted back as it appeared.',
				shot: {
					src: '/proof/setup/08-import.png',
					width: 768,
					height: 1510,
					phone: { src: '/proof/setup/08-import-mobile.png', width: 780, height: 2010 },
					alt: 'The “Add documents” card on the import screen outside setup: “Photos, files and pasted text all go into one list.” What are you bringing in: Recipe picked, then Price sheet, Ingredient list and Invoice. “A dish or batch with its ingredients and amounts.” A dashed box, “Drop files here. PDF, photo, CSV, Excel, or DOCX”, holds “Take photo”, “Choose files”, “Paste text instead” and “Paste a link”. Under it, a spreadsheet can be added the same way, with links to map recipe or supplier columns by hand. On a phone the page heading “Import and review” sits above the card and an empty “Read and review” panel below it.',
					caption: 'The same box, outside setup, with Recipe picked. One list for invoices, price sheets, ingredient lists and recipe cards.'
				}
			}
		],
		handoff: 'Once your first order is ready, invite the crew to work from its lists.'
	},
	{
		id: 'after-crew',
		eyebrow: 'The rest of your crew',
		heading: 'The crew joins from a link, and works from the list you built.',
		scenes: [
			{
				label: 'Invite a teammate',
				body: 'Open Settings, then Team & access, add their email under “Invite people”, pick Staff or Manager, and tap “Send 1 invitation”; they get a one-time sign-in link by email, with no password to remember.',
				shot: {
					src: '/proof/setup/09-team.png',
					width: 1524,
					height: 850,
					phone: { src: '/proof/setup/09-team-mobile.png', width: 748, height: 1298 },
					alt: 'The “Invite people” card on Settings, Team & access. “They get a one-time sign-in link by email. No password to remember.” The Email addresses box holds maria@harborhearth.example, with room to add another or paste a list of up to 20. Under “They join as”, Staff is picked: “Works from orders, prep lists, deliveries and recipes. Can’t change prices, settings or billing.” Beside it, Manager, marked New: “Everything Staff can do, plus costs, vendors and purchase orders. No billing.” Then “Links work for 7 days. You can change someone’s role later.” and a “Send 1 invitation” button.',
					caption: 'Settings, then Team & access. Type their email and pick a role before you send.'
				}
			}
		],
		handoff: null
	}
];

const welcomeShot: Shot = {
	src: '/proof/setup/00-welcome.png',
	width: 1462,
	height: 1812,
	phone: { src: '/proof/setup/00-welcome-mobile.png', width: 748, height: 2398 },
	alt: 'The welcome screen, marked Step 3 of 3 and headed “Welcome to Harbor & Hearth Catering.” It says you cost one dish you already cook, then one event that serves it: what to buy, what to prep, what to pack, and what the food really costs, and that each stage saves when you continue. It lists the five stages, then “Three questions so the rest fits your kitchen. All three are optional.” What kind of kitchen do you run: Catering picked, Meal prep, Restaurant with events, Something else. One dish you know well: Roast chicken plate. What do you most want to know: What an event really costs picked, What to buy for a date, Whether a price change hurt me, Not sure yet. Two buttons: “Start setup” and “Skip these questions”.',
	caption: 'The first screen after sign-up asks three optional questions, one of them a dish you know well.'
};

const readyShot: Shot = {
	src: '/proof/setup/06-ready.png',
	width: 1376,
	height: 1116,
	phone: { src: '/proof/setup/06-ready-mobile.png', width: 748, height: 1458 },
	alt: 'The setup summary, headed “Your kitchen is ready”. It reads “You said you most wanted to know what an event really costs. For the order for Roast chicken plate, the food comes to $129.39.” A box: Order for Roast chicken plate, 80 guests, Food cost $129.39. Five ticks: 1 supplier, 1 ingredient, Dish: Roast chicken plate, Menu: Roast chicken plate menu, Order for 80 guests. Then “Next: your shopping list. What to buy for this order, sorted by supplier, in whole packs. The order stays a draft, with prices updating, until you confirm it on the order page.” Two buttons: “Open shopping list” and “Go to Today”.',
	caption: 'The summary behind “See what setup built”. If you named a goal at the welcome, the first line answers it in your words.'
};

/** The phone capture below 64rem, the desktop one from 64rem (scoped CSS). */
const shotStyle = (shot: Shot) =>
	`--phone-w: ${(shot.phone ?? shot).width / 2}px; --desk-w: ${shot.width / 2}px`;

---

<!-- story: docs/stories/onboarding.story.md -->
<article class="first-dish">
	<section class="fd-hero" aria-labelledby="fd-heading">
		<div class="container-page fd-hero-layout">
			<div class="fd-hero-copy">
				<nav aria-label="Breadcrumb" class="feature-breadcrumb">
					<a href="/">Home</a><span aria-hidden="true">/</span><span>Your initial setup</span>
				</nav>

				<h1 id="fd-heading" class="feature-display">Start by costing one dish.</h1>
				<p class="fd-lede">Start with one recipe and current supplier prices. Allow about fifteen minutes for a first dish; checking missing details can take longer. Follow five stages to its food cost and your first order.</p>
				<div class="fd-actions">
					<a href={cta.href} target={cta.target} rel={cta.rel} aria-label={cta.ariaLabel} class="btn-primary">{cta.label}</a>
					<a href="#the-number" class="btn-quiet">See the example food cost</a>
				</div>
				<FeatureTrialTerms />
			</div>

			<figure class="fd-ticket anim-enter" aria-labelledby="fd-ticket-title">
				<div class="fd-ticket-head">
					<p id="fd-ticket-title">This page</p>
					<span>3 parts &middot; 5 stages &middot; 1 dish</span>
				</div>
				<ol class="fd-ticket-stages fd-map" role="list">
					{parts.map((part) => (
						<li>
							<a href={`#${part.id}`} class="fd-map-link">
								<span class="fd-ticket-n fd-map-n">{part.n}</span>
								<span class="fd-map-text">
									<span class="fd-map-label">{part.label}</span>
									<span class="fd-map-done">{part.done}</span>
								</span>
							</a>
						</li>
					))}
				</ol>
				<figcaption>Pick the question you came with. Each part ends with one next step.</figcaption>
			</figure>
		</div>
	</section>

	<section class="fd-band fd-part" id="before" aria-labelledby="fd-before-heading">
		<div class="container-page" data-reveal>
			<div class="fd-prose">
				<p class="eyebrow fd-part-label">Part 1 of 3 &middot; Before you start</p>
				<h2 id="fd-before-heading">Have one recipe and its supplier prices ready.</h2>
				<p>
					You have done this before. The last tool wanted your whole catalog typed in before it
					would do anything, and the half-filled spreadsheet is still on the desktop.
				</p>
				<p>
					CostCook wants what is already written down: one invoice, one recipe. Review the amounts and prices it reads, then fill in any missing details.
				</p>
			</div>
			<div class="fd-before-layout">
				<figure class="fd-ticket fd-have" aria-labelledby="fd-have-title">
					<div class="fd-ticket-head">
						<p id="fd-have-title">Have ready</p>
						<span>2 papers &middot; 1 phone</span>
					</div>
					<ol class="fd-ticket-rows" role="list">
						{haveReady.map((item, index) => (
							<li>
								<span class="fd-have-n">{index + 1}</span>
								<span class="fd-map-text">
									<span class="fd-map-label">{item.lead}</span>
									<span class="fd-map-done">{item.body}</span>
								</span>
							</li>
						))}
					</ol>
					<figcaption>Check the recipe amounts and pack prices. Add or correct anything the upload could not read.</figcaption>
				</figure>
				<figure class="fd-shot fd-welcome-shot">
					<div class="shot-pan" tabindex="0" role="region" aria-label="Welcome screen screenshot">
						<picture>
							{welcomeShot.phone && <source media="(min-width: 64rem)" srcset={welcomeShot.src} width={welcomeShot.width} height={welcomeShot.height} />}
							<img src={(welcomeShot.phone ?? welcomeShot).src} width={(welcomeShot.phone ?? welcomeShot).width} height={(welcomeShot.phone ?? welcomeShot).height} style={shotStyle(welcomeShot)} loading="lazy" decoding="async" alt={welcomeShot.alt} />
						</picture>
					</div>
					<figcaption>{welcomeShot.caption}</figcaption>
				</figure>
			</div>
			<div class="fd-prose">
				<p>
					During sign-up, you name your kitchen and enter the card for your trial. Name the dish at the
					welcome, and every screen after says its name back to you.
				</p>
				<p class="fd-handoff">Those answers take a minute. These five stages are the work.</p>
			</div>
		</div>
	</section>

	<section class="fd-band fd-part" id="stages" aria-labelledby="fd-stages-heading">
		<div class="container-page" data-reveal>
			<div class="fd-prose">
				<p class="eyebrow fd-part-label">Part 2 of 3 &middot; The five stages</p>
				<h2 id="fd-stages-heading">Five stages is one dish&rsquo;s worth of facts, and two of them are uploads.</h2>
				<p>
					Each stage asks for the next thing that one dish needs, and nothing else. Here is
					each one as you will meet it.
				</p>
			</div>
			<ol class="fd-stage-list" role="list">
				{stages.map((stage) => (
					<li class="fd-stage fd-scene">
						<p class="fd-stage-head">
							<span class="fd-stage-n" aria-hidden="true">{stage.n}</span>
							<span class="fd-stage-label">{stage.label}</span>
						</p>
						<div class="fd-stage-copy">
							<p class="fd-stage-body">{stage.body}</p>
							<p class="fd-stage-done"><span class="fd-stage-done-k">Done when</span> {stage.done}.</p>
						</div>
						{stage.shots.map((shot) => (
							<figure class="fd-shot fd-scene-shot">
								<div class="shot-pan" tabindex="0" role="region" aria-label={`Stage ${stage.n}, ${stage.label}, screenshot`}>
									<picture>
										{shot.phone && <source media="(min-width: 64rem)" srcset={shot.src} width={shot.width} height={shot.height} />}
										<img src={(shot.phone ?? shot).src} width={(shot.phone ?? shot).width} height={(shot.phone ?? shot).height} style={shotStyle(shot)} loading="lazy" decoding="async" alt={shot.alt} />
									</picture>
								</div>
								<figcaption>{shot.caption} <a class="fd-full" href={shot.src} target="_blank" rel="noopener noreferrer">Open full-size (new tab)</a></figcaption>
							</figure>
						))}
					</li>
				))}
			</ol>

			<p class="fd-gate">
				Nothing that comes in through an upload is written to your kitchen until you confirm it,
				and what CostCook could not read is quoted back to you rather than guessed at.
			</p>

			<p class="fd-sage">
				On a computer, Sage stays open beside whichever stage you are on; on a phone it opens over it. Its questions are the ones that
				stage raises, and it answers from the records you have entered so far. It reads them;
				it never fills a stage in for you.
			</p>

			<p class="fd-handoff">Stage four ends on a number.</p>
		</div>
	</section>

	<section class="fd-band fd-band-cream" id="the-number" aria-labelledby="fd-number-heading">
		<div class="container-page fd-number-layout" data-reveal>
			<div class="fd-prose">
				<p class="eyebrow">The number</p>
				<h2 id="fd-number-heading">Example: one ingredient costed from its case price.</h2>
				<p>
					6.3 oz (180 g) of chicken thigh, bought at $32.00 for a 10 lb case, 80% of it surviving the trim.
				</p>
				<p class="fd-snap">
					A $32 case of thighs, 80% usable after trim, 6.3 oz (180 g) on the plate, plus 2% misc: $1.62. Check it
					on paper. We would rather you did.
				</p>
			</div>

			<figure class="fd-maths" aria-labelledby="fd-maths-title">
				<p id="fd-maths-title" class="fd-maths-title">Plate cost, as the screen prints it</p>
				<div
					class="fd-maths-scroll"
					tabindex="0"
					role="group"
					aria-label="Plate cost arithmetic, scrollable"
				>
					<table>
