---
import { getPublishedPosts } from '../lib/blog';
import { spellCapital } from '../lib/words';
import { blogMenu } from '../lib/site';

type Props = {
	path: string;
};

const { path } = Astro.props;
const posts = await getPublishedPosts();
const groups = ['Cost the work', 'Plan and buy'] as const;

// Considered Composite; not used because this menu has two fixed groups of
// article leaves. Recursive navigation nodes would obscure a flat reading order.
---

<!-- story: docs/stories/features-navigation.story.md -->
<div class="grid lg:grid-cols-2">
	{groups.map((group, groupIndex) => (
		<section
			aria-labelledby={`blog-menu-group-${groupIndex}`}
			class:list={[
				'p-3 sm:p-4',
				groupIndex > 0 && 'border-t border-ticket-rule lg:border-t-0 lg:border-l'
			]}
		>
			<p id={`blog-menu-group-${groupIndex}`} class="px-3 pt-1 pb-2 text-sm font-semibold text-ink">{group}</p>
			<ul role="list">
				{posts.filter((post) => post.data.menuGroup === group).map((post) => (
					<li>
						<a
							href={`/blog/${post.id}`}
							aria-current={path === `/blog/${post.id}` ? 'page' : undefined}
							class="grid min-h-11 grid-cols-[1.25rem_minmax(0,1fr)] gap-3 rounded-md px-3 py-2.5 transition-colors duration-150 hover:bg-cream"
						>
							<svg
								width="20"
								height="20"
								viewBox="0 0 20 20"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="mt-0.5 text-amber-deep"
								aria-hidden="true"
							>
								<use href={`#blog-menu-${post.data.menuIcon}`} />
							</svg>
							<span class="min-w-0">
								<span class="block text-sm font-semibold leading-snug text-ink">{post.data.title}</span>
								<span class="mt-1 block text-xs leading-snug text-ink-soft">{post.data.description}</span>
							</span>
						</a>
					</li>
				))}
			</ul>
		</section>
	))}
</div>

<div class="flex flex-wrap items-center justify-between gap-x-6 border-t border-ticket-rule bg-cream px-6 py-2.5">
	<a
		href={blogMenu.href}
		aria-current={path === blogMenu.href ? 'page' : undefined}
		class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-green-deep underline decoration-ticket-rule underline-offset-4 transition-colors duration-150 hover:decoration-green"
	>
		{blogMenu.overviewLabel}
		<svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
			<path d="M1 5h11M8 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
		</svg>
	</a>
	<p class="text-xs text-ink-soft">{spellCapital(posts.length)} worked guides. The assumptions stay beside the arithmetic.</p>
</div>
