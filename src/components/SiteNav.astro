---
import { cta, nav } from '../lib/site';
import BrandLockup from './BrandLockup.astro';
---

<header class="container-page flex items-center justify-between gap-3 pt-5 pb-4 sm:pt-8">
	<BrandLockup href="/" />
	<nav aria-label="Main">
		<ul role="list" class="flex items-center gap-5 lg:gap-8">
			{
				nav.map((item) => (
					<li class="hidden md:block">
						<a
							href={item.href}
							class="inline-flex min-h-11 items-center text-sm font-medium text-ink-soft transition-colors duration-150 hover:text-ink"
						>
							{item.label}
						</a>
					</li>
				))
			}
			<li>
				<!-- py-3 makes the pill a true 44px tap target (12+20+12) — it's
				     the page's most important persistent control. -->
				<a
					href={cta.href}
					target={cta.target}
					rel={cta.rel}
					aria-label={cta.ariaLabel}
					class="btn-primary whitespace-nowrap px-4 py-3 text-sm sm:px-5"
				>
					<span class="sm:hidden">Book demo</span>
					<span class="hidden sm:inline">{cta.label}</span>
				</a>
			</li>
		</ul>
	</nav>
</header>
