---
import { cta, nav } from '../lib/site';
import BrandLockup from './BrandLockup.astro';
---

<header class="container-page flex items-baseline justify-between pt-6 pb-4 sm:pt-8">
	<BrandLockup href="/" />
	<nav aria-label="Main">
		<ul role="list" class="flex items-baseline gap-5 sm:gap-8">
			{
				nav.map((item) => (
					<li class="hidden sm:block">
						<a
							href={item.href}
							class="text-sm font-medium text-ink-soft transition-colors duration-150 hover:text-ink"
						>
							{item.label}
						</a>
					</li>
				))
			}
			<li>
				<!-- py-3 makes the pill a true 44px tap target (12+20+12) — it's
				     the page's most important persistent control. -->
				<a href={cta.href} class="btn-primary px-5 py-3 text-sm">{cta.label}</a>
			</li>
		</ul>
	</nav>
</header>
