---
import { blogMenu, cta, demoCta, featuresMenu, mobileMenu, nav, resourcesMenu, signIn, siteMap } from '../lib/site';
import BrandLockup from './BrandLockup.astro';
import BlogMenuContents from './BlogMenuContents.astro';
import FeatureMenuContents from './FeatureMenuContents.astro';
import ResourcesMenuContents from './ResourcesMenuContents.astro';

// The native disclosure is the reliable base: click, Enter, touch, and no-JS
// all use the same mechanism. The script adds only the recovery behavior a
// navigation panel needs: Escape, click-away, link activation, and focus-out.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const pricingItem = nav.find((item) => item.header === 'direct');
const blogActive = path === blogMenu.href || path.startsWith(`${blogMenu.href}/`);
const resourcesActive = resourcesMenu.items.some((item) => item.href === path || path.startsWith(`${item.href}/`));
// Considered State; not used because the active destination is derived from
// the current URL while native details own each open/closed state.
---

<!-- story: docs/stories/homepage-caterer-fixes.story.md -->
<!-- story: docs/stories/features-navigation.story.md -->
<!-- The header spans the page, not the 72rem content column: the mark sits
     at the left gutter, where readers look for it first (owner, 2026-10-07).
     Capped at 96rem so on a very wide screen the mark and the trial button
     do not drift apart. Same side padding as container-page, so up to 72rem
     the mark sits on the content's left edge; wider than that the header
     keeps to the left gutter by design, and the footer mark follows it
     (design review 2026-10-07: they were 3vw against 4vw, 6-10px apart). -->
<header class="site-header relative mx-auto w-full max-w-[96rem] px-[clamp(1.25rem,4vw,3rem)] flex flex-wrap items-center justify-between gap-x-3 gap-y-2 pt-5 pb-4 sm:pt-8">
	<!-- One sprite keeps every destination icon on the same 20px grid and
	     stroke weight. Visible titles and descriptions carry their meaning. -->
	<svg width="0" height="0" class="absolute overflow-hidden" aria-hidden="true">
		<defs>
			<symbol id="feature-menu-recipe" viewBox="0 0 20 20">
				<path d="M4 3.5h8.25A2.75 2.75 0 0 1 15 6.25V16H6.75A2.75 2.75 0 0 1 4 13.25V3.5Z" />
				<path d="M6.75 13.5H15M7 7h5M7 10h4" />
			</symbol>
			<symbol id="feature-menu-menu" viewBox="0 0 20 20">
				<circle cx="10" cy="10" r="6.5" />
				<path d="M10 3.5v13M3.5 10h13" />
			</symbol>
			<symbol id="feature-menu-ingredient" viewBox="0 0 20 20">
				<path d="M6.25 13.75c2.5-4.75 4.75-7 8.75-8.75-1 4.75-3.25 8.25-7.25 9.5-1.5.5-2.75-.25-1.5-.75Z" />
				<path d="M5 16c1.5-3 3.5-5.25 6.75-7.5M12.75 4.25c-.25-1-.75-1.75-1.5-2.25" />
			</symbol>
			<symbol id="feature-menu-import" viewBox="0 0 20 20">
				<path d="M5 2.75h6l4 4V17.25H5V2.75Z" />
				<path d="M11 2.75v4h4M10 9v5M7.75 11.75 10 14l2.25-2.25" />
			</symbol>
			<symbol id="feature-menu-orders" viewBox="0 0 20 20">
				<path d="M5 2.75h10v14.5H5V2.75Z" />
				<path d="m7.25 7 1 1 2-2M11.5 7H13M7.25 12h5.75" />
			</symbol>
			<symbol id="feature-menu-purchasing" viewBox="0 0 20 20">
				<path d="M2.75 5.5h9.5v8h-9.5v-8ZM12.25 8h2.25l2.75 3v2.5h-5" />
				<circle cx="6" cy="15" r="1.5" /><circle cx="14.75" cy="15" r="1.5" />
			</symbol>
			<symbol id="feature-menu-inventory" viewBox="0 0 20 20">
				<path d="M3 4.25h14v11.5H3V4.25ZM3 9.75h14M7.5 4.25v11.5M12.5 4.25v11.5" />
			</symbol>
			<symbol id="feature-menu-nutrition" viewBox="0 0 20 20">
				<path d="M4.5 2.75h11v14.5h-11V2.75Z" />
				<path d="M6.75 6h6.5M6.75 8.75h6.5M6.75 11.5h4M6.75 14.25h6.5" />
			</symbol>
			<symbol id="feature-menu-labels" viewBox="0 0 20 20">
				<path d="M3.5 5.25h13v9.5h-13v-9.5Z" />
				<path d="M6 8.25h8M6 11h5M13.25 11.75h.5" />
			</symbol>
			<symbol id="feature-menu-ledger" viewBox="0 0 20 20">
				<path d="M4.5 2.75h11v14.5l-2-1.25-2 1.25-2-1.25-2 1.25-3-1.75V2.75Z" />
				<path d="M7 7h6M7 10h6M7 13h3.5" />
			</symbol>
			<symbol id="feature-menu-team" viewBox="0 0 20 20">
				<circle cx="7" cy="7" r="2.5" />
				<circle cx="14" cy="8" r="2" />
				<path d="M2.75 16c.3-3 1.75-4.5 4.25-4.5s3.95 1.5 4.25 4.5M11.25 12.25c.7-.8 1.65-1.2 2.75-1.2 2.05 0 3.15 1.15 3.4 3.45" />
			</symbol>
			<symbol id="blog-menu-calculator" viewBox="0 0 20 20">
				<rect x="4" y="2.75" width="12" height="14.5" rx="1" />
				<path d="M6.5 5.5h7M7 9h1M12 9h1M7 12.5h1M12 12.5h1" />
			</symbol>
			<symbol id="blog-menu-percent" viewBox="0 0 20 20">
				<circle cx="6" cy="6" r="2" /><circle cx="14" cy="14" r="2" />
				<path d="m5 15 10-10" />
			</symbol>
			<symbol id="blog-menu-yield" viewBox="0 0 20 20">
				<path d="M5.25 14.75c2.25-4.5 4.75-7.25 9.5-9.5-.75 5-3.25 8.5-7.25 9.75-1.25.4-2.1.2-2.25-.25Z" />
				<path d="M4 17c1.75-3.5 4.25-6 7.75-8.25" />
			</symbol>
			<symbol id="blog-menu-guests" viewBox="0 0 20 20">
				<circle cx="7" cy="7" r="2.5" /><circle cx="14" cy="8" r="2" />
				<path d="M2.75 16c.3-3 1.75-4.5 4.25-4.5s3.95 1.5 4.25 4.5M11.25 12.25c.7-.8 1.65-1.2 2.75-1.2 2.05 0 3.15 1.15 3.4 3.45" />
			</symbol>
			<symbol id="blog-menu-packs" viewBox="0 0 20 20">
				<path d="m3.5 6 6.5-3 6.5 3v8L10 17l-6.5-3V6Z" />
				<path d="m3.5 6 6.5 3 6.5-3M10 9v8" />
			</symbol>
			<symbol id="blog-menu-prices" viewBox="0 0 20 20">
				<path d="M3.5 4h6.75l6.25 6.25-6.25 6.25L4 10.25V4Z" />
				<circle cx="7" cy="7.25" r="1" />
			</symbol>
			<symbol id="blog-menu-receiving" viewBox="0 0 20 20">
				<path d="M2.75 5.5h9.5v8h-9.5v-8ZM12.25 8h2.25l2.75 3v2.5h-5" />
				<path d="m5.5 9.5 1.5 1.5 2.75-3" /><circle cx="6" cy="15" r="1.5" /><circle cx="14.75" cy="15" r="1.5" />
			</symbol>
			<symbol id="blog-menu-variance" viewBox="0 0 20 20">
				<path d="M3.25 15.5h13.5M5 13V8M10 13V4M15 13v-2.5" />
				<path d="m4.5 5.5 3-2 3 2 4.5-3" />
			</symbol>
			<symbol id="blog-menu-prep" viewBox="0 0 20 20">
				<path d="M4 8h12l-1 7.5H5L4 8ZM6 8V5.5h8V8M7 3.5h6" />
				<path d="M7.25 11.25h5.5" />
			</symbol>
			<symbol id="blog-menu-invoice" viewBox="0 0 20 20">
				<path d="M5 2.75h7l3 3v11.5l-2-1.25-2 1.25L9 16l-2 1.25-2-1.25V2.75Z" />
				<path d="M8 7h4M8 10h4M8 13h2" />
			</symbol>
			<symbol id="blog-menu-calendar" viewBox="0 0 20 20">
				<path d="M3.5 5h13v11.5h-13V5ZM3.5 8.5h13M7 3v3.5M13 3v3.5" />
				<path d="m7.5 12.5 1.75 1.75 3.5-3.5" />
			</symbol>
			<symbol id="blog-menu-credit" viewBox="0 0 20 20">
				<path d="M5 2.75h7l3 3v11.5l-2-1.25-2 1.25L9 16l-2 1.25-2-1.25V2.75Z" />
				<path d="M7.75 10h4.5" />
			</symbol>
			<symbol id="blog-menu-order" viewBox="0 0 20 20">
				<rect x="5.75" y="2.75" width="8.5" height="14.5" rx="1.25" />
				<path d="M8.25 6.5h3.5M8.25 9.5h3.5M9 14.25h2" />
			</symbol>
			<symbol id="blog-menu-web" viewBox="0 0 20 20">
				<rect x="2.75" y="3.75" width="14.5" height="12.5" rx="1" />
				<path d="M2.75 7h14.5M8.25 9.75 6.5 11.5l1.75 1.75M11.75 9.75l1.75 1.75-1.75 1.75" />
			</symbol>
			<symbol id="resource-menu-tour" viewBox="0 0 20 20">
				<rect x="3" y="4" width="14" height="12" rx="1" /><path d="m8 7 5 3-5 3V7Z" />
			</symbol>
			<symbol id="resource-menu-audience" viewBox="0 0 20 20">
				<circle cx="10" cy="7" r="3" /><path d="M4.5 16c.4-3.1 2.25-4.75 5.5-4.75s5.1 1.65 5.5 4.75" />
			</symbol>
			<symbol id="resource-menu-dish" viewBox="0 0 20 20">
				<circle cx="10" cy="11" r="6" /><circle cx="10" cy="11" r="2.5" /><path d="M10 2.5v2" />
			</symbol>
			<symbol id="resource-menu-compare" viewBox="0 0 20 20">
				<path d="M4 4h12M4 10h12M4 16h12" /><circle cx="7" cy="4" r="1.5" fill="currentColor" stroke="none" /><circle cx="13" cy="10" r="1.5" fill="currentColor" stroke="none" /><circle cx="9" cy="16" r="1.5" fill="currentColor" stroke="none" />
			</symbol>
			<symbol id="resource-menu-faq" viewBox="0 0 20 20">
				<circle cx="10" cy="10" r="7" /><path d="M7.75 7.5a2.35 2.35 0 0 1 4.5.8c0 1.7-2.25 1.7-2.25 3.2M10 14.25h.01" />
			</symbol>
			<symbol id="resource-menu-contact" viewBox="0 0 20 20">
				<path d="M3.25 4.5h13.5v10H8l-3.5 2v-2h-1.25v-10Z" /><path d="M6.5 8h7M6.5 11h4.5" />
			</symbol>
		</defs>
	</svg>

	<BrandLockup href="/" size="header" />
	<div class="header-actions flex flex-wrap items-center justify-end gap-2 sm:gap-3 lg:gap-4">
		<nav aria-label="Main">
			<ul role="list" class="flex items-center gap-3 lg:gap-5">
				<li class="feature-disclosure lg:relative">
					<details data-nav-disclosure data-features-menu>
						<summary
							aria-label={featuresMenu.ariaLabel}
							class:list={[
								'panel-trigger inline-flex min-h-11 cursor-pointer list-none items-center gap-1.5 text-sm font-medium text-ink-soft transition-colors duration-150 hover:text-ink [&::-webkit-details-marker]:hidden',
								path.startsWith('/features') && 'text-ink'
							]}
						>
							{featuresMenu.label}
							<svg
								width="10"
								height="6"
								viewBox="0 0 10 6"
								fill="none"
								aria-hidden="true"
								class="transition-transform duration-150 [details[open]_&]:rotate-180"
							>
								<path d="M1 1 5 5 9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</summary>

						<div
							class="absolute inset-x-3 top-full z-40 max-h-[calc(100dvh-6.5rem)] overflow-x-hidden overflow-y-auto overscroll-contain rounded-lg border border-ticket-rule bg-paper shadow-lift lg:inset-x-auto lg:right-auto lg:left-1/2 lg:mt-2 lg:max-h-[calc(100dvh-9rem)] lg:w-[min(50rem,calc(100vw-2.5rem))] lg:-translate-x-1/2"
						>
							<!-- Below lg the panel opens like Menu: under the header, over the
							     same backdrop, with a Close row (design review 2026-10-07: it was
							     a bottom sheet with neither, beside a Menu that had both). -->
							<p class="flex items-center justify-between gap-x-3 border-b border-ticket-rule bg-cream py-1 pr-1 pl-4 lg:hidden">
								<span class="min-w-0 font-display text-lg font-semibold">{featuresMenu.label}</span>
								<button type="button" data-menu-close hidden class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-md px-3 text-sm font-semibold text-ink-soft hover:bg-paper hover:text-ink">Close</button>
							</p>
							<FeatureMenuContents {path} idPrefix="global-features" />
						</div>
					</details>
				</li>

				{pricingItem && (
					<li class="hidden lg:block">
						<a
							href={pricingItem.href}
							aria-current={path === pricingItem.href ? 'page' : undefined}
							class:list={[
								'inline-flex min-h-11 items-center text-sm font-medium text-ink-soft transition-colors duration-150 hover:text-ink',
								path === pricingItem.href && 'text-ink underline decoration-ticket-rule underline-offset-8'
							]}
						>
							{pricingItem.label}
						</a>
					</li>
				)}

				<li class="relative hidden xl:block">
					<details data-nav-disclosure data-blog-menu>
						<summary
							aria-label={blogMenu.ariaLabel}
							class:list={[
								'inline-flex min-h-11 cursor-pointer list-none items-center gap-1.5 text-sm font-medium text-ink-soft transition-colors duration-150 hover:text-ink [&::-webkit-details-marker]:hidden',
								blogActive && 'text-ink'
							]}
						>
							{blogMenu.label}
							<svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true" class="nav-chevron transition-transform duration-150 [details[open]_&]:rotate-180">
								<path d="M1 1 5 5 9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</summary>
						<div class="absolute top-full left-1/2 z-40 mt-2 max-h-[calc(100dvh-7rem)] w-[min(52rem,calc(100vw-2.5rem))] -translate-x-1/2 overflow-x-hidden overflow-y-auto overscroll-contain rounded-lg border border-ticket-rule bg-paper shadow-lift">
							<BlogMenuContents {path} />
						</div>
					</details>
				</li>

				<li class="relative hidden xl:block">
					<details data-nav-disclosure data-resources-menu>
						<summary
							aria-label={resourcesMenu.ariaLabel}
							class:list={[
								'inline-flex min-h-11 cursor-pointer list-none items-center gap-1.5 text-sm font-medium text-ink-soft transition-colors duration-150 hover:text-ink [&::-webkit-details-marker]:hidden',
								resourcesActive && 'text-ink'
							]}
						>
							{resourcesMenu.label}
							<svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true" class="nav-chevron transition-transform duration-150 [details[open]_&]:rotate-180">
								<path d="M1 1 5 5 9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</summary>
						<div class="absolute top-full right-0 z-40 mt-2 w-[min(54rem,calc(100vw-2.5rem))] overflow-hidden rounded-lg border border-ticket-rule bg-paper shadow-lift">
							<ResourcesMenuContents {path} />
						</div>
					</details>
				</li>
				<li class="xl:hidden">
					<!-- GROUPED, ANCHORED, CLOSABLE (design review 2026-10-07). The Menu
					     was a flat run of eleven links in a sheet pinned to the bottom of
					     the screen, far from its trigger, with no backdrop and no close
					     control. It now opens under the header, reads the footer's own
					     groups (siteMap), and puts Sign in and the demo link in an action
					     row. The backdrop is the summary's own ::before, so tapping it
					     closes the menu with or without JavaScript. -->
					<details data-nav-disclosure data-mobile-menu>
						<summary
							class="panel-trigger inline-flex min-h-11 cursor-pointer list-none items-center gap-1.5 text-sm font-medium text-ink-soft transition-colors duration-150 hover:text-ink [&::-webkit-details-marker]:hidden"
						>
							{mobileMenu.label}
							<svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true" class="nav-chevron transition-transform duration-150 [details[open]_&]:rotate-180">
								<path d="M1 1 5 5 9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</summary>
						<div class="absolute inset-x-3 top-full z-40 max-h-[calc(100dvh-6.5rem)] overflow-x-hidden overflow-y-auto overscroll-contain rounded-lg border border-ticket-rule bg-paper shadow-lift sm:left-auto sm:w-[26rem]">
							<div class="flex flex-wrap items-center justify-between gap-x-3 border-b border-ticket-rule bg-cream py-1 pr-1 pl-4">
								<p class="min-w-0 font-display text-lg font-semibold [overflow-wrap:anywhere]">Navigate CostCook</p>
								<button type="button" data-menu-close hidden class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-md px-3 text-sm font-semibold text-ink-soft hover:bg-paper hover:text-ink">Close</button>
							</div>

							<ul role="list" class="flex flex-wrap items-center gap-x-2 border-b border-ticket-rule p-2">
								<li><a href={signIn.href} target={signIn.target} aria-label={signIn.ariaLabel} class="flex min-h-11 items-center px-3 text-sm font-medium text-ink-soft hover:bg-cream hover:text-ink">{signIn.label}</a></li>
								<!-- The actions sit first, under the title: on a 320x568 phone they were
								     two inner scrolls down (design review 2026-10-07).
								     Phones only: the header's demo link moves in here so the bar is
								     one row (mark, Menu, Free trial). Same label and target. -->
								<li class="sm:hidden"><a href={demoCta.href} target={demoCta.target} rel={demoCta.rel} aria-label={demoCta.ariaLabel} class="flex min-h-11 items-center px-3 text-sm font-semibold text-green-deep underline decoration-ticket-rule underline-offset-4 hover:bg-cream">{demoCta.label}</a></li>
							</ul>

							<div class="grid grid-cols-1 gap-x-2 gap-y-3 p-2 min-[360px]:grid-cols-2">
								{siteMap.map((group, index) => (
									<div class="min-w-0">
										<p id={`mobile-menu-group-${index}`} class="eyebrow px-3 pt-2 [overflow-wrap:anywhere]">{group.heading}</p>
										<ul role="list" aria-labelledby={`mobile-menu-group-${index}`}>
											{group.links.map((item) => (
												<li class:list={[item.phoneOnly && 'tiny-features-link']}>
													<a
														href={item.href}
														target={item.target}
														rel={item.rel}
														aria-label={item.ariaLabel}
														aria-current={path === item.href ? 'page' : undefined}
														class="flex min-h-11 items-center px-3 text-sm font-medium [overflow-wrap:anywhere] text-ink-soft hover:bg-cream hover:text-ink"
													>{item.label}</a>
												</li>
											))}
										</ul>
									</div>
								))}
							</div>
						</div>
					</details>
				</li>
			</ul>
		</nav>

		<a
			href={signIn.href}
			target={signIn.target}
			aria-label={signIn.ariaLabel}
			class="hidden min-h-11 items-center whitespace-nowrap text-sm font-medium text-ink-soft transition-colors duration-150 hover:text-ink lg:inline-flex"
		>
			{signIn.label}
		</a>
		<a
			href={demoCta.href}
			target={demoCta.target}
			rel={demoCta.rel}
			aria-label={demoCta.ariaLabel}
			aria-current={path === demoCta.href ? 'page' : undefined}
			class="nav-demo hidden min-h-11 sm:inline-flex items-center whitespace-nowrap px-1 text-sm font-semibold text-green-deep underline decoration-ticket-rule underline-offset-4 transition-colors duration-150 hover:decoration-green"
		>
			<!-- A LINK, NOT A SECOND BUTTON (2026-09-10). This was a bordered pill
			     beside the primary, so the header read as three actions with two of
			     them shaped like buttons. The demo is the quiet alternative
			     (CLAUDE.md principle 5), so it takes the underlined-link register
			     the Features menu footer already uses. Label and target unchanged. -->
			<span>{demoCta.label}</span>
		</a>
		<a
			href={cta.href}
			target={cta.target}
			rel={cta.rel}
			class="btn-primary min-h-11 whitespace-nowrap px-4 py-3 text-sm sm:px-5"
		>
			<!-- No aria-label: the visible words are the name. Below xl the button
			     reads "Free trial", and a name that does not start with what a
			     speech-input user sees fails label-in-name (design audit
			     2026-10-07). -->
			<!-- The short form keeps "free trial": "Start" alone was the one place
			     the button said nothing about what starting costs. -->
			<span class="xl:hidden">Free trial</span>
			<span class="hidden xl:inline">{cta.label}</span>
		</a>
	</div>
</header>

<style>
	.tiny-features-link {
		display: none;
	}

	/* ONE ROW ON PHONES (2026-10-07, owner, after a navbar review): below sm
	   the bar holds the mark, Menu and Free trial. Features and Book a demo
	   live inside Menu there. It was two rows, about 130px of an 844px
	   screen; one row gives back about 50px above the fold. */
	@media (max-width: 639px) {
		.feature-disclosure {
			display: none;
		}

		.tiny-features-link {
			display: block;
		}
	}

	/* The backdrop: tapping it is tapping the summary, which closes the panel.
	   The Menu always has it; Features has it below lg, where it opens the same
	   way. While a panel is open the page does not scroll (design review
	   2026-10-07: the page scrolled away under the backdrop and the sticky
	   bar painted over it). Both work without JavaScript. */
	[data-mobile-menu][open] > .panel-trigger::before {
		content: '';
		position: fixed;
		inset: 0;
		z-index: 30;
		background: color-mix(in oklab, var(--color-ink) 28%, transparent);
		cursor: default;
	}
	:global(html:has([data-mobile-menu][open])) {
		overflow: hidden;
	}
	@media (max-width: 63.99rem) {
		[data-features-menu][open] > .panel-trigger::before {
			content: '';
			position: fixed;
			inset: 0;
			z-index: 30;
			background: color-mix(in oklab, var(--color-ink) 28%, transparent);
			cursor: default;
		}
		:global(html:has([data-features-menu][open])) {
			overflow: hidden;
		}
	}
	/* The bar's own links stay above the backdrop, so Free trial is one tap
	   even with a panel open (design review 2026-10-07). */
	.site-header > :global(a),
	.header-actions > a {
		position: relative;
		z-index: 31;
	}

	@media (prefers-reduced-motion: reduce) {
		.nav-chevron,
		[data-features-menu] summary svg {
			transition: none;
		}

		.nav-demo {
			transition: none;
		}
	}
</style>

<script>
	const menus = [...document.querySelectorAll<HTMLDetailsElement>('[data-nav-disclosure]')];
	for (const menu of menus) {
		menu.addEventListener('toggle', () => {
			if (!menu.open) return;
			for (const other of menus) if (other !== menu) other.open = false;
		});

		menu.addEventListener('click', (event) => {
			if ((event.target as Element).closest('a')) menu.open = false;
		});

		menu.addEventListener('focusout', (event) => {
			const next = event.relatedTarget as Node | null;
			if (menu.open && next && !menu.contains(next)) menu.open = false;
		});
	}

	for (const close of document.querySelectorAll<HTMLButtonElement>('[data-menu-close]')) {
		const menu = close.closest('details');
		if (!menu) continue;
		close.hidden = false;
		close.addEventListener('click', () => {
			menu.open = false;
			menu.querySelector<HTMLElement>(':scope > summary')?.focus();
		});
	}

	document.addEventListener('click', (event) => {
		for (const menu of menus) if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
	});

	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape') return;
		const openMenu = menus.find((menu) => menu.open);
		if (!openMenu) return;
		openMenu.open = false;
		openMenu.querySelector<HTMLElement>(':scope > summary')?.focus();
	});
</script>
