---
import { featureMenuHref, featureMenuSections } from '../lib/features';
import { cta, featuresMenu, nav, signIn } from '../lib/site';
import BrandLockup from './BrandLockup.astro';

// The native disclosure is the reliable base: click, Enter, touch, and no-JS
// all use the same mechanism. The script adds only the recovery behavior a
// navigation panel needs: Escape, click-away, link activation, and focus-out.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
// Considered State; not used because the active destination is derived from
// the current URL and the navigation owns no self-transitioning behavior.
---

<!-- story: docs/stories/features-navigation.story.md -->
<header class="container-page relative flex flex-wrap items-center justify-between gap-x-3 gap-y-2 pt-5 pb-4 sm:pt-8">
	<!-- One sprite keeps every destination icon on the same 20px grid and
	     stroke weight. Visible titles and descriptions carry their meaning. -->
	<svg width="0" height="0" class="absolute overflow-hidden" aria-hidden="true">
		<defs>
			<symbol id="feature-menu-recipe" viewBox="0 0 20 20">
				<path d="M4 3.5h8.25A2.75 2.75 0 0 1 15 6.25V16H6.75A2.75 2.75 0 0 1 4 13.25V3.5Z" />
				<path d="M6.75 13.5H15M7 7h5M7 10h4" />
			</symbol>
			<symbol id="feature-menu-menu" viewBox="0 0 20 20">
				<circle cx="10" cy="10" r="6.5" />
				<path d="M10 3.5v13M3.5 10h13" />
			</symbol>
			<symbol id="feature-menu-ingredient" viewBox="0 0 20 20">
				<path d="M6.25 13.75c2.5-4.75 4.75-7 8.75-8.75-1 4.75-3.25 8.25-7.25 9.5-1.5.5-2.75-.25-1.5-.75Z" />
				<path d="M5 16c1.5-3 3.5-5.25 6.75-7.5M12.75 4.25c-.25-1-.75-1.75-1.5-2.25" />
			</symbol>
			<symbol id="feature-menu-import" viewBox="0 0 20 20">
				<path d="M5 2.75h6l4 4V17.25H5V2.75Z" />
				<path d="M11 2.75v4h4M10 9v5M7.75 11.75 10 14l2.25-2.25" />
			</symbol>
			<symbol id="feature-menu-orders" viewBox="0 0 20 20">
				<path d="M5 2.75h10v14.5H5V2.75Z" />
				<path d="m7.25 7 1 1 2-2M11.5 7H13M7.25 12h5.75" />
			</symbol>
			<symbol id="feature-menu-purchasing" viewBox="0 0 20 20">
				<path d="M2.75 5.5h9.5v8h-9.5v-8ZM12.25 8h2.25l2.75 3v2.5h-5" />
				<circle cx="6" cy="15" r="1.5" /><circle cx="14.75" cy="15" r="1.5" />
			</symbol>
			<symbol id="feature-menu-inventory" viewBox="0 0 20 20">
				<path d="M3 4.25h14v11.5H3V4.25ZM3 9.75h14M7.5 4.25v11.5M12.5 4.25v11.5" />
			</symbol>
			<symbol id="feature-menu-nutrition" viewBox="0 0 20 20">
				<path d="M4.5 2.75h11v14.5h-11V2.75Z" />
				<path d="M6.75 6h6.5M6.75 8.75h6.5M6.75 11.5h4M6.75 14.25h6.5" />
			</symbol>
			<symbol id="feature-menu-labels" viewBox="0 0 20 20">
				<path d="M3.5 5.25h13v9.5h-13v-9.5Z" />
				<path d="M6 8.25h8M6 11h5M13.25 11.75h.5" />
			</symbol>
			<symbol id="feature-menu-assistant" viewBox="0 0 20 20">
				<path d="M3.5 4.75h13v8.5H9.25L5.5 16.5v-3.25h-2v-8.5Z" />
				<path d="M7 8h6M7 10.5h4" />
			</symbol>
			<symbol id="feature-menu-ledger" viewBox="0 0 20 20">
				<path d="M4.5 2.75h11v14.5l-2-1.25-2 1.25-2-1.25-2 1.25-3-1.75V2.75Z" />
				<path d="M7 7h6M7 10h6M7 13h3.5" />
			</symbol>
			<symbol id="feature-menu-team" viewBox="0 0 20 20">
				<circle cx="7" cy="7" r="2.5" />
				<circle cx="14" cy="8" r="2" />
				<path d="M2.75 16c.3-3 1.75-4.5 4.25-4.5s3.95 1.5 4.25 4.5M11.25 12.25c.7-.8 1.65-1.2 2.75-1.2 2.05 0 3.15 1.15 3.4 3.45" />
			</symbol>
		</defs>
	</svg>

	<BrandLockup href="/" />
	<div class="flex flex-wrap items-center justify-end gap-x-4 gap-y-2 lg:gap-x-8">
		<nav aria-label="Main">
			<ul role="list" class="flex flex-wrap items-center justify-end gap-x-4 gap-y-2 lg:gap-x-8">
				<li>
					<details data-features-menu>
						<summary
							aria-label={featuresMenu.ariaLabel}
							class:list={[
								'inline-flex min-h-11 cursor-pointer list-none items-center gap-1.5 text-sm font-medium text-ink-soft transition-colors duration-150 hover:text-ink [&::-webkit-details-marker]:hidden',
								path.startsWith('/features') && 'text-ink'
							]}
						>
							{featuresMenu.label}
							<svg
								width="10"
								height="6"
								viewBox="0 0 10 6"
								fill="none"
								aria-hidden="true"
								class="transition-transform duration-150 [details[open]_&]:rotate-180"
							>
								<path d="M1 1 5 5 9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</summary>

						<div
							class="absolute inset-x-[clamp(1.25rem,4vw,3rem)] top-full z-40 mt-2 overflow-hidden rounded-lg border border-ticket-rule bg-paper md:right-auto md:left-1/2 md:w-[min(50rem,calc(100vw-2.5rem))] md:-translate-x-1/2"
						>
							<div class="grid md:grid-cols-2">
								{
									featureMenuSections.map((section, sectionIndex) => (
										<section
											aria-labelledby={`feature-menu-section-${sectionIndex}`}
											class:list={[
												'p-3 sm:p-4',
												sectionIndex > 0 && 'border-t border-ticket-rule md:border-t-0 md:border-l'
											]}
										>
											<p id={`feature-menu-section-${sectionIndex}`} class="px-3 pt-1 pb-2 text-sm font-semibold text-ink">
												{section.label}
											</p>
											<ul role="list">
												{section.items.map((item) => (
													<li>
														<a
															href={featureMenuHref(item.featureId, item.coming === true)}
															aria-current={path === featureMenuHref(item.featureId, item.coming === true) ? 'page' : undefined}
															class="grid min-h-11 grid-cols-[1.25rem_minmax(0,1fr)] gap-3 rounded-md px-3 py-2.5 transition-colors duration-150 hover:bg-cream"
														>
															<svg
																width="20"
																height="20"
																viewBox="0 0 20 20"
																fill="none"
																stroke="currentColor"
																stroke-width="1.5"
																stroke-linecap="round"
																stroke-linejoin="round"
																class="mt-0.5 text-amber-deep"
																aria-hidden="true"
															>
																<use href={`#feature-menu-${item.icon}`} />
															</svg>
															<span class="min-w-0">
																<span class="flex flex-wrap items-baseline gap-x-2 text-sm font-semibold text-ink">
																	{item.label}
																	{item.coming && (
																		<span class="inline-flex items-center rounded-full border border-ticket-rule bg-softamber px-2 py-0.5 font-mono text-xs font-semibold tracking-wide text-amber-deep">
																			Coming
																		</span>
																	)}
																</span>
																<span class="mt-0.5 block text-xs leading-snug text-ink-soft">{item.description}</span>
															</span>
														</a>
													</li>
												))}
											</ul>
										</section>
									))
								}
							</div>

							<div class="flex flex-wrap items-center justify-between gap-x-6 border-t border-ticket-rule bg-cream px-6 py-2.5">
								<div class="flex flex-wrap items-center gap-x-6">
									<a
										href={featuresMenu.tourHref}
										aria-current={path === featuresMenu.tourHref ? 'page' : undefined}
										class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-green-deep underline decoration-ticket-rule underline-offset-4 transition-colors duration-150 hover:decoration-green"
									>
										{featuresMenu.tourLabel}
										<svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
											<path d="M1 5h11M8 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
									</a>
									<a href={featuresMenu.href} class="inline-flex min-h-11 items-center text-sm font-semibold text-ink-soft underline decoration-ticket-rule underline-offset-4 hover:text-ink">
										{featuresMenu.overviewLabel}
									</a>
								</div>
								<p class="text-xs text-ink-soft">Every line is shipped unless it is marked Coming.</p>
							</div>
						</div>
					</details>
				</li>

				{
					nav.map((item) => (
						<li class={item.earlyVisible ? 'block' : item.wideOnly ? 'hidden xl:block' : 'hidden md:block'}>
							<a
								href={item.href}
								aria-current={path === item.href ? 'page' : undefined}
								class:list={[
									'inline-flex min-h-11 items-center text-sm font-medium text-ink-soft transition-colors duration-150 hover:text-ink',
									path === item.href && 'text-ink underline decoration-ticket-rule underline-offset-8'
								]}
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<a
			href={signIn.href}
			target={signIn.target}
			aria-label={signIn.ariaLabel}
			class="inline-flex min-h-11 items-center whitespace-nowrap text-sm font-medium text-ink-soft transition-colors duration-150 hover:text-ink"
		>
			{signIn.label}
		</a>
		<a
			href={cta.href}
			target={cta.target}
			rel={cta.rel}
			aria-label={cta.ariaLabel}
			class="btn-primary whitespace-nowrap px-4 py-3 text-sm sm:px-5"
		>
			<span class="sm:hidden">Start</span>
			<span class="hidden sm:inline">{cta.label}</span>
		</a>
	</div>
</header>

<style>
	@media (prefers-reduced-motion: reduce) {
		[data-features-menu] summary svg {
			transition: none;
		}
	}
</style>

<script>
	const menu = document.querySelector<HTMLDetailsElement>('[data-features-menu]');
	if (menu) {
		document.addEventListener('click', (event) => {
			if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && menu.open) {
				menu.open = false;
				menu.querySelector('summary')?.focus();
			}
		});

		menu.addEventListener('click', (event) => {
			if ((event.target as Element).closest('a')) menu.open = false;
		});

		menu.addEventListener('focusout', (event) => {
			const next = event.relatedTarget as Node | null;
			if (menu.open && next && !menu.contains(next)) menu.open = false;
		});
	}
</script>
