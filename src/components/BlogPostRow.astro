---
import type { CollectionEntry } from 'astro:content';

type Props = {
	post: CollectionEntry<'blog'>;
	compact?: boolean;
};

const { post, compact = false } = Astro.props;
const published = new Intl.DateTimeFormat('en-US', {
	month: 'short',
	day: 'numeric',
	year: 'numeric',
	timeZone: 'UTC'
}).format(post.data.publishedDate);
---

<article class:list={['blog-row grid gap-3 border-t border-hairline py-6 sm:grid-cols-[10rem_1fr_auto] sm:items-start sm:gap-6', compact && 'py-5']}>
	<div class="flex flex-wrap gap-x-3 gap-y-1 text-xs font-semibold text-amber-deep sm:block">
		<p>{post.data.category}</p>
		<p class="mt-0 text-ink-soft sm:mt-2">{post.data.readMinutes} min read</p>
	</div>
	<div>
		<h2 class:list={['font-display font-semibold text-ink text-balance', compact ? 'text-xl' : 'text-2xl']}>
			<a href={`/blog/${post.id}`} class="underline decoration-transparent underline-offset-4 transition-colors duration-150 hover:text-green-deep hover:decoration-hairline-strong">
				{post.data.title}
			</a>
		</h2>
		{!compact && <p class="mt-3 max-w-[65ch] text-sm leading-relaxed text-ink-soft">{post.data.description}</p>}
	</div>
	<p class="font-mono text-xs tabular-nums text-ink-soft sm:text-right">{published}</p>
</article>

