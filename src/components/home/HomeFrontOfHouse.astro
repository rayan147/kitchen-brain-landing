---
/**
 * Front of house (canvas S5). The canvas drew this band dark; the site is light
 * only (CLAUDE.md, anti-reference: dark pages), so it takes its turn in the
 * cream and soft-amber alternation (rule 1).
 *
 * Considered Template Method; not used because both cards have the same fixed
 * reading order and differ only in their content, not an algorithm step.
 */
import HomeBand from './HomeBand.astro';
import SectionHandoff from '../SectionHandoff.astro';
import HomeFrame from './HomeFrame.astro';
import { frontOfHouse } from '../../lib/home';
---
<HomeBand
	id="front"
	tone="amber"
	eyebrow="Client orders, supplier invoices"
	heading="Orders and invoices come to you."
	lede="Clients order from your own page or your website. Suppliers email invoices to your kitchen."
>
	<div class="cards">
		{frontOfHouse.map((card) => (
			<article class="card" data-front={card.id} data-reveal>
				<h3 class="home-h3">{card.heading}</h3>
				<p class="home-body mt-3">{card.body}</p>
					<HomeFrame shot={card.shot} class="card-shot" />
				{'guide' in card && <a href={card.guide.href} class="home-guide">{card.guide.label}</a>}
			</article>
		))}
	</div>
	<SectionHandoff from="front" class="home-handoff" />
</HomeBand>

<style>
	.cards { display: grid; gap: 3rem; margin-top: 3rem; }
	/* :global: the img renders inside HomeFrame. Each card shows its capture
	   whole. The 6:5 crop (3:2 until 2026-10-07) went on 2026-10-09: the
	   ordering frame is now shot 600 wide so it reads at 1:1 in its card, and
	   that frame runs taller than 6:5 to reach its Coastal Dinner row. The
	   invoice inbox is shot at 600 too: it stands about two thirds of the
	   ordering card's height, where at 780 it stood half. */
	.card :global(.card-shot) { margin-top: 1.5rem; }
	/* Keep each guide beside its own frame; the two captures have different
	   heights, so shared rows would leave a long empty gap under the shorter one. */
	/* Two up from 48rem, not 64: one card across a 750px tablet column ran
	   its lines to 99 characters (mobile review 2026-10-09). */
	@media (min-width: 48rem) {
		.cards { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 3rem; row-gap: 0; }
	}
</style>
