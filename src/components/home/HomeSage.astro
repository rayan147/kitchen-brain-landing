---
/**
 * Sage (canvas S6). Words from src/lib/sage.ts, so the draft kinds and the
 * approval boundary stay the ones kitchen-brain ships (RC-49).
 *
 * Considered Strategy; not used because there is one band and one frame.
 */
import HomeBand from './HomeBand.astro';
import SectionHandoff from '../SectionHandoff.astro';
import SageIcon from '../SageIcon.astro';
import { sageGuide, sageShot } from '../../lib/home';
import { sageDraftKindsOr, sageStatusWord } from '../../lib/sage';
---
<HomeBand id="sage" tone="cream" labelledBy="sage-heading">
	<div class="sage-grid" data-home-sage>
		<div>
			<SageIcon size={44} context="homepage" />
			<p class="home-eyebrow mt-4">Sage, the kitchen assistant · {sageStatusWord}</p>
			<h2 id="sage-heading" class="home-h2">Ask what the wedding still owes. It shows you the record.</h2>
			<p class="home-body mt-4">It reads only your kitchen’s records and shows where each number came from. It can draft {sageDraftKindsOr}, and nothing changes until a manager or owner approves it.</p>
			<a href={sageGuide.href} class="home-guide">{sageGuide.label}</a>
		</div>
		<figure class="sage-figure">
			<img src={sageShot.src} alt={sageShot.alt} width={sageShot.width} height={sageShot.height} loading="lazy" decoding="async" class="home-shot" />
		</figure>
	</div>
	<SectionHandoff from="sage" class="home-handoff" />
</HomeBand>

<style>
	.sage-grid { display: grid; gap: 2.5rem; align-items: center; }
	.sage-figure { margin: 0; }
	@media (min-width: 64rem) { .sage-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 4rem; } }
</style>
