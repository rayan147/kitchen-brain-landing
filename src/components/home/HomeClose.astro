---
import { cta, demoCta, launchPlan } from '../../lib/site';

// Considered Composite; not used because the close is one fixed decision
// point with one primary action and a small set of supporting links.
---
<!-- story: docs/stories/homepage-mockup-2026-10.story.md -->
<section id="start" class="home-band home-band--cream close" aria-labelledby="start-heading" data-sticky-end>
  <div class="container-page close-grid" data-real-order-trial>
    <div class="close-copy">
      <p class="home-eyebrow">Your next quote</p>
      <h2 id="start-heading" class="home-h2">Cost your first dish before you quote the next job.</h2>
      <p class="home-body close-intro">For caterers and restaurants that cater. Start with one recipe, see your food cost before you send the price, and bring the rest of the event workflow with you when you’re ready.</p>
    </div>
    <div class="close-actions">
      <a href={cta.href} target={cta.target} rel={cta.rel} aria-label={cta.ariaLabel} class="btn-primary">{cta.label}</a>
      <a href={demoCta.href} aria-label={demoCta.ariaLabel} class="home-guide">{demoCta.label}</a>
      <p class="home-small close-terms"><strong>{launchPlan.trialDays} days free</strong>, then {launchPlan.displayPrice} {launchPlan.unit}. Unlimited crew. Card required to start; $0 charged today. Cancel in Settings.</p>
    </div>
    <div class="close-links">
      <a href="/faq">Questions about the trial?</a>
      <a href="/features">See everything it does, area by area</a>
    </div>
  </div>
</section>

<style>
  .close { padding-block: var(--spacing-section-tight); }
  .close-grid { display: grid; gap: 1.5rem 3rem; align-items: start; max-width: 92rem; }
  .close-copy { max-width: 49rem; }
  .close-copy .home-h2 { font-size: var(--text-display-hero); line-height: 1.05; }
  .close-intro { max-width: 48rem; margin-top: 1.15rem; }
  .close-actions { display: flex; flex-direction: column; align-items: stretch; }
  .close-actions .btn-primary { width: 100%; max-width: 100%; justify-content: center; padding-inline: 1rem; text-align: center; white-space: normal; }
  .close-actions .home-guide { align-self: center; margin-top: .65rem; }
  .close-terms { margin-top: 1rem; }
  .close-links { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; }
  .close-links a { display: inline-flex; align-items: center; min-height: 2.75rem; color: var(--color-green-deep); font-size: var(--text-body); text-decoration: underline; text-underline-offset: 4px; }
  @media (min-width: 64rem) {
    .close-grid { grid-template-columns: minmax(0, 1fr) minmax(18rem, 28rem); column-gap: clamp(3rem, 5vw, 6rem); }
    .close-copy { grid-column: 1; grid-row: 1; }
    .close-links { grid-column: 1; grid-row: 2; margin-top: -.75rem; }
    .close-actions { grid-column: 2; grid-row: 1 / span 2; align-self: stretch; padding-left: clamp(2rem, 4vw, 4rem); border-left: 1px solid var(--color-ticket-rule); }
  }
</style>
