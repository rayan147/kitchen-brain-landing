---
/**
 * Sage's shared mark: a question enters on the left as a leaf-shaped prompt,
 * then resolves into the evidence lines on the right. It uses the same
 * single-colour, round-ended line language as CostCook's feature marks and
 * remains legible in print.
 *
 * Every current use sits beside visible Sage text, so the icon is decorative.
 * `context` is a build-time regression hook, not an accessible name.
 *
 * Considered Flyweight; not used because Astro emits this small static SVG at
 * build time, with no runtime object pool or shared state to manage.
 */
interface Props {
	size?: number;
	class?: string;
	context: 'navigation' | 'homepage' | 'specialist' | 'feature-area' | 'comparison' | 'faq' | 'tour';
}

const { size = 24, class: className = '', context } = Astro.props;
---

<!-- story: docs/stories/sage.story.md -->
<svg
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	class={className}
	data-sage-icon={context}
>
	<path d="M5.25 4.5h13.5a2 2 0 0 1 2 2v8.25a2 2 0 0 1-2 2h-7.4L7 20v-3.25H5.25a2 2 0 0 1-2-2V6.5a2 2 0 0 1 2-2Z" />
	<path d="M6.75 12.65c.35-3.2 2.15-5 5.35-5.4-.4 3.15-2.2 5-5.35 5.4Z" />
	<path d="m6.85 12.55 3.55-3.5M14.15 8.75h2.9M13.65 12h3.4" />
</svg>
