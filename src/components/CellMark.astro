---
interface Props {
	status: 'yes' | 'coming' | 'no';
	/** Set on the mobile card path, where the cell has no column header above it. */
	class?: string;
}
const { status, class: extra = '' } = Astro.props;

// The CostCook cell on /compare: a hairline mark and the word, together.
//
// THE MARK NEVER TRAVELS. It may render in the CostCook column and nowhere
// else, and check-landing-claims enforces that. A competitor cell is a STRING
// that reports what their own pricing page said on a date; a glyph beside
// "Not listed" would round that hedge into a verdict about another company's
// product, which is the one thing RC-40 forbids. The columns look asymmetric
// on purpose. The asymmetry is the honesty, and the pull to tidy it up is the
// failure mode to resist.
//
// NEVER THE MARK ALONE. The word carries the meaning and the glyph is
// aria-hidden, so nothing here depends on colour, on shape recognition, or on
// a legend the reader scrolled past four groups ago.
//
// Drawn, not borrowed: a check, a dashed ring (the ticket motif at 12px), and
// a rule. Twelve-square with intrinsic width and height, per check-dist.
const marks = {
	yes: { label: 'Yes', tone: 'text-green-deep' },
	coming: { label: 'Coming', tone: 'text-amber-deep' },
	no: { label: 'No', tone: 'text-ink-soft' }
} as const;
const mark = marks[status];
---

<span class:list={['inline-flex items-baseline gap-2', extra]}>
	<span class:list={['inline-flex w-3 shrink-0 translate-y-px justify-center', mark.tone]}>
		{
			status === 'yes' && (
				<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
					<path d="M1.5 6.4L4.4 9.2L10.5 2.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
			)
		}
		{
			status === 'coming' && (
				<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
					<circle cx="6" cy="6" r="4.6" stroke="currentColor" stroke-width="1.4" stroke-dasharray="2.1 2.1" stroke-linecap="round" />
				</svg>
			)
		}
		{
			status === 'no' && (
				<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
					<path d="M2 6H10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
				</svg>
			)
		}
	</span>
	<span class:list={[status === 'no' ? 'text-ink-soft' : 'font-semibold']}>{mark.label}</span>
</span>
