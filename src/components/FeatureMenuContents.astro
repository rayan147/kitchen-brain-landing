---
import { featureMenuHref, featureMenuSections } from '../lib/features';
import { featuresMenu } from '../lib/site';
import SageIcon from './SageIcon.astro';

type Props = {
	path: string;
	idPrefix: string;
};

const { path, idPrefix } = Astro.props;

// Considered Composite; not used because this is one fixed two-level feature
// tree rendered by a shared Astro component. Recursive node objects would add
// indirection without introducing another kind of branch or leaf.
---

<div class="grid lg:grid-cols-2">
	{
		featureMenuSections.map((section, sectionIndex) => (
			<section
				aria-labelledby={`${idPrefix}-section-${sectionIndex}`}
				class:list={[
					'p-2 sm:p-4',
					sectionIndex > 0 && 'border-t border-ticket-rule lg:border-t-0 lg:border-l'
				]}
			>
				<p id={`${idPrefix}-section-${sectionIndex}`} class="px-2 pt-1 pb-2 text-sm font-semibold text-ink sm:px-3">
					{section.label}
				</p>
				<ul role="list">
					{section.items.map((item) => (
						<li>
							<a
								href={featureMenuHref(item.featureId, item.coming === true)}
								aria-current={path === featureMenuHref(item.featureId, item.coming === true) ? 'page' : undefined}
								class="grid min-h-11 grid-cols-[1.25rem_minmax(0,1fr)] gap-2 rounded-md px-2 py-2.5 transition-colors duration-150 hover:bg-cream sm:gap-3 sm:px-3"
							>
								{item.icon === 'sage' ? (
									<SageIcon size={20} context="navigation" class="mt-0.5 text-amber-deep" />
								) : (
									<svg
										width="20"
										height="20"
										viewBox="0 0 20 20"
										fill="none"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linecap="round"
										stroke-linejoin="round"
										class="mt-0.5 text-amber-deep"
										aria-hidden="true"
									>
										<use href={`#feature-menu-${item.icon}`} />
									</svg>
								)}
								<span class="min-w-0">
									<span class="flex flex-wrap items-baseline gap-x-2 text-sm font-semibold text-ink">
										{item.label}
										{item.coming && (
											<span class="inline-flex items-center rounded-full border border-ticket-rule bg-softamber px-1.5 py-0.5 font-mono text-xs font-semibold tracking-wide text-amber-deep sm:px-2">
												Coming
											</span>
										)}
									</span>
									<span class="mt-0.5 block text-xs leading-snug text-ink-soft">{item.description}</span>
								</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		))
	}
</div>

<div class="flex flex-wrap items-center justify-between gap-x-6 border-t border-ticket-rule bg-cream px-3 py-2.5 sm:px-6">
	<div class="flex flex-wrap items-center gap-x-6">
		<a
			href={featuresMenu.tourHref}
			aria-current={path === featuresMenu.tourHref ? 'page' : undefined}
			class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-green-deep underline decoration-ticket-rule underline-offset-4 transition-colors duration-150 hover:decoration-green"
		>
			{featuresMenu.tourLabel}
			<svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
				<path d="M1 5h11M8 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
		</a>
		<a href={featuresMenu.href} class="inline-flex min-h-11 items-center text-sm font-semibold text-ink-soft underline decoration-ticket-rule underline-offset-4 hover:text-ink">
			{featuresMenu.overviewLabel}
		</a>
	</div>
	<p class="text-xs text-ink-soft">Every line is shipped unless it is marked Coming.</p>
</div>
