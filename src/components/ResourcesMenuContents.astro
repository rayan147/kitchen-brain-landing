---
import { resourcesMenu } from '../lib/site';

type Props = {
	path: string;
};

const { path } = Astro.props;

// Considered Composite; not used because these are three fixed groups of leaf
// destinations. The variation is flat navigation data, not a recursive tree.


---

<!-- story: docs/stories/resources-navigation.story.md -->
<div class="grid lg:grid-cols-3">
	{resourcesMenu.groups.map((group, groupIndex) => (
		<section
			aria-labelledby={`resources-menu-group-${groupIndex}`}
			class:list={[
				'p-3 sm:p-4',
				groupIndex > 0 && 'border-t border-ticket-rule lg:border-t-0 lg:border-l'
			]}
		>
			<p id={`resources-menu-group-${groupIndex}`} class="px-3 pt-1 pb-2 text-sm font-semibold text-ink">{group}</p>
			<ul role="list">
				{resourcesMenu.items.filter((item) => item.group === group).map((item) => (
					<li>
						<a
							href={item.href}
							aria-current={path === item.href ? 'page' : undefined}
							class="grid min-h-11 grid-cols-[1.25rem_minmax(0,1fr)] gap-3 rounded-md px-3 py-2.5 transition-colors duration-150 hover:bg-cream"
						>
							<svg
								width="20"
								height="20"
								viewBox="0 0 20 20"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="mt-0.5 text-amber-deep"
								aria-hidden="true"
							>
								<use href={`#resource-menu-${item.icon}`} />
							</svg>
							<span class="min-w-0">
								<span class="block text-sm font-semibold leading-snug text-ink">{item.label}</span>
								<span class="mt-1 block text-xs leading-snug text-ink-soft">{item.description}</span>
							</span>
						</a>
					</li>
				))}
			</ul>
		</section>
	))}
</div>

<div class="border-t border-ticket-rule bg-cream px-6 py-4">
	<!-- Describe the decision instead of making the reader interpret a path count. -->
	<p class="text-xs text-ink-soft">Choose a guide, check the limits, or ask Rayan.</p>
</div>
