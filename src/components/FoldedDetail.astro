---
// Pattern: Decorator. Why: supporting evidence needs one native disclosure
// wrapper across homepage sections. Alternative rejected: repeating custom
// breakpoint state in every section, which overwrites the reader's choice.
interface Props { summary: string; hint: string; }
const { summary, hint } = Astro.props;
---
<!-- story: docs/stories/homepage-caterer-fixes.story.md -->
<details class="folded-detail" data-folded-detail>
  <summary class="folded-summary"><span><strong>{summary}</strong><small>{hint}</small></span>
    <span class="folded-chevron" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M5 8l5 5 5-5" /></svg></span>
  </summary>
  <slot />
</details>
<style>
	.folded-summary {
		display: flex;
		gap: 1.5rem;
		align-items: center;
		justify-content: space-between;
		min-height: 44px;
		margin-top: 2rem;
		padding-block: 0.85rem;
		border-block: 1px solid var(--color-hairline-strong);
		cursor: pointer;
		list-style: none;
	}

	.folded-summary::-webkit-details-marker {
		display: none;
	}

	.folded-summary strong {
		display: block;
		color: var(--color-green-deep);
		font-size: var(--text-body-sm);
		font-weight: 700;
	}

	.folded-summary small {
		display: block;
		margin-top: 0.15rem;
		color: var(--color-ink-soft);
		font-size: var(--text-caption);
	}

	.folded-summary:focus-visible {
		outline: 2px solid var(--color-green);
		outline-offset: 4px;
	}

	.folded-chevron {
		display: grid;
		flex: none;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border: 1px solid var(--color-hairline-strong);
		border-radius: 999px;
		color: var(--color-green-deep);
	}

	.folded-chevron svg {
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
		/* Transform only, and it is inert under reduced motion. Principle 3. */
		transition: transform 160ms ease-out;
	}

	.folded-detail[open] .folded-chevron svg {
		transform: rotate(180deg);
	}

	@media (prefers-reduced-motion: reduce) {
		.folded-chevron svg {
			transition: none;
		}
	}

</style>
