---
// CostCook logo lockup: inline icon (crisp at any size) + wordmark set
// live in Fraunces so it stays text for a11y/SEO. Icon geometry mirrors
// public/brand/costcook-icon.svg.
import { site } from '../lib/site';

// Considered Decorator; not used because link and inert rendering differ only
// by native semantics and target size, not stackable responsibilities.

type Props = {
	/** Render as a link (nav) or inert mark (footer). */
	href?: string;
	/** Icon box size; wordmark scales with the parent's font-size. */
	iconClass?: string;
	/**
	 * `header`: the site header's mark, 20px wordmark on phones and 24px from
	 * sm (icon 1.375em, so about 28px and 33px tall). Logo guidance puts a
	 * header mark at 24-32px on phones and 28-40px on desktop; at 18px it
	 * read smaller than the nav links' row (owner, 2026-10-07).
	 */
	size?: 'default' | 'header';
};
const { href, iconClass = 'size-[1.375em]', size = 'default' } = Astro.props;
const Tag = href ? 'a' : 'p';
---

<Tag {href} class:list={['flex items-center gap-1.5 font-display font-semibold whitespace-nowrap', size === 'header' ? 'text-xl sm:text-2xl' : 'text-lg', href && 'min-h-11']}>
	<!-- width/height: intrinsic fallback (1.375em at text-lg ≈ 25px) so the
	     icon can never paint at container width before the stylesheet
	     applies (issue #54). The class overrides them once CSS is live. -->
	<svg viewBox="0 0 64 64" width="25" height="25" fill="none" class={iconClass} aria-hidden="true">
		<!-- Considered Flyweight; not used because one static mark needs no runtime object cache. -->
		<path fill="#2F7D5B" fill-rule="evenodd" d="M49.6 30.1 Q47 24 44 22 L59 11 A6 6 0 0 0 50.5 2.5 L36 17 A23 23 0 1 0 49.6 45.9 L40.2 42.5 A13 13 0 1 1 40.2 33.5 Z M56.8 6.8 A1.8 1.8 0 1 1 53.2 6.8 A1.8 1.8 0 1 1 56.8 6.8 Z" />
	</svg>
	{site.name}
</Tag>
