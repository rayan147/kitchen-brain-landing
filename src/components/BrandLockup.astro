---
// CostCook logo lockup: inline icon (crisp at any size) + wordmark set
// live in Fraunces so it stays text for a11y/SEO. Icon geometry mirrors
// public/brand/costcook-icon.svg.
import { site } from '../lib/site';

// Considered Decorator; not used because link and inert rendering differ only
// by native semantics and target size, not stackable responsibilities.

type Props = {
	/** Render as a link (nav) or inert mark (footer). */
	href?: string;
	/** Icon box size; wordmark scales with the parent's font-size. */
	iconClass?: string;
};
const { href, iconClass = 'size-[1.375em]' } = Astro.props;
const Tag = href ? 'a' : 'p';
---

<Tag {href} class:list={['flex items-center gap-1.5 font-display text-lg font-semibold whitespace-nowrap', href && 'min-h-11']}>
	<!-- width/height: intrinsic fallback (1.375em at text-lg ≈ 25px) so the
	     icon can never paint at container width before the stylesheet
	     applies (issue #54). The class overrides them once CSS is live. -->
	<svg viewBox="0 0 64 64" width="25" height="25" fill="none" class={iconClass} aria-hidden="true">
		<path
			d="M 44.77 42.89 A 20 20 0 1 1 44.77 21.11"
			stroke="#2F7D5B"
			stroke-width="10.5"
			stroke-linecap="round"
		/>
		<rect x="40" y="28.5" width="21" height="7" rx="3.5" fill="#2F7D5B" />
		<rect x="22" y="26" width="12" height="12" rx="1.5" fill="#B9762A" transform="rotate(45 28 32)" />
	</svg>
	{site.name}
</Tag>
