---
/**
 * Phone-only bar carrying the primary action between the hero and the close.
 *
 * MEASURED 2026-10-07 at 390x844 (design review): keyed to the bottom of
 * #event-walk, the bar first showed at y=5,921, so the reader went through all
 * five rail steps, about 4,650px, with nothing to tap. It now appears once the
 * hero's own primary ([data-hero-cta]) has scrolled off the top, and hides
 * again once #start is in view, so exactly one primary is in reach from the
 * hero to the close. It never shows while the hero's button is on screen,
 * never over the close, and never above md.
 *
 * ONE ACTION, SAME WORDS. It renders cta.label from site.ts like every other
 * primary, so the page still opens, middles and closes on one action and the
 * claim check's F1 rule holds by construction.
 *
 * JS OFF: it stays hidden. It is a convenience duplicate of a link that exists
 * three times in the document, so hiding it costs a no-JS reader nothing
 * (principle 3 is about content, and this is not content).
 *
 * Considered Observer (a scroll-position store the bar and the header both
 * subscribe to); not used because there is exactly one subscriber. One
 * passive scroll listener, two rect reads, no store. (An IntersectionObserver
 * was the first cut and is wrong here: see the note in the script.)
 */
import { cta, launchPlan } from '../lib/site';
---

<div
	hidden
	data-sticky-cta
	class="fixed inset-x-0 bottom-0 z-30 border-t border-ticket-rule bg-cream/95 px-[clamp(1rem,4vw,1.5rem)] py-2.5 shadow-ticket backdrop-blur-sm md:hidden"
	style="padding-bottom: max(0.625rem, env(safe-area-inset-bottom))"
>
	<div class="mx-auto flex max-w-lg items-center justify-between gap-3">
		<p class="text-sm leading-snug text-ink-soft">
			<strong class="font-semibold text-ink">{launchPlan.trialDays} days free.</strong> Charged $0 today.
		</p>
		<a
			href={cta.href}
			target={cta.target}
			rel={cta.rel}
			aria-label={cta.ariaLabel}
			class="btn-primary min-h-11 shrink-0 justify-center px-4 py-2.5 text-sm whitespace-nowrap"
		>
			{cta.label}
		</a>
	</div>
</div>

<script>
	const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
	const heroCta = document.querySelector<HTMLElement>('[data-hero-cta]');
	const start = document.getElementById('start');
	if (bar && heroCta && start) {
		// A scroll listener, not an IntersectionObserver. The observer only fires
		// on threshold crossings, so an anchor jump from above the demo to below
		// it (the hand-off links, the tour link, a deep link) skips the crossing
		// and the bar never shows. Two rect reads per frame is nothing.
		let queued = false;
		const update = () => {
			queued = false;
			const pastHeroCta = heroCta.getBoundingClientRect().bottom < 0;
			const reachedClose = start.getBoundingClientRect().top < window.innerHeight;
			bar.hidden = !(pastHeroCta && !reachedClose);
		};
		const schedule = () => {
			if (!queued) {
				queued = true;
				requestAnimationFrame(update);
			}
		};
		addEventListener('scroll', schedule, { passive: true });
		addEventListener('resize', schedule, { passive: true });
		update();
	}
</script>
