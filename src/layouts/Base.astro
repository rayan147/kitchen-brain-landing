---
// The opsz file carries wght + optical-size axes; the default index.css is
// wght-only and would silently flatten Fraunces' display character.
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/instrument-sans/index.css';
// Preload just the two latin subsets first paint uses: discovery is
// otherwise chained HTML → CSS → woff2, so the Fraunces H1 (the LCP)
// swaps in late. ?url resolves to the same hashed asset the CSS uses.
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import instrumentLatin from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../lib/site';

type Props = {
	title?: string;
	description?: string;
	/** Root-relative route ('/features') so canonical/og:url stay per-page. */
	path?: string;
	/** Optional surface contract emitted as the first body child for design review. */
	directionContract?: string;
	/**
	 * Paint the header band in the first section's tone so the two read as one
	 * surface (owner, 2026-10-07: the homepage hero is cream and the off-white
	 * header above it showed as a stripe). Cream is the default on every route
	 * (owner, 2026-10-07: "make the navbar sub route the same color as the home
	 * navbar"), so the bar is one colour across the site.
	 * Considered Strategy; not used because it is one optional color token.
	 */
	headerTone?: 'cream';
};

const {
	title = site.title,
	description = site.description,
	path = '/',
	directionContract,
	headerTone = 'cream'
} = Astro.props;
// Slash form so canonical/og:url agree byte-for-byte with the sitemap.
const canonical = new URL(path, site.url).href;
// stage.costcook.io builds the release branch with PUBLIC_NOINDEX=1 (the app
// repo's ADR 0010). Canonical already names costcook.io; this keeps the stage
// copy out of the index entirely.
const noindex = import.meta.env.PUBLIC_NOINDEX === '1';
const ogImage = new URL('/og.png', site.url).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={instrumentLatin} as="font" type="font/woff2" crossorigin />
		<!-- Cream, the header every route opens on: browsers tint their bar with
		     it, and gray-green flashed against the cream page (owner, 2026-10-07). -->
		<meta name="theme-color" content="#FAF5EA" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="CostCook: back-of-house software for caterers" />
		<meta name="twitter:card" content="summary_large_image" />

		<!-- Vercel Web Analytics is a deployment boundary. Loading its same-origin
		     endpoint during local development creates a misleading 404 in every
		     customer-journey rehearsal. -->
		{import.meta.env.PROD && <script defer src="/_vercel/insights/script.js" is:inline></script>}
	</head>
	<body>
		{directionContract && <Fragment set:html={`<!-- ${directionContract} -->`} />}
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-paper focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:shadow-lift"
		>
			Skip to content
		</a>
		<div class:list={{ 'bg-cream': headerTone === 'cream' }} data-header-tone={headerTone}>
			<SiteNav />
		</div>
		<!-- tabindex="-1": the skip link must move AT/keyboard focus here,
		     not just scroll (WCAG 2.4.1). No ring: arrival is the feedback. -->
		<main id="main" tabindex="-1" class="focus-visible:outline-none">
			<slot />
		</main>
		<SiteFooter />

		<script>
			// Scroll reveals. Hidden state is applied here, at runtime, and only
			// to elements still below the fold — so no-JS visitors and users
			// with reduced motion always see everything.
			const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
			const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (els.length > 0 && !reduced && 'IntersectionObserver' in window) {
				const io = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add('revealed');
								io.unobserve(entry.target);
							}
						}
					},
					{ rootMargin: '0px 0px -8% 0px', threshold: 0.1 }
				);
				// Only the next three screens are ever hidden. Deeper blocks stay
				// painted: a full-page capture (link previews, crawlers, screenshot
				// tools) never intersects anything, and with every block hidden
				// the page rendered as ten blank sections. The reveal is a first-
				// screens courtesy, not a page-long effect. 2026-08-29.
				const revealFloor = window.innerHeight * 3;
				for (const el of els) {
					// >= innerHeight: anything even partially painted must never
					// be hidden (reviewers: a visible sliver in the 0.9–1.0 band
					// would blink out and, outside the -8% root, stay hidden).
					const top = el.getBoundingClientRect().top;
					if (top >= window.innerHeight && top < revealFloor) {
						el.classList.add('reveal-pending');
						io.observe(el);
					}
				}
			}
		</script>

		<script>
			// Screenshot frames (.shot-pan, global.css) are a named, focusable
			// region only while they scroll: a phone, or a tablet with a wide
			// capture. On a desktop the capture fits and the frame was a dead tab
			// stop with a name about scrolling (accessibility review 2026-10-09).
			// The HTML ships every frame focusable, so without JavaScript each one
			// can still be scrolled from the keyboard.
			// Pattern: Observer. Why: a frame's scroll state changes with the
			// viewport and with the capture's load, and one ResizeObserver hears
			// both. Alternative rejected: a resize listener, which misses a lazy
			// image arriving after the first layout.
			// [data-pan] puts any other sideways scroller (the tour's tables, the
			// pack comparison on a phone) through the same treatment, with its
			// own hint in data-pan-hint (mobile review 2026-10-09: neither was
			// focusable or said that it scrolls).
			const pans = document.querySelectorAll<HTMLElement>('.shot-pan, [data-pan]');
			if (pans.length > 0 && 'ResizeObserver' in window) {
				const sync = (pan: HTMLElement) => {
					const label = pan.dataset.panLabel ?? pan.getAttribute('aria-label') ?? '';
					pan.dataset.panLabel = label;
					const hint = pan.nextElementSibling?.classList.contains('pan-hint') ? pan.nextElementSibling : null;
					if (pan.scrollWidth > pan.clientWidth + 1) {
						pan.setAttribute('tabindex', '0');
						pan.setAttribute('role', 'region');
						if (label) pan.setAttribute('aria-label', label);
						// A touch scrollbar is invisible, so the frame says it
						// scrolls (design review 2026-10-09). Hidden from AT: the
						// region itself is focusable and scrolls by keyboard.
						if (!hint) {
							const p = document.createElement('p');
							p.className = 'pan-hint';
							p.setAttribute('aria-hidden', 'true');
							p.textContent = pan.dataset.panHint ?? 'Scroll sideways to see the whole screen.';
							pan.after(p);
						}
					} else {
						pan.removeAttribute('tabindex');
						pan.removeAttribute('role');
						pan.removeAttribute('aria-label');
						hint?.remove();
					}
				};
				const ro = new ResizeObserver((entries) => {
					for (const entry of entries) {
						const pan = (entry.target as HTMLElement).closest<HTMLElement>('.shot-pan, [data-pan]');
						if (pan) sync(pan);
					}
				});
				for (const pan of pans) {
					sync(pan);
					ro.observe(pan);
					const content = pan.querySelector('img, table');
					if (content) ro.observe(content);
				}
			}
		</script>
	</body>
</html>

<style is:global>
	/* The cream header runs straight into the page's opening, so the bar and
	   the opening read as one surface on every route, as on the homepage
	   (owner, 2026-10-07). Only the opening is cream: the rest of the page
	   stays on the body's off-white so tickets keep their figure/ground
	   (design review 2026-10-07: whole-page cream flattened .fd-ticket, the
	   events phone and the softamber notes). The opening is
	   - the first section, when the page is a run of sections;
	   - the wrapper's first section, when an <article>/<div> wraps the page;
	   - an element marked [data-opening], when one long section is the page
	     (/compare, /pricing): its intro takes the cream instead.
	   :nth-child(1 of :not(script)) skips leading JSON-LD (/faq, posts).
	   Considered a data-opening attribute on every route; not used because
	   the structural rule already finds 30 openings and new routes inherit it. */
	[data-header-tone='cream'] + #main > section:nth-child(1 of :not(script)):not(:has([data-opening])),
	[data-header-tone='cream'] + #main > :is(article, div):nth-child(1 of :not(script)) > :nth-child(1 of :not(script)),
	[data-header-tone='cream'] + #main [data-opening] {
		background-color: var(--color-cream);
		/* Full bleed even inside the 72rem container (/contact, /pricing). */
		box-shadow: 0 0 0 100vmax var(--color-cream);
		clip-path: inset(0 -100vmax);
		/* No hairline between the bar and the opening: heroes' border-block
		   drew a rule under the navbar the homepage doesn't have (owner,
		   2026-10-07). The bottom rule still closes the hero. */
		border-top-width: 0;
	}
	/* A marked intro sits inside its section's top padding: run the cream up
	   through that padding to the bar, and give the intro room to end. */
	[data-header-tone='cream'] + #main [data-opening] {
		clip-path: inset(-100vmax -100vmax 0);
		padding-bottom: clamp(2rem, 4vw, 3rem);
	}
</style>
