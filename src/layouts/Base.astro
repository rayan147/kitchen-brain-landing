---
// The opsz file carries wght + optical-size axes; the default index.css is
// wght-only and would silently flatten Fraunces' display character.
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/instrument-sans/index.css';
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../lib/site';

type Props = {
	title?: string;
	description?: string;
};

const { title = site.name, description = site.description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<!-- noindex until launch — removed by the SEO issue -->
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-paper focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:shadow-lift"
		>
			Skip to content
		</a>
		<SiteNav />
		<main id="main">
			<slot />
		</main>
		<SiteFooter />

		<script>
			// Scroll reveals. Hidden state is applied here, at runtime, and only
			// to elements still below the fold — so no-JS visitors and users
			// with reduced motion always see everything.
			const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
			const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (els.length > 0 && !reduced && 'IntersectionObserver' in window) {
				const io = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add('revealed');
								io.unobserve(entry.target);
							}
						}
					},
					{ rootMargin: '0px 0px -8% 0px', threshold: 0.1 }
				);
				for (const el of els) {
					// >= innerHeight: anything even partially painted must never
					// be hidden (reviewers: a visible sliver in the 0.9–1.0 band
					// would blink out and, outside the -8% root, stay hidden).
					if (el.getBoundingClientRect().top >= window.innerHeight) {
						el.classList.add('reveal-pending');
						io.observe(el);
					}
				}
			}
		</script>
	</body>
</html>
