---
// The opsz file carries wght + optical-size axes; the default index.css is
// wght-only and would silently flatten Fraunces' display character.
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/instrument-sans/index.css';
// Preload just the two latin subsets first paint uses: discovery is
// otherwise chained HTML → CSS → woff2, so the Fraunces H1 (the LCP)
// swaps in late. ?url resolves to the same hashed asset the CSS uses.
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import instrumentLatin from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../lib/site';

type Props = {
	title?: string;
	description?: string;
	/** Root-relative route ('/features') so canonical/og:url stay per-page. */
	path?: string;
	/** Optional surface contract emitted as the first body child for design review. */
	directionContract?: string;
};

const {
	title = site.title,
	description = site.description,
	path = '/',
	directionContract
} = Astro.props;
// Slash form so canonical/og:url agree byte-for-byte with the sitemap.
const canonical = new URL(path, site.url).href;
const ogImage = new URL('/og.png', site.url).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={instrumentLatin} as="font" type="font/woff2" crossorigin />
		<meta name="theme-color" content="#F4F6F4" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="CostCook: back-of-house software for caterers" />
		<meta name="twitter:card" content="summary_large_image" />

		<!-- Vercel Web Analytics (cookieless). TODO(owner): flip on
		     Analytics in the Vercel dashboard — until then this script 404s
		     harmlessly. Same-origin, so the CSP needs no new hosts. -->
		<script defer src="/_vercel/insights/script.js" is:inline></script>
	</head>
	<body>
		{directionContract && <Fragment set:html={`<!-- ${directionContract} -->`} />}
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-paper focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:shadow-lift"
		>
			Skip to content
		</a>
		<SiteNav />
		<!-- tabindex="-1": the skip link must move AT/keyboard focus here,
		     not just scroll (WCAG 2.4.1). No ring: arrival is the feedback. -->
		<main id="main" tabindex="-1" class="focus-visible:outline-none">
			<slot />
		</main>
		<SiteFooter />

		<script>
			// Scroll reveals. Hidden state is applied here, at runtime, and only
			// to elements still below the fold — so no-JS visitors and users
			// with reduced motion always see everything.
			const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
			const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (els.length > 0 && !reduced && 'IntersectionObserver' in window) {
				const io = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add('revealed');
								io.unobserve(entry.target);
							}
						}
					},
					{ rootMargin: '0px 0px -8% 0px', threshold: 0.1 }
				);
				for (const el of els) {
					// >= innerHeight: anything even partially painted must never
					// be hidden (reviewers: a visible sliver in the 0.9–1.0 band
					// would blink out and, outside the -8% root, stay hidden).
					if (el.getBoundingClientRect().top >= window.innerHeight) {
						el.classList.add('reveal-pending');
						io.observe(el);
					}
				}
			}
		</script>
	</body>
</html>
