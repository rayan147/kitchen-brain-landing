---
import Base from '../layouts/Base.astro';
import OnboardingPage from '../components/sections/OnboardingPage.astro';

// Considered Template Method; not used because this route shares the existing
// Base shell and its setup argument is one fixed composition, not a page
// algorithm with overridable steps.
const directionContract = [
	'THESIS: Setup asks for one dish you already cook, not the whole walk-in, and its ingredients can arrive as paperwork instead of typing; the duration is the owner-confirmed approximation of RC-10 and may not be hardened.',
	'OWN-WORLD: CostCook Kitchen Ticket paper, cream and offwhite fields, ink type, amber eyebrows and dashed rules, green actions.',
	'STORY: Data-entry dread becomes one invoice and one recipe uploaded and confirmed, five stages met as scenes with the app’s own screens beside them, a checkable $1.62, then the two questions the old page left open: what next (the shopping list, Today), and how the rest of the menu and the crew get in (upload then confirm, a one-time link, Staff).',
	'FIRST VIEWPORT: The refusal of the wall at left; the five-stage setup ticket at right.',
	'FORM: Code-led editorial route; initial-setup-guide; three numbered parts under one settling setup ticket that doubles as the page map; Part 1 is a have-ready ticket beside the welcome screen; Part 2 is five scenes, one paragraph and one real screen each, never a list of taps, and never assumes the reader knows the app.',
	'FINISH: Navigation, no-JS, reduced motion, keyboard, 200% text, desktop, mobile, claim guard, build, and documentation all close.'
].join(' ');
---

<Base
	title="Your initial setup in CostCook | One dish, then the rest of your kitchen"
	description="Setup asks for one dish you already cook, not your whole walk-in. See the five stages, the plate cost they end on, what the app offers next, and how your crew gets in."
	path="/onboarding"
	directionContract={directionContract}
>
	<OnboardingPage />
</Base>
