---
import Base from '../layouts/Base.astro';
import { comparison, competitors, costcookNo, NOT_LISTED, VERIFIED_ON } from '../lib/comparison';
import { spell } from '../lib/words';
import CellMark from '../components/CellMark.astro';
import { cta, demoCta, launchPlan } from '../lib/site';
import { comingDefinition } from '../lib/availability';
import ComparisonCapabilityLabel from '../components/ComparisonCapabilityLabel.astro';

const costcookLimits = comparison.flatMap((group) =>
	group.rows.filter((row) => row.costcook === 'no').map((row) => row.label)
);

// The comparison page. Approved as RC-40; the ledger otherwise forbids naming
// a competitor at all. Read src/lib/comparison.ts before touching any cell:
// the rule that keeps this page honest is that a competitor cell reports what
// THEIR pricing page said on a date, never what their product can or cannot do.
//
// THE PAGE IS NOT ALLOWED TO WIN EVERY ROW. The remaining No rows stay in
// the task area where a reader expects to find them rather than being buried at
// the bottom. A table that ticks all the way down is read as marketing by
// exactly the reader this page is for, and every claim here has to survive a
// 15-minute demo call.
//
// ONE PRIMARY, RENDERING cta.label VERBATIM, at the close only. The quiet
// secondary is the demo link. Same rules as the homepage.
// Three of the four legend rows carry the mark that appears in the table. The
// fourth deliberately does NOT: "Not listed" is a competitor cell, and giving
// it a glyph would teach a reader to take it as a verdict on their product
// rather than as the hedge it is. Four rows, three marks. See CellMark.astro.
const legend = [
	['yes', 'It ships in the CostCook you would start today.'],
	['coming', comingDefinition],
	['no', 'CostCook does not do this.'],
	[null, 'Not named on their own pricing page on the date below. It does not mean their product cannot do it.']
] as const;
---

<!-- story: docs/stories/compare.story.md -->
<Base
	title="Compare CostCook, Parsley, and meez"
	description="A dated, tier-by-tier look at what CostCook ships and what Parsley and meez list on their pricing pages."
	path="/compare"
>
	<section class="container-page py-section" aria-labelledby="compare-title">
		<div class="max-w-3xl">
			<h1 id="compare-title" class="text-display font-semibold">
				Compare the work, not just the feature list.
			</h1>
			<p class="mt-5 max-w-[62ch] text-lede text-ink-soft">
				You are choosing what your kitchen can rely on when the guest count changes,
				the order goes out, and the delivery reaches the back door.
			</p>
			<p class="mt-5 max-w-[62ch] text-ink-soft">
				This page shows what CostCook ships, what it does not, and what Parsley and meez
				list on their pricing pages&mdash;at the monthly price that unlocks each row.
			</p>
		</div>

		<section class="mt-10 border-y border-ticket-rule py-8" aria-labelledby="fit-title">
			<h2 id="fit-title" class="text-h3 font-semibold">Start with the tradeoff</h2>
			<div class="mt-5 grid gap-8 md:grid-cols-2 md:gap-0">
				<div class="md:pr-10">
					<h3 class="text-base font-semibold font-body">CostCook fits the job when</h3>
					<p class="mt-3 max-w-[52ch] text-ink-soft">
						one kitchen needs recipes, food cost, prep, purchasing, receiving, and inventory
						to follow the same changing event. It is one {launchPlan.displayPrice} plan.
					</p>
				</div>
				<div class="border-t border-ticket-rule pt-8 md:border-t-0 md:border-l md:pt-0 md:pl-10">
					<h3 class="text-base font-semibold font-body">Keep comparing if you need</h3>
					<ul role="list" class="mt-3 grid gap-x-6 gap-y-2 text-sm text-ink-soft sm:grid-cols-2">
						{costcookLimits.map((limit) => (
							<li class="border-t border-hairline pt-2">{limit}</li>
						))}
					</ul>
					<p class="mt-4 text-sm text-ink-soft">
						All {spell(costcookNo)} are marked <span class="font-semibold text-ink">No</span> in the table.
					</p>
				</div>
			</div>
		</section>

		<!-- Three prices, one basis. meez leads with annual-prepay figures on
		     their own page; these are their monthly-billed ones, because
		     CostCook is billed monthly and comparing across bases would be the
		     first thing a careful reader caught. -->
		<section class="mt-10" aria-labelledby="monthly-price-title">
			<h2 id="monthly-price-title" class="text-h3 font-semibold">Monthly price on the cited pages</h2>
			<div class="mt-5 grid gap-6 border-y border-ticket-rule py-8 sm:grid-cols-3">
				<div>
					<p class="text-sm font-semibold text-amber-deep">CostCook</p>
					<p class="mt-2 text-h2 font-semibold">{launchPlan.displayPrice}</p>
					<p class="mt-2 text-sm text-ink-soft">One plan. Billed monthly, {launchPlan.trialDays} days free.</p>
				</div>
				{competitors.map((rival) => (
					<div>
						<p class="text-sm font-semibold text-ink-soft">{rival.name}</p>
						<p class="mt-2 text-h2 font-semibold">
							{rival.key === 'parsley' ? '$129 to $379' : '$24 to $199'}
						</p>
						<p class="mt-2 text-sm text-ink-soft">
							Four tiers, plus a quote-only top tier. {rival.basis}.
						</p>
					</div>
				))}
			</div>
		</section>

		<!-- The legend is page copy, not a footnote, because the meaning of a
		     "Not listed" cell is the one thing on this page that could become a
		     false statement about another company. -->
		<div class="mt-10 max-w-3xl">
			<h2 class="text-h3 font-semibold">Read each cell literally</h2>
			<dl class="mt-4 space-y-3 text-ink-soft">
				{legend.map(([status, meaning]) => (
					<div class="sm:flex sm:gap-4">
						<dt class="text-ink sm:w-36 sm:shrink-0">
							{status ? <CellMark status={status} /> : <span class="font-semibold">{NOT_LISTED}</span>}
						</dt>
						<dd class="max-w-[58ch]">{meaning}</dd>
					</div>
				))}
			</dl>
			<p class="mt-5">
				<!-- The one moving proof on the site. A reader deciding between three
				     products off a table has no way to see any of them run, and this
				     page had no link to the footage at all. -->
				<a href="/#demo" class="btn-quiet">Watch the 2:30 product tour</a>
			</p>
			<p class="mt-5 max-w-[58ch] text-ink-soft">
				Their columns were read from
				<a href={competitors[0].href} target="_blank" rel="noopener noreferrer" class="btn-quiet">Parsley&rsquo;s pricing page</a>
				and
				<a href={competitors[1].href} target="_blank" rel="noopener noreferrer" class="btn-quiet">meez&rsquo;s pricing page</a>
				on {VERIFIED_ON}. Prices and tiers move. If you find a row that is out of date,
				tell me and I will fix it.
			</p>
		</div>

		{comparison.map((group, i) => (
			<div class="mt-16 border-t border-ticket-rule pt-8">
				{/* The same "Area n of five" device as the /features hub, over the
				    same five titles. Five tables stacked with only a heading between
				    them read as one endless table, and a reader four groups down has
				    no way to tell how much of the board is left. */}
				<p class="eyebrow">Area {i + 1} of {comparison.length}</p>
				<h2 class="mt-3 text-h3 font-semibold">{group.title}</h2>

				{/* Below sm the table becomes one card per row: a four-column
				    price table at 390px shears the tier names, and a sheared
				    tier name is the one thing on this page that must not be
				    misread. */}
				<ul role="list" class="mt-5 space-y-5 sm:hidden">
					{group.rows.map((row) => (
						<li class="border-t border-hairline pt-4">
							<p><ComparisonCapabilityLabel label={row.label} icon={row.icon} /></p>
							{row.note && <p class="mt-1 text-sm text-ink-soft">{row.note}</p>}
							{/* flex-wrap, not flex. MEASURED at 390px with the root font forced
							    to 32px (200% text): the fixed w-24 label column plus a value
							    reached 410px in a 390px viewport and scrolled the whole page
							    sideways. Wrapping drops the value under its label instead.
							    The phone path carries the SAME marks as the table. It is the
							    one that gets forgotten in an edit, and it is the one most of
							    these readers will actually see. */}
							<dl class="mt-3 space-y-1 text-sm">
								<div class="flex flex-wrap gap-x-2 rounded-sm bg-cream px-2 py-1.5">
									<dt class="w-24 shrink-0 text-ink-soft">CostCook</dt>
									<dd><CellMark status={row.costcook} /></dd>
								</div>
								<div class="flex flex-wrap gap-x-2 px-2 pt-1">
									<dt class="w-24 shrink-0 text-ink-soft">Parsley</dt>
									<dd>{row.parsley}</dd>
								</div>
								<div class="flex flex-wrap gap-x-2 px-2">
									<dt class="w-24 shrink-0 text-ink-soft">meez</dt>
									<dd>{row.meez}</dd>
								</div>
							</dl>
						</li>
					))}
				</ul>

				<div class="mt-5 hidden overflow-x-auto sm:block">
					<table class="w-full border-collapse text-left">
						<caption class="sr-only">
							{group.title}: what CostCook does, against what Parsley and meez list on
							their pricing pages as of {VERIFIED_ON}.
						</caption>
						<thead>
							{/* The competitor headers repeat the hedge in every group. The
							    legend that defines "Not listed" sits at the top of the page,
							    and by group four the reader has scrolled past the only thing
							    that says what the word means. That is the one cell whose
							    meaning going fuzzy is an honesty problem rather than a polish
							    one, so the reminder rides along with it. */}
							<tr class="border-b border-ticket-rule align-bottom">
								<th scope="col" class="py-3 pr-4 font-semibold">Capability</th>
								<th scope="col" class="w-36 bg-cream px-3 py-3 font-semibold">CostCook</th>
								<th scope="col" class="w-48 py-3 pr-4 font-semibold">
									Parsley
									<span class="mt-1 block font-mono text-xs font-normal tracking-wide text-ink-soft">their pricing page</span>
								</th>
								<th scope="col" class="w-48 py-3 font-semibold">
									meez
									<span class="mt-1 block font-mono text-xs font-normal tracking-wide text-ink-soft">their pricing page</span>
								</th>
							</tr>
						</thead>
						<tbody>
							{group.rows.map((row) => (
								<tr class="border-b border-hairline align-top">
									<th scope="row" class="max-w-[34ch] py-4 pr-4 font-normal">
										<ComparisonCapabilityLabel label={row.label} icon={row.icon} />
										{row.note && <span class="mt-1 block text-sm font-normal text-ink-soft">{row.note}</span>}
									</th>
									{/* Tinted the whole way down: one anchor the eye can run
									    along across five separate tables. */}
									<td class="bg-cream px-3 py-4">
										<CellMark status={row.costcook} />
									</td>
									<td class="py-4 pr-4 text-ink-soft">{row.parsley}</td>
									<td class="py-4 text-ink-soft">{row.meez}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</div>
		))}

		<div class="mt-16 max-w-[62ch] border-t border-ticket-rule pt-8">
			<h2 class="text-h3 font-semibold">Four rules built for event work</h2>
			<p class="mt-4 text-ink-soft">
				These rules came from the places event kitchens lose trust when software smooths
				over uncertainty. They explain how the work behaves, not four more checkmarks.
			</p>
			<ul role="list" class="mt-5 space-y-4 text-ink-soft">
				<li>
					<span class="font-semibold text-ink">A confirmed quote stays confirmed.</span> Once
					you confirm an event, its plan and its costing freeze. Prices that move next
					week move the next quote, never the one you already gave someone.
				</li>
				<li>
					<span class="font-semibold text-ink">Receiving is the order you sent.</span> The
					checklist at the back door is the purchase order, and ticking it off is what
					writes the purchase and updates the price, so the delivery is not typed in a
					second time.
				</li>
				<li>
					<span class="font-semibold text-ink">A missing price stops the costing.</span> It
					does not quietly become zero and hand you a plate cost that is wrong by the
					price of the beef.
				</li>
				<li>
					<span class="font-semibold text-ink">The month says what it does not know.</span> What
					the month should have cost, against what you actually spent, with the gap
					between them named rather than blamed on waste.
				</li>
			</ul>
		</div>

		<div class="mt-14 border-t border-ticket-rule pt-8">
			<h2 class="text-h2 font-semibold">Bring one real menu. Leave with an answer.</h2>
			<p class="mt-4 max-w-[58ch] text-ink-soft">
				{launchPlan.trialDays} days free, then {launchPlan.displayPrice}. If a row marked
				No is the one you need, one of the others may be the better buy,
				and I would rather you knew that now than after a month. Start with the next
				menu you need to cost.
			</p>
			<div class="mt-7 flex flex-wrap items-center gap-5">
				<a href={cta.href} aria-label={cta.ariaLabel} class="btn-primary">{cta.label}</a>
				<a href={demoCta.href} target={demoCta.target} rel={demoCta.rel} aria-label={demoCta.ariaLabel} class="btn-quiet">
					Book 15 minutes
				</a>
			</div>
		</div>
	</section>
</Base>
