---
import Base from '../../layouts/Base.astro';
import NutritionFactsAllergensFeature from '../../components/sections/NutritionFactsAllergensFeature.astro';

// Considered Strategy; not used because this route is one deliberate editorial
// composition selected at build time, not a runtime-swappable layout family.
const directionContract = [
	'THESIS: One recipe carries two answers that must never outrun their evidence: nutrition facts and allergen review.',
	'OWN-WORLD: CostCook Kitchen Ticket paper, pale-green working fields, ink-heavy label rules, green reviewed states, restrained amber incomplete states and square evidence sheets.',
	'STORY: A meal-prep owner meets the Sunday-night split, follows nutrition sources and allergen evidence through two product chapters, inspects the printable sheet and its boundaries, then starts or books a demo.',
	'FIRST VIEWPORT: A shared-scale editorial statement sits left; one high-resolution, task-focused crop shows the Wild Mushroom Polenta draft nutrition result at reading size on the right, with a tighter art-directed crop on mobile.',
	'FORM: Code-led proof-label composition informed by preview exec-90664d26 as critique reference; authentic captures outrank generated imagery.',
	'FINISH: Unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md.'
].join(' ');
---

<Base
	title="Nutrition facts and allergen management software | CostCook"
	description="Match your ingredients to nutrient sources and review their allergen information. See per-portion nutrition, missing information and a printable estimate. Your kitchen still needs to review the food and its suitability for each guest."
	path="/features/nutrition-facts-and-allergens"
	directionContract={directionContract}
>
	<NutritionFactsAllergensFeature />
</Base>
