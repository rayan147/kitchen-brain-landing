---
import Base from '../../layouts/Base.astro';
import OrderShopPrepPackFeature from '../../components/sections/OrderShopPrepPackFeature.astro';

// Considered Template Method; not used because the dedicated feature pages
// share a visual system, while their evidence scenes and reading sequences are
// deliberately different rather than overridable steps in one algorithm.
const directionContract = [
	'THESIS: One confirmed event should become three working lists without becoming three versions of the truth; refuse the generic task dashboard and feature-card catalogue.',
	'OWN-WORLD: CostCook Kitchen Ticket paper, cream and soft-green fields, ink type, amber attention states, square production sheets, green actions.',
	'STORY: The chef-owner confirms one event, shops from its buy math, moves through frozen prep work, finds one open pack line, resolves change states, then starts or books a demo.',
	'FIRST VIEWPORT: Editorial statement at left; an illustrative 80-guest ticket at right shows Shop 12/12, Prep 7/7, and Pack 7/8 with one hotel pan open and both actions visible.',
	'FORM: Code-led editorial split extending the approved Recipes & Costing surface; seed key order-shop-prep-pack-handoff.',
	'FINISH: The frozen source, three stage states, open pack line, and recovery path remain explicit across desktop, mobile, reduced-motion, and no-JavaScript states.'
].join(' ');
---

<Base
	title="Catering orders, shopping, prep and packing | CostCook"
	description="Turn one confirmed menu and guest count into the shopping, prep, and pack work for the day, with the frozen event plan behind every check."
	path="/features/order-shop-prep-pack"
	directionContract={directionContract}
>
	<OrderShopPrepPackFeature />
</Base>
