---
import Base from '../layouts/Base.astro';
import { contactCta, cta, demoCta, launchPlan } from '../lib/site';
import { inDevelopmentFeatureGroups } from '../lib/features';
import { spellCapital } from '../lib/words';
import { comingDefinition } from '../lib/availability';
import { labelsAvailability } from '../lib/labels';
import { orderingAvailability } from '../lib/ordering';
import { comingPlanList } from '../lib/coming-plans';

// Included at launch, 2026-09-27 (gap report S11). One plan, no tier gating
// (inventory plan_matrix). Labels and online ordering read their status files,
// so a status flip back to Coming drops them here instead of leaving pricing
// promising them. The events line names the deposit boundary because card
// payment for events is a Coming plan, not part of this price.
// Considered Strategy; not used because this is a static list with two
// status-read entries, not interchangeable behavior.
const included = [
	'Events and proposals, with the deposit recorded by hand',
	'Clients and the calendar',
	'Recipe and menu costing',
	'Orders, shopping, prep, and pack plans',
	'Purchasing, receiving, and inventory',
	'Analytics',
	...(labelsAvailability.isComing ? [] : ['Kitchen labels']),
	...(orderingAvailability.isComing ? [] : ['Online ordering']),
	'Unlimited teammates'
];

// The in-development cards are read from features.ts, not typed here. They
// used to be two hand-written articles (labels, ordering) and there are now
// every current group; a page that quotes a price while naming half of what is NOT in
// it is the wrong half to get wrong. One source, one status word, everywhere.
---
<!-- story: docs/stories/homepage-caterer-fixes.story.md -->

<!-- story: docs/stories/features-navigation.story.md -->

<Base
	title="CostCook pricing for catering kitchens"
	description="One CostCook launch plan per kitchen, with unlimited teammates."
	path="/pricing"
>
	<section class="container-page py-section" aria-labelledby="pricing-title">
		<div class="max-w-3xl" data-opening>
			<p class="eyebrow">Priced by the kitchen</p>
			<h1 id="pricing-title" class="mt-4 text-display font-semibold">One price for the kitchen, however big the crew.</h1>
			<p class="mt-5 max-w-[62ch] text-lede text-ink-soft">You pay for the kitchen, not for each cook in it, and there is no cap on the crew. The verified owner handles billing and sends the invites.</p>
		</div>

		<div id="launch-terms" class="mt-10 grid grid-cols-1 gap-8 border-y border-ticket-rule py-8 lg:grid-cols-[7fr_5fr]">
			<div>
				<p class="text-sm font-semibold text-amber-deep">CostCook Launch</p>
				<p class="mt-2 text-h2 font-semibold">{launchPlan.displayPrice}</p>
                <p class="mt-3 max-w-[54ch] text-ink-soft">{launchPlan.crewTerms}</p>
				<p class="mt-3 max-w-[54ch] text-ink-soft">The first {launchPlan.trialDays} days are free. Stripe takes your card, charges $0 today, and starts billing you monthly when the trial ends unless you cancel.</p>
				<!-- The launch price is introductory and the page used to be silent about
				     it, which left a reader unable to tell whether $49 was the price or a
				     promotion. It says both halves now: it will rise, and it will not rise
				     under anyone already on it. The second half is a commitment, not copy.
				     If it ever stops being true, this paragraph comes off the page first. -->
				<p class="mt-4 max-w-[54ch] text-ink-soft">
					{launchPlan.displayPrice} is the launch price and it will not stay there. When it
					moves it moves for kitchens that sign up after, never for yours. The price you
					start on is the price you keep.
				</p>
				<a href={cta.href} aria-label={cta.ariaLabel} class="btn-primary mt-7">{cta.label}</a>
			</div>
			<div>
				<h2 class="text-h3 font-semibold">Included at launch</h2>
				<ul role="list" class="mt-4 space-y-3 text-ink-soft">
					{included.map((item) => <li>{item}</li>)}
				</ul>
			</div>
		</div>

		<div class="mt-12">
			<h2 class="text-h3 font-semibold">Coming, and not in this price.</h2>
			<p class="mt-3 max-w-[62ch] text-ink-soft">
				{spellCapital(inDevelopmentFeatureGroups.length)} feature groups contain work marked Coming. {comingDefinition}
			</p>
			<div class="mt-6 grid gap-6 sm:grid-cols-2">
				{inDevelopmentFeatureGroups.map((group) => (
					<article class="border-t border-hairline pt-5">
						<div class="flex flex-wrap items-baseline gap-x-3 gap-y-2">
							<p class="eyebrow">{group.kicker}</p>
							<span class="inline-flex items-center rounded-full border border-ticket-rule bg-softamber px-2.5 py-0.5 font-mono text-xs font-semibold tracking-wide text-amber-deep">
								Coming
							</span>
						</div>
						<h3 class="mt-2 text-h3 font-semibold">{group.title}</h3>
						<p class="mt-3 text-ink-soft">{group.items[0].detail}</p>
					</article>
				))}
			</div>
			<!-- The owner-confirmed Coming plans (src/lib/coming-plans.ts) are not
			     feature groups, so the cards above miss them. Card payment for
			     booked events is the one a reader of this price most needs. -->
			<ul role="list" class="mt-6 space-y-3 text-ink-soft" data-pricing-coming-plans>
				{comingPlanList.map((plan) => (
					<li><strong class="text-ink">{plan.title}.</strong> {plan.homepage}</li>
				))}
			</ul>
		</div>

		<div class="mt-12 space-y-2 text-ink-soft">
			<!-- The reader looking at one price is exactly the reader who wants to
			     see it against the other two. Quiet text, not a button: this page
			     still has one primary. -->
			<p>Wondering how that compares? <a href="/compare" class="btn-quiet">See it against Parsley and meez</a>.</p>
			<p>Have a question about the plan? <a href={contactCta.href} class="btn-quiet">Contact Rayan</a>.</p>
			<p>Want to see your own menu run first? <a href={demoCta.href} target={demoCta.target} rel={demoCta.rel} class="btn-quiet">{demoCta.label}</a>.</p>
		</div>
	</section>
</Base>
