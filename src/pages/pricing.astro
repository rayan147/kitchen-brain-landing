---
import Base from '../layouts/Base.astro';
import { contactCta, cta, demoCta, launchPlan } from '../lib/site';
import { inDevelopmentFeatureGroups } from '../lib/features';
import { spellCapital } from '../lib/words';
import { comingDefinition } from '../lib/availability';

// The in-development cards are read from features.ts, not typed here. They
// used to be two hand-written articles (labels, ordering) and there are now
// four groups; a page that quotes a price while naming half of what is NOT in
// it is the wrong half to get wrong. One source, one status word, everywhere.
---

<Base
	title="CostCook pricing for catering kitchens"
	description="One CostCook launch plan for a kitchen workspace, with unlimited teammates during launch."
	path="/pricing"
>
	<section class="container-page py-section" aria-labelledby="pricing-title">
		<div class="max-w-3xl">
			<p class="eyebrow">Simple workspace pricing</p>
			<h1 id="pricing-title" class="mt-4 text-display font-semibold">One kitchen. One launch plan.</h1>
			<p class="mt-5 max-w-[62ch] text-lede text-ink-soft">The subscription belongs to the kitchen workspace, not each teammate. The verified owner manages billing and can invite the team.</p>
		</div>

		<div class="mt-10 grid gap-8 border-y border-ticket-rule py-8 lg:grid-cols-[7fr_5fr]">
			<div>
				<p class="text-sm font-semibold text-amber-deep">CostCook Launch</p>
				<p class="mt-2 text-h2 font-semibold">{launchPlan.displayPrice}</p>
				<p class="mt-3 max-w-[54ch] text-ink-soft">Start with {launchPlan.trialDays} days free. Stripe securely collects payment details, charges $0 today, and begins monthly billing after the trial unless you cancel.</p>
				<!-- The launch price is introductory and the page used to be silent about
				     it, which left a reader unable to tell whether $49 was the price or a
				     promotion. It says both halves now: it will rise, and it will not rise
				     under anyone already on it. The second half is a commitment, not copy.
				     If it ever stops being true, this paragraph comes off the page first. -->
				<p class="mt-4 max-w-[54ch] text-ink-soft">
					{launchPlan.displayPrice} is the launch price and it will not stay there. When it
					moves it moves for kitchens that sign up after, never for yours. The price you
					start on is the price you keep.
				</p>
				<a href={cta.href} aria-label={cta.ariaLabel} class="btn-primary mt-7">Start {launchPlan.trialDays}-day free trial</a>
			</div>
			<div>
				<h2 class="text-h3 font-semibold">Included at launch</h2>
				<ul role="list" class="mt-4 space-y-3 text-ink-soft">
					<li>Recipe and menu costing</li>
					<li>Orders, shopping, prep, and pack plans</li>
					<li>Purchasing, receiving, and inventory</li>
					<li>Unlimited teammates during launch</li>
				</ul>
			</div>
		</div>

		<div class="mt-12">
			<h2 class="text-h3 font-semibold">Coming, and not in this price.</h2>
			<p class="mt-3 max-w-[62ch] text-ink-soft">
				{spellCapital(inDevelopmentFeatureGroups.length)} things are marked Coming. {comingDefinition}
			</p>
			<div class="mt-6 grid gap-6 sm:grid-cols-2">
				{inDevelopmentFeatureGroups.map((group) => (
					<article class="border-t border-hairline pt-5">
						<div class="flex flex-wrap items-baseline gap-x-3 gap-y-2">
							<p class="eyebrow">{group.kicker}</p>
							<span class="inline-flex items-center rounded-full border border-ticket-rule bg-softamber px-2.5 py-0.5 font-mono text-xs font-semibold tracking-wide text-amber-deep">
								Coming
							</span>
						</div>
						<h3 class="mt-2 text-h3 font-semibold">{group.title}</h3>
						<p class="mt-3 text-ink-soft">{group.items[0].detail}</p>
					</article>
				))}
			</div>
		</div>

		<div class="mt-12 space-y-2 text-ink-soft">
			<!-- The reader looking at one price is exactly the reader who wants to
			     see it against the other two. Quiet text, not a button: this page
			     still has one primary. -->
			<p>Wondering how that compares? <a href="/compare" class="btn-quiet">See it against Parsley and meez</a>.</p>
			<p>Have a question about the plan? <a href={contactCta.href} class="btn-quiet">Contact Rayan</a>.</p>
			<p>Want to see your own menu run first? <a href={demoCta.href} target={demoCta.target} rel={demoCta.rel} class="btn-quiet">Book a 15-minute demo</a>.</p>
		</div>
	</section>
</Base>
