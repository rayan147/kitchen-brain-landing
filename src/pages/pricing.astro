---
import Base from '../layouts/Base.astro';
import { cta, demoCta } from '../lib/site';

const displayPrice = import.meta.env.PUBLIC_LAUNCH_PRICE_DISPLAY?.trim() || 'Price announced at launch';
---

<Base
	title="CostCook pricing for catering kitchens"
	description="One CostCook launch plan for a kitchen workspace, with unlimited teammates during launch."
	path="/pricing"
>
	<section class="container-page py-section" aria-labelledby="pricing-title">
		<div class="max-w-3xl">
			<p class="eyebrow">Simple workspace pricing</p>
			<h1 id="pricing-title" class="mt-4 text-h2 font-semibold">One kitchen. One launch plan.</h1>
			<p class="mt-5 max-w-[62ch] text-lede text-ink-soft">The subscription belongs to the kitchen workspace, not each teammate. The verified owner manages billing and can invite the team.</p>
		</div>

		<div class="mt-10 grid gap-8 border-y border-ticket-rule py-8 lg:grid-cols-[7fr_5fr]">
			<div>
				<p class="text-sm font-semibold text-amber-deep">CostCook Launch</p>
				<p class="mt-2 text-h2 font-semibold">{displayPrice}</p>
				<p class="mt-3 max-w-[54ch] text-ink-soft">No trial or billing interval is promised here unless it is configured. Stripe shows the exact charge before payment.</p>
				<a href={cta.href} aria-label={cta.ariaLabel} class="btn-primary mt-7">{cta.label}</a>
			</div>
			<div>
				<h2 class="text-h3 font-semibold">Included at launch</h2>
				<ul role="list" class="mt-4 space-y-3 text-ink-soft">
					<li>Recipe and menu costing</li>
					<li>Orders, shopping, prep, and pack plans</li>
					<li>Purchasing, receiving, and inventory</li>
					<li>Unlimited teammates during launch</li>
				</ul>
			</div>
		</div>

		<div class="mt-10 grid gap-6 sm:grid-cols-2">
			<article class="border-t border-hairline pt-5">
				<p class="eyebrow">In development</p>
				<h2 class="mt-2 text-h3 font-semibold">Labels & printing</h2>
				<p class="mt-3 text-ink-soft">Kitchen label workflows and printer-ready output are planned for a later release and are not included today.</p>
			</article>
			<article class="border-t border-hairline pt-5">
				<p class="eyebrow">In development</p>
				<h2 class="mt-2 text-h3 font-semibold">Ordering integrations</h2>
				<p class="mt-3 text-ink-soft">External ordering connections are being developed for a later release and are not included today.</p>
			</article>
		</div>

		<p class="mt-12 text-ink-soft">Want to see your own menu run first? <a href={demoCta.href} target={demoCta.target} rel={demoCta.rel} class="btn-quiet">Book a 15-minute demo</a>.</p>
	</section>
</Base>
