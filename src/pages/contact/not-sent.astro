---
import Base from '../../layouts/Base.astro';
import { site } from '../../lib/site';

/**
 * The honest other half of /contact/sent. A contact form that loses a message
 * in silence is worse than one that admits it failed, because the visitor walks
 * away believing someone will reply. This page never pretends.
 * story: docs/stories/contact-support.story.md
 */
const mailtoHref = `mailto:${site.email}?subject=${encodeURIComponent('Question about CostCook')}`;
---

<Base
	title="Message not sent | CostCook"
	description="The CostCook contact form could not send your message. Email or call instead."
	path="/contact/not-sent"
>
	<section class="container-page py-section" aria-labelledby="not-sent-title">
		<p class="font-mono text-eyebrow font-semibold tracking-wide text-amber-deep">ASK · NOT SENT</p>
		<h1 id="not-sent-title" class="mt-4 max-w-[22ch] text-display font-semibold">
			That did not send. Here are two things that will.
		</h1>
		<p class="mt-6 max-w-[58ch] text-lede text-ink-soft">
			Something on my side stopped the message, so nothing reached me. Rather than ask you to
			retype it into the same form, email it or call.
		</p>
		<p class="mt-8 flex flex-wrap gap-x-6 gap-y-3">
			<a href={mailtoHref} class="btn-primary">Email {site.email}</a>
			<a href={site.phoneHref} class="btn-quiet">Call {site.phone}</a>
		</p>
		<p class="mt-6 max-w-[58ch] text-sm text-ink-soft">
			Or <a href="/contact#ask-form" class="font-medium text-green-deep underline decoration-hairline underline-offset-4">go back to the form</a> and try once more.
		</p>
	</section>
</Base>
