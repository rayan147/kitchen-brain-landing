---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import BlogPostRow from '../../components/BlogPostRow.astro';
import { demoCta, site } from '../../lib/site';
import { getPublishedPosts } from '../../lib/blog';

export const getStaticPaths = (async () => {
	const posts = await getPublishedPosts();
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content, headings } = await render(post);
const allPosts = await getPublishedPosts();
const related = [
	...allPosts.filter((candidate) => candidate.id !== post.id && candidate.data.category === post.data.category),
	...allPosts.filter((candidate) => candidate.id !== post.id && candidate.data.category !== post.data.category)
].slice(0, 2);
const published = new Intl.DateTimeFormat('en-US', {
	month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC'
}).format(post.data.publishedDate);
const path = `/blog/${post.id}`;
const articleJsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: post.data.title,
	description: post.data.description,
	datePublished: post.data.publishedDate.toISOString(),
	dateModified: (post.data.updatedDate ?? post.data.publishedDate).toISOString(),
	author: { '@type': 'Person', name: site.founderName },
	publisher: { '@type': 'Organization', name: site.name, url: site.url },
	mainEntityOfPage: new URL(path, site.url).href
});
const directionContract = `THESIS: Work one kitchen question all the way through; refuse the generic SEO article, floating table of contents, and product pitch disguised as instruction.
OWN-WORLD: A calm CostCook working sheet with editorial decisions, plain body type, amber arithmetic, green handoffs, and ruled paper evidence.
STORY: Name the decision, show the formula, work a bounded example, expose its exceptions, and return the reader to the next job with the working intact.
FIRST VIEWPORT: Breadcrumb and article identity lead; category, date, and reading time support; the first useful paragraph begins without a decorative hero image.
FORM: Code-led long-form working sheet; seed key blog-article-working-shown.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md`;
---

<Base title={`${post.data.title} | CostCook`} description={post.data.description} {path} {directionContract}>
	<script type="application/ld+json" set:html={articleJsonLd} is:inline></script>
	<article>
		<header class="border-y border-hairline bg-cream">
			<div class="container-page py-section-tight">
				<nav aria-label="Breadcrumb" class="anim-enter flex flex-wrap items-center gap-2 text-sm text-ink-soft">
					<a href="/blog" class="btn-quiet inline-flex min-h-11 items-center">Blog</a>
					<span aria-hidden="true">/</span>
					<span>{post.data.category}</span>
				</nav>
				<div class="mt-5 grid gap-8 lg:grid-cols-[1fr_15rem] lg:items-end lg:gap-16">
					<div>
						<h1 class="anim-enter max-w-[23ch] text-display font-semibold" style="--enter-delay: 60ms">{post.data.title}</h1>
						<p class="anim-enter mt-6 max-w-[62ch] text-lede text-ink-soft" style="--enter-delay: 120ms">{post.data.description}</p>
					</div>
					<dl class="anim-enter grid grid-cols-2 gap-4 border-y border-ticket-rule py-4 text-sm lg:grid-cols-1" style="--enter-delay: 180ms">
						<div><dt class="text-xs font-semibold text-amber-deep">Written by</dt><dd class="mt-1 font-semibold">{site.founderName}</dd></div>
						<div><dt class="text-xs font-semibold text-amber-deep">Published</dt><dd class="mt-1">{published} · {post.data.readMinutes} min</dd></div>
					</dl>
				</div>
			</div>
		</header>

		<div class="container-page grid gap-10 py-section-tight lg:grid-cols-[minmax(0,44rem)_14rem] lg:justify-center lg:gap-16">
			{headings.length > 0 && (
				<aside class="lg:col-start-2 lg:row-start-1" aria-labelledby="article-path-title">
					<div class="border-y border-ticket-rule py-4 lg:sticky lg:top-6">
						<h2 id="article-path-title" class="text-sm font-semibold">In this guide</h2>
						<ol class="mt-3 space-y-1">
							{headings.filter((heading) => heading.depth === 2).map((heading) => (
								<li><a href={`#${heading.slug}`} class="inline-flex min-h-11 items-center text-sm leading-snug text-green-deep underline decoration-hairline underline-offset-4">{heading.text}</a></li>
							))}
						</ol>
					</div>
				</aside>
			)}
			<div class="article-body min-w-0 lg:col-start-1 lg:row-start-1"><Content /></div>
		</div>
	</article>

	<section class="border-y border-hairline bg-softgreen" aria-labelledby="article-next-step">
		<div class="container-page flex flex-col gap-6 py-10 sm:flex-row sm:items-center sm:justify-between">
			<div>
				<h2 id="article-next-step" class="font-display text-2xl font-semibold">See the working inside the product.</h2>
				<p class="mt-2 max-w-[54ch] text-sm leading-relaxed text-ink-soft">The same question, shown in CostCook.</p>
			</div>
			<a href={post.data.featureHref} class="btn-quiet self-start sm:self-auto sm:whitespace-nowrap">{post.data.featureLabel}</a>
		</div>
	</section>

	<section class="container-page py-section-tight" aria-labelledby="related-guides-title">
		<div class="flex flex-wrap items-end justify-between gap-4">
			<h2 id="related-guides-title" class="text-h2 font-semibold">Keep working the question.</h2>
			<a href="/blog" class="btn-quiet inline-flex min-h-11 items-center">See every guide</a>
		</div>
		<div class="mt-7 border-b border-hairline">
			{related.map((candidate) => <BlogPostRow post={candidate} headingLevel={3} compact />)}
		</div>
		<div class="mt-8"><a href={demoCta.href} class="btn-quiet inline-flex min-h-11 items-center">Or bring one real order to a 15-minute demo <span aria-hidden="true">→</span></a></div>
	</section>
</Base>

<style>
	.article-body :global(p),
	.article-body :global(li) {
		font-size: var(--text-body-lg);
		line-height: 1.75;
		color: var(--color-ink-soft);
	}

	.article-body :global(p + p),
	.article-body :global(ul + p),
	.article-body :global(ol + p),
	.article-body :global(pre + p) {
		margin-top: 1.35rem;
	}

	.article-body :global(h2) {
		margin-top: 3.5rem;
		margin-bottom: 1rem;
		font-family: var(--font-display);
		font-size: var(--text-h2);
		font-weight: 600;
		line-height: 1.15;
		color: var(--color-ink);
		text-wrap: balance;
		scroll-margin-top: 2rem;
	}

	.article-body :global(ul),
	.article-body :global(ol) {
		margin-top: 1rem;
		padding-left: 1.4rem;
	}

	.article-body :global(ul) { list-style: square; }
	.article-body :global(ol) { list-style: decimal; }
	.article-body :global(li + li) { margin-top: .55rem; }
	.article-body :global(strong) { color: var(--color-ink); font-weight: 650; }

	.article-body :global(pre) {
		margin-block: 1.5rem;
		overflow-x: auto;
		border-block: 1px solid var(--color-ticket-rule);
		background: var(--color-paper);
		padding: 1.25rem;
		font-size: var(--text-body-sm);
		line-height: 1.7;
		color: var(--color-ink);
		font-variant-numeric: tabular-nums;
	}

	.article-body :global(a) {
		color: var(--color-green-deep);
		font-weight: 600;
		text-decoration: underline;
		text-decoration-color: var(--color-hairline-strong);
		text-underline-offset: 4px;
	}

	@media (max-width: 1023px) {
		.article-body :global(h2) { scroll-margin-top: 1rem; }
	}

	@media (max-width: 639px) {
		.article-body :global(p),
		.article-body :global(li) { font-size: var(--text-body); }
		.article-body :global(pre) { margin-inline: -1.25rem; padding-inline: 1.25rem; }
	}
</style>
