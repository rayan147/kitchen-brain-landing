---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BlogPostRow from '../../components/BlogPostRow.astro';
import { demoCta } from '../../lib/site';

// story: docs/stories/blog.story.md

const posts = (await getCollection('blog')).sort((a, b) => a.data.order - b.data.order);
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const categories = [...new Set(posts.map((post) => post.data.category))];
const published = featured
	? new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(featured.data.publishedDate)
	: '';

const directionContract = `THESIS: A working chef should leave with the number worked through, not another list of software opinions; refuse the generic publication grid and stock-photo article cards.
OWN-WORLD: CostCook's warm counter becomes a ruled working notebook: paper, ink, green actions, amber measurements, Fraunces decisions, and Instrument Sans explanations.
STORY: Choose the kitchen question in front of you, see the arithmetic and its boundary, then carry one answer into the next job.
FIRST VIEWPORT: Editorial promise at left; a real 180-guest quote calculation at right; the featured guide begins at the fold.
FORM: Code-led working-notebook index; seed key blog-working-through-the-number.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md`;
---

<Base
	title="CostCook Blog: Food Cost, Recipes, Buying & Catering Operations"
	description="Practical guides for catering food cost, recipe yield, menu pricing, supplier buying, and the kitchen work behind an event."
	path="/blog"
	{directionContract}
>
	<!-- story: docs/stories/blog.story.md -->
	<section class="border-y border-hairline bg-cream">
		<div class="container-page grid gap-10 py-section-tight lg:grid-cols-[1.2fr_.8fr] lg:items-end lg:gap-16">
			<div class="anim-enter max-w-3xl">
				<h1 class="text-display font-semibold">Practical answers for the numbers behind the food.</h1>
				<p class="mt-6 max-w-[58ch] text-lede text-ink-soft">
					Cost a recipe, price a menu, plan the buy, and keep the working visible when the count or supplier price changes.
				</p>
			</div>

			<aside class="anim-enter border-y border-ticket-rule py-5" style="--enter-delay: 100ms" aria-label="An example of the working shown in the blog">
				<p class="text-sm font-semibold text-ink">One quote, worked through</p>
				<dl class="mt-4 space-y-3 font-mono text-sm tabular-nums">
					<div class="flex items-baseline justify-between gap-4"><dt class="text-ink-soft">180 guests × $68</dt><dd class="font-semibold">$12,240</dd></div>
					<div class="flex items-baseline justify-between gap-4"><dt class="text-ink-soft">Food per guest</dt><dd class="font-semibold">$26.93</dd></div>
					<div class="flex items-baseline justify-between gap-4 border-t border-ticket-rule pt-3"><dt class="text-ink-soft">Food-cost target</dt><dd class="font-semibold text-amber-deep">30%</dd></div>
				</dl>
				<p class="mt-4 text-sm leading-relaxed text-ink-soft">Every guide starts with the kitchen question and keeps the assumption beside the answer.</p>
			</aside>
		</div>
	</section>

	{featured && (
		<section class="container-page py-section-tight" aria-labelledby="featured-guide-title">
			<div class="grid border-y border-ticket-rule bg-paper lg:grid-cols-[1.35fr_.65fr]">
				<div class="p-6 sm:p-9 lg:p-12">
					<div class="flex flex-wrap gap-x-4 gap-y-1 text-xs font-semibold text-amber-deep">
						<span>{featured.data.category}</span>
						<span class="text-ink-soft">{published} · {featured.data.readMinutes} min read</span>
					</div>
					<h2 id="featured-guide-title" class="mt-5 max-w-[22ch] text-h2 font-semibold">{featured.data.title}</h2>
					<p class="mt-5 max-w-[58ch] leading-relaxed text-ink-soft">{featured.data.description}</p>
					<a href={`/blog/${featured.id}`} class="btn-quiet mt-7 inline-flex min-h-11 items-center">Work through the example <span aria-hidden="true">→</span></a>
				</div>
				<div class="flex flex-col justify-between border-t border-ticket-rule bg-softgreen p-6 sm:p-9 lg:border-t-0 lg:border-l lg:p-10">
					<p class="font-display text-2xl font-semibold">Before you say the price out loud.</p>
					<div class="mt-8 space-y-4 text-sm text-ink-soft">
						<p><strong class="text-ink">Start:</strong> the menu, guest count, and current ingredient cost.</p>
						<p><strong class="text-ink">Check:</strong> food per guest and percentage against the target.</p>
						<p><strong class="text-ink">Decide:</strong> change the price, menu, target, or job with the consequence visible.</p>
					</div>
				</div>
			</div>
		</section>
	)}

	<section class="border-t border-hairline" aria-labelledby="all-guides-title">
		<div class="container-page py-section">
			<div class="grid gap-8 lg:grid-cols-[16rem_1fr] lg:gap-16">
				<div>
					<h2 id="all-guides-title" class="text-h2 font-semibold">Choose the question in front of you.</h2>
					<nav class="mt-6" aria-label="Blog topics">
						<ul role="list" class="space-y-1">
							{categories.map((category) => (
								<li><a href={`#${category.toLowerCase().replaceAll(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`} class="btn-quiet inline-flex min-h-11 items-center">{category}</a></li>
							))}
						</ul>
					</nav>
				</div>

				<div>
					{categories.map((category) => {
						const id = category.toLowerCase().replaceAll(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
						const categoryPosts = posts.filter((post) => post.data.category === category);
						return (
							<section id={id} class="scroll-mt-28 pb-12 last:pb-0" aria-labelledby={`${id}-title`}>
								<h3 id={`${id}-title`} class="pb-4 text-sm font-semibold text-amber-deep">{category}</h3>
								{categoryPosts.map((post) => <BlogPostRow {post} headingLevel={4} />)}
							</section>
						);
					})}
				</div>
			</div>
		</div>
	</section>

	<section class="border-t border-hairline bg-softgreen">
		<div class="container-page flex flex-col gap-6 py-section-tight sm:flex-row sm:items-center sm:justify-between">
			<div>
				<h2 class="text-h2 font-semibold">Bring the number you are working on.</h2>
				<p class="mt-3 max-w-[56ch] text-ink-soft">Put one real menu and guest count through CostCook with Rayan.</p>
			</div>
			<a href={demoCta.href} class="btn-primary self-start whitespace-nowrap sm:self-auto">Book a 15-min demo</a>
		</div>
	</section>
</Base>
