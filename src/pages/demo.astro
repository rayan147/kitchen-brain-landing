---
import Base from '../layouts/Base.astro';
import DemoRequest from '../components/sections/DemoRequest.astro';

const directionContract = `request-demo-working-session
THESIS: One real kitchen job leads the demo; the page refuses the generic SaaS lead form and feature parade.
OWN-WORLD: CostCook's off-white counter, paper demo ticket, green actions, amber rules, Fraunces decisions, and Instrument Sans working details.
STORY: The visitor names the work, prepares a visible email handoff, chooses a 15-minute time, and keeps a self-serve exit.
FIRST VIEWPORT: A direct promise and connected three-step work path sit beside the two-stage demo ticket; the first action closes the ticket's first frame.
FORM: A focused two-step qualification ticket, chosen from the supplied Meez reference and adapted to CostCook's static, founder-direct contact boundary.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md`;
---

<Base
	title="Book a 15-minute CostCook demo"
	description="Bring one real menu, quote, order, or supplier sheet. Follow it through CostCook with Rayan and decide whether it fits your kitchen."
	path="/demo"
	{directionContract}
>
	<DemoRequest />
</Base>
