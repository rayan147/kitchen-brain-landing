---
import Base from '../layouts/Base.astro';
import FaqPage from '../components/sections/FaqPage.astro';
import { faq, faqCount } from '../lib/faq';
import { spellCapital } from '../lib/words';

// story: docs/stories/faq.story.md

const description = `${spellCapital(faqCount)} plain answers about the CostCook trial, the bill, who it fits, how the work moves, and getting started.`;

// FAQPage structured data. A data block, not a script: the CSP's script-src
// does not govern application/ld+json. Answers are plain text here (tags
// stripped) because the markup allowed in an answer is one inline link.
const strip = (html: string) => html.replace(/<[^>]+>/g, '');
const jsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.flatMap((group) =>
		group.entries.map((entry) => ({
			'@type': 'Question',
			name: entry.question,
			acceptedAnswer: { '@type': 'Answer', text: entry.answer.map(strip).join(' ') }
		}))
	)
});

const directionContract = `THESIS: Reveal the catch before asking for trust; refuse the accordion wall and generic feature-card FAQ.
OWN-WORLD: Warm answer sheet, cream decision ticket, green actions, amber rules, Fraunces decisions, Instrument Sans mechanics.
STORY: Check the hard terms, choose a question path, read every answer in place, then try one real order.
FIRST VIEWPORT: Editorial promise left; trial, card, first charge, and cancel ticket right; billing action immediately visible.
FORM: Founder answer sheet, first-ranked extension of the established Kitchen Ticket world; seed faq-answer-sheet.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md`;
---

<Base title="CostCook questions, answered plainly" description={description} path="/faq" directionContract={directionContract}>
	<script type="application/ld+json" is:inline set:html={jsonLd} />
	<FaqPage />
</Base>
