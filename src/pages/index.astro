---
import Base from '../layouts/Base.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeEventWalk from '../components/home/HomeEventWalk.astro';
import HomeKitchen from '../components/home/HomeKitchen.astro';
import HomeConnections from '../components/home/HomeConnections.astro';
import HomeClose from '../components/home/HomeClose.astro';
import StickyCta from '../components/StickyCta.astro';
import { site } from '../lib/site';

// Considered Builder; not used because this is one fixed, factual organization
// record. A builder would hide the few properties the homepage can verify.
const organizationJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.name,
  url: site.url,
  logo: new URL('/brand/costcook-icon.svg', site.url).href,
  founder: { '@type': 'Person', name: site.founderName }
});
---
<!-- story: docs/stories/homepage-mockup-2026-10.story.md -->
<!-- Considered Composite; not used because this is a fixed, flat editorial
     sequence. The detailed product tour remains at /tour/main. -->
<Base headerTone="cream" structuredData={organizationJsonLd}>
  <HomeHero />
  <HomeEventWalk />
  <HomeKitchen />
  <HomeConnections />
  <HomeClose />
  <StickyCta />
</Base>
